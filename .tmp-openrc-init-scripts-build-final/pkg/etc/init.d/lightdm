#!/sbin/openrc-run

description="Light Display Manager"

pidfile=/run/lightdm.pid

depend() {
	provide xdm
	need dbus
	need logger
}

start() {
	ebegin "Starting LightDM"
	start-stop-daemon --start --exec /usr/bin/lightdm
	eend $?
}

stop() {
	ebegin "Stopping LightDM"
	start-stop-daemon --stop --exec /usr/bin/lightdm
	eend $?
}
