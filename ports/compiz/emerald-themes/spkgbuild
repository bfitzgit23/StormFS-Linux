# description	: Themes for the Emerald Compiz decorator
# homepage	: https://gitlab.com/compiz/emerald-themes
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Themes for the Emerald Compiz decorator"
name=emerald-themes
version=0.8.18
release=2
source="https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
