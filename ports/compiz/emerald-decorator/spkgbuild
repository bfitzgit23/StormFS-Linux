# description	: GTK3 Emerald window decorator for Compiz Reloaded
# homepage	: https://gitlab.com/compiz/emerald
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=emerald-decorator
version=0.8.18
release=2
source="https://gitlab.com/compiz/emerald/-/archive/v$version/emerald-v$version.tar.bz2"

build() {
	cd "$name-$version" || return 1
    NOCONFIGURE=1 LIBS+=" -lm -ldl" ./autogen.sh || return 1
    ./configure --prefix=/usr --with-gtk=3.0 || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
