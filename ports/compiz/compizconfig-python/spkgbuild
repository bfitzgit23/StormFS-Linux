# description	: Python 3 bindings for CompizConfig
# homepage	: https://gitlab.com/compiz/compizconfig-python
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python 3 bindings for CompizConfig"
name=compizconfig-python
version=0.8.18
release=1
source="https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2"

build() {
	cd "$name-$version" || return 1
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
