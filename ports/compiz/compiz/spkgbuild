# description	: Compiz Reloaded compositing window manager (0.8.x series)
# homepage	: https://gitlab.com/compiz/compiz-core
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Compiz Reloaded compositing window manager (0.8.x series)"
name=compiz
version=0.8.18
release=3
source="https://gitlab.com/compiz/compiz-core/-/archive/v$version/compiz-core-v$version.tar.bz2 https://gitlab.com/compiz/compiz-core/-/commit/c0c605dd.patch https://gitlab.com/compiz/compiz-core/-/commit/9f105a8b.patch https://gitlab.com/compiz/compiz-core/-/commit/ea7b3731.patch https://gitlab.com/compiz/compiz-core/-/commit/d4213fa4.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# 9f105a8b is a follow-up to c0c605dd; apply in dependency order
	# because the alphabetic glob would sort 9f105a8b first.
	for _bfs_patch in \
		"$SRC/c0c605dd.patch" \
		"$SRC/9f105a8b.patch" \
		"$SRC/ea7b3731.patch" \
		"$SRC/d4213fa4.patch"; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --with-default-plugins="core,ccp,composite,opengl,decor,move,resize,place,regex,wall,animation,staticswitcher" \
        || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
