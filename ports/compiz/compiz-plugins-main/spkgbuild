# description	: Main Compiz Reloaded plugin collection
# homepage	: https://gitlab.com/compiz/compiz-plugins-main
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Main Compiz Reloaded plugin collection"
name=compiz-plugins-main
version=0.8.18
release=1
source="https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2 https://gitlab.com/compiz/compiz-plugins-main/-/commit/568f653a.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    NOCONFIGURE=1 ./autogen.sh || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
