description="texinfo package"
name=texinfo
version=7.3
release=1
source="https://ftp.gnu.org/gnu/texinfo/texinfo-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
