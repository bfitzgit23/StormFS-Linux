# description	: Programmable completion functions for the Bash shell
# homepage	: https://github.com/scop/bash-completion
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Programmable completion functions for the Bash shell"
name=bash-completion
version=2.18.0
release=1
source="https://github.com/scop/bash-completion/releases/download/$version/bash-completion-$version.tar.xz bash_completion.sh"

build() {
	cd "$name-$version" || return 1
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc || return 1

    make -j "${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1
    install -Dm644 "$SRC/bash_completion.sh" "$PKG/etc/profile.d/bash_completion.sh" || return 1
}
