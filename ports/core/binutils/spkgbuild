# description	: binutils package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="binutils package"
name=binutils
version=2.47
release=1
source="https://sourceware.org/pub/binutils/releases/binutils-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	mkdir -v build
	cd       build

	../configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-gold \
		--enable-ld=default \
		--enable-lto \
		--enable-plugins \
		--enable-shared \
		--disable-werror \
		--with-system-zlib \
		--enable-multilib \
		--with-lib-path=/usr/lib:/lib:/usr/lib32
	make DESTDIR=$PKG tooldir=/usr
	make DESTDIR=$PKG tooldir=/usr install
}

bootstrap_build() {
	mkdir -v build
	cd       build
	
	if [ "$tcpkg" = binutils-pass1 ]; then
		../configure  \
			--prefix=$TOOLS \
			--with-sysroot=$LFS \
			--target=$LFS_TGT \
			--disable-nls \
			--disable-werror \
			--enable-gprofng=no \
			--enable-new-dtags \
			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib:$TOOLS/lib32
		make
		mkdir -v $TOOLS/lib && ln -sv lib $TOOLS/lib64
		mkdir -p $TOOLS/lib32
		make install
	elif [ "$tcpkg" = binutils-pass2 ]; then
		# This builds for the temporary toolchain's target, not for the build
		# host.  At this point $LFS_TGT-gcc links every program against the
		# temporary glibc under $TOOLS, so a probe binary carries an
		# interpreter under $TOOLS and autoconf cannot execute it from the
		# build host: configure aborts with "cannot run C compiled programs.
		# If you meant to cross compile, use `--host'."  Declaring the real
		# build/host pair is what turns those probes into compile-only checks.
		CC=$LFS_TGT-gcc \
		AR=$LFS_TGT-ar \
		RANLIB=$LFS_TGT-ranlib \
		../configure \
			--build="$(../config.guess)" \
			--host="$LFS_TGT" \
			--prefix=$TOOLS \
			--enable-shared \
			--disable-nls \
			--disable-werror \
			--enable-64-bit-bfd \
			--enable-new-dtags \
			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib \
			--enable-gprofng=no \
			--with-sysroot

		if [ ! -f Makefile ]; then
			echo "ERROR: binutils-pass2 configure did not produce a Makefile." >&2

			if [ -f config.log ]; then
				echo "== configure failure (config.log tail) ==" >&2
				tail -n 40 config.log >&2
			fi

			# Report what the temporary compiler actually produces: a probe
			# binary whose dynamic loader cannot be resolved is the usual
			# cause, and this says which of the two it is.
			printf 'int main(void) { return 0; }\n' > /tmp/bfs-cc-probe.c

			if $LFS_TGT-gcc /tmp/bfs-cc-probe.c -o /tmp/bfs-cc-probe 2>/tmp/bfs-cc-probe.log; then
				echo "== temporary-compiler probe ==" >&2
				readelf -l /tmp/bfs-cc-probe 2>/dev/null |
					sed -n 's@.*interpreter: \(.*\)@interpreter: \1@p' >&2
				if /tmp/bfs-cc-probe; then
					echo "probe: the compiled program runs; the dynamic loader is fine." >&2
				else
					echo "probe: the compiled program does not run (exit $?)." >&2
				fi
			else
				echo "== temporary-compiler probe failed to compile ==" >&2
				tail -n 20 /tmp/bfs-cc-probe.log >&2
			fi

			return 1
		fi

		# GCC prefers the target-layout tooldir copy of the assembler over
		# PATH.  A failed earlier run can leave a target-linked binary there
		# which cannot execute on the build host: every compile then reports
		# "cannot execute .../as: posix_spawn: No such file or directory".
		# Restore the pass-1 host copy while it is still usable.
		tc_as="$TOOLS/$LFS_TGT/bin/as"
		tc_as_host="$TOOLS/bin/$LFS_TGT-as"

		if [ -e "$tc_as" ] && ! "$tc_as" --version >/dev/null 2>&1; then
			if "$tc_as_host" --version >/dev/null 2>&1; then
				echo "binutils-pass2: repairing unusable $tc_as from $tc_as_host" >&2
				cp -f "$tc_as_host" "$tc_as" || return 1
			else
				echo "ERROR: the temporary assembler cannot run: $tc_as" >&2
				readelf -l "$tc_as" 2>/dev/null |
					sed -n 's@.*interpreter: \(.*\)@  interpreter: @p' >&2
				return 1
			fi
		fi

		# A failed compile must never reach make install: installing the
		# partial tree puts a target-linked assembler in $TOOLS/bin and in the
		# target-layout tooldir, so every following compile fails with an exec
		# error instead of the real build error.
		if ! make CFLAGS="-O2 -DPATH_MAX=4096"; then
			echo "binutils-pass2: parallel build failed; retrying with -j1" >&2

			if ! make -j1 CFLAGS="-O2 -DPATH_MAX=4096"; then
				echo "ERROR: binutils-pass2 failed to compile; nothing was installed." >&2
				echo "       The first error is above this line in the package log." >&2
				return 1
			fi
		fi

		make install || return 1
		make -C ld clean || return 1
		make -C ld LIB_PATH=/usr/lib:/lib:/usr/lib32 || return 1
		cp -v ld/ld-new $TOOLS/bin || return 1
	fi
}
