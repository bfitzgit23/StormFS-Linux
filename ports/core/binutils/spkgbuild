# description	: binutils package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="binutils package"
name=binutils
version=2.47
release=1
source="https://sourceware.org/pub/binutils/releases/binutils-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	mkdir -v build
	cd       build

	../configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-gold \
		--enable-ld=default \
		--enable-lto \
		--enable-plugins \
		--enable-shared \
		--disable-werror \
		--with-system-zlib \
		--enable-multilib \
		--with-lib-path=/usr/lib:/lib:/usr/lib32
	make DESTDIR=$PKG tooldir=/usr
	make DESTDIR=$PKG tooldir=/usr install
}

bootstrap_build() {
	# The temporary compiler is configured with --with-sysroot=$TOOLS, so it
	# links every program with the interpreter $TOOLS/lib64/ld-linux-x86-64.so.2
	# (and $TOOLS/lib/ld-linux.so.2 for -m32), while the temporary glibc
	# installs its loaders into $TOOLS/lib and $TOOLS/lib32.  $TOOLS/lib64 must
	# therefore be a link to lib.  A cache that cannot hold symlinks drops that
	# link silently, and the failure it causes is misleading: execve reports
	# ENOENT for the missing interpreter, not for the program, so gcc prints
	# "cannot execute .../as: No such file or directory" while the file is
	# right there, and every compile and link in the toolchain stage fails.
	_bfs_ensure_tools_loader() {
		if [ ! -e "$TOOLS/lib64/ld-linux-x86-64.so.2" ]; then
			if [ ! -d "$TOOLS/lib64" ] || [ -L "$TOOLS/lib64" ]; then
				/bin/ln -sfn lib "$TOOLS/lib64" 2>/dev/null || true
			fi
		fi

		if [ ! -e "$TOOLS/lib/ld-linux.so.2" ] && [ -e "$TOOLS/lib32/ld-linux.so.2" ]; then
			/bin/ln -sfn ../lib32/ld-linux.so.2 "$TOOLS/lib/ld-linux.so.2" 2>/dev/null || true
		fi

		if [ -e "$TOOLS/lib/ld-linux-x86-64.so.2" ] &&
			[ ! -e "$TOOLS/lib64/ld-linux-x86-64.so.2" ]; then
			echo "ERROR: the temporary loader is not reachable at $TOOLS/lib64/ld-linux-x86-64.so.2" >&2
			ls -ld "$TOOLS/lib64" "$TOOLS/lib/ld-linux-x86-64.so.2" >&2 2>/dev/null || true
			return 1
		fi

		return 0
	}

	_bfs_ensure_tools_loader || return 1

	mkdir -v build
	cd       build
	
	if [ "$tcpkg" = binutils-pass1 ]; then
		../configure  \
			--prefix=$TOOLS \
			--with-sysroot=$LFS \
			--target=$LFS_TGT \
			--disable-nls \
			--disable-werror \
			--enable-gprofng=no \
			--enable-new-dtags \
			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib:$TOOLS/lib32
		make
		mkdir -pv $TOOLS/lib
		mkdir -p $TOOLS/lib32
		make install
	elif [ "$tcpkg" = binutils-pass2 ]; then
		# This builds for the temporary toolchain's target, not for the build
		# host.  At this point $LFS_TGT-gcc links every program against the
		# temporary glibc under $TOOLS, so a probe binary carries an
		# interpreter under $TOOLS and autoconf cannot execute it from the
		# build host: configure aborts with "cannot run C compiled programs.
		# If you meant to cross compile, use `--host'."  Declaring the real
		# build/host pair is what turns those probes into compile-only checks.
		CC=$LFS_TGT-gcc \
		AR=$LFS_TGT-ar \
		RANLIB=$LFS_TGT-ranlib \
		../configure \
			--build="$(../config.guess)" \
			--host="$LFS_TGT" \
			--prefix=$TOOLS \
			--enable-shared \
			--disable-nls \
			--disable-werror \
			--enable-64-bit-bfd \
			--enable-new-dtags \
			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib \
			--enable-gprofng=no \
			--with-sysroot

		if [ ! -f Makefile ]; then
			echo "ERROR: binutils-pass2 configure did not produce a Makefile." >&2

			if [ -f config.log ]; then
				echo "== configure failure (config.log tail) ==" >&2
				tail -n 40 config.log >&2
			fi

			# Report what the temporary compiler actually produces: a probe
			# binary whose dynamic loader cannot be resolved is the usual
			# cause, and this says which of the two it is.
			printf 'int main(void) { return 0; }\n' > /tmp/bfs-cc-probe.c

			if $LFS_TGT-gcc /tmp/bfs-cc-probe.c -o /tmp/bfs-cc-probe 2>/tmp/bfs-cc-probe.log; then
				echo "== temporary-compiler probe ==" >&2
				readelf -l /tmp/bfs-cc-probe 2>/dev/null |
					sed -n 's@.*interpreter: \(.*\)@interpreter: \1@p' >&2
				if /tmp/bfs-cc-probe; then
					echo "probe: the compiled program runs; the dynamic loader is fine." >&2
				else
					echo "probe: the compiled program does not run (exit $?)." >&2
				fi
			else
				echo "== temporary-compiler probe failed to compile ==" >&2
				tail -n 20 /tmp/bfs-cc-probe.log >&2
			fi

			return 1
		fi

		# GCC prefers the target-layout tooldir copy of the assembler over
		# PATH.  binutils' own install refreshes that entry from the program it
		# just installed, so once a pass has owned the entry it can be left
		# missing, dangling or target-linked; every compile then reports
		# "cannot execute .../as: posix_spawn: No such file or directory".
		# `test -e` follows symlinks, so a dangling entry reads as absent:
		# remove the entry before restoring the pass-1 host copy.
		_bfs_ensure_tc_as() {
			local tc_as="$TOOLS/$LFS_TGT/bin/as"
			local tc_as_host="$TOOLS/bin/$LFS_TGT-as"

			if "$tc_as" --version >/dev/null 2>&1; then
				return 0
			fi

			if ! "$tc_as_host" --version >/dev/null 2>&1; then
				echo "ERROR: no usable assembler for the temporary toolchain." >&2
				echo "  unusable: $tc_as" >&2
				echo "  unusable: $tc_as_host" >&2
				ls -l "$tc_as" "$tc_as_host" >&2 2>/dev/null || true
				return 1
			fi

			echo "binutils-pass2: restoring $tc_as from $tc_as_host" >&2
			rm -f "$tc_as" || return 1
			cp -f "$tc_as_host" "$tc_as" || return 1
			chmod 0755 "$tc_as" || return 1
		}

		# A failed compile must never reach make install: installing the
		# partial tree puts a target-linked assembler in $TOOLS/bin and in the
		# target-layout tooldir, so every following compile fails with an exec
		# error instead of the real build error.
		_bfs_ensure_tc_as || return 1

		if ! make CFLAGS="-O2 -DPATH_MAX=4096"; then
			echo "binutils-pass2: parallel build failed; retrying with -j1" >&2

			if ! make -j1 CFLAGS="-O2 -DPATH_MAX=4096"; then
				echo "ERROR: binutils-pass2 failed to compile; nothing was installed." >&2
				echo "       The first error is above this line in the package log." >&2
				return 1
			fi
		fi

		make install || return 1

		# make install rewrites the tooldir assembler entry; the ld relink
		# below compiles again and must not inherit a broken one.
		_bfs_ensure_tc_as || return 1
		make -C ld clean || return 1
		make -C ld LIB_PATH=/usr/lib:/lib:/usr/lib32 || return 1
		cp -v ld/ld-new $TOOLS/bin || return 1
	fi
}
