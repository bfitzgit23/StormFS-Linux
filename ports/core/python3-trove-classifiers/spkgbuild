description="python3-trove-classifiers package"
name=python3-trove-classifiers
version=2026.9.21.13
release=1
source="https://files.pythonhosted.org/packages/source/t/trove_classifiers/trove_classifiers-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "trove_classifiers-2026.9.21.13" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
