# description	: pcre2 package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="pcre2 package"
name=pcre2
version=10.48
release=1
source="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$version/pcre2-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr                       \
	            --enable-unicode                    \
	            --enable-jit                        \
	            --enable-pcre2-16                   \
	            --enable-pcre2-32                   \
	            --enable-pcre2grep-libz             \
	            --enable-pcre2grep-libbz2           \
	            --enable-pcre2test-libreadline
	make
	make DESTDIR="$PKG" install
}
