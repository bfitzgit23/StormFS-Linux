description="python3-markdown package"
name=python3-markdown
version=3.10.3
release=1
source="https://files.pythonhosted.org/packages/29/6f/da4c6aea59b3001f2e8c0ec7497475aadaf3b021c10cab5b2858f0f32b26/markdown-3.10.3.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "markdown-3.10.3" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    /usr/bin/pip3 install . \
        --root="$PKG" \
        --prefix=/usr \
        --no-deps \
        --no-build-isolation
}
