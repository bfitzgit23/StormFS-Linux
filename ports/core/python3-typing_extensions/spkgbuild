description="python3-typing_extensions package"
name=python3-typing_extensions
version=4.16.0
release=1
source="https://files.pythonhosted.org/packages/source/t/typing_extensions/typing_extensions-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "typing_extensions-4.16.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --skip-dependency-check --no-isolation
python3 -m installer --destdir="${PKG}" dist/*.whl
}
