# description	: A low-level library for installing from a Python wheel distribution
# homepage	: https://github.com/pypa/installer
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A low-level library for installing from a Python wheel distribution"
name=python3-installer
version=1.0.1
release=1
source="https://pypi.org/packages/source/i/installer/installer-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "installer-1.0.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install --isolated --root=$PKG \
    --ignore-installed --no-deps .
}
