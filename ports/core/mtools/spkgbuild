# description	: Utilities to access MS-DOS disks without mounting them
# homepage	: https://www.gnu.org/software/mtools/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Utilities to access MS-DOS disks without mounting them"
name=mtools
version=4.0.49
release=2
source="https://ftp.gnu.org/gnu/mtools/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-floppyd
	make
	sed -i Makefile -e 's|install-scripts install-info|install-scripts|'
	make -j1 DESTDIR="$PKG" prefix=/usr install
}
