# description	: Utilities to access MS-DOS disks without mounting them
# homepage	: https://www.gnu.org/software/mtools/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=mtools
version=4.0.49
release=2
source="https://ftp.gnu.org/gnu/mtools/$name-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-floppyd
	make
	sed -i Makefile -e 's|install-scripts install-info|install-scripts|'
	make -j1 DESTDIR="$PKG" prefix=/usr install
}
