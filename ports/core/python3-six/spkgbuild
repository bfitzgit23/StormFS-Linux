# description	: Python 2 and 3 compatibility utilities
# homepage	: https://pypi.python.org/pypi/six/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python 2 and 3 compatibility utilities"
name=python3-six
version=1.17.0
release=2
source="https://pypi.org/packages/source/s/six/six-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "six-1.17.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --prefix=/usr \
    --root=$PKG \
    --skip-build
}
