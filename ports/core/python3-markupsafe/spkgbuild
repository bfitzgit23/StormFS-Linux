# description	: A stream oriented C library for parsing XML
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A stream oriented C library for parsing XML"
name=python3-markupsafe
version=3.0.3
release=1
source="https://pypi.org/packages/source/M/MarkupSafe/markupsafe-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "markupsafe-3.0.3" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

		/usr/bin/python3 setup.py build

	/usr/bin/python3 setup.py install --prefix=/usr \
		--root=$PKG --optimize=1
}
