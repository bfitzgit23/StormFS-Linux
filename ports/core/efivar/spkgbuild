# description	: efivar package
# homepage	: https://github.com/rhboot/efivar
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
cription: Tools and libraries to manipulate EFI variables

description="efivar package"
name=efivar
version=39
release=2
source="https://github.com/rhboot/$name/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    make -j1 \
        ENABLE_DOCS=0 \
        libdir=/usr/lib

    make \
        ENABLE_DOCS=0 \
        libdir=/usr/lib \
        DESTDIR="$PKG" \
        install
}
