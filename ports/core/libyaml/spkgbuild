# description	: YAML 1.1 parser and emitter library
# homepage	: https://github.com/yaml/libyaml
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="YAML 1.1 parser and emitter library"
name=libyaml
version=0.2.5
release=1
source="https://github.com/yaml/libyaml/releases/download/$version/yaml-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure \
        --prefix=/usr \
        --disable-static
    make
    make DESTDIR="$PKG" install
}
