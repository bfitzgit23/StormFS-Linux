description="python3-pygdbmi package"
name=python3-pygdbmi
version=0.11.0.0
release=1
source="https://files.pythonhosted.org/packages/source/p/pygdbmi/pygdbmi-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pygdbmi-0.11.0.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
