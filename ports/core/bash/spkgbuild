description="bash package"
name=bash
version=5.3
release=1
#	bashrc
#	profile
build_opt="--prefix=/usr
            --without-bash-malloc
            --with-installed-readline
            --docdir=/usr/share/doc/$name-$version"
source="https://ftp.gnu.org/gnu/bash/bash-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
	mkdir -p $PKG/bin
	mv $PKG/usr/bin/bash $PKG/bin
	
#	install -d $PKG/etc
#	install -m644 $SRC/bashrc $PKG/etc
#	install -m644 $SRC/profile $PKG/etc
}

bootstrap_build() {
	./configure --prefix=$TOOLS --without-bash-malloc bash_cv_strtold_broken=no
	make -j1
	make install
	ln -sv bash $TOOLS/bin/sh
}
