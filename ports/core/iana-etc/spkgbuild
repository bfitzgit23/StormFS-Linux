# description	: Services and protocols files for /etc
# homepage	: https://www.iana.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=iana-etc
version=20260817
release=1
source="https://github.com/Mic92/iana-etc/releases/download/$version/iana-etc-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    install -d -m 0755 "$PKG/etc"
    install -m 0644 services protocols "$PKG/etc/"
}
