# description	: Services and protocols files for /etc
# homepage	: https://www.iana.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Services and protocols files for /etc"
name=iana-etc
version=20260817
release=1
source="https://github.com/Mic92/iana-etc/releases/download/$version/iana-etc-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    install -d -m 0755 "$PKG/etc"
    install -m 0644 services protocols "$PKG/etc/"
}
