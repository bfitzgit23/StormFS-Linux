# description	: libffi package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libffi package"
name=libffi
version=3.8.0
release=1
build_opt="--with-gcc-arch=x86-64"
bootstrap_opt=""
source="https://github.com/libffi/libffi/releases/download/v$version/libffi-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
