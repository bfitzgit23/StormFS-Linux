# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-packaging package"
name=python3-packaging
version=26.3
release=1
source="https://files.pythonhosted.org/packages/source/p/packaging/packaging-${version}.tar.gz"

build() {
	cd "$name-$version" || return 1
    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 wheel \
        -w dist --no-cache-dir --no-build-isolation --no-deps .
    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install \
        --no-index --find-links dist --root="$PKG" --ignore-installed --no-deps packaging
}
