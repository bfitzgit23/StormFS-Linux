# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-requests package"
name=python3-requests
version=2.34.2
release=2
source="https://files.pythonhosted.org/packages/source/r/requests/requests-${version}.tar.gz requests-use_system_certs-2.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "requests-2.34.2" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
python3 -m build --wheel --no-isolation || return 1
python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
