# description	: Tools for managing software RAID arrays
# homepage	: https://www.kernel.org/pub/linux/utils/raid/mdadm/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: mta

description="Tools for managing software RAID arrays"
name=mdadm
version=4.6
release=2
source="https://github.com/md-raid-utilities/mdadm/archive/refs/tags/mdadm-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    make \
        BINDIR=/usr/sbin \
        CWFLAGS="-Wall -Wstrict-prototypes -Wextra -Wno-unused-parameter -Wimplicit-fallthrough=0 -O2"

    make \
        DESTDIR=$PKG \
        BINDIR=/usr/sbin \
        install
}
