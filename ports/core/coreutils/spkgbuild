# description	: coreutils package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="coreutils package"
name=coreutils
version=9.12
release=1
export FORCE_UNSAFE_CONFIGURE=1
build_opt="--enable-no-install-program=kill,uptime"
source="https://ftp.gnu.org/gnu/coreutils/coreutils-$version.tar.xz https://www.linuxfromscratch.org/patches/downloads/coreutils/coreutils-9.11-i18n-1.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	export BFS_SKIP_PATCHES=1
	bfs_autobuild
	mkdir -p $PKG/bin
	for i in cat chgrp chmod chown cp date dd df echo \
		false ln ls mkdir mknod mv pwd rm rmdir stty sync true uname; do
		mv $PKG/usr/bin/$i $PKG/bin
	done
	mkdir -p $PKG/usr/sbin
	mv $PKG/usr/bin/chroot $PKG/usr/sbin
	mkdir -p $PKG/usr/share/man/man8/
	mv -v $PKG/usr/share/man/man1/chroot.1 $PKG/usr/share/man/man8/chroot.8
	sed -i s/\"1\"/\"8\"/1 $PKG/usr/share/man/man8/chroot.8
}

bootstrap_build() {
	FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=$TOOLS --enable-install-program=hostname
	make
	make install
}
