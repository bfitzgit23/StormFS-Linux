# description	: Popt libraries which are used by some programs to parse command-line options
# homepage	: https://github.com/rpm-software-management/popt
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen

description="Popt libraries which are used by some programs to parse command-line options"
name=popt
version=1.19
release=1
source="https://ftp.osuosl.org/pub/rpm/popt/releases/popt-1.x/popt-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	

	./configure --prefix=/usr --disable-static &&
make
#sed -i 's@\./@src/@' Doxyfile &&
#doxygen
        make DESTDIR=$PKG install
install -v -m755 -d $PKG/usr/share/doc/$name-$version
#install -v -m644 doxygen/html/* $PKG/usr/share/doc/$name-$version
}
