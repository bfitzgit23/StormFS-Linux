# description	: man-db package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=man-db
version=2.13.1
release=1
build_opt="--prefix=/usr                         
            --docdir=/usr/share/doc/$name-$version
            --sysconfdir=/etc                     
            --disable-setuid                      
            --enable-cache-owner=bin              
            --with-browser=/usr/bin/lynx          
            --with-vgrind=/usr/bin/vgrind         
            --with-grap=/usr/bin/grap"
source="https://debian.netcologne.de/savannah/man-db/man-db-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
