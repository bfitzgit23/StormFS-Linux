# Description: Package manager utility for the pacman package format
# URL: https://gitlab.archlinux.org/pacman/pacman
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libarchive curl openssl

name=pacman
version=6.0.2
release=1

source=(
    https://sources.archlinux.org/other/$name/$name-$version.tar.xz
)

pkg_build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Ddoc=disabled \
        -Dscriptlet-shell=/bin/bash \
        -Dldconfig=/sbin/ldconfig

    meson compile -C build

    DESTDIR="$PKG" meson install -C build
}
