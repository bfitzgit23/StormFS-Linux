# description	: Modern formatting library for C++
# homepage	: https://fmt.dev/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Modern formatting library for C++"
name=fmt
version=12.2.0
release=3
keep_static=1
source="https://github.com/fmtlib/fmt/releases/download/$version/fmt-$version.zip"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DFMT_DOC=OFF \
        -DFMT_TEST=OFF || return 1

    cmake --build build || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
