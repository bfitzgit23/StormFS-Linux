# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-typogrify package"
name=python3-typogrify
version=2.1.0
release=1
source="https://files.pythonhosted.org/packages/source/t/typogrify/typogrify-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "typogrify-2.1.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
