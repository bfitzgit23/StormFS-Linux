# description	: The userspace-rcu package provides a set of userspace RCU (read-copy-update) libraries. These data synchronization libraries provide read-side access which scales linearly with the number of cores.
# homepage	: https://lttng.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The userspace-rcu package provides a set of userspace RCU (read-copy-update) libraries. These data synchronization libraries provide read-side access which scales linearly with the number of cores."
name=liburcu
version=0.15.6
release=1
source="https://lttng.org/files/urcu/userspace-rcu-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        ./configure \
                --prefix=/usr \
                --disable-static \
                --docdir=/usr/share/doc/$name-$version

        make
        make DESTDIR=$PKG install
}
