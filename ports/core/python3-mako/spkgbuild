description="python3-mako package"
name=python3-mako
version=1.4.1
release=1
source="https://pypi.org/packages/source/m/mako/mako-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "mako-1.4.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
