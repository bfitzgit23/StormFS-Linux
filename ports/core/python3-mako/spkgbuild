description="python3-mako package"
name=python3-mako
version=1.4.1
release=1
source="https://pypi.org/packages/source/m/mako/mako-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
