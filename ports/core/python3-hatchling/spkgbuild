# description	: python3-hatchling package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-hatchling package"
name=python3-hatchling
version=1.32.4
release=1
source="https://github.com/ofek/hatch/archive/hatchling-v$version/hatchling-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "hatchling-1.32.4" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  /usr/bin/python3 -m build backend
  PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install --isolated --root=$PKG \
    --ignore-installed --no-deps backend/dist/*.whl
}
