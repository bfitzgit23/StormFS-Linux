# description	: grub-efi package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="grub-efi package"
name=grub-efi
version=2.14
release=1
renames=(SKIP unifont-17.0.05.pcf.noextract SKIP)
build_opt="--disable-efiemu
        --enable-grub-mount
        --enable-grub-mkfont
        --enable-device-mapper
        --with-platform=efi
        --target=x86_64
        --disable-werror"
source="https://ftp.gnu.org/gnu/grub/grub-$version.tar.xz https://ftp.gnu.org/gnu/unifont/unifont-17.0.05/unifont-17.0.05.pcf.gz extra_deps.lst"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        unset CFLAGS
        unset CXXFLAGS
        cp $SRC/extra_deps.lst grub-core/
        mkdir -pv $PKG/usr/share/fonts/unifont
        gunzip -c ../unifont-17.0.05.pcf.noextract > $PKG/usr/share/fonts/unifont/unifont.pcf
	bfs_autobuild
        rm -rf \
        $PKG/etc \
        $PKG/usr/sbin \
        $PKG/usr/bin \
        $PKG/usr/share/info \
        $PKG/usr/share/locale \
        $PKG/usr/share/grub
}
