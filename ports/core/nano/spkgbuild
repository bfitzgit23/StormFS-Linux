# description	: GNU pico clone (a tiny text editor)
# homepage	: https://www.nano-editor.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GNU pico clone (a tiny text editor)"
name=nano
version=9.2
release=1
source="https://www.nano-editor.org/dist/v${version%%.*}/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --enable-utf8     \
            --docdir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
	install -D -m 644 doc/sample.nanorc $PKG/usr/etc/nanorc
rm -rf $PKG/usr/share/info/dir
mkdir -p $PKG/etc
cat > $PKG/etc/nanorc << "EOF"
set autoindent
set constantshow
set fill 72
set historylog
set multibuffer
set nohelp
set positionlog
set quickblank
set regexp
EOF
}
