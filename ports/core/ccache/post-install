#!/bin/sh
set -eu
cache=/var/cache/ccache
build_user=pkgbuild
if ! getent passwd "$build_user" >/dev/null 2>&1; then
    build_user=pkgmk
fi
getent passwd "$build_user" >/dev/null 2>&1 || {
    echo "ccache: package build account is missing" >&2
    exit 1
}
install -d -m 0775 -o "$build_user" -g "$build_user" "$cache"
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
    size=20G
else
    kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || echo 0)
    gib=$(( (kb + 1048575) / 1048576 ))
    [ "$gib" -gt 0 ] || gib=20
    size="${gib}G"
fi
CCACHE_DIR="$cache" ccache --set-config="max_size=$size"
chown -R "$build_user:$build_user" "$cache"
echo "ccache default maximum size: $size"
