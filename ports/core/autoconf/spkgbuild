# description	: autoconf package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="autoconf package"
name=autoconf
version=2.73
release=1
source="https://ftp.gnu.org/gnu/autoconf/autoconf-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild

	# autoconf is built before the target m4 package is installed, so its
	# configure records the temporary toolchain path. The installed autom4te
	# must use the target m4 instead.
	sed -i 's|/tmp/lfs-tools/bin/m4|/usr/bin/m4|g' "$PKG/usr/bin/autom4te" || return 1
}
