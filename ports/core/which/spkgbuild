# description	: A utility to show the full path of commands
# homepage	: https://savannah.gnu.org/projects/which
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A utility to show the full path of commands"
name=which
version=2.25
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr
        make
        make DESTDIR=$PKG install
mv $PKG/usr/share/info/dir $PKG/usr/share/info/which
}
