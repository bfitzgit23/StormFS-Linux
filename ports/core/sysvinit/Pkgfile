# Description: System V init and shutdown utilities
# URL: https://github.com/slicer69/sysvinit
# Maintainer: BFSOS maintainers
# Depends: filesystem

name=sysvinit
version=3.15
release=2
source=(
    https://github.com/slicer69/sysvinit/archive/refs/tags/$version.tar.gz
    inittab
)

pkg_build() {
    cd "$name-$version" || return 1
    make -C src || return 1
    make -C src DESTDIR="$PKG" install || return 1

    install -d -m 0755 "$PKG/etc/inittab.d" "$PKG/etc/rc.d"
    ln -sfn /usr/lib/sysvinit/init "$PKG/sbin/init"

    # Ship a working default inittab (runlevels, console logins, commented
    # dm line); admins edit it directly as directed by the LFS book.
    install -m 0644 inittab "$PKG/etc/inittab" || return 1
}
