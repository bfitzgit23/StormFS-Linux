# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libcap package"
name=libcap
version=2.78
release=1
source="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	sed -i '/install -m.*STA/d' libcap/Makefile
	make prefix=/usr lib=lib
	make prefix=/usr lib=lib DESTDIR="$PKG" install
}
