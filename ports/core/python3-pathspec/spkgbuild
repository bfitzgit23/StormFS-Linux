description="python3-pathspec package"
name=python3-pathspec
version=1.1.1
release=1
source="https://files.pythonhosted.org/packages/source/p/pathspec/pathspec-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pathspec-1.1.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --skip-dependency-check --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
