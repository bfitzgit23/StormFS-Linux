description="python3-editables package"
name=python3-editables
version=0.6
release=1
source="https://files.pythonhosted.org/packages/source/e/editables/editables-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "editables-0.6" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
