# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-psutil package"
name=python3-psutil
version=7.2.2
release=1
source="https://files.pythonhosted.org/packages/source/p/psutil/psutil-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "psutil-7.2.2" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
