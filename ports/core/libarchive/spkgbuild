# description	: libarchive package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libarchive package"
name=libarchive
version=3.8.9
release=2
keep_static=1
build_opt="--without-xml2 
--disable-debuginfod"
bootstrap_opt=$build_opt
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
