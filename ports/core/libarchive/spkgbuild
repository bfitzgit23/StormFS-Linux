# description	: libarchive package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libarchive
version=3.8.9
release=2
keep_static=1
build_opt="--without-xml2 
--disable-debuginfod"
bootstrap_opt=$build_opt
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
