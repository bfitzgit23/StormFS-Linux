description="python3-ply package"
name=python3-ply
version=3.11
release=1
source="https://files.pythonhosted.org/packages/source/p/ply/ply-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "ply-3.11" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
