# description	: Filesystem utilities for Btrfs
# homepage	: https://btrfs.readthedocs.io/en/latest/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Filesystem utilities for Btrfs"
name=btrfs-progs
version=7.1
release=1
build_opt="--prefix=/usr
           --bindir=/sbin
           --disable-convert
           --disable-zoned
           --disable-documentation"
source="https://www.kernel.org/pub/linux/kernel/people/kdave/$name/$name-v$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    install -d \
        "$PKG/usr/share/man/man5" \
        "$PKG/usr/share/man/man8"

    install -m 644 Documentation/*.5 "$PKG/usr/share/man/man5/"
    install -m 644 Documentation/*.8 "$PKG/usr/share/man/man8/"
}
