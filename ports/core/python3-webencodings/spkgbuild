description="Python 3 Module"
name=python3-webencodings
version=0.6.1
release=2
source="https://files.pythonhosted.org/packages/source/w/webencodings/webencodings-0.6.1.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "webencodings-0.6.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
