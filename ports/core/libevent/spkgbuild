# description	: Asynchronous event notification software library
# homepage	: http://libevent.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Asynchronous event notification software library"
name=libevent
version=2.1.13
release=2
source="https://github.com/libevent/libevent/releases/download/release-$version-stable/libevent-$version-stable.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	sed -i 's/python/&3/' event_rpcgen.py
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
