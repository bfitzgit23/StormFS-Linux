# description	: Package for correctly-rounded arbitrary precision decimal floating point arithmetic.
# homepage	: https://www.bytereef.org/mpdecimal/index.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Package for correctly-rounded arbitrary precision decimal floating point arithmetic."
name=mpdecimal
version=4.0.1
release=1
source="https://www.bytereef.org/software/mpdecimal/releases/mpdecimal-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


	./configure --prefix=/usr \
		--disable-static \
		--docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share/doc
	rmdir $PKG/usr/share
}
