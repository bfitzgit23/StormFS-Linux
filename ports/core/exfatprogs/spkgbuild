# description	: Userspace utilities for the exfat filesystem kernel module
# homepage	: https://github.com/exfatprogs/exfatprogs
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Userspace utilities for the exfat filesystem kernel module"
name=exfatprogs
version=1.4.3
release=1
source="https://github.com/exfatprogs/exfatprogs/releases/download/$version/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr --sbindir=/sbin
	make
	make DESTDIR=$PKG install
}
