# description	: C extensions compiler for Python
# homepage	: https://cython.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C extensions compiler for Python"
name=python3-cython
version=3.3.0
release=1
source="https://files.pythonhosted.org/packages/source/c/cython/cython-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "cython-3.3.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    python3 -m build --wheel --skip-dependency-check --no-isolation
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl
}
