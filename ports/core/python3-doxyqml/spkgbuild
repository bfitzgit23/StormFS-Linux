description="python3-doxyqml package"
name=python3-doxyqml
version=0.5.3
release=1
source="https://files.pythonhosted.org/packages/source/d/doxyqml/doxyqml-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "doxyqml-0.5.3" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
