# description	: A built-package format for Python
# homepage	: https://pypi.python.org/pypi/wheel
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A built-package format for Python"
name=python3-wheel
version=0.48.0
release=1
source="https://files.pythonhosted.org/packages/source/w/wheel/${name#*-}-$version.tar.gz"

build() {
  _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "wheel-$version" -print -quit)
  [ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
  [ -n "$_bfs_src" ] || return 1
  cd "$_bfs_src" || return 1

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}

unpack_source() {
          for file in ${source[@]}; do
                   case ${file##*/} in
                           ${name#*-}-$version.tar.gz)
                                   tar xfvz $(get_filename $file) -C $SRC ;;
                           *)
                                   cp $(get_filename $file) $SRC ;;
                   esac
           done
   }
