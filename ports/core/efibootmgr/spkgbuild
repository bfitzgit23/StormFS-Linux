# description	: efibootmgr package
# homepage	: https://github.com/rhboot/efibootmgr
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
cription: Manipulate EFI boot manager variables

description="efibootmgr package"
name=efibootmgr
version=18
release=2
source="https://github.com/rhboot/efibootmgr/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    #
    # Compatibility fix for newer efivar headers.
    #
    sed -i \
        '/extern int efi_set_verbose/d' \
        src/efibootmgr.c

    #
    # EFIDIR is only the default EFI System Partition path compiled
    # into the utility. It does not mount or modify /boot/efi here.
    #
    make \
        EFIDIR=/boot/efi \
        CFLAGS="$CFLAGS -Wno-error=pointer-sign"

    install -D -m 0755 \
        src/efibootmgr \
        "$PKG/usr/sbin/efibootmgr"

    install -D -m 0644 \
        src/efibootmgr.8 \
        "$PKG/usr/share/man/man8/efibootmgr.8"
}
