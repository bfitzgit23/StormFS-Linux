# description	: libnftnl is a userspace library providing a low-level netlink programming interface (API) to the in-kernel nf_tables subsystem
# homepage	: https://netfilter.org/projects/libnftnl/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libnftnl is a userspace library providing a low-level netlink programming interface (API) to the in-kernel nf_tables subsystem"
name=libnftnl
version=1.3.2
release=1
source="https://www.netfilter.org/pub/libnftnl/libnftnl-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
