# description	: Poetry core utilities for Python packaging
# homepage	: https://github.com/python-poetry/poetry-core
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Poetry core utilities for Python packaging"
name=python3-poetry-core
version=2.5.0
release=2
source="https://files.pythonhosted.org/packages/source/p/poetry-core/poetry_core-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "poetry_core-2.5.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    python3 -m build \
        --wheel \
        --skip-dependency-check \
        --no-isolation || return 1

    python3 -m installer \
        --compile-bytecode 2 \
        --destdir="$PKG" \
        dist/*.whl || return 1
}
