# description	: Builds and maintains the system CA certificate trust store
# homepage	: https://github.com/lfs-book/make-ca
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Builds and maintains the system CA certificate trust store"
name=make-ca
version=1.16.1
release=6
source="https://github.com/lfs-book/make-ca/archive/v$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    # BLFS recommends removing deprecated mktemp -t usage.
    sed '/mktemp/s/-t //' -i make-ca || return 1

    make DESTDIR="$PKG" install || return 1

    # Keep only make-ca's own local trust directory in this package.
    # /etc/ssl/cert.pem and /etc/ssl/certs/ca-certificates.crt are owned
    # by the ca-certificates package and must not be duplicated here.
    install -vdm755 \
        "$PKG/etc/ssl/local" \
        "$PKG/etc/pki/anchors" \
        "$PKG/etc/pki/tls/certs" \
        "$PKG/etc/pki/nssdb" || return 1
}
