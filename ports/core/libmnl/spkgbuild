# description	: A minimalistic user-space library oriented to Netlink developers.
# homepage	: https://netfilter.org/projects/libmnl/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A minimalistic user-space library oriented to Netlink developers."
name=libmnl
version=1.0.5
release=1
source="https://www.netfilter.org/projects/$name/files/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr &&
make
	make DESTDIR=$PKG install
rm -rf $PKG/usr/share/man/man3/
}
