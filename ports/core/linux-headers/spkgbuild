# description	: Linux userspace API headers from the BFSOS default LTS kernel line
# homepage	: https://www.kernel.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Linux userspace API headers from the BFSOS default LTS kernel line"
name=linux-headers
version=6.18.54
release=1
# Keep libc/userspace headers aligned with the BFSOS default kernel line.
# The optional current/mainline kernel remains separately available as `linux`.
source="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	make mrproper
	make headers
	find usr/include -type f ! -name '*.h' -delete
	mkdir -p $PKG/usr/include
	cp -rv usr/include/* $PKG/usr/include
}

bootstrap_build() {
	make mrproper
	make headers
	find usr/include -type f ! -name '*.h' -delete
	mkdir -p $TOOLS/include
	cp -rv usr/include/* $TOOLS/include
}
