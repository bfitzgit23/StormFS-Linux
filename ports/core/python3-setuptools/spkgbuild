# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="python3-setuptools package"
name=python3-setuptools
version=84.0.0
release=1
export SETUPTOOLS_INSTALL_WINDOWS_SPECIFIC_FILES=0
export PYTHONDONTWRITEBYTECODE=1
source="https://pypi.org/packages/source/s/setuptools/setuptools-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "setuptools-84.0.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
