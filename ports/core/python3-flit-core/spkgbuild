# description	: Core build backend for Flit
# homepage	: https://pypi.org/project/flit-core/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Core build backend for Flit"
name=python3-flit-core
version=4.1.0
release=1
source="https://pypi.org/packages/source/f/flit-core/flit_core-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 wheel \
        -w dist \
        --no-cache-dir \
        --no-build-isolation \
        --no-deps \
        .

    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install \
        --no-index \
        --find-links dist \
        --root="$PKG" \
        --ignore-installed \
        --no-deps \
        flit_core
}
