description="python3-doxypypy package"
name=python3-doxypypy
version=0.8.8.7
release=1
source="https://files.pythonhosted.org/packages/source/d/doxypypy/doxypypy-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "doxypypy-0.8.8.7" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
