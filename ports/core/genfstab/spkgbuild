# description	: Generate an fstab from the current system
# homepage	: https://gitlab.archlinux.org/archlinux/arch-install-scripts
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Generate an fstab from the current system"
name=genfstab
version=31
release=2
# Custom build required: BFSOS intentionally packages only genfstab from the
# upstream arch-install-scripts suite; StormFS ships genfstab only, the Arch
# pacstrap/arch-chroot helpers are not provided.
source="https://gitlab.archlinux.org/archlinux/arch-install-scripts/-/archive/v$version/arch-install-scripts-v$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    make genfstab || return 1

    install -d "$PKG/usr/bin" "$PKG/usr/share/licenses/$name" || return 1
    install -m755 genfstab "$PKG/usr/bin/genfstab" || return 1
    install -m644 COPYING "$PKG/usr/share/licenses/$name/COPYING" || return 1
}
