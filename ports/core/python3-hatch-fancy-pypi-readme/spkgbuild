# description	: Fancy PyPI READMEs with Hatch
# homepage	: https://github.com/hynek/hatch-fancy-pypi-readme
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Fancy PyPI READMEs with Hatch"
name=python3-hatch-fancy-pypi-readme
version=25.1.0
release=2
source="https://github.com/hynek/hatch-fancy-pypi-readme/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "hatch-fancy-pypi-readme-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    /usr/bin/python3 -m build --wheel --no-isolation || return 1

    PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install \
        --isolated \
        --root="$PKG" \
        --ignore-installed \
        --no-deps \
        dist/*.whl || return 1

    rm -f "$PKG"/usr/lib/python*/site-packages/hatch_fancy_pypi_readme-*/{licenses/AUTHORS.md,INSTALLER}
}
