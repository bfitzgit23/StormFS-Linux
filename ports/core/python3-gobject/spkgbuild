# description	: Python bindings for GLib/GObject/GIO/GTK+/GStreamer
# homepage	: https://wiki.gnome.org/Projects/PyGObject
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python bindings for GLib/GObject/GIO/GTK+/GStreamer"
name=python3-gobject
version=3.58.0
release=1
source="https://download.gnome.org/sources/pygobject/${version::4}/pygobject-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pygobject-3.58.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D python=/usr/bin/python3

	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install -C build

	/usr/bin/python3 -m compileall -d /usr/lib $PKG/usr/lib
	/usr/bin/python3 -O -m compileall -d /usr/lib $PKG/usr/lib
}
