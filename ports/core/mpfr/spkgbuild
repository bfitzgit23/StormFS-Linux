# description	: mpfr package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="mpfr package"
name=mpfr
version=4.2.2
release=1
build_opt="--enable-thread-safe"
source="https://ftp.gnu.org/gnu/mpfr/mpfr-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
