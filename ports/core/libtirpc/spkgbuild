name=libtirpc
version=1.3.7
release=1
build_opt="--disable-gssapi"
bootstrap_opt="--disable-gssapi"
source="https://downloads.sourceforge.net/$name/$name-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
