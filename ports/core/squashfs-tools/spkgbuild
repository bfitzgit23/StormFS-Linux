# description	: Tools for squashfs, a highly compressed read-only filesystem for Linux
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Tools for squashfs, a highly compressed read-only filesystem for Linux"
name=squashfs-tools
version=4.7.5
release=2
source="https://downloads.sourceforge.net/squashfs/squashfs$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        make -C $name \
                XZ_SUPPORT=1 \
                LZO_SUPPORT=1 \
                LZMA_XZ_SUPPORT=1 \
                LZ4_SUPPORT=1 \
                ZSTD_SUPPORT=0

        make -C $name install \
                XZ_SUPPORT=1 \
                LZO_SUPPORT=1 \
                LZMA_XZ_SUPPORT=1 \
                LZ4_SUPPORT=1 \
                ZSTD_SUPPORT=0 \
                INSTALL_DIR="$PKG/usr/bin"
}
