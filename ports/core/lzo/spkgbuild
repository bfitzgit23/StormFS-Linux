# description	: lzo package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=lzo
version=2.10
release=1
keep_static=0
build_opt="--prefix=/usr
           --enable-shared"
source="https://www.oberhumer.com/opensource/lzo/download/lzo-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
