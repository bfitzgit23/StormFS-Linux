# description	: dash package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="dash package"
name=dash
version=0.5.13.5
release=1
build_opt="--bindir=/bin"
source="https://gondor.apana.org.au/~herbert/$name/files/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
	ln -sv dash $PKG/bin/sh
}
