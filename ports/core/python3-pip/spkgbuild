# description	: A tool for installing and managing Python packages.
# homepage	: https://pypi.python.org/pypi/pip/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A tool for installing and managing Python packages."
name=python3-pip
version=26.2.1
release=1
source="https://files.pythonhosted.org/packages/py3/${name:8:1}/${name#*-}/${name#*-}-$version-py3-none-any.whl"

build() {
    wheel="$SRC/${name#*-}-$version-py3-none-any.whl"

    PYTHONPATH="$wheel" \
        /usr/bin/python3 -m pip install \
        --no-index \
        --no-deps \
        --no-compile \
        --ignore-installed \
        --prefix=/usr \
        --root="$PKG" \
        "$wheel"

    # Keep pip, pip3, and the versioned pip command for compatibility.

    # Byte-compile after installation.
    /usr/bin/python3 -m compileall \
        -q \
        -f \
        -d /usr/lib/python${PYTHON_VERSION:-3.14}/site-packages \
        "$PKG/usr/lib/python3.14/site-packages"

    # Ensure packaged Python files are not group/world writable.
    find "$PKG/usr/lib/python"*"/site-packages" \
        -type f \
        -exec chmod go-w '{}' +
}
