# description	: Utility for incremental file transfers over networks
# homepage	: https://rsync.samba.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Utility for incremental file transfers over networks"
name=rsync
version=3.5.1
release=1
source="https://www.samba.org/ftp/$name/src/$name-$version.tar.gz rsyncd.conf rsync.driver"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


	./configure \
		--prefix=/usr \
		--with-rsh=ssh \
		--with-included-zlib=no \
		--with-included-popt=yes \
		--disable-xxhash \
		--disable-lz4

	make
	make DESTDIR=$PKG install

	install -m 644 $SRC/rsyncd.conf $PKG/etc
	install -m 755 $SRC/rsync.driver $PKG/etc/ports/drivers/rsync
	touch $PKG/var/log/rsyncd.log
}
