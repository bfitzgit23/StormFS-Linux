# description	: Support library with a focus on asynchronous I/O
# homepage	: https://libuv.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Support library with a focus on asynchronous I/O"
name=libuv
version=1.52.1
release=2
source="https://dist.libuv.org/dist/v$version/$name-v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-v$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    sh autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="$PKG" install
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
