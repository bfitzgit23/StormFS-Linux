# description	: World timezone definitions, modern and historical
# homepage	: https://pythonhosted.org/pytz/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="World timezone definitions, modern and historical"
name=python3-pytz
version=2026.3.post1
release=1
source="https://pypi.io/packages/source/p/pytz/pytz-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pytz-2026.3.post1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install --root=$PKG \
    --optimize=1 \
    --skip-build
}
