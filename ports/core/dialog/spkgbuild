# description	: A tool to display dialog boxes from shell scripts
# homepage	: https://invisible-island.net/dialog/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A tool to display dialog boxes from shell scripts"
name=dialog
version=1.3_20260721
srcver=1.3-20260721
release=1
build_opt="
    --prefix=/usr
    --with-ncursesw
"
source="https://invisible-mirror.net/archives/dialog/dialog-$srcver.tgz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$srcver" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
