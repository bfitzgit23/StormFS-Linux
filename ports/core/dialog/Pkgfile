# Description: A tool to display dialog boxes from shell scripts
# URL:         https://invisible-island.net/dialog/
# Maintainer:  Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  ncurses

name=dialog
# pacman keeps the last '-' as the pkgrel separator and rejects a pkgver that
# contains one, so version= must use '_'; srcver keeps the upstream spelling.
version=1.3_20260721
srcver=1.3-20260721
release=1

source=(
    https://invisible-mirror.net/archives/dialog/dialog-$srcver.tgz
)

build_opt="
    --prefix=/usr
    --with-ncursesw
"
