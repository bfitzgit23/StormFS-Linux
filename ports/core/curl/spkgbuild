# description	: URL transfer tool
# homepage	: https://curl.se/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="URL transfer tool"
name=curl
version=8.22.0
release=1
build_opt="
	--with-openssl
	--enable-threaded-resolver
	--with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt
	--without-brotli
	--without-libidn2
	--without-libpsl
	--without-librtmp
	--without-nghttp2"
#bootstrap_opt="
#	--disable-static \
#	--enable-threaded-resolver \
#	--with-openssl \
#	--without-libpsl \
#	--without-brotli \
#	--without-librtmp \
#	--without-nghttp2 \
#	--without-libidn2 \
#	--with-ca-bundle=$TOOLS/etc/ssl/cert.pem"
source="https://$name.se/download/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}

bootstrap_build() {
autoreconf 
./configure --prefix=$TOOLS \
        --disable-static \
        --enable-threaded-resolver \
        --with-openssl \
        --without-libpsl \
        --without-brotli \
        --without-librtmp \
        --without-nghttp2 \
        --without-libidn2 \
        --with-ca-bundle=$TOOLS/etc/ssl/cert.pem
 make
 make install
}
