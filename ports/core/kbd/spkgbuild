# description	: Key-table files, console fonts, and keyboard utilities
# homepage	: http://www.kbd-project.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Key-table files, console fonts, and keyboard utilities"
name=kbd
version=2.10.0
release=1
source="https://www.kernel.org/pub/linux/utils/$name/$name-$version.tar.xz kbd-2.10.0-backspace-1.patch"

build() {
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done


        

        sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
	sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in

	./configure --prefix=/usr --disable-vlock
        make
        make DESTDIR=$PKG install

      	mkdir -pv           $PKG/usr/share/doc/$name-$version
	cp -R -v docs/doc/* $PKG/usr/share/doc/$name-$version
}
