# description	: linux-pam package
# homepage	: https://github.com/linux-pam/linux-pam
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
cription: Pluggable Authentication Modules for Linux

description="linux-pam package"
name=linux-pam
version=1.7.2
release=4
build_opt="
    --prefix=/usr
    --sbindir=/usr/sbin
    --libdir=/usr/lib
    --buildtype=plain
    --wrap-mode=nodownload
    -Ddocdir=/usr/share/doc/Linux-PAM-$version
    -Db_lto=true
    -Db_pie=true
    -Dsecuredir=/usr/lib/security
    -Dpam_userdb=disabled
    -Ddocs=disabled
"
source="https://github.com/linux-pam/linux-pam/releases/download/v$version/Linux-PAM-$version.tar.xz other system-account system-auth system-password system-session"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    #
    # unix_chkpwd must be setuid root so unprivileged PAM clients can
    # validate passwords against the protected shadow database.
    #
    chmod 4755 "$PKG/usr/sbin/unix_chkpwd"

    #
    # Install the base PAM policy files into the package staging tree.
    #
    install -d -m 0755 "$PKG/etc/pam.d"

    for file in \
        other \
        system-account \
        system-auth \
        system-password \
        system-session
    do
        install -m 0644 \
            "$SRC/$file" \
            "$PKG/etc/pam.d/$file"
    done
}
