# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="procps-ng package"
name=procps-ng
version=4.0.7
release=1
source="https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
      

        ./configure --prefix=/usr                           \
            --docdir=/usr/share/doc/$name-$version \
            --disable-static                        \
            --disable-kill                          \
            --enable-watch8bit                      \
            --without-systemd
        make
        make DESTDIR=$PKG install
}
