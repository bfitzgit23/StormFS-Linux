# description	: Programs for compressing and decompressing files
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Programs for compressing and decompressing files"
name=bzip2
version=1.0.8
release=1
keep_static=1
source="https://www.sourceware.org/pub/bzip2/$name-$version.tar.gz bzip2-1.0.8-install_docs-1.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	sed -i 's@\(ln -s -f \)$(PREFIX)/bin/@\1@' Makefile
	sed -i "s@(PREFIX)/man@(PREFIX)/share/man@g" Makefile
	
	[ "${CFLAGS}" ] && sed -i "s|-O2|${CFLAGS}|g" Makefile
	[ "${CFLAGS}" ] && sed -i "s|-O2|${CFLAGS}|g" Makefile-libbz2_so
	
	make -f Makefile-libbz2_so
	mkdir -p $PKG/usr/lib
	install libbz2.so.$version $PKG/usr/lib
	ln -s libbz2.so.$version $PKG/usr/lib/libbz2.so
	ln -s libbz2.so.$version $PKG/usr/lib/libbz2.so.1.0
	
	make clean
	make
	make PREFIX=$PKG/usr install
	
	cp -v bzip2-shared $PKG/usr/bin/bzip2
	ln -sf bzip2 $PKG/usr/bin/bzcat
	ln -sf bzip2 $PKG/usr/bin/bunzip2
	
	install -Dm 0644 bzlib.h $PKG/usr/include/bzlib.h
}

bootstrap_build() {
	make -f Makefile-libbz2_so
	make clean
	make
	make PREFIX=$TOOLS install
	cp -v bzip2-shared $TOOLS/bin/bzip2
	cp -v libbz2.so* $TOOLS/lib
	ln -sv libbz2.so.1.0 $TOOLS/lib/libbz2.so
}
