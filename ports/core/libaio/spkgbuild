description="libaio package"
name=libaio
version=0.3.113
release=2
source="https://archive.ubuntu.com/ubuntu/pool/main/liba/libaio/libaio_${version}.orig.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        sed -i '/install.*libaio.a/s/^/#/' src/Makefile

        make
        make DESTDIR=$PKG install
}
