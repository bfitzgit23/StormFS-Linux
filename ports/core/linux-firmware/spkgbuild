# description	: Firmware files for Linux
# homepage	: https://gitlab.com/kernel-firmware/linux-firmware
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Firmware files for Linux"
name=linux-firmware
version=20260916
release=1
source="https://www.kernel.org/pub/linux/kernel/firmware/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    make -j1 \
        DESTDIR="$PKG" \
        FIRMWAREDIR=/lib/firmware \
        install

    make \
        DESTDIR="$PKG" \
        FIRMWAREDIR=/lib/firmware \
        dedup

    find "$PKG" \
        \( -name ChangeLog -o -name README \) \
        -delete
}
