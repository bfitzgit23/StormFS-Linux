# description	: Compression and decompression routines used by some programs
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Compression and decompression routines used by some programs"
name=zlib
version=1.3.2
release=1
keep_static=1
bootstrap_opt=""
export CPATH="/usr/include"
source="https://zlib.net/fossils/zlib-$version.tar.gz https://github.com/madler/zlib/commit/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
 CFLAGS+=" -ffat-lto-objects"
        ./configure --prefix=/usr --insecure
        make
        make DESTDIR=$PKG install
}
