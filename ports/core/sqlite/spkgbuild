# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="sqlite package"
name=sqlite
version=3.53.4
# pkgbuild sources recipes with /bin/sh, so compute the dotted version
# forms that POSIX shell has no substitution for.
_ver_space=$(printf '%s' "$version" | tr . ' ')
release=1
_version=$(printf "%i%.2i%.2i%.2i" $_ver_space)
source="https://www.sqlite.org/2026/sqlite-autoconf-${_version}.tar.gz"

build() {
	cd "$name-$version" || return 1
    CPPFLAGS="$CPPFLAGS \
        -DSQLITE_SECURE_DELETE=1 \
        -DSQLITE_ENABLE_COLUMN_METADATA=1 \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY=1 \
        -DSQLITE_ENABLE_DBSTAT_VTAB=1" \
    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-fts4 \
        --enable-fts5

    make LDFLAGS.rpath=""
    make DESTDIR="$PKG" install
}
