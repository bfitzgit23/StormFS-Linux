description="bc package"
name=bc
version=7.1.0
release=1
source="https://github.com/gavinhoward/bc/releases/download/$version/bc-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	PREFIX=/usr CC=gcc CFLAGS="-std=c99" ./configure.sh -G -O3
	#./configure --prefix=/usr -r
	make
	make DESTDIR="$PKG" install
}
