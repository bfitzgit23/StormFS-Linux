# description	: Style-preserving TOML library for Python
# homepage	: https://github.com/python-poetry/tomlkit
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Style-preserving TOML library for Python"
name=python3-tomlkit
version=0.15.1
release=1
source="https://files.pythonhosted.org/packages/source/t/tomlkit/tomlkit-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "tomlkit-0.15.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  python3 -m build --wheel --no-isolation

  python3 -m installer \
    --destdir="$PKG" \
    dist/*.whl
}
