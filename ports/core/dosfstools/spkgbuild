# description	: Tools for creating and checking DOS/FAT filesystems
# homepage	: https://github.com/dosfstools/dosfstools
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Tools for creating and checking DOS/FAT filesystems"
name=dosfstools
version=4.2
release=1
build_opt="--prefix=/usr
           --sbindir=/sbin
           --enable-compat-symlinks"
source="https://github.com/dosfstools/dosfstools/releases/download/v$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    rm -rf "$PKG/usr/share/doc"
}
