description="python3-urllib3 package"
name=python3-urllib3
version=2.7.0
release=1
source="https://files.pythonhosted.org/packages/source/u/urllib3/urllib3-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "urllib3-2.7.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
