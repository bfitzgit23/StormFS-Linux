# description	: Package manager for StormFS Linux (Venom Linux scratchpkg)
# homepage	: https://codeberg.org/venomlinux/scratchpkg
# maintainer	: StormFS maintainers
#
# scratchpkg replaces the former the former CRUX packaging stack/pkgutils + scratch stack.  It
# builds ports from spkgbuild recipes, records every installed file in
# /var/lib/scratchpkg/db and resolves dependencies from each port's depends
# file.  StormFS ships its own /etc/scratchpkg.conf and /etc/scratchpkg.repo
# so the port tree under /usr/ports is the release source of truth.

description="Package manager for StormFS Linux (Venom Linux scratchpkg)"
name=scratchpkg
version=fdd643ab
release=1
# Codeberg runs Forgejo, which serves /archive/<ref>.tar.gz and does not
# understand GitHub's /archive/<ref>/<name>.tar.gz, so name the file
# explicitly; the archive unpacks to scratchpkg/, which build() handles.
source="scratchpkg-$version.tar.gz::https://codeberg.org/venomlinux/scratchpkg/archive/$version.tar.gz
        scratchpkg.conf
        scratchpkg.repo"

build() {
	cd "scratchpkg-$version" 2>/dev/null || cd scratchpkg || return 1

	# INSTALL.sh honours DESTDIR and installs pkgbuild, pkgadd, pkgdel,
	# scratch, portsync, pkgbase, pkgrebuild, revdep and the configs.
	DESTDIR="$PKG" ./INSTALL.sh || return 1

	# spkgbuild recipes use bash arrays while pkgbuild ships a /bin/sh shebang.
	# Re-exec under bash so they parse on a dash system; /bin/sh stays the
	# shebang because it is the only interpreter guaranteed this early.
	if ! grep -q 'BFS_PKGBUILD_BASH' "$PKG/usr/bin/pkgbuild"; then
		cat > "$WORK_DIR/bfs-pkgbuild-reexec" <<'BFS_PKGBUILD_REEXEC'
# StormFS: spkgbuild recipes use bash constructs; re-exec under bash when available.
if [ -z "${BFS_PKGBUILD_BASH:-}" ] && [ -z "${BASH:-}" ]; then
    for _bfs_bash in bash /bin/bash /usr/bin/bash /tools/bin/bash; do
        if command -v "$_bfs_bash" >/dev/null 2>&1; then
            BFS_PKGBUILD_BASH=1 exec "$_bfs_bash" "$0" "$@"
        fi
    done
fi
BFS_PKGBUILD_REEXEC
		sed -i "1r $WORK_DIR/bfs-pkgbuild-reexec" "$PKG/usr/bin/pkgbuild"
		rm -f "$WORK_DIR/bfs-pkgbuild-reexec"
	fi

	# The package database must exist before the first pkgadd run.
	install -d -m 0755 "$PKG/var/lib/scratchpkg/db" || return 1

	# StormFS policy: our own build configuration and ports repository.
	install -m 0644 "$SRC/scratchpkg.conf" "$PKG/etc/scratchpkg.conf" || return 1
	install -m 0644 "$SRC/scratchpkg.repo" "$PKG/etc/scratchpkg.repo" || return 1
}
