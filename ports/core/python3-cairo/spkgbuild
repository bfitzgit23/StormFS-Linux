# description	: A set of python bindings for cairo.
# homepage	: https://pypi.org/project/pycairo/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A set of python bindings for cairo."
name=python3-cairo
version=1.29.1
release=2
source="https://github.com/pygobject/pycairo/releases/download/v$version/pycairo-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pycairo-1.29.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  meson setup build . \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D python=/usr/bin/python3

  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
