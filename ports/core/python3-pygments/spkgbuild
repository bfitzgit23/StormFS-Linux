# description	: Python syntax highlighter
# homepage	: https://pygments.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python syntax highlighter"
name=python3-pygments
version=2.21.0
release=1
source="https://files.pythonhosted.org/packages/source/P/Pygments/pygments-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pygments-2.21.0" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  python3 -m build --wheel --no-isolation
python3 -m installer --destdir="$PKG" dist/*.whl
}
