# description	: C++ coroutine library for Qt6
# homepage	: https://github.com/danvratil/qcoro
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ coroutine library for Qt6"
name=qcoro
version=0.13.0
release=3
build_opt="-DUSE_QT_VERSION=6 \
-DBUILD_TESTING=OFF \
-DQCORO_BUILD_EXAMPLES=OFF \
-DBUILD_SHARED_LIBS=ON"
source="https://github.com/danvratil/qcoro/archive/v$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
