# description	: A library that provides a Qt implementation of the DBusMenu spec
# homepage	: https://launchpad.net/libdbusmenu-qt
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libdbusmenu-qt5
version=0.9.3+16.04.20160218
release=2
source="https://launchpad.net/ubuntu/+archive/primary/+files/libdbusmenu-qt_0.9.3+16.04.20160218.orig.tar.gz"

build() {
	cd "$name-$version" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DWITH_DOC=OFF \
        -Wno-dev || return 1
    cmake --build build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
