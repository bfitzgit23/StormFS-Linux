# description	: kimageannotator package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="kimageannotator package"
name=kimageannotator
version=0.7.2
release=1
build_opt="      -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 
                 -DCMAKE_BUILD_TYPE=Release  
                 -DBUILD_SHARED_LIBS=ON      
                 -DBUILD_WITH_QT6=ON"
source="https://github.com/ksnip/kImageAnnotator/archive/v${version}/kImageAnnotator-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
