# description	: A library that allows developers to access PolicyKit API with a Qt-style API
# homepage	: https://www.kde.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A library that allows developers to access PolicyKit API with a Qt-style API"
name=polkit-qt5
version=0.201.1
release=1
source="https://download.kde.org/stable/polkit-qt-1/polkit-qt-1-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_PREFIX_PATH=/opt/qt5 \
        -DQT_MAJOR_VERSION=5 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Wno-dev || return 1
    cmake --build build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
