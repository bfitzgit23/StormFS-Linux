# description	: Image format plugins for Qt6/KF6
# homepage	: https://invent.kde.org/frameworks/kimageformats
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=kimageformats
version=6.30.0
release=1
build_opt="-DQT_MAJOR_VERSION=6 \
-DCMAKE_INSTALL_PREFIX=/opt/kf6 \
-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 \
-DCMAKE_INSTALL_LIBEXECDIR=libexec \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_TESTING=OFF"
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
