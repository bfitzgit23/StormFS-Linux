# description	: pulseaudio-qt package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="pulseaudio-qt package"
name=pulseaudio-qt
version=1.8.1
release=3
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 
      -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6        
      -DCMAKE_SKIP_INSTALL_RPATH=ON      
      -DCMAKE_BUILD_TYPE=Release         
      -DBUILD_TESTING=OFF                
      -DQT_MAJOR_VERSION=6               
      .. &&"
source="https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
