# description	: pulseaudio-qt package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=pulseaudio-qt
version=1.8.1
release=3
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 
      -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6        
      -DCMAKE_SKIP_INSTALL_RPATH=ON      
      -DCMAKE_BUILD_TYPE=Release         
      -DBUILD_TESTING=OFF                
      -DQT_MAJOR_VERSION=6               
      .. &&"
source="https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
