# description	: QML-based display manager
# homepage	: https://github.com/sddm/sddm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="QML-based display manager"
name=sddm
version=0.21.0
release=5
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_WITH_QT6=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_BUILD_TYPE=Release \
        -DNO_SYSTEMD=ON \
        -DRUNTIME_DIR=/run/sddm \
        -DBUILD_MAN_PAGES=ON \
        -DDATA_INSTALL_DIR=/usr/share/sddm \
        -DDBUS_CONFIG_FILENAME=sddm_org.freedesktop.DisplayManager.conf || return 1

    cmake --build build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1

    # BFSOS uses the OpenRC display-manager wrapper and ConsoleKit2.
    rm -rf "$PKG/usr/lib/systemd" "$PKG/lib/systemd" \
        "$PKG/usr/lib/sysusers.d" "$PKG/usr/lib/tmpfiles.d" || return 1
}
