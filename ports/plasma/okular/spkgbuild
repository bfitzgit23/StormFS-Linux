description="okular package"
name=okular
version=26.08.1
release=1
source="https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    mkdir -p build || return 1
    cd build || return 1

    SKIP_OPTIONAL='Discount;DjVuLibre;EPub;LibSpectre;LibZip'

    cmake \
        -DCMAKE_INSTALL_PREFIX=/opt/kf6 \
        -DCMAKE_PREFIX_PATH="/opt/qt6;/opt/kf6" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DFORCE_NOT_REQUIRED_DEPENDENCIES="$SKIP_OPTIONAL" \
        -Wno-author \
        .. || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
