# description	: KDE Plasma 6 desktop meta package
# homepage	: https://kde.org/plasma-desktop/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: plasma-login-manager

description="KDE Plasma 6 desktop meta package"
name=plasma-meta
version=6.7.6
release=4
source=""

build() {
    install -d "$PKG/usr/share/bfsos/meta-packages" || return 1

    printf '%s\n'         'BFSOS Plasma meta-package. Desktop audio activation is owned by the WirePlumber systemd user preset.'         > "$PKG/usr/share/bfsos/meta-packages/plasma-meta" || return 1
}

