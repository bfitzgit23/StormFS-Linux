# description	: KDE API documentation generation tools
# homepage	: https://invent.kde.org/frameworks/kapidox
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="KDE API documentation generation tools"
name=kapidox
version=6.30.0
release=1
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
