# description	: konsole package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=konsole
version=26.08.1
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6
      -DCMAKE_BUILD_TYPE=Release         
      -DBUILD_TESTING=OFF                
      -Wno-author"
source="https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz konsole-adjust_scrollbar-1.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	export BFS_SKIP_PATCHES=1
	bfs_autobuild
}
