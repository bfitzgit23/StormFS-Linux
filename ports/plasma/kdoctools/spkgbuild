# description	: KDE Framework for processing and generating documentation
# homepage	: https://invent.kde.org/frameworks/kdoctools
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="KDE Framework for processing and generating documentation"
name=kdoctools
version=6.30.0
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 \
-DCMAKE_INSTALL_LIBEXECDIR=libexec \
-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_TESTING=OFF"
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
