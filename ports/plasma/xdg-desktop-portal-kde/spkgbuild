# description	: xdg-desktop-portal-kde package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xdg-desktop-portal-kde
version=6.7.5
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 \
            -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 
             -DCMAKE_INSTALL_LIBEXECDIR=libexec 
             -DCMAKE_BUILD_TYPE=Release         
             -DCMAKE_QT6=ON				
             -DBUILD_QT5=OFF                    
             -DBUILD_TESTING=OFF                
             -Wno-author"
source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
