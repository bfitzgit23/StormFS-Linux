# description	: phonon-backend-vlc package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="phonon-backend-vlc package"
name=phonon-backend-vlc
version=0.12.0
release=2
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6
           -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6
           -DCMAKE_BUILD_TYPE=Release
           -DPHONON_BUILD_QT5=OFF"
source="https://download.kde.org/stable/phonon/${name}/${version}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
