# description	: KDAB dock widget framework for Qt6
# homepage	: https://github.com/KDAB/KDDockWidgets
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="KDAB dock widget framework for Qt6"
name=kddockwidgets
version=2.4.1
release=1
source="https://github.com/KDAB/KDDockWidgets/releases/download/v$version/KDDockWidgets-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    mkdir -p build || return 1
    cd build || return 1

    cmake \
        -DCMAKE_INSTALL_PREFIX=/opt/kf6 \
        -DCMAKE_PREFIX_PATH="/opt/qt6;/opt/kf6" \
        -DCMAKE_BUILD_TYPE=Release \
        -DKDAB_INSTALL=OFF \
        -DKDDockWidgets_QT6=ON \
        -Wno-author \
        .. || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
