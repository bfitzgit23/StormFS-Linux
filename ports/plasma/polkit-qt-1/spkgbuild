description="polkit-qt-1 package"
name=polkit-qt-1
version=0.201.1
release=3
build_opt=" -DCMAKE_INSTALL_PREFIX=/usr
      -DCMAKE_BUILD_TYPE=Release  
      -DQT_MAJOR_VERSION=6        
      -DBUILD_TESTING=OFF
      -Wno-dev"
source="https://download.kde.org/stable/${name}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
