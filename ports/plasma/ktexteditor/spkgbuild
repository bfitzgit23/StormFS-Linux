# description	: ktexteditor package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=ktexteditor
version=6.30.0
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6 
            -DCMAKE_INSTALL_LIBEXECDIR=libexec 
            -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6        
            -DCMAKE_BUILD_TYPE=Release         
            -DBUILD_TESTING=OFF                
            -Wno-author"
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
