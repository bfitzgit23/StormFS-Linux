# description	: Minimal NetworkManager daemon plus nmcli/nmtui for BFSOS live media
# homepage	: https://networkmanager.dev/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Minimal NetworkManager daemon plus nmcli/nmtui for BFSOS live media"
name=networkmanager-iso
version=1.58.1
release=2
build_opt="-Dlibaudit=no
-Dwifi=true
-Dnmcli=true
-Dnmtui=true
-Dreadline=libreadline
-Dconfig_dhcp_default=internal
-Dconcheck=false
-Dlibpsl=false
-Dovs=false
-Dppp=false
-Dnbft=false
-Dselinux=false
-Dqt=false
-Dsession_tracking=no
-Dnm_cloud_setup=false
-Dclat=false
-Dmodem_manager=false
-Dintrospection=false
-Dvapi=false
-Ddocs=false
-Dman=false
-Dtests=no
-Dfirewalld_zone=false
-Dmore_logging=false"
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    grep -rl '^#!.*python$' . | xargs -r sed -i '1s/python$/python3/' || return 1
	bfs_autobuild
    install -d "$PKG/etc/NetworkManager/conf.d" || return 1
    cat > "$PKG/etc/NetworkManager/NetworkManager.conf" <<'EOC'
[main]
plugins=keyfile
EOC
}
