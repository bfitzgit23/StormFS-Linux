# description	: DSP library derived from speex
# homepage	: https://www.speex.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="DSP library derived from speex"
name=speexdsp-32
version=1.2.1
release=2
source="https://ftp.osuosl.org/pub/xiph/releases/speex/speexdsp-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	sed -i -e '/^SUBDIRS *=/s|\bdoc\b||' Makefile

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/include
  )
	bfs_compat32_validate || return 1
}
