# description	: xorg lib libxmu
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libxmu-32
version=1.3.1
release=3
source="https://www.x.org/releases/individual/lib/libxmu-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share/doc}
	bfs_compat32_validate || return 1
}
