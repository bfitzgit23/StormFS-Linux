# description	: Library providing APIs to netlink protocol based Linux kernel interfaces
# homepage	: http://www.infradead.org/~tgr/libnl/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Library providing APIs to netlink protocol based Linux kernel interfaces"
name=libnl-32
version=3.12.0
# pkgbuild sources recipes with /bin/sh, so compute the dotted version
# forms that POSIX shell has no substitution for.
_ver_under=$(printf '%s' "$version" | tr . _)
release=2
build_opt="--disable-cli"
source="https://github.com/thom311/libnl/releases/download/libnl$_ver_under/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{share,include}
	rm -r $PKG/etc
	bfs_compat32_validate || return 1
}
