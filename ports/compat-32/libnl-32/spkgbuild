# description	: Library providing APIs to netlink protocol based Linux kernel interfaces
# homepage	: http://www.infradead.org/~tgr/libnl/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libnl-32
version=3.12.0
release=2
build_opt="--disable-cli"
source="https://github.com/thom311/libnl/releases/download/libnl${version//./_}/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{share,include}
	rm -r $PKG/etc
	bfs_compat32_validate || return 1
}
