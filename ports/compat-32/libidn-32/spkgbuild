# description	: Provides support for IETF Internationalized Domain Names (IDN).
# homepage	: http://www.gnu.org/software/libidn/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libidn-32
version=1.44
release=2
build_opt="--disable-nls"
source="https://ftp.gnu.org/gnu/${name%-*}/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r \
		$PKG/usr/{bin,include,share/man} \
		$PKG/usr/share/emacs

	rm -rf $PKG/usr/share/info

	# Remove empty directories
	find $PKG -depth -empty -exec rm -r {} \;
	bfs_compat32_validate || return 1
}
