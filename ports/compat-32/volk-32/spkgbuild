# description	: Meta loader for Vulkan API
# homepage	: https://github.com/zeux/volk
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=volk-32
version=1.4.357.0
_version=vulkan-sdk-$version
release=3
build_opt="-D VOLK_INSTALL=True -Wno-dev"
source="https://github.com/zeux/volk/archive/$_version/volk-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

  rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
