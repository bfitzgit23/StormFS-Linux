# description	: Userspace device management daemon
# homepage	: https://github.com/eudev-project/eudev
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Userspace device management daemon"
name=eudev-32
version=3.2.14
release=2
build_opt="--sbindir=/sbin --bindir=/sbin --with-rootprefix= --with-rootlibdir=/usr/lib32 --disable-introspection --disable-manpages --enable-split-usr"
source="https://github.com/eudev-project/eudev/releases/download/v$version/eudev-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return 0
  sed -i '/^Libs:/s/-ludev/-ludev -lrt/' src/libudev/libudev.pc.in || return 1
  CFLAGS+=" -D_GNU_SOURCE"
	bfs_autobuild
  rm -rf "$PKG/etc" "$PKG/sbin" "$PKG/usr/include" "$PKG/usr/lib32/udev" "$PKG/usr/share"
	bfs_compat32_validate || return 1
}
