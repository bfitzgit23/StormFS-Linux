# description	: Mesa 3D demos
# homepage	: https://www.mesa3d.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Mesa 3D demos"
name=mesa-demos-32
version=9.0.0
release=3
build_opt="-D gles1=disabled -D with-system-data-files=true -D osmesa=disabled"
source="https://archive.mesa3d.org/demos/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	local i
	for i in $PKG/usr/bin/*; do mv "$i" "$i"-32; done

	rm -r $PKG/usr/share/
	bfs_compat32_validate || return 1
}
