# description	: X Video extension client library
# homepage	: http://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Video extension client library"
name=libxv-32
version=1.0.13
release=2
source="https://www.x.org/releases/individual/lib/libxv-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share/man,share}
	bfs_compat32_validate || return 1
}
