# description	: X cursor management library
# homepage	: https://cgit.freedesktop.org/xorg/lib/libxcursor/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X cursor management library"
name=libxcursor-32
version=1.2.3
release=2
source="https://www.x.org/releases/individual/lib/libxcursor-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share/man}
	rmdir $PKG/usr/share
	bfs_compat32_validate || return 1
}
