# description	: Vorbis codec library
# homepage	: https://xiph.org/vorbis/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Vorbis codec library"
name=libvorbis-32
version=1.3.7
release=2
source="https://downloads.xiph.org/releases/vorbis/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
