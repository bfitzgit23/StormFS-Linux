# description	: Provides support for IETF Internationalized Domain Names (IDN).
# homepage	: https://www.gnu.org/software/libidn/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Provides support for IETF Internationalized Domain Names (IDN)."
name=libidn133-32
version=1.33
release=3
source="https://ftp.gnu.org/gnu/libidn/libidn-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-nls \
		--disable-static
	sed -i 's/^SUBDIRS = .*/SUBDIRS = gl lib\/gl lib/' Makefile
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/{bin,include,lib32/{libidn.so,libidn.la,pkgconfig},share}
  )
	bfs_compat32_validate || return 1
}
