# description	: Mesa OpenGL Utility library
# homepage	: https://www.mesa3d.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=glu-32
version=9.0.3
release=3
build_opt="-D default_library=shared"
source="https://mesa.freedesktop.org/archive/glu/glu-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf $PKG/usr/include
	bfs_compat32_validate || return 1
}
