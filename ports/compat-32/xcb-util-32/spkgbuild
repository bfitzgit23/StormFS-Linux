# description	: XCB utilities library
# homepage	: https://xcb.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xcb-util-32
version=0.4.1
release=2
source="https://www.x.org/releases/individual/xcb/xcb-util-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild
	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
