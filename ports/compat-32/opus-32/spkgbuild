# description	: a totally open, royalty-free, highly versatile audio codec
# homepage	: https://www.opus-codec.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=opus-32
version=1.6.1
release=3
build_opt="-D custom-modes=true -D tests=disabled"
source="https://downloads.xiph.org/releases/opus/opus-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
