# description	: A 2D graphics library with support for multiple output devices
# homepage	: https://www.cairographics.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A 2D graphics library with support for multiple output devices"
name=cairo-32
version=1.18.4
release=3
build_opt="-D dwrite=disabled -D spectre=disabled -D symbol-lookup=disabled -D tests=disabled"
source="https://gitlab.freedesktop.org/cairo/cairo/-/archive/$version/cairo-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include}
	bfs_compat32_validate || return 1
}
