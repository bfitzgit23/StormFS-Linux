# description	: A general purpose cryptographic library based on GnuPG
# homepage	: https://www.gnupg.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A general purpose cryptographic library based on GnuPG"
name=libgcrypt-32
version=1.12.4
release=3
build_opt="--disable-padlock-support --enable-static=yes --disable-asm"
source="https://gnupg.org/ftp/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return 0
	autoreconf -fi
	bfs_autobuild

	rm -r $PKG/usr/{share,include,bin}
	bfs_compat32_validate || return 1
}
