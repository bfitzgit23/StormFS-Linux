# description	: Widely used set of C/C++ libraries providing Unicode and Globalization support.
# homepage	: https://icu.unicode.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Widely used set of C/C++ libraries providing Unicode and Globalization support."
name=icu-32
version=78.3
# pkgbuild sources recipes with /bin/sh, so compute the dotted version
# forms that POSIX shell has no substitution for.
_ver_under=$(printf '%s' "$version" | tr . _)
_ver_dash=$(printf '%s' "$version" | tr . -)
release=3
build_opt="--disable-samples --disable-tests"
source="https://github.com/unicode-org/icu/releases/download/release-$_ver_dash/icu4c-$_ver_under-src.tgz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return 0
	cd source || return 1

	touch ../LICENSE

	# icu tries to use clang by default, only do so if installed
	prt-get isinst llvm lld && LDFLAGS+=' -fuse-ld=lld -flto=thin'
	prt-get isinst llvm && export CC=clang CXX=clang++ AR=llvm-ar NM=llvm-nm RANLIB=llvm-ranlib || \
		export CC=gcc CXX=g++
	bfs_autobuild

	rm -r \
		$PKG/usr/bin \
		$PKG/usr/sbin \
		$PKG/usr/share/man \
		$PKG/usr/share/icu \
		$PKG/usr/include/unicode
	bfs_compat32_validate || return 1
}
