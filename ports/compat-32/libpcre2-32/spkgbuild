# description	: Perl Compatible Regular Expressions
# homepage	: https://www.pcre.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Perl Compatible Regular Expressions"
name=libpcre2-32
version=10.48
release=3
build_opt="--enable-jit --enable-pcre2-16 --enable-pcre2-32"
source="https://github.com/PhilipHazel/pcre2/releases/download/pcre2-$version/pcre2-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	install -d $PKG/lib32
	mv $PKG/usr/lib32/libpcre2-8.so.* $PKG/lib32
	ln -sf ../../lib32/$(readlink $PKG/usr/lib32/libpcre2-8.so) $PKG/usr/lib32/libpcre2-8.so

	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
