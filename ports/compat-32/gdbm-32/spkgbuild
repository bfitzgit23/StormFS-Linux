# description	: GNU database library for C
# homepage	: https://www.gnu.org/software/gdbm/gdbm.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GNU database library for C"
name=gdbm-32
version=1.26
release=2
build_opt="--enable-libgdbm-compat"
source="https://ftp.gnu.org/gnu/${name%-*}/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return 0
	export CFLAGS="$CFLAGS -fcommon"
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
