# description	: Utility libraries for Vulkan developers, 32-bit
# homepage	: https://www.khronos.org/vulkan/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Utility libraries for Vulkan developers, 32-bit"
name=vulkan-utility-libraries-32
version=1.4.357.0
_commit=5a88b6042edb8f03eefc8de73bd73a899989373f
release=3
build_opt="-Wno-dev"
source="https://github.com/KhronosGroup/Vulkan-Utility-Libraries/archive/$_commit/vulkan-utility-libraries-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

  rm -r $PKG/usr/include/
	bfs_compat32_validate || return 1
}
