# description	: A small library defining error values for GnuPG components
# homepage	: https://www.gnupg.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libgpg-error-32
version=1.61
release=2
build_opt="--disable-nls --enable-static"
source="https://mirrors.dotsrc.org/gcrypt/${name%-*}/${name%-*}-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{share,bin,include}
	bfs_compat32_validate || return 1
}
