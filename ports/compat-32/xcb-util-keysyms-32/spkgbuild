# description	: XCB utilities library
# homepage	: https://xcb.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="XCB utilities library"
name=xcb-util-keysyms-32
version=0.4.1
release=2
keep_libtool=1
keep_static=1
source="https://xcb.freedesktop.org/dist/xcb-util-keysyms-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
