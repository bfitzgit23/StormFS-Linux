# description	: Video Acceleration API to enable hardware accelerated video decode/encode.
# homepage	: https://github.com/intel/libva
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Video Acceleration API to enable hardware accelerated video decode/encode."
name=libva-32
version=2.24.1
release=3
source="https://github.com/intel/libva/archive/$version/libva-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
