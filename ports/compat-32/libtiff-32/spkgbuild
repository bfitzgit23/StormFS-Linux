# description	: Library for manipulation of TIFF (Tag Image File Format) images
# homepage	: http://www.libtiff.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libtiff-32
version=4.7.2
release=3
source="https://download.osgeo.org/libtiff/tiff-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share/man,share}
	bfs_compat32_validate || return 1
}
