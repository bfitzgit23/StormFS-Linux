# description	: Network configuration tool
# homepage	: https://wiki.gnome.org/Projects/NetworkManager/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Network configuration tool"
name=libnm-32
version=1.58.1
release=7
build_opt="--libexecdir=/usr/lib/networkmanager \
-Dcrypto=nss \
-Ddbus_conf_dir=/usr/share/dbus-1/system.d \
-Dudev_dir=/lib/udev \
-Dintrospection=false \
-Dsession_tracking=no \
-Dlibaudit=no \
-Dbluez5_dun=false \
-Dconcheck=false \
-Dclat=false \
-Dnbft=false \
-Debpf=false \
-Diwd=false \
-Dmodem_manager=false \
-Dnm_cloud_setup=false \
-Dnmcli=false \
-Dnmtui=false \
-Dovs=false \
-Dppp=false \
-Dteamdctl=false \
-Dtests=no \
-Dmore_asserts=no \
-Dmore_logging=false \
-Dqt=false \
-Dsystemdsystemunitdir=no \
-Dsystemd_journal=false \
-Dselinux=false \
-Dsuspend_resume=consolekit \
-Dpolkit=false"
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    rm -rf "$PKG/usr/bin" \
           "$PKG/usr/include" \
           "$PKG/usr/sbin" \
           "$PKG/usr/share" \
           "$PKG/usr/lib" \
           "$PKG/etc" \
           "$PKG/lib" \
           "$PKG/var"
	bfs_compat32_validate || return 1
}
