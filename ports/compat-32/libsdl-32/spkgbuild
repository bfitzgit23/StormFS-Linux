# description	: SDL, Simple DirectMedia Layer
# homepage	: http://www.libsdl.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libsdl-32
version=1.2.15
release=6
build_opt="--mandir=/usr/man --program-suffix=-32 --enable-alsa"
source="http://www.libsdl.org/release/SDL-$version.tar.gz gcc15-xext-prototypes.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
	# Apply patch sources; pkgbuild does this automatically.
	for _p in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_p" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_p" || return 1
	done
        _bfs_require_compat32_extension 2 || return 0
  export PKG_CONFIG_PATH='/usr/lib32/pkgconfig:/usr/share/pkgconfig'
	bfs_autobuild
  rm -r $PKG/usr/{include,man,share}

  # --program-suffix=-32 is being ignored
  mv $PKG/usr/bin/sdl-config $PKG/usr/bin/sdl-config-32
	bfs_compat32_validate || return 1
}
