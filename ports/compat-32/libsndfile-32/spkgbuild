# description	: Library for manipulating sound files.
# homepage	: http://www.mega-nerd.com/libsndfile
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Library for manipulating sound files."
name=libsndfile-32
version=1.2.2
release=4
source="https://github.com/libsndfile/libsndfile/releases/download/$version/libsndfile-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
  (
    set -e
	CFLAGS="$CFLAGS -std=gnu17" \
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	make || return 1
	make DESTDIR=$PKG install || return 1
	rm -r $PKG/usr/{bin,include,share/man,share}
  )
	bfs_compat32_validate || return 1
}
