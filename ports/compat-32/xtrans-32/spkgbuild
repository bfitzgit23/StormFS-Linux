# description	: xorg lib xtrans
# homepage	: http://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xtrans-32
version=1.6.0
release=2
source="https://www.x.org/releases/individual/lib/xtrans-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return 0
	sed -i -e 's,$(datadir)/pkgconfig,$(libdir)/pkgconfig,' Makefile.in
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
