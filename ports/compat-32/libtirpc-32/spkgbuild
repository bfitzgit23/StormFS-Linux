# description	: Transport Independent RPC library
# homepage	: https://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libtirpc-32
version=1.3.7
release=2
build_opt="--disable-gssapi"
source="https://downloads.sourceforge.net/project/${name%-*}/${name%-*}/$version/${name%-*}-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/etc $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
