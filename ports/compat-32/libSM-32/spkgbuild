# description	: X Session Management client library
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Session Management client library"
name=libsm-32
version=1.2.6
release=4
source="https://xorg.freedesktop.org/archive/individual/lib/libSM-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm $PKG/usr/share/doc/libsm/{SMlib,xsmp}.xml
	find $PKG/usr/share -type d -delete
	rm -rf $PKG/usr/include
	bfs_compat32_validate || return 1
}
