# description	: xorg xorgproto
# homepage	: http://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg xorgproto"
name=xorgproto-32
version=2025.1
release=3
build_opt="--datadir=/usr/lib32 -D legacy=false"
source="https://xorg.freedesktop.org/archive/individual/proto/xorgproto-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include $PKG/usr/lib32/doc $PKG/usr/lib32/pkgconfig/applewmproto.pc
	bfs_compat32_validate || return 1
}
