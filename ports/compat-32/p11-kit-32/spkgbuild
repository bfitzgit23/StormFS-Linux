# description	: Provides a way to load and enumerate PKCS#11 modules
# homepage	: https://p11-glue.github.io/p11-glue/p11-kit.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Provides a way to load and enumerate PKCS#11 modules"
name=p11-kit-32
version=0.26.5
release=3
build_opt="-D trust_paths=/etc/pki/anchors -D module_path=/usr/lib/pkcs11 -D nls=false"
source="https://github.com/p11-glue/${name%-*}/releases/download/$version/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf \
		$PKG/etc $PKG/usr/{bin,lib,include,share} \
		$PKG/usr/lib32/p11-kit/{trust-extract-compat,p11-kit-{remote,server}}
	bfs_compat32_validate || return 1
}
