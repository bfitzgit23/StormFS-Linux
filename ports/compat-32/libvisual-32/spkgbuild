# description	: An abstraction library that comes between applications and audio visualisation plugins.
# homepage	: http://libvisual.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="An abstraction library that comes between applications and audio visualisation plugins."
name=libvisual-32
version=0.4.2
release=2
build_opt="--enable-extra-optimization --disable-examples --disable-nls"
source="https://github.com/Libvisual/libvisual/releases/download/libvisual-$version/libvisual-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return 0
	export PKG_CONFIG_PATH='/usr/lib32/pkgconfig'
	sed -i 's/sdl-config/sdl-config-32/g' configure.ac
	autoreconf -vfi
	bfs_autobuild
	rm -r $PKG/usr/share

	rm -rf $PKG/{etc,var} $PKG/usr/{bin,etc,include,man,sbin,share}
	bfs_compat32_validate || return 1
}
