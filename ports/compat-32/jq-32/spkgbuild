# description	: Lightweight and flexible command-line JSON processor
# homepage	: https://stedolan.github.io/jq/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Lightweight and flexible command-line JSON processor"
name=jq-32
version=1.8.2
release=2
build_opt="--disable-maintainer-mode --with-oniguruma=builtin --disable-gtk-doc"
source="https://github.com/stedolan/jq/releases/download/jq-$version/jq-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return 0
	autoreconf -i modules/oniguruma
	bfs_autobuild
	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
