# description	: A free and portable TrueType font rendering engine
# homepage	: https://www.freetype.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A free and portable TrueType font rendering engine"
name=freetype-32
version=2.14.3
release=3
build_opt="-D default_library=shared"
source="https://sourceforge.net/projects/freetype/files/freetype2/$version/freetype-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

        rm -rf "$PKG/usr/include" "$PKG/usr/share/aclocal"
	bfs_compat32_validate || return 1
}
