# description	: ALSA libraries
# homepage	: http://www.alsa-project.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="ALSA libraries"
name=alsa-lib-32
version=1.2.16.1
release=2
build_opt="--disable-python"
source="https://www.alsa-project.org/files/pub/lib/alsa-lib-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

    rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
