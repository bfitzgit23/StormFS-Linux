# description	: Library of JPEG support functions.
# homepage	: https://www.libjpeg-turbo.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Library of JPEG support functions."
name=libjpeg-turbo-32
version=3.2.0
release=3
build_opt="-D WITH_JPEG8=ON"
source="https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/$version/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share/man,share}
	bfs_compat32_validate || return 1
}
