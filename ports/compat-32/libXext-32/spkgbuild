# description	: Common X extensions client library
# homepage	: http://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libxext-32
version=1.3.7
release=2
source="https://www.x.org/releases/individual/lib/libxext-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share/man,share/doc}
	bfs_compat32_validate || return 1
}
