# description	: Userspace interface to kernel DRM services
# homepage	: https://dri.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Userspace interface to kernel DRM services"
name=libdrm-32
version=2.4.134
release=3
build_opt="-D intel=enabled -D man-pages=disabled -D valgrind=disabled -D cairo-tests=disabled"
source="https://dri.freedesktop.org/${name%-*}/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
