# description	: a free alternative to the OpenGL Utility Toolkit (GLUT) library
# homepage	: https://freeglut.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="a free alternative to the OpenGL Utility Toolkit (GLUT) library"
name=freeglut-32
version=3.8.0
release=4
source="https://downloads.sourceforge.net/project/freeglut/freeglut/$version/freeglut-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	ln -s glut.pc $PKG/usr/lib32/pkgconfig/freeglut.pc

	rm -rf "$PKG/usr/include" "$PKG/usr/share"
	bfs_compat32_validate || return 1
}
