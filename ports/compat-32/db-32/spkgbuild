# description	: Berkeley DB
# homepage	: http://www.oracle.com/database/berkeley-db/index.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Berkeley DB"
name=db-32
version=5.3.28
release=4
source="https://download.oracle.com/berkeley-db/db-$version.tar.gz 0001-atomic-Rename-local-__atomic_compare_exchange-to-avo.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	# Apply patch sources; pkgbuild does this automatically.
	for _p in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_p" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_p" || return 1
	done
  (
    set -e
    cd build_unix || return 1

    ../dist/configure --prefix=/usr \
		--libdir=/usr/lib32 \
		--enable-compat185 \
		--enable-shared \
		--enable-static \
		--enable-cxx
    make
    make DESTDIR=$PKG install
    rm -r $PKG/usr/docs
    chmod -R +w $PKG
    rm -rf $PKG/usr/{bin,include}
  )
	bfs_compat32_validate || return 1
}
