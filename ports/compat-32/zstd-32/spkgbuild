# description	: Real-time compression with high compression ratios.
# homepage	: https://facebook.github.io/zstd/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Real-time compression with high compression ratios."
name=zstd-32
version=1.5.7
release=2
source="https://github.com/facebook/zstd/archive/v$version/zstd-v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
	make HAVE_THREAD=1
	PREFIX=/usr LIBDIR=/usr/lib32 PKGCONFIGDIR=/usr/lib32/pkgconfig make DESTDIR=$PKG install

	rm -r $PKG/usr/{share,include,bin}
  )
	bfs_compat32_validate || return 1
}
