# description	: Generic PCI access library
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: hwdata

description="Generic PCI access library"
name=libpciaccess-32
version=0.19
release=3
source="https://www.x.org/releases/individual/lib/libpciaccess-$version.tar.xz cross-file.txt"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
	prt-get isinst hwdata && SPKG_LIBPCIA+=' -D pci-ids=hwdata'

	meson setup build . $SPKG_LIBPCIA --cross-file ../cross-file.txt  \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=false \
		-D b_pie=true \
		-D zlib=enabled
	meson compile -C build
	DESTDIR=$PKG meson install -C build

	rm -rf $PKG/usr/include
  )
	bfs_compat32_validate || return 1
}
