# description	: X Video Motion Compensation extension client library
# homepage	: http://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Video Motion Compensation extension client library"
name=libxvmc-32
version=1.0.15
release=2
source="https://www.x.org/releases/individual/lib/libxvmc-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return 0
	# prevent linking against libxv
	export XVMC_LIBS="-lX11 -lXext"
	bfs_autobuild

	rm -r $PKG/usr/{include,share/doc}
	bfs_compat32_validate || return 1
}
