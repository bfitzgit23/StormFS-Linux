# description	: Wrapper library for evdev devices
# homepage	: https://xorg.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Wrapper library for evdev devices"
name=libevdev-32
version=1.13.7
release=3
build_opt="-D tests=disabled -D documentation=disabled"
source="https://www.freedesktop.org/software/libevdev/libevdev-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
