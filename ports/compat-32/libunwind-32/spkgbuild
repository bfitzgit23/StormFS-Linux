# description	: Portable and efficient API to determine the call-chain of a program
# homepage	: https://github.com/libunwind/libunwind
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Portable and efficient API to determine the call-chain of a program"
name=libunwind-32
version=1.8.3
release=3
source="https://github.com/libunwind/libunwind/releases/download/v$version/libunwind-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
  autoreconf -fvi || return 1

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib32 \
    --host=i686-pc-linux-gnu \
    --disable-documentation \
    --disable-tests \
    --disable-static || return 1

  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

  make || return 1
  make DESTDIR="$PKG" install || return 1

  if [ -d "$PKG/usr/include" ]; then
    find "$PKG/usr/include" -type f ! -name libunwind-x86.h -delete
  fi

  rm -rf "$PKG/usr/libexec"
  )
	bfs_compat32_validate || return 1
}
