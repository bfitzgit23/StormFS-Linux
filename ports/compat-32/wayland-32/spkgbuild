# description	: Wayland is intended as a simpler replacement for X
# homepage	: https://wayland.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Wayland is intended as a simpler replacement for X"
name=wayland-32
version=1.26.0
release=4
build_opt="-D documentation=false
-Dbuild.pkg_config_path=/usr/lib/pkgconfig:/usr/share/pkgconfig"
source="https://gitlab.freedesktop.org/wayland/wayland/-/releases/$version/downloads/wayland-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild
	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
