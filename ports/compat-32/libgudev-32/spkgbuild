# description	: GObject bindings for libudev
# homepage	: https://wiki.gnome.org/Projects/libgudev
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GObject bindings for libudev"
name=libgudev-32
version=238
release=3
build_opt="-D introspection=disabled -D vapi=disabled"
source="https://download.gnome.org/sources/${name%-*}/$version/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
