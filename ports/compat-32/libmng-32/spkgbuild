# description	: libmng - Mutliple Image Network Graphics
# homepage	: http://www.libmng.com
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libmng-32
version=2.0.3
release=3
build_opt="--mandir=/usr/man"
source="https://downloads.sourceforge.net/project/libmng//libmng-devel/$version/libmng-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,man}
	bfs_compat32_validate || return 1
}
