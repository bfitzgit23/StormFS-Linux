# description	: xorg lib libice
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg lib libice"
name=libice-32
version=1.1.2
release=3
build_opt="--disable-docs"
source="https://www.x.org/releases/individual/lib/libice-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
