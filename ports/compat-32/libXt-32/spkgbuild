# description	: X11 toolkit intrinsics library
# homepage	: https://xorg.freedesktop.org/wiki/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libxt-32
version=1.3.1
release=3
source="https://www.x.org/releases/individual/lib/libxt-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
