# description	: Portable Foreign Function Interface Library
# homepage	: https://sourceware.org/libffi/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Portable Foreign Function Interface Library"
name=libffi-32
version=3.8.0
release=3
build_opt="--includedir=/usr/lib32/libffi/include"
source="https://github.com/libffi/libffi/releases/download/v$version/libffi-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf $PKG/usr/{lib,share/man,share}
	bfs_compat32_validate || return 1
}
