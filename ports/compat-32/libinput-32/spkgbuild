# description	: A library that handles input devices for display servers
# homepage	: https://wayland.freedesktop.org/libinput/doc/latest/index.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A library that handles input devices for display servers"
name=libinput-32
version=1.31.3
release=3
build_opt="-D debug-gui=false -D documentation=false -D tests=false -D libwacom=false -D udev-dir=/lib/udev -D zshcompletiondir=no"
source="https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/etc $PKG/lib $PKG/usr/{bin,include,lib32/libinput,share}
	bfs_compat32_validate || return 1
}
