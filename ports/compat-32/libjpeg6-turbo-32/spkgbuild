# description	: libjpeg derivative with accelerated baseline JPEG compression and decompression
# homepage	: https://libjpeg-turbo.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libjpeg derivative with accelerated baseline JPEG compression and decompression"
name=libjpeg6-turbo-32
version=1.5.3
release=3
build_opt="--without-simd"
source="https://downloads.sourceforge.net/project/libjpeg-turbo/$version/libjpeg-turbo-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf $PKG/usr/{bin,include,lib32/pkgconfig,share}
	rm $PKG/usr/lib32/lib{jpeg.{a,so},turbojpeg.{a,so*}}
	bfs_compat32_validate || return 1
}
