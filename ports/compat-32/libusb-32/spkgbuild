# description	: Library giving userland programs access to USB devices
# homepage	: https://libusb.info/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libusb-32
version=1.0.30
release=2
source="https://github.com/libusb/libusb/releases/download/v$version/${name%-*}-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
