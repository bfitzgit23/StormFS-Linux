# description	: Unicode Bidirectional (BiDi) Algorithm.
# homepage	: https://github.com/fribidi/fribidi/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=fribidi-32
version=1.0.16
release=3
build_opt="-D docs=false"
source="https://github.com/${name%-*}/${name%-*}/releases/download/v$version/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include}
	bfs_compat32_validate || return 1
}
