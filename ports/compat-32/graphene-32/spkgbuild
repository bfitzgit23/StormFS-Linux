# description	: A thin layer of graphic data types - 32-bit
# homepage	: https://ebassi.github.io/graphene/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A thin layer of graphic data types - 32-bit"
name=graphene-32
version=1.10.8
release=4
build_opt="-Dgobject_types=true -Dintrospection=disabled -Dtests=false -Dinstalled_tests=false"
source="https://github.com/ebassi/graphene/archive/$version/graphene-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild
    rm -rf "$PKG/usr/include"
	bfs_compat32_validate || return 1
}
