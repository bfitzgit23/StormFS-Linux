# description	: Library for manipulation of TIFF (Tag Image File Format) images
# homepage	: http://www.simplesystems.org/libtiff/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Library for manipulation of TIFF (Tag Image File Format) images"
name=libtiff4-32
version=3.9.7
release=3
build_opt="--prefix=/usr --libdir=/usr/lib32"
source="http://download.osgeo.org/libtiff/tiff-$version.tar.gz libtiff4-soname.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
	# Apply patch sources; pkgbuild does this automatically.
	for _p in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_p" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_p" || return 1
	done
  (
    set -e
	./autogen.sh
	./configure $build_opt
	make
	make DESTDIR=$PKG -C libtiff install
	rm -rf $PKG/usr/{bin,include,lib32/libtiff{,xx}.{la,a,so},share}
  )
	bfs_compat32_validate || return 1
}
