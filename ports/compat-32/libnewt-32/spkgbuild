# description	: a programming library for color text mode
# homepage	: https://pagure.io/newt
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: tcl-32

description="a programming library for color text mode"
name=libnewt-32
version=0.52.25
release=3
build_opt="--without-python --disable-nls"
# Pagure's release endpoint currently returns 404; BLFS mirrors the
# byte-identical upstream archive (MD5 cca66ed1d8774fb9e3f6a33525de416d).
source="https://anduin.linuxfromscratch.org/BLFS/newt/newt-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return 0
	if prt-get isinst tcl-32; then
		sed -i "s:tcl8.4:tcl8.6:" Makefile.in
		echo '#define USE_INTERP_RESULT 1' >> config.h
	fi

	NOCONFIGURE=1 ./autogen.sh || return 1
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
