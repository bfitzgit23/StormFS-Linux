# description	: Fast & memory efficient hashtable based on robin hood hashing for C++11/14/17/20
# homepage	: https://github.com/martinus/robin-hood-hashing
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Fast & memory efficient hashtable based on robin hood hashing for C++11/14/17/20"
name=robin-hood-hashing-32
version=3.11.5
release=3
build_opt="-D RH_STANDALONE_PROJECT=OFF"
source="https://github.com/martinus/robin-hood-hashing/archive/$version/robin-hood-hashing-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
