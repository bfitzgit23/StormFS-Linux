# description	: X shared memory fences
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X shared memory fences"
name=libxshmfence-32
version=1.3.3
release=2
source="https://xorg.freedesktop.org/archive/individual/lib/libxshmfence-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
