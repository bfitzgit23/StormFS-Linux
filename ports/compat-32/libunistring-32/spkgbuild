# description	: Functions for manipulating Unicode strings and C strings.
# homepage	: https://www.gnu.org/software/libunistring/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libunistring-32
version=1.4.2
release=2
source="https://ftp.gnu.org/gnu/libunistring/libunistring-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	bfs_compat32_validate || return 1
}
