# description	: Little CMS intends to be an small-footprint color management engine
# homepage	: https://www.littlecms.com/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Little CMS intends to be an small-footprint color management engine"
name=lcms2-32
version=2.19.1
release=3
source="https://downloads.sourceforge.net/project/lcms/lcms/$version/lcms2-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf $PKG/usr/{bin,include,share/man}
	bfs_compat32_validate || return 1
}
