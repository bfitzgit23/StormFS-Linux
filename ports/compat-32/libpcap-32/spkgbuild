# description	: Packet capture library
# homepage	: https://www.tcpdump.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libpcap-32
version=1.10.7
release=2
build_opt="--disable-dbus --without-libnl"
source="https://www.tcpdump.org/release/${name%-*}-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share/man,share}
	bfs_compat32_validate || return 1
}
