# description	: An image loading library for GTK+
# homepage	: https://www.gtk.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=gdk-pixbuf-32
version=2.44.8
release=4
build_opt="-D installed_tests=false -D introspection=disabled -D man=false"
source="https://download.gnome.org/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return 0
	# Run-time dependency shared-mime-info found
	export PKG_CONFIG_PATH='/usr/lib32/pkgconfig:/usr/share/pkgconfig'
	bfs_autobuild

	rm -r $PKG/usr/{include,share}
	find $PKG/usr/bin -type f -not -name gdk-pixbuf-query-loaders -printf 'Removing %P\n' -delete
	mv $PKG/usr/bin/gdk-pixbuf-query-loaders{,-32}
	bfs_compat32_validate || return 1
}
