# description	: A collection of utilities to handle ELF objects.
# homepage	: https://sourceware.org/elfutils/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A collection of utilities to handle ELF objects."
name=elfutils-32
version=0.196
release=3
build_opt="--program-prefix=eu- --disable-debuginfod --disable-libdebuginfod --disable-nls"
source="https://sourceware.org/${name%-*}/ftp/$version/${name%-*}-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/{bin,include,share/man}
	bfs_compat32_validate || return 1
}
