# description	: A compression/decompression Library
# homepage	: https://www.zlib.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A compression/decompression Library"
name=zlib-32
version=1.3.2
release=2
keep_static=1
build_opt="--prefix=/usr --libdir=/usr/lib32"
source="https://www.zlib.net/zlib-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
  (
    set -e
	./configure $build_opt

	make
	make DESTDIR=$PKG install

	ln -sf ../../lib32/libz.so.$version $PKG/usr/lib32/libz.so
	rm -rf $PKG/lib32/libz.so

	rm -r $PKG/usr/{include,share/man,share}
  )
	bfs_compat32_validate || return 1
}
