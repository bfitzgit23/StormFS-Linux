# description	: XAudio2 reimplementation
# homepage	: https://github.com/FNA-XNA/FAudio/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=faudio-32
version=26.09
release=3
source="https://github.com/FNA-XNA/FAudio/archive/$version/faudio-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -r $PKG/usr/include
	bfs_compat32_validate || return 1
}
