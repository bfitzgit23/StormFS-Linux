# description	: Brotli compression library
# homepage	: https://github.com/google/brotli
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Brotli compression library"
name=brotli-32
version=1.2.0
release=4
source="https://github.com/google/${name%-*}/archive/v$version/${name%-*}-v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

	rm -rf $PKG/usr/{bin,include,share}
	bfs_compat32_validate || return 1
}
