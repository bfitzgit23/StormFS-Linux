# description	: X11 client-side library
# homepage	: https://xcb.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X11 client-side library"
name=libxcb-32
version=1.17.0
release=2
source="https://www.x.org/releases/individual/lib/libxcb-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  (
    set -e
	export PKG_CONFIG_LIBDIR='/usr/lib32/pkgconfig:/usr/share/pkgconfig'
	PYTHON=/usr/bin/python3 \
	./configure \
		--host=i686-pc-linux-gnu \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,share}
  )
	bfs_compat32_validate || return 1
}
