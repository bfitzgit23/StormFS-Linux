# description	: Lightweight Directory Access Protocol (LDAP) Toolkit
# homepage	: https://www.openldap.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=openldap-32
version=2.7.1
release=2
source="https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-$version.tgz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
  (
    set -e
	export CC="${CC:-gcc}"
	export CXX="${CXX:-g++}"

	./configure --prefix=/usr \
		--libdir=/usr/lib32 \
		--sysconfdir=/etc \
		--libexecdir=/usr/sbin \
		--localstatedir=/var/lib/openldap \
		--with-threads \
		--without-cyrus-sasl \
		--enable-dynamic \
		--enable-ipv6 \
		--enable-shared \
		--enable-crypt \
		--disable-static \
		--disable-wrappers \
		--disable-spasswd \
		--disable-bdb \
		--disable-hdb

	# This is need to not get  fatal error: ldap_config.h: No such file or directory
	cd include
	make
	make DESTDIR=$PKG install

	cd ../libraries
	make depend
	make
	make DESTDIR=$PKG install

	rm -r $PKG/etc $PKG/usr/include $PKG/usr/lib32/*.la
  )
	bfs_compat32_validate || return 1
}
