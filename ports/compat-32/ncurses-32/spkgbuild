# description	: A System V Release 4.0 curses emulation library
# homepage	: https://invisible-island.net/ncurses/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=ncurses-32
version=6.6
release=4
build_opt="--with-normal --with-shared --without-debug --without-ada --without-tests --enable-pc-files --with-pkg-config-libdir=/usr/lib32/pkgconfig --without-gpm --enable-widec"
source="https://invisible-mirror.net/archives/ncurses/ncurses-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	bfs_compat32
	cd "$name-$version" || return 1
        _bfs_require_compat32_extension 2 || return $?
	bfs_autobuild

    #
    # We only want the 32-bit libraries and pkg-config metadata.
    #
    rm -rf \
        "$PKG/usr/bin" \
        "$PKG/usr/include" \
        "$PKG/usr/share" \
        "$PKG/usr/lib/terminfo"

    #
    # Wide-character compatibility names.
    #
    for lib in ncurses form panel menu; do
        rm -f "$PKG/usr/lib32/lib${lib}.so"

        printf 'INPUT(-l%sw)\n' "$lib" \
            > "$PKG/usr/lib32/lib${lib}.so"

        if [ -f "$PKG/usr/lib32/pkgconfig/${lib}w.pc" ]; then
            ln -sfn "${lib}w.pc" \
                "$PKG/usr/lib32/pkgconfig/${lib}.pc"
        fi
    done

    #
    # curses compatibility names.
    #
    printf 'INPUT(-lncursesw)\n' \
        > "$PKG/usr/lib32/libcursesw.so"

    ln -sfn libncurses.so \
        "$PKG/usr/lib32/libcurses.so"

    #
    # tinfo compatibility.  BFSOS links tinfo compatibility to
    # the wide ncurses implementation.
    #
    rm -f "$PKG/usr/lib32/libtinfo.so"

    printf 'INPUT(-lncursesw)\n' \
        > "$PKG/usr/lib32/libtinfo.so"

    if [ -f "$PKG/usr/lib32/pkgconfig/ncursesw.pc" ]; then
        ln -sfn ncursesw.pc \
            "$PKG/usr/lib32/pkgconfig/tinfo.pc"
    fi
	bfs_compat32_validate || return 1
}
