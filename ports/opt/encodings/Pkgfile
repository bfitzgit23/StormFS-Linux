# Description: X.org font encoding files
# URL: https://gitlab.freedesktop.org/xorg/font/encodings
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: util-macros mkfontscale

name=encodings
version=1.1.0
release=2
source=(https://xorg.freedesktop.org//releases/individual/font/$name-$version.tar.xz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -rf $PKG/usr/share/fonts/encodings/encodings.dir
}