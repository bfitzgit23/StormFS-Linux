# description	: SassC is a wrapper around libsass, a CSS pre-processor language.
# homepage	: https://github.com/sass/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="SassC is a wrapper around libsass, a CSS pre-processor language."
name=libsass
version=3.6.6
release=1
source="https://github.com/sass/$name/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	autoreconf -fi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
