# Description: C-style arbitrary precision calculator
# URL: http://www.isthe.com/chongo/tech/comp/calc/index.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: readline

name=calc
version=2.17.0.0
release=1
source=($name-$version.tar.gz::https://github.com/lcn2/calc/archive/refs/tags/v${version}.tar.gz)

build() {
	cd $name-$version
	make clobber calc-dynamic-only BLD_TYPE=calc-dynamic-only PREFIX=$PKG
	make install T=$PKG

}