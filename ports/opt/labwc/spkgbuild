# description	: Lightweight Wayland stacking compositor inspired by Openbox
# homepage	: https://labwc.github.io/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Lightweight Wayland stacking compositor inspired by Openbox"
name=labwc
version=0.20.2
release=1
source="https://github.com/labwc/labwc/archive/refs/tags/${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dicon=disabled \
        -Dtest=disabled || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
