# description	: The libaom package contains a reference version of the Alliance for Open Media video codec. This codec is a patent free alternative to H.265, and is starting to be used throughout the internet.
# homepage	: https://aomedia.googlesource.com/aom/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen

description="The libaom package contains a reference version of the Alliance for Open Media video codec. This codec is a patent free alternative to H.265, and is starting to be used throughout the internet."
name=libaom
version=3.15.0
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
      -DCMAKE_BUILD_TYPE=Release
      -DBUILD_SHARED_LIBS=1
      -DENABLE_DOCS=no
      -G Ninja .."
source="https://storage.googleapis.com/aom-releases/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
