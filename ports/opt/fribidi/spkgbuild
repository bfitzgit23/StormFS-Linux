# description	: Unicode Bidirectional (BiDi) Algorithm
# homepage	: https://github.com/fribidi/fribidi/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Unicode Bidirectional (BiDi) Algorithm"
name=fribidi
version=1.0.16
release=2
source="https://github.com/fribidi/fribidi/releases/download/v$version/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  meson setup build . \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true &&

  meson compile -C build -j ${JOBS:-1} &&

  DESTDIR="$PKG" meson install -C build
}
