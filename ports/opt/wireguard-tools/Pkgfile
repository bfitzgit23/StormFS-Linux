# Description: Tools for configuring WireGuard
# URL: https://www.wireguard.com/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: openresolv

name=wireguard-tools
version=1.0.20260223
release=1
source=(https://git.zx2c4.com/wireguard-tools/snapshot/$name-$version.tar.xz)

build() {
	cd $name-$version
	cd src

	make
	make install \
		 DESTDIR=$PKG \
		 PREFIX=/usr \
		 RUNSTATEDIR=/run \
		 WITH_BASHCOMPLETION=$(prt-get isinst bash-completion && echo yes || echo no) \
		 WITH_SYSTEMDUNITS=no \
		 WITH_WGQUICK=yes
}