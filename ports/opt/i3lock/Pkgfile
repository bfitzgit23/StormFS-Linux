# Description: Improved screenlocker based upon XCB and PAM
# URL: https://i3wm.org/i3lock
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: xcb-util-image xcb-util-xrm libxkbcommon cairo linux-pam libev meson

name=i3lock
version=2.16
release=1
source=(https://i3wm.org/i3lock/$name-$version.tar.xz)

build() {
	cd $name-$version

	# Fix ticket FS#31544, sed line taken from gentoo
	sed -i -e 's:login:system-auth:' pam/i3lock

	venom-meson build
        meson compile -C build
        DESTDIR=$PKG meson install --no-rebuild -C build
}