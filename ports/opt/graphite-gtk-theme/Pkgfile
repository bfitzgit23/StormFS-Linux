# Description: Graphite gtk theme
# URL: https://github.com/vinceliuice/Graphite-gtk-theme
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gnome-themes-extra gtk-engine-murrine sassc

name=graphite-gtk-theme
version=2025.07.06
release=1
source=($name-$version.tar.gz::https://github.com/vinceliuice/Graphite-gtk-theme/archive/refs/tags/$vrsn.tar.gz Graphite-backgrounds.xml)

build() {
	cd Graphite-gtk-theme-${vrsn}

	    # wallpapers
	wdir="$PKG/usr/share/backgrounds/Graphite"
	wpdir="$PKG/usr/share/gnome-background-properties/"
	mkdir -p $wdir $wpdir
	cp $SRC/Graphite-backgrounds.xml $wpdir
	cp wallpaper/wallpapers*/* $wdir
	
	install -dm 755 $PKG/usr/share/icons
	./install.sh -t all -s compact -d $PKG/usr/share/icons  --tweaks nord
	./install.sh -t all -s compact -d $PKG/usr/share/icons  --tweaks normal
}