# Description: Password generator for creating easily memorable passwords
# URL: https://sourceforge.net/projects/pwgen/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=pwgen
version=2.08
release=1
source=(http://download.sourceforge.net/$name/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}