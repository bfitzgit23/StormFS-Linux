# Description: Graphical Soulseek client
# URL: https://github.com/Nicotine-Plus/nicotine-plus
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-gobject gtk3 python3-build python3-wheel

name=nicotine-plus
version=3.3.10
release=1
source=(https://github.com/Nicotine-Plus/$name/archive/$version.tar.gz)

build() {
    cd $name-$version

	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir=$PKG dist/*.whl

}