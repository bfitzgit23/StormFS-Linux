# description	: The Jansson package contains a library used to encode, decode, and manipulate JSON data.
# homepage	: https://github.com/akheron/jansson/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The Jansson package contains a library used to encode, decode, and manipulate JSON data."
name=jansson
version=2.15.1
release=2
source="https://github.com/akheron/$name/releases/download/v$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	sed -e "/DT/s;| sort;| sed 's/@@libjansson.*//' &;" \
    -i test/suites/api/check-exports
	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
