# description	: Netscape Portable Runtime library
# homepage	: https://developer.mozilla.org/en-US/docs/Mozilla/Projects/NSPR
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Netscape Portable Runtime library"
name=nspr
version=4.40
release=3
source="https://archive.mozilla.org/pub/$name/releases/v$version/src/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cd nspr || return 1

    sed -ri '/^RELEASE/s/^/#/' pr/src/misc/Makefile.in || return 1
    sed -i 's#$(LIBRARY) ##' config/rules.mk || return 1

    ./configure         --prefix=/usr         --with-mozilla         --with-pthreads         $([ "$(uname -m)" = x86_64 ] && echo --enable-64bit) || return 1

    make || return 1
    make DESTDIR="$PKG" install || return 1
}
