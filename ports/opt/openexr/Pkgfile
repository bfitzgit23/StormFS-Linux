# Description: A high dynamic-range image file format library
# URL: https://www.openexr.com/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: imath libdeflate

name=openexr
version=3.4.13
release=1
source=(https://github.com/AcademySoftwareFoundation/$name/archive/v$version/$name-$version.tar.gz)

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}