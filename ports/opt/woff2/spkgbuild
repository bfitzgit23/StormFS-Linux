description="woff2 package"
name=woff2
version=1.0.2
release=2
source="https://github.com/google/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
    sed -i '/output.h/i #include <cstdint>' src/woff2_out.cc
	bfs_autobuild
}
