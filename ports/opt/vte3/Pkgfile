# Description: Termcap file implementation for terminal emulators
# URL: https://gitlab.gnome.org/GNOME/vte
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: fmt gobject-introspection vala pango fribidi gnutls pcre2 zlib gtk3 at-spi2-core cairo gdk-pixbuf fast_float simdutf

name=vte3
version=0.84.0
release=1
source=(https://gitlab.gnome.org/GNOME/vte/-/archive/$version/vte-$version.tar.gz)

build() {

       meson setup $name-$version build \
	      -Db_lto=false \
	      -Db_pie=false \
	      -D_systemd=false \
	      -Dgtk3=true \
	      -Dgtk4=$(prt-get isinst gtk4 && printf "true" || printf "false") 
        meson compile -C build
        DESTDIR=$PKG meson install --no-rebuild -C build

}