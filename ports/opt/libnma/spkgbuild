# description	: Networkmanager GUI client library
# homepage	: https://gitlab.gnome.org/GNOME/libnma
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gtk4 mobile-broadband-provider-info vala

description="Networkmanager GUI client library"
name=libnma
version=1.10.6
release=3
source="https://gitlab.gnome.org/GNOME/libnma/-/archive/$version/libnma-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1
  scratch isinstalled gtk4 && BFS_LIBNMA+=' -D libnma_gtk4=true'
  scratch isinstalled mobile-broadband-provider-info || BFS_LIBNMA+=' -D mobile_broadband_provider_info=false'
  #scratch isinstalled vala || BFS_LIBNMA+=' -D vapi=false'
  BFS_LIBNMA+=' -D vapi=false'

  meson setup build . $BFS_LIBNMA \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D gtk_doc=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -r $PKG/usr/share/locale
}
