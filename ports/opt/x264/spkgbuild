# description	: Library for encoding H264/AVC video streams (snapshot).
# homepage	: https://www.videolan.org/developers/x264.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: ffms2 gpac liblsmash

description="Library for encoding H264/AVC video streams (snapshot)."
name=x264
version=20250815
release=1
source="https://anduin.linuxfromscratch.org/BLFS/x264/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  ./configure --prefix=/usr \
            --enable-shared \
            --disable-cli &&
make
  make DESTDIR=$PKG install
}
