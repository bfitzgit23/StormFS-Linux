# description	: Realtime Policy and Watchdog Daemon
# homepage	: https://gitlab.freedesktop.org/pipewire/rtkit
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Realtime Policy and Watchdog Daemon"
name=rtkit
version=0.14
release=1
build_opt="
    -Dinstalled_tests=false
    -Dlibsystemd=disabled
"
source="https://gitlab.freedesktop.org/pipewire/$name/-/archive/v$version/$name-v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
