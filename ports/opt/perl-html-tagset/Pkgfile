# Description: Data tables useful in parsing HTML
# URL: https://metacpan.org/pod/HTML::Tagset
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl

name=perl-html-tagset
version=3.24
release=1
source=($name-$version.tar.gz::https://www.cpan.org/authors/id/P/PE/PETDANCE/HTML-Tagset-$version.tar.gz)

build() {
	cd HTML-Tagset-$version
	perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}