# Description: Git extension for versioning large files
# URL: https://git-lfs.github.com
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: go

name=git-lfs
version=3.7.1
release=1
source=($name-$version.tar.gz::https://github.com/git-lfs/git-lfs/archive/refs/tags/v$version.tar.gz)

build() {
	cd $name-$version
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -modcacherw -ldflags=-linkmode=external"
	go mod vendor
	go generate ./commands
	go build .

	install -Dm755 $name $PKG/usr/bin/$name
}