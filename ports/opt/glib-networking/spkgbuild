# description	: Network-related giomodules for glib
# homepage	: https://git.gnome.org/browse/glib-networking/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: make-ca

description="Network-related giomodules for glib"
name=glib-networking
version=2.80.1
release=2
source="https://download.gnome.org/sources/$name/2.80/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

mkdir build &&
cd    build &&

meson setup            \
   --prefix=/usr       \
   --buildtype=release \
   -Dlibproxy=disabled \
   .. &&
ninja

  DESTDIR=$PKG ninja install
}
