# description	: General-purpose cryptographic library used by GnuPG and other applications.
# homepage	: https://www.gnupg.org/software/libgcrypt/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="General-purpose cryptographic library used by GnuPG and other applications."
name=libgcrypt
version=1.12.4
release=1
build_opt=(
    --prefix=/usr
)
source="https://gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1
    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install

    # BFS does not package GNU info pages.
    rm -rf "$PKG/usr/share/info"
}
