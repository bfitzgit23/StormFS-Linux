# description	: D-Bus service for power-device enumeration and statistics
# homepage	: https://gitlab.freedesktop.org/upower/upower
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=upower
version=1.91.3
release=2
source="https://gitlab.freedesktop.org/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.bz2"

build() {
	cd "$name-$version" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dgtk-doc=false \
        -Dman=false \
        -Dudevrulesdir=/usr/lib/udev/rules.d || return 1
    meson compile -C build || return 1
    DESTDIR="$PKG" meson install --no-rebuild -C build || return 1
}
