# Description: Script for sway and i3 to automatically switch the horizontal / vertical window split orientation
# URL: https://github.com/nwg-piotr/autotiling
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools python3-wheel python3-i3ipc

name=nwg-autotiling
version=1.9.3
release=1
source=($name-$version.tar.gz::https://github.com/nwg-piotr/autotiling/archive/v$version.tar.gz)

build() {
	cd autotiling-$version
	python3 setup.py install --root=$PKG --optimize=1
}