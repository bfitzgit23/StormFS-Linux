# Description: A modern, maintained replacement for ls (maintained fork of exa)
# URL: https://github.com/eza-community/eza
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: rust

name=eza
version=0.23.4
release=1
source=($name-$version.tar.gz::https://github.com/eza-community/$name/archive/v$version/$name_x86_64-unknown-linux-gnu.tar.gz)

build() {
	cd $name-$version
  	mkdir rust || true
	export CARGO_HOME=rust

	cargo update
	cargo fetch
	cargo build --release --locked
	install -Dt $PKG/usr/bin target/release/eza

	install -Dm644 completions/zsh/_$name \
		$PKG/usr/share/zsh/site-functions/_$name
	install -Dm644 completions/bash/$name \
		$PKG/usr/share/bash-completion/completions/$name
	install -Dm644 completions/fish/$name.fish \
		$PKG/usr/share/fish/vendor_completions.d/$name.fish
}