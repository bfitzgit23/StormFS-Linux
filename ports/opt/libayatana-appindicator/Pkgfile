# Description: Ayatana Application Indicators Shared Library
# URL: https://github.com/AyatanaIndicators/libayatana-appindicator
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake dbus-glib glib gobject-introspection gtk3 libayatana-indicator libdbusmenu ninja vala

name=libayatana-appindicator
version=0.6.0
release=1
source=(https://github.com/AyatanaIndicators/libayatana-appindicator/archive/$version/${name}-${version}.tar.gz)

build() {
	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DBUILD_SHARED_LIBS=True \
		-DENABLE_TESTS=OFF \
		-DENABLE_BINDINGS_MONO=OFF \
		-DENABLE_GTKDOC=OFF \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}