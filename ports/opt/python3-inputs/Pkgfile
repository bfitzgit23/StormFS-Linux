# Description: Cross-platform Python support for keyboards, mice and gamepads
# URL: https://github.com/zeth/python-inputs#python-
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-gpep517 python3-setuptools-scm

name=python3-inputs
version=0.5
release=2
source=($name-$version.zip::https://github.com/zeth/inputs/archive/refs/tags/v$version.zip 3203c9e25f1e14c4316d85d59c536b4e407f569f.patch)

build() {
        cd inputs-$version
	patch -Np1 -i $SRC/3203c9e25f1e14c4316d85d59c536b4e407f569f.patch
	    gpep517 build-wheel \
		    --wheel-dir .dist \
		    --output-fd 3 3>&1 >&2
	    python3 -m installer \
		    -d $PKG \
		    .dist/*.whl
}