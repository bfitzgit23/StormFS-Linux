# Description: Read and write Advanced Authoring Format (AAF) files
# URL: http://pyaaf.readthedocs.io
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-build python3-installer python3-setuptools python3-wheel

name=python3-aaf2
version=1.7.1
release=1
source=($name-$version.tar.gz::https://github.com/markreidvfx/pyaaf2/archive/refs/tags/v$version.tar.gz)

build() {
	cd pyaaf2-$version	
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir="$PKG" dist/*.whl
}