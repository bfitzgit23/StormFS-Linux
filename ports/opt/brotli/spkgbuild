# description	: Brotli compression library
# homepage	: https://github.com/google/brotli
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: pluggy pytest

description="Brotli compression library"
name=brotli
version=1.2.0
release=3
source="https://github.com/google/$name/archive/v$version/$name-v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  mkdir build &&
cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release  \
      ..  &&
make
  make DESTDIR=$PKG install

  cd $SRC/$name-$version

    /usr/bin/python3 setup.py build
  /usr/bin/python3 setup.py install \
    --prefix=/usr --root=$PKG --optimize=1
}
