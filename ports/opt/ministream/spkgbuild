# description	: Lightweight AppStream metadata reader for libadwaita
# homepage	: https://gitlab.gnome.org/GNOME/ministream
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Lightweight AppStream metadata reader for libadwaita"
name=ministream
version=0.99.1
release=1
source="https://gitlab.gnome.org/GNOME/$name/-/archive/$version/$name-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
