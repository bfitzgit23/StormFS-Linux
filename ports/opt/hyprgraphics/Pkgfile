# Description: Hyprland graphics resource utilities
# URL: https://github.com/hyprwm/hyprgraphics
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: hyprutils libwebp libjxl libspng pango librsvg

name=hyprgraphics
version=0.5.1
release=1
source=($name-$version.tar.gz::https://github.com/hyprwm/hyprgraphics/archive/v$version.tar.gz)

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -D CMAKE_INSTALL_PREFIX=/usr \
	        -D CMAKE_INSTALL_LIBDIR=lib \
	        -D CMAKE_BUILD_TYPE=Release \
	        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}