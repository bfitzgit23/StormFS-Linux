# description	: A C++ wrapper for GTK3+
# homepage	: https://www.gtkmm.org/en/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A C++ wrapper for GTK3+"
name=gtkmm3
version=3.24.11
release=3
source="https://download.gnome.org/sources/gtkmm/${version%.*}/gtkmm-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  meson setup gtkmm-$version build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D build-demos=false \
    -D build-tests=false
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
