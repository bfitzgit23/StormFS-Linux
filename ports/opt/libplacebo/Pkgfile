# Description: Reusable library for GPU-accelerated video/image rendering primitives
# URL: https://github.com/haasn/libplacebo
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: glad lcms2 shaderc vulkan-icd-loader

name=libplacebo
version=7.360.1
release=1
source=($name-$version.tar.gz::https://github.com/haasn/libplacebo/archive/v$version.tar.gz)

build() {
	CXXFLAGS="$CXXFLAGS -I/usr/include/glslang"
	meson setup $name-$version build \
		-Dvulkan=enabled \
		-Dshaderc=enabled \
		-Dlcms=enabled \
		-Dd3d11=disabled \
		-Ddemos=false \
		-Dtests=false
	meson compile -C build 
	DESTDIR=$PKG meson install --no-rebuild -C build
}