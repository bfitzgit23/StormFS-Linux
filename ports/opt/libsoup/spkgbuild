# description	: HTTP library implementation in C
# homepage	: https://wiki.gnome.org/action/show/Projects/libsoup
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gobject-introspection vala apache brotli curl MIT Kerberos V5  gtk-doc php samba sysprof

description="HTTP library implementation in C"
name=libsoup
version=2.74.3
release=1
source="https://ftp.gnome.org/pub/gnome/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -Dvapi=enabled      \
            -Dgssapi=disabled   \
            -Dsysprof=disabled  \
            ..                  &&
ninja
  DESTDIR=$PKG ninja install

  rm -r $PKG/usr/share/locale
}
