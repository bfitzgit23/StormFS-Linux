# description	: Qt 6 client library for accessing the online accounts database
# homepage	: https://gitlab.com/accounts-sso/libaccounts-qt
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Qt 6 client library for accessing the online accounts database"
name=libaccounts-qt
version=1.17
release=1
source="https://gitlab.com/accounts-sso/$name/-/archive/VERSION_$version/$name-VERSION_$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    "$QT6DIR/bin/qmake" PREFIX=/usr LIBDIR=/usr/lib CONFIG+=release || return 1
    make -j${JOBS:-1} || return 1
    make INSTALL_ROOT="$PKG" install || return 1
}
