# Description: Python3 bindings for PyGObject3
# URL: https://pygobject.gnome.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-cairo gobject-introspection

name=python3-gobject3
version=3.56.3
release=1
source=($name-$version.tar.gz::https://gitlab.gnome.org/GNOME/pygobject/-/archive/$version/pygobject-$version.tar.gz)

build() {
	meson setup $name-$version build \
	    --wrap-mode=default \
	    -Dpython=python3 \
	    -Dpycairo=enabled \
	    -Dtests=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}