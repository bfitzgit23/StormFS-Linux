# Description: Python PE parsing module
# URL: https://github.com/erocarrera/pefile
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools python3-gpep517

name=python3-pefile
version=2024.8.26
release=2
source=($name-$version.tar.gz::https://github.com/erocarrera/pefile/archive/v$version/python-setuptools-$version.tar.gz)

build() {
	cd pefile-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	python3 -m installer -d $PKG \
		.dist/*.whl
}