# description	: Fast Unicode validation and transcoding library
# homepage	: https://simdutf.github.io/simdutf/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Fast Unicode validation and transcoding library"
name=simdutf
version=9.2.2
release=1
source="https://github.com/simdutf/simdutf/archive/refs/tags/v$version.tar.gz"

build() {
    _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
    [ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
    [ -n "$_bfs_src" ] || return 1
    cd "$_bfs_src" || return 1

    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DSIMDUTF_TESTS=OFF \
        -DSIMDUTF_BENCHMARKS=OFF \
        -DSIMDUTF_TOOLS=OFF || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        cmake --install build || return 1
}
