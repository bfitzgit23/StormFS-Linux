# description	: The Parted package is a disk partitioning and partition resizing tool.
# homepage	: https://www.gnu.org/software/parted/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: dosfstools pth Digest::CRC texlive

description="The Parted package is a disk partitioning and partition resizing tool."
name=parted
version=3.7
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
