# description	: A stream oriented C library for parsing XML
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A stream oriented C library for parsing XML"
name=dejagnu
version=1.6.3
release=1
source="https://ftp.gnu.org/gnu/dejagnu/dejagnu-$version.tar.gz"

build() {
	cd "$name-$version" || return 1


        mkdir -v build
	cd       build
../configure --prefix=/usr
makeinfo --html --no-split -o doc/dejagnu.html ../doc/dejagnu.texi
makeinfo --plaintext       -o doc/dejagnu.txt  ../doc/dejagnu.texi
make DESTDIR=$PKG install
install -v -dm755  $PKG/usr/share/doc/dejagnu-1.6.3
install -v -m644   doc/dejagnu.{html,txt} $PKG/usr/share/doc/dejagnu-1.6.3
}
