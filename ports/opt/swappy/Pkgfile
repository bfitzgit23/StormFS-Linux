# Description: A Wayland native snapshot editing tool
# URL: https://github.com/jtheoof/swappy
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 libnotify pango scdoc

name=swappy
version=1.8.0
release=1
source=(https://github.com/jtheoof/swappy/releases/download/v$version/$name-$version.tar.gz no-git-version.patch)

build() {
	patch -d $name-$version -i $SRC/no-git-version.patch
	meson setup $name-$version build 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}