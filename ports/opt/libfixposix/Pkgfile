# Description: Thin wrapper over POSIX syscalls
# URL: https://github.com/sionescu/libfixposix/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=libfixposix
version=0.5.1
release=1
source=($name-$version.tar.gz::https://github.com/sionescu/libfixposix/archive/v$version.tar.gz)

build() {
	cd $name-$version
	autoreconf -fiv
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}