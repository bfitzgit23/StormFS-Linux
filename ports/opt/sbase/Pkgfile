name=sbase
version=20230729
release=1
source=($name-$version.tar.gz::https://github.com/michaelforney/sbase/archive/$_commit.tar.gz)

build() {
	cd $name-$_commit
	make $name-box
	install -Dm 755 $name-box $PKG/bin/$name-box
	#make DESTDIR=$PKG PREFIX=/usr $name-box-install
}