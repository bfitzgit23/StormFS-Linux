# Description: suil library for loading and wrapping lv2 plugins UIs
# URL: https://drobilla.net/software/suil.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: sratom python3-babel python3-sphinxygen

name=suil
version=0.10.26
release=1
source=(https://download.drobilla.net/$name-$version.tar.xz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}