# description	: Backends and filters for CUPS
# homepage	: https://openprinting.github.io/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Backends and filters for CUPS"
name=cups-filters
version=2.0.1
release=1
source="https://github.com/OpenPrinting/cups-filters/releases/download/$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
