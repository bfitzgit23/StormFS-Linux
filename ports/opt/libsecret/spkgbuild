# description	: libsecret package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libsecret package"
name=libsecret
version=0.21.7
release=2
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  scratch isinstalled bash-completion || \
    BFS_LIBSECRET+=' -D bash_completion=disabled'
  scratch isinstalled docbook-xsl || BFS_LIBSECRET+=' -D manpage=false'
  scratch isinstalled vala || BFS_LIBSECRET+=' -D vapi=false'

  meson setup build . $BFS_LIBSECRET \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D gtk_doc=false
  meson compile -C build -j ${JOBS:-1}
  DESTDIR=$PKG meson install -C build

  rm -rf "$PKG/usr/share/locale"
}
