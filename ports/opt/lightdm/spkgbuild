# description	: Lightweight cross-desktop display manager
# homepage	: https://github.com/ubuntu/lightdm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: accountsservice libxklavier vala

description="Lightweight cross-desktop display manager"
name=lightdm
version=1.33.1
release=4
source="https://github.com/ubuntu/lightdm/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    # GitHub tag archives do not contain a generated configure script.
    # Current upstream/BLFS also removes obsolete Yelp help generation.
    sed -i '/YELP_HELP/d' \
        configure.ac \
        help/Makefile.am \
        || return 1

    autoreconf -fiv || return 1

    # BFSOS uses ConsoleKit2 for session tracking, not systemd-logind.
    sed -i 's/pam_systemd\.so/pam_ck_connector.so nox11/' \
        data/pam/lightdm \
        data/pam/lightdm-autologin \
        data/pam/lightdm-greeter \
        || return 1

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib/lightdm \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --disable-static \
        --disable-tests \
        --with-greeter-user=lightdm \
        --with-greeter-session=lightdm-gtk-greeter \
        || return 1

    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1

    # Fail the build rather than shipping a PAM stack that references the
    # unavailable systemd module.
    if grep -Rq 'pam_systemd' "$PKG/etc/pam.d"; then
        echo 'ERROR: LightDM PAM files still reference pam_systemd' >&2
        return 1
    fi

    # Ensure graphical sessions use the normal BFSOS login environment.
    install -Dm755 \
        tests/src/lightdm-session \
        "$PKG/usr/bin/lightdm-session" \
        || return 1

    sed -i '1 s|/bin/sh|/bin/bash --login|' \
        "$PKG/usr/bin/lightdm-session" \
        || return 1

    # Remove obsolete Upstart integration.
    rm -rf "$PKG/etc/init"

    # Runtime directories. Ownership is applied by post-install after
    # the lightdm service account exists.
    install -d \
        "$PKG/var/lib/lightdm" \
        "$PKG/var/lib/lightdm-data" \
        "$PKG/var/cache/lightdm" \
        "$PKG/var/log/lightdm" \
        || return 1

rm -f "$PKG/usr/share/dbus-1/system.d/org.freedesktop.DisplayManager.conf"
}
