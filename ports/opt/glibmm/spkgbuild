# description	: C++ interface for the popular glib library.
# homepage	: https://www.gtkmm.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ interface for the popular glib library."
name=glibmm
version=2.88.1
release=3
# pkgbuild expands $source as a shell word list, so keep this a string.
# An array here would drop the local patch entry and leave it out of src/.
source="https://ftp.gnome.org/pub/GNOME/sources/$name/${version%.*}/$name-$version.tar.xz glibmm-2.88.1-glib-2.90-final-types.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	patch -Np1 -i "$SRC/glibmm-2.88.1-glib-2.90-final-types.patch" || return 1

	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true

	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install -C build

	find $PKG \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
