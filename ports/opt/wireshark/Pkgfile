# Description: Network Sniffer with nice GTK+ UI
# URL: https://www.wireshark.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 libpcap pcre2 hicolor-icon-theme

name=wireshark
version=4.7.1
release=1
source=(https://gitlab.com/wireshark/wireshark/-/archive/v$version/$name-$version.tar.gz)

build() {
	cmake -S $name-v${version}* -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS -Wno-error=unused-function" \
		-DENABLE_BCG729=OFF \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build

	# GID for wireshark is 150
	#install -Dm 644 "$SRC"/wireshark.sysusers $PKG/usr/lib/sysusers.d/wireshark.conf
	#chgrp 150 $PKG/usr/bin/dumpcap
	#chmod 754 $PKG/usr/bin/dumpcap
}