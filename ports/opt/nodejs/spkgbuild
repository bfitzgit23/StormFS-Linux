# description	: Evented I/O for V8 javascript.
# homepage	: https://nodejs.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: brotli c-ares icu libnghttp3 libngtcp2 simdjson simdutf

name=nodejs
version=24.21.0
release=1
SPKG_AUTO_PATCH=no
source="https://nodejs.org/dist/v$version/node-v$version.tar.xz unbundle-uv.patch"

build() {
	cd "$name-$version" || return 1

  patch -Np1 -i "$SRC/unbundle-uv.patch" || return 1
  rm deps/uv/uv.gyp deps/zlib/zlib.gyp || return 1

  scratch isinstalled brotli && BFS_NODEJS+=' --shared-brotli'
  scratch isinstalled c-ares && BFS_NODEJS+=' --shared-cares'
  scratch isinstalled icu && BFS_NODEJS+=' --with-intl=system-icu'
  scratch isinstalled libnghttp3 && BFS_NODEJS+=' --shared-nghttp3'
  scratch isinstalled libngtcp2 && BFS_NODEJS+=' --shared-ngtcp2'
  scratch isinstalled simdjson && BFS_NODEJS+=' --shared-simdjson'
  scratch isinstalled simdutf && BFS_NODEJS+=' --shared-simdutf'

  CFLAGS="$CFLAGS -g0 -Wl,--no-keep-memory -fuse-ld=gold -Wl,--no-map-whole-files -Wl,--no-keep-files-mapped" \
  CXXFLAGS="$CFLAGS" \
  ./configure ${BFS_NODEJS} \
    --prefix=/usr \
    --ninja \
    --without-npm \
    --shared-libuv \
    --shared-nghttp2 \
    --shared-zlib \
    --shared-openssl || return 1

  make || return 1
  make DESTDIR="$PKG" install || return 1

  rm -r $PKG/usr/share/doc

  # clean up
  find $PKG -type f \( \
    -name 'README.md' -o \
    -name 'AUTHORS.md' -o \
    -name 'INSTALL.md' -o \
    -name 'TODO.org' -o \
    -name 'ChangeLog' -o \
    -name 'NEWS' \) -delete
}
