# description	: C++ interface for GLib, legacy glibmm-2.4 ABI.
# homepage	: https://www.gtkmm.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ interface for GLib, legacy glibmm-2.4 ABI."
name=glibmm-2.4
version=2.66.10
release=1
build_opt=(
  -Dbuild-documentation=false
  -Dbuild-examples=false
  -Dbuild-tests=false
)
source="https://download.gnome.org/sources/glibmm/${version%.*}/glibmm-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
