# Description: A collection of USB tools to query connected USB devices
# URL: https://git.kernel.org/pub/scm/linux/kernel/git/gregkh/usbutils.git/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libusb hwdata

name=usbutils
version=019
release=1
source=(https://www.kernel.org/pub/linux/utils/usb/usbutils/$name-$version.tar.xz http://www.linux-usb.org/usb.ids)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

}