# description	: libwacom package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libwacom package"
name=libwacom
version=2.19.1
release=2
build_opt="--prefix=/usr
      --buildtype=release
      -D tests=disabled "
source="https://github.com/linuxwacom/${name}/releases/download/${name}-${version}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
