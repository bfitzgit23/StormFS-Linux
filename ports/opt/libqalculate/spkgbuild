# description	: The libqalculate package contains a library that provides functions for a multi-purpose calculator.
# homepage	: https://github.com/Qalculate/libqalculate/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gnuplot	doxygen

description="The libqalculate package contains a library that provides functions for a multi-purpose calculator."
name=libqalculate
version=5.12.0
release=2
build_opt=" --prefix=/usr
            --disable-static
            --docdir=/usr/share/doc/$name-$version"
source="https://github.com/Qalculate/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
