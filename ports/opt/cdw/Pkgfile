# Description: Ncurses CD writer program which uses cdrecord and mkisofs
# URL: http://cdw.sourceforge.net/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cdrtools ncurses libburn libcdio

name=cdw
version=0.8.1
release=1
source=(https://sourceforge.net/projects/$name/files/$name/${name}%20${version}/$name-$version.tar.gz)

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make prefix=$PKG/usr install
}