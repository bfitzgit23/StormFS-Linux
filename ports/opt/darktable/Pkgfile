# Description: Open source photography workflow application
# URL: https://www.darktable.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: colord-gtk cups exiv2 imagemagick lensfun libgphoto2 libsecret libsoup libwebp lua openexr openjpeg2 openmp portmidi pugixml

name=darktable
version=5.6.0
release=1
source=(https://github.com/darktable-org/${name}/releases/download/release-${version}/${name}-${version}.tar.xz)

build() {
	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DCMAKE_INSTALL_LIBEXECDIR=/usr/lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DUSE_LIBSECRET=ON \
		-DUSE_LUA=ON \
		-DUSE_COLORD=ON \
		-DUSE_IMAGEMAGICK=ON \
		-DUSE_GRAPHICSMAGICK=OFF \
		-DBINARY_PACKAGE_BUILD=ON \
		-DBUILD_CURVE_TOOLS=ON \
		-DBUILD_NOISE_TOOLS=ON \
		-DRAWSPEED_ENABLE_LTO=ON \
		-DUSE_GMIC=OFF \
		-DDONT_USE_INTERNAL_LUA=OFF
	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -rf $PKG/usr/share/doc
}