# Description: AV1 Codec Library
# URL: https://aomedia.googlesource.com/aom
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja yasm

name=aom
version=3.14.1
release=1
source=($name-$version.tar.gz::https://storage.googleapis.com/aom-releases/libaom-$version.tar.gz)

build() {
	
	cmake -S libaom-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
	        -DCMAKE_INSTALL_LIBEXECDIR=lib \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DBUILD_SHARED_LIBS=1 \
		-DENABLE_TESTS=0 \
		-DENABLE_DOCS=0 \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}