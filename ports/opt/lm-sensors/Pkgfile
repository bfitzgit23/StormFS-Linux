# Description: The lm_sensors package provides userspace support for the hardware monitoring drivers in the Linux kernel. This is useful for monitoring the temperature of the CPU and adjusting the performance of some hardware (such as cooling fans).
# URL:          https://github.com/lm-sensors/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  which

name=lm-sensors
# pacman keeps the last '-' as the pkgrel separator and rejects a pkgver that
# contains one, so version= must use '_'; srcver keeps the upstream spelling.
version=3_6_2
srcver=3-6-2
release=1
source=(https://github.com/lm-sensors/$name/archive/V$srcver/$name-$srcver.tar.gz)

pkg_build() {

	make PREFIX=/usr        \
     BUILD_STATIC_LIB=0 \
     MANDIR=/usr/share/man
     make DESTDIR=$PKG PREFIX=/usr        \
     BUILD_STATIC_LIB=0 \
     MANDIR=/usr/share/man install &&

install -v -m755 -d $PKG/usr/share/doc/lm_sensors-$srcver &&
cp -rv              README INSTALL doc/* \
                    $PKG/usr/share/doc/lm_sensors-$srcver
}
