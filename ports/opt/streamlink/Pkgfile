# Description: CLI program that launches streams from various streaming services in a custom video player (livestreamer fork)
# URL: https://streamlink.github.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-pysocks python3-websocket-client python3-iso3166 python3-iso-639 python3-requests python3-pycryptodome python3-isodate python3-build python3-wheel

name=streamlink
version=8.4.0
release=1
source=(https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	sed -i 's/versioningit >=2.0.0, <3/versioningit/' pyproject.toml
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir=$PKG dist/*.whl
	
}