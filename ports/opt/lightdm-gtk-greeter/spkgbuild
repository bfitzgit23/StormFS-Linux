# description	: GTK3 greeter for the LightDM display manager
# homepage	: https://github.com/Xubuntu/lightdm-gtk-greeter
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: at-spi2-core

description="GTK3 greeter for the LightDM display manager"
name=lightdm-gtk-greeter
version=2.0.9
release=3
build_opt="\
    --libexecdir=/usr/lib/lightdm \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --with-libxklavier \
    --enable-kill-on-sigterm \
    --disable-libido \
    --disable-libindicator \
    --disable-static \
    --disable-maintainer-mode \
    --docdir=/usr/share/doc/lightdm-gtk-greeter-$version"
# GitHub's release asset is intermittently returning 504; this is the
# identical upstream tarball archived by Debian.
source="https://deb.debian.org/debian/pool/main/l/lightdm-gtk-greeter/lightdm-gtk-greeter_${version}.orig.tar.gz greeter.conf"

build() {
	_bfs_greeter="$PWD/greeter.conf"
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild || return 1
	install -Dm644 "$_bfs_greeter" "$PKG/etc/lightdm/lightdm-gtk-greeter.conf" || return 1
}
