# Description: Wallpaper & color manager for wlroots-based compositors and some X11 WMs
# URL: https://github.com/nwg-piotr/azote
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools gtk3 python3-pillow slurp libappindicator python3-yaml swaybg feh xrandr python3-gobject3

name=azote
version=1.16.0
release=1
source=($name-$version.tar.gz::https://github.com/nwg-piotr/$name/archive/v$version.tar.gz)

build() {
	cd $name-$version

	/usr/bin/python3 -m build --wheel --no-isolation

	install -D -t $PKG/usr/share/pixmaps dist/azote.svg
	install -D -t $PKG/usr/share/$name dist/indicator*.png
	install -D -t $PKG/usr/share/applications dist/azote.desktop

	/usr/bin/python3 -m installer --destdir=$PKG dist/*.whl

	rm -rf $PKG/usr/share/licenses
}