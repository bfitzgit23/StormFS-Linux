# Description: A shell utility for manipulating Linux IDE drive/driver parameters
# URL: https://sourceforge.net/projects/hdparm/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=hdparm
version=9.65
release=1
source=(https://downloads.sourceforge.net/hdparm/$name-$version.tar.gz)

build() {
	cd $name-$version
	make
	make DESTDIR=$PKG install
}