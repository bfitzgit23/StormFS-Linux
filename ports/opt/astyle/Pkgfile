name=astyle
version=3.6.16
release=1
source=(https://gitlab.com/saalen/astyle/-/archive/$version/$name-$version.tar.bz2 makefile-install.patch)

build() {
	cd $name-$version/AStyle/build/gcc
	patch -Np1 -i $SRC/makefile-install.patch
	make shared release
	DESTDIR=$PKG make INSTALL=install install
}