# Description: Next-Gen ls command
# URL: https://github.com/Peltoche/lsd
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: rust

name=lsd
version=1.2.0
release=1
source=($name-$version.tar.gz::https://github.com/lsd-rs/lsd/archive/v${version}.tar.gz)

build() {
	cd $name-$version
	cargo build --release
	cargo install --locked --path . --root=$PKG/usr
	rm $PKG/usr/.crates*
}