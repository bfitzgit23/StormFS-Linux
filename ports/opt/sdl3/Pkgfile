# Description: A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 2)
# URL: https://www.libsdl.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libx11 libxext libxrandr libxscrnsaver libxfixes libxi libxinerama wayland-protocols cmake libxkbcommon ninja

name=sdl3
version=3.4.10
release=1
source=($name-$version.tar.gz::https://github.com/libsdl-org/SDL/releases/download/release-$version/SDL3-$version.tar.gz)

build() {

	CFLAGS="${CFLAGS} -ffat-lto-objects"
	cmake -S SDL3-$version -B build -G Ninja \
			-D CMAKE_BUILD_TYPE=None \
			-D CMAKE_INSTALL_PREFIX=/usr \
			-D SDL_STATIC=OFF \
			-D SDL_RPATH=OFF
	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/share/licenses/
}