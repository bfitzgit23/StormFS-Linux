# Description: The Aspell package contains an interactive spell checking program and the Aspell libraries. Aspell can either be used as a library or as an independent spell checker.
# URL:         https://ftp.gnu.org/gnu/aspell/dict/en/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on:  aspell which

name=aspell6-en
# pacman keeps the last '-' as the pkgrel separator and rejects a pkgver that
# contains one, so version= must use '_'; srcver keeps the upstream spelling.
version=2026.02.25_0
srcver=2026.02.25-0
release=1
source=(https://ftp.gnu.org/gnu/aspell/dict/en/$name-$srcver.tar.bz2)

pkg_build() {

./configure &&
make
	make DESTDIR=$PKG install
}
