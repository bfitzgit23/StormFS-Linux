# description	: Device Tree Compiler and libfdt
# homepage	: https://git.kernel.org/pub/scm/utils/dtc/dtc.git/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=dtc
version=1.8.1
release=1
build_opt=(
    PREFIX=/usr
    LIBDIR=/usr/lib
)
source="https://www.kernel.org/pub/software/utils/dtc/dtc-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
    make "${build_opt[@]}" || return 1

    make \
        DESTDIR="$PKG" \
        "${build_opt[@]}" \
        install || return 1
}
