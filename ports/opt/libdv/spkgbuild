# description	: libdv package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libdv
version=1.0.0
release=1
build_opt="--disable-xv"
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
install -v -m755 -d      $PKG/usr/share/doc/libdv-1.0.0 &&
install -v -m644 README* $PKG/usr/share/doc/libdv-1.0.0
}
