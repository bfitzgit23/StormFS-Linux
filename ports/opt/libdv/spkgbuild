# description	: libdv package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libdv package"
name=libdv
version=1.0.0
release=1
build_opt="--disable-xv"
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
install -v -m755 -d      $PKG/usr/share/doc/libdv-1.0.0 &&
install -v -m644 README* $PKG/usr/share/doc/libdv-1.0.0
}
