# Description: A simple, vim-like file manager
# URL: http://ranger.github.io
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3

name=ranger
version=1.9.4
release=1
source=(http://ranger.github.io/$name-$version.tar.gz)

build() {
	cd $name-$version
	python3 setup.py -q install --root=$PKG --optimize=1

}