# Description: ReadyMedia (formerly known as MiniDLNA) is a simple media server software
# URL: http://sourceforge.net/projects/minidlna/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ffmpeg libexif flac taglib libid3tag libjpeg-turbo libvorbis x264 opus libmatroska

name=minidlna
version=1.3.3
release=2
source=(https://sourceforge.net/projects/$name/files/$name-$version.tar.gz ffmpeg7.patch)

build() {

	cd $name-$version

	# fix build with ffmpeg 7
	patch -Np1 -i $SRC/ffmpeg7.patch

	./autogen.sh
	./configure --prefix=/usr 
	 make
	 make DESTDIR=$PKG install
}