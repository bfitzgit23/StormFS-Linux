# Description: A picom fork with support for rounded corners
# URL: https://github.com/ibhagwan/picom
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libconfig libev libxdg-basedir uthash xcb-util-renderutil xcb-util-image libxext pixman libglvnd dbus

name=ibhagwan-picom
version="Next"
release=1
source=($name-$version.tar.gz::https://github.com/ibhagwan/picom/archive/vNext.tar.gz)

build() {
	meson setup $name-$version build --buildtype=release 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}