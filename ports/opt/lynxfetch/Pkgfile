# Description: Super fast, versatile, and customizable command-line fetcher
# URL: https://gitlab.com/lynxfetch/lynxfetch
# Maintainer: CELESTIFYX Team <celestifyx@gmail.com>
# Depends on: pciutils libdrm dbus rust

name=lynxfetch
version=1.1.4
release=1
source=(https://gitlab.com/${name}/${name}/-/archive/${version}/${name}-${version}.tar.gz)

build() {
    cd "${name}-${version}"

    cargo build --release
    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"

    install -Dm644 "completions/${name}.bash" "${PKG}/usr/share/bash-completion/completions/${name}"
    install -Dm644 "completions/${name}.fish" "${PKG}/usr/share/fish/vendor_completions.d/${name}.fish"
    install -Dm644 "completions/${name}.zsh"  "${PKG}/usr/share/zsh/site-functions/_${name}"
}