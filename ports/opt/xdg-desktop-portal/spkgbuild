# description	: Desktop integration portal for Flatpak and other sandboxed applications
# homepage	: https://github.com/flatpak/xdg-desktop-portal
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Desktop integration portal for Flatpak and other sandboxed applications"
name=xdg-desktop-portal
version=1.22.1
release=3
build_opt="-Dtests=disabled"
source="https://github.com/flatpak/$name/releases/download/$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
