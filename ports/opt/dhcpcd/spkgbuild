# description	: Implementation of the DHCP client specified in RFC2131
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Implementation of the DHCP client specified in RFC2131"
name=dhcpcd
version=10.5.2
bootscriptsversion=20240522
release=1
build_opt=" --prefix=/usr
            --sysconfdir=/etc
            --libexecdir=/usr/lib/dhcpcd
            --dbdir=/var/lib/dhcpcd
            --runstatedir=/run
            --disable-privsep"
source="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v$version/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
