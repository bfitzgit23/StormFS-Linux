# description	: POSIX capabilities library
# homepage	: https://people.redhat.com/sgrubb/libcap-ng/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="POSIX capabilities library"
name=libcap-ng
version=0.8.5
release=1
build_opt=(--without-python)
source="https://people.redhat.com/sgrubb/libcap-ng/libcap-ng-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
