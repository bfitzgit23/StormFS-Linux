# Description: A fancier screen locker for Wayland.
# URL: https://github.com/jirutka/swaylock-effects
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: scdoc linux-pam wayland-protocols

name=swaylock-effects
version=1.8.1
release=1
source=($name-$version.tar.gz::https://github.com/hboetes/swaylock-effects/archive/refs/tags/v$version.tar.gz)

build() {
	meson setup $name-$version build \
		-D pam=enabled \
		-Dbash-completions=$(prt-get isinst bash-completions && printf "true" || printf "false") \
		-Dfish-completions=$(prt-get isinst fish-completions && printf "true" || printf "false") \
		-Dzsh-completions=$(prt-get isinst zsh-completions && printf "true" || printf "false") 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# Adapt pam file to venom
	sed -i 's|login|system-auth|' $PKG/etc/pam.d/swaylock
}