# description	: GNU binutils for mingw-w64 toolchain
# homepage	: https://www.gnu.org/software/binutils/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GNU binutils for mingw-w64 toolchain"
name=mingw-w64-binutils
version=2.47
release=2
source="https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	for T in {i686,x86_64}-w64-mingw32; do
		mkdir build-$T
		cd build-$T
		../configure \
			--prefix=/usr \
			--target=$T \
			--disable-nls \
			--disable-multilib
		sed -i -e '/^MAKEINFO/s:=.*:= true:' Makefile
		make
		make DESTDIR=$PKG install
		cd ..
	done
	rm -r $PKG/usr/share/info
	rm $PKG/usr/lib/bfd-plugins/libdep.so
}
