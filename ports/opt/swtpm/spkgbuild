# description	: Software TPM emulator using libtpms
# homepage	: https://github.com/stefanberger/swtpm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Software TPM emulator using libtpms"
name=swtpm
version=0.10.2
release=2
build_opt=(
    --with-gnutls
    --without-selinux
)
# Upstream's GitHub tag archive requires autogen.sh before configure exists.
source="https://github.com/stefanberger/swtpm/archive/refs/tags/v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./autogen.sh --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc \
        --localstatedir=/var "${build_opt[@]}" || return 1
    make || return 1
    make DESTDIR="$PKG" install || return 1
}
