# description	: MP3 encoder
# homepage	: http://lame.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: dmalloc electric fence libsndfile nasm

description="MP3 encoder"
name=lame
version=3.100
release=1
source="http://downloads.sourceforge.net/project/$name/$name/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure --prefix=/usr --enable-mp3rtp --disable-static &&
make

    make DESTDIR=$PKG pkghtmldir=/usr/share/doc/$name-$version install
}
