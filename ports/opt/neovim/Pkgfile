# Description: neovim
# URL: https://github.com/neovim/neovim
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: pynvim unzip

name=neovim
version=0.12.3
release=1
source=($name-$version.tar.gz::https://github.com/$name/$name/archive/refs/tags/v$version.tar.gz)

build() {
	cd $name-$version
	make CMAKE_INSTALL_PREFIX=/usr USE_BUNDLED=1 CMAKE_BUILD_TYPE=Release
	make DESTDIR=$PKG install

	rm -f $PKG/usr/share/nvim/runtime/ftplugin/systemd.vim \
	      $PKG/usr/share/nvim/runtime/syntax/systemd.vim
}