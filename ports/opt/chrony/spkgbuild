# description	: Lightweight NTP client/server used by the BFSOS live environment
# homepage	: https://chrony-project.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
# NOTE: OpenRC profile integration (chronyd service script) ships in the
# openrc-init-scripts port.

description="Lightweight NTP client/server used by the BFSOS live environment"
name=chrony
version=4.9
release=3
build_opt="--with-user=chrony"
source="https://chrony-project.org/releases/chrony-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild || return 1

    cat > "$PKG/etc/chrony.conf" <<'EOC'
pool pool.ntp.org iburst

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync

# NetworkManager may drop transient source fragments here on live systems.
sourcedir /run/chrony-dhcp
EOC

}
