# Description: Google Noto emoji fonts
# URL: https://fonts.google.com/noto
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=ttf-noto-emoji
version=2.051
release=1
source=($name-$version.tar.gz::https://github.com/googlefonts/noto-emoji/archive/refs/tags/v$version.tar.gz)

build() {
	mkdir -p $PKG/usr/share/fonts/noto
	install -m644 noto-emoji-$version/fonts/NotoColorEmoji.ttf $PKG/usr/share/fonts/noto
}