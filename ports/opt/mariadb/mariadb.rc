#!/bin/sh
#
# /etc/rc.d/mariadb: start/stop mariadb daemon
#

. /etc/rc.subr

NAME=mariadbd
PROG=/usr/sbin/mariadbd
PID=/run/mysqld/mysqld.pid
OPTS="--pid-file=$PID --user=mysql"

case $1 in
	start)
		msg "Starting $NAME..."
		install -o mysql -g mysql -m 0755 -d /run/mysqld
		start_daemon -p $PID $PROG $OPTS
		;;
	stop)
		msg "Stopping $NAME..."
		stop_daemon -p $PID $PROG
		;;
	restart)
		$0 stop
		sleep 1
		$0 start		
		;;
	status)
		status_daemon $PROG
		;;
	*)
		echo "usage: $0 [start|stop|restart|status]"
		;;
esac

# End of file
