#!/bin/sh
#
# /etc/rc.d/seatd: start/stop seatd daemon
#
. /etc/rc.subr

NAME=seatd
PROG=/usr/bin/seatd
PID=/run/seatd/pid
OPTS="-l error -g seat"

case $1 in
	start)
		msg "Starting $NAME..."
		start_daemon -p $PID $PROG $OPTS &
		;;
	stop)
		msg "Stopping $NAME..."
		stop_daemon -p $PID $PROG
		;;
	restart)
		$0 stop
		sleep 1
		$0 start
		;;
	status)
		status_daemon $PROG
		;;
	*)
		echo "Usage: $0 [start|stop|restart|status]"
		;;
esac

# End of file
