# Description: Seat management daemon and library
# URL: https://git.sr.ht/~kennylevinsen/seatd
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: meson scdoc

name=seatd
version=0.9.3
release=1
source=($name-$version.tar.gz::https://git.sr.ht/~kennylevinsen/seatd/archive/$version.tar.gz rc.seatd run.seatd)

build() {
    meson setup $name-$version build \
          -Dlibseat-logind=disabled \
	  -Dlibseat-seatd=enabled \
	  -Dlibseat-builtin=enabled \
          -Dman-pages=enabled \
          -Dexamples=disabled \
          -Dserver=enabled 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# user can run seatd-launch
	chmod u+s $PKG/usr/bin/seatd-launch

	# rc service
	prt-get isinst sysvinit && \
		install -Dm755 $SRC/rc.seatd $PKG/etc/rc.d/seatd || continue
	
	# runit service
	prt-get isinst runit && {
		install -Dm755 $SRC/run.seatd $PKG/etc/sv/seatd/run
		ln -s /run/runit/supervise.seatd $PKG/etc/sv/seatd/supervise
	} || continue
}