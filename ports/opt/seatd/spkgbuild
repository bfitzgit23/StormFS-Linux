# description	: Seat management daemon and libseat library
# homepage	: https://sr.ht/~kennylevinsen/seatd/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Seat management daemon and libseat library"
name=seatd
version=0.9.3
release=1
source="https://github.com/kennylevinsen/seatd/archive/refs/tags/${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dwerror=false \
        -Dlibseat-logind=disabled \
        -Dlibseat-seatd=enabled \
        -Dlibseat-builtin=disabled \
        -Dserver=enabled \
        -Dexamples=disabled \
        -Dman-pages=disabled || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
