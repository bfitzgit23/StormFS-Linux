# Description: Portable command line archive file manager
# URL: https://wummel.github.io/patool/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools

name=patool
version=4.0.5
release=1
source=(https://github.com/wummel/$name/releases/download/$version/$name-$version.tar.gz)

build() {
	cd patool-$version
	/usr/bin/python3 setup.py build
	/usr/bin/python3 setup.py install \
		--prefix=/usr \
		--root=$PKG

	chmod -R go-w,a+r,u+w $PKG
}