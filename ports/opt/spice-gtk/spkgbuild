# description	: GTK3 SPICE client library and widget
# homepage	: https://www.spice-space.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GTK3 SPICE client library and widget"
name=spice-gtk
version=0.42
release=2
build_opt=(
    -Dgtk=enabled
    -Dwayland-protocols=enabled
    -Dwebdav=disabled
    -Dusbredir=enabled
    -Dlibcap-ng=enabled
    -Dpolkit=enabled
    -Dintrospection=enabled
    -Dvapi=disabled
    -Dlz4=enabled
    -Dsasl=enabled
    -Dopus=enabled
    -Dsmartcard=disabled
    -Degl=enabled
    -Dgtk_doc=disabled
)
source="https://www.spice-space.org/download/gtk/spice-gtk-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
