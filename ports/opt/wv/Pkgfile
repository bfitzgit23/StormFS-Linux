# Description: Command line utilities to convert Microsoft Word documents.
# URL: http://wvware.sourceforge.net/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libgsf glib

name=wv
version=1.2.9
release=1
source=($name-$version.tar.gz::https://github.com/AbiWord/wv/archive/refs/tags/$name-1-2-9.tar.gz format_security.patch)

build() {
	cd $name-$name-1-2-9

	# fix build
	patch -Np1 -i $SRC/format_security.patch	
	touch AUTHORS ChangeLog

	autoreconf -fi
	./configure --prefix=/usr \
	    --sysconfdir=/etc \
	    --localstatedir=/var \
	    --mandir=/usr/share/man \
	    --disable-static
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
	make DESTDIR=$PKG install
}