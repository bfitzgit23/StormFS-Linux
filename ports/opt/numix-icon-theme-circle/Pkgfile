# Description: Base icon theme from the Numix project (circle)
# URL: https://github.com/numixproject/numix-icon-theme-circle
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3

name=numix-icon-theme-circle
version=26.02.21
release=2
source=($name-$version.tar.gz::https://github.com/numixproject/numix-icon-theme-circle/archive/$version.tar.gz)

build() {
	cd $name-$version
	install -dm 755 $PKG/usr/share/icons
	cp -dr --no-preserve='ownership' Numix-Circle Numix-Circle-Light $PKG/usr/share/icons/

	rm -f $PKG/usr/share/icons/Numix-Circle/*/apps/systemd-pilot.svg \
	      $PKG/usr/share/icons/Numix-Circle/48/apps/io.github.mfat.systemdpilot.svg
}