# description	: potrace package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="potrace package"
name=potrace
version=1.16
release=1
build_opt="--prefix=/usr
            --disable-static
            --docdir=/usr/share/doc/$name-$version
            --enable-a4
            --enable-metric
            --with-libpotrace"
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
