# description	: D-Bus GLib bindings
# homepage	: https://freedesktop.org/wiki/Software/DBusBindings
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gtk-doc

description="D-Bus GLib bindings"
name=dbus-glib
version=0.114
release=3
source="https://ftp.debian.org/debian/pool/main/d/dbus-glib/dbus-glib_${version}.orig.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	scratch isinstalled bash-completion || BFS_DBUSGLIB+=' --enable-bash-completion=no'

	./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --disable-static &&
make
	make DESTDIR=$PKG install
}
