# Description: Elegant, simple, clean dock
# URL: https://launchpad.net/plank
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: bamf libgee gnome-menus

name=plank
version=0.11.89
release=1
source=(https://launchpad.net/plank/1.0/$version/+download/plank-$version.tar.xz)

build() {
	cd $name-$version
	./configure \
	    --prefix=/usr \
	    --sysconfdir=/etc \
	    --disable-apport \
	    --disable-nls
	make
	make DESTDIR=$PKG install
}