# Description: Kitty is a GPU Accelerated Terminal
# URL: https://sw.kovidgoyal.net/kitty/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libcanberra imagemagick python3-pygments libxkbcommon librsync go xxhash simde ttf-nerd-fonts-symbols

name=kitty
version=0.47.4
release=1
source=(https://github.com/kovidgoyal/kitty/releases/download/v$version/$name-$version.tar.xz)

build() {
	cd $name-$version
	python3 setup.py linux-package --update-check-interval=0
	python3 setup.py linux-package --prefix $PKG/usr
}