# description	: Lightweight KMS plane library
# homepage	: https://gitlab.freedesktop.org/emersion/libliftoff
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Lightweight KMS plane library"
name=libliftoff
version=0.5.0
release=1
source="https://gitlab.freedesktop.org/emersion/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload || return 1

    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
