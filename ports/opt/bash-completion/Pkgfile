# Description: Programmable completion for the bash shell
# URL: https://github.com/scop/bash-completion
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: bash

name=bash-completion
version=2.17.0
release=1
source=(https://github.com/scop/bash-completion/releases/download/$version/$name-$version.tar.xz)
noextract=(*.tar.xz)

build() {
	cd $name-$version
	./configure --prefix=/usr --sysconfdir=/etc
	make
	make DESTDIR=$PKG install

	# bash-completion is sourced in /etc/bash.bashrc so that non-bash shell don't source it
	rm $PKG/etc/profile.d/bash_completion.sh
	
	# remove Slackware's makepkg completion
	rm $PKG/usr/share/bash-completion/completions/makepkg
	
	# remove libsecret provided completion
#	rm $PKG/usr/share/bash-completion/completions/secret-tool
}