#!/bin/sh	
#	
# /etc/rc.d/tor: start/stop Tor service	
#	

. /etc/rc.subr

NAME="Tor service"
PROG=/usr/bin/tor
PID=/run/tor/pid
OPTS="--quiet --runasdaemon 1"
	
case $1 in	
	start)	
		msg "Starting $NAME..."	
		start_daemon -p $PID $PROG $OPTS
		;;	
	stop)	
		msg "Stopping $NAME..."	
		stop_daemon -p $PID $PROG
		;;	
	restart)	
		$0 stop	
		sleep 1	
		$0 start	
		;;	
	status)	
		status_daemon $PROG
		;;	
	*)	
		echo "Usage: $0 [start|stop|restart|status]"	
		;;	
esac

# End of file
