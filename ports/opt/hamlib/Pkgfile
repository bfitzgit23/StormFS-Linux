# Description: Ham radio equipment control libraries
# URL: https://hamlib.github.io
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl lua tcl libxml2 libusb-compat libtool boost swig

name=hamlib
version=4.7.2
release=1
source=(https://github.com/Hamlib/Hamlib/releases/download/$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	export PYTHON_VERSION="3.14"

	./configure \
  		--prefix=/usr \
  		--sbindir=/usr/bin \
  		--with-perl-binding \
  		--with-python-binding \
  		--with-tcl-binding \
  		--with-lua-binding \
  		--with-xml-support \
  		--disable-uhd

	make
	make DESTDIR=$PKG install
}