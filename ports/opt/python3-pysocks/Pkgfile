# Description: SOCKS4, SOCKS5 or HTTP proxy (Anorov fork PySocks replaces socksipy)
# URL: https://github.com/Anorov/PySocks
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools

name=python3-pysocks
version=1.7.1
release=1
source=($name-$version.tar.gz::https://pypi.io/packages/source/P/PySocks/PySocks-$version.tar.gz)

build() {
	cd PySocks-$version
	python3 setup.py build
	python3 setup.py install --prefix=/usr --root=$PKG --optimize=1 --skip-build
}