# Description: A minimal static theme for Sphinx
# URL: https://gitlab.com/lv2/sphinx_lv2_theme
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools python3-gpep517

name=python3-sphinx-lv2-theme
version=1.4.6
release=3
source=($name-$version.tar.gz::https://gitlab.com/lv2/${_name}/-/archive/v$version/${_name}-v$version.tar.gz)

build() {
	cd $_name-v$version

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}