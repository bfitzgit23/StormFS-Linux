# description	: A stream oriented C library for parsing XML
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A stream oriented C library for parsing XML"
name=isl
version=0.28
release=1
source="https://libisl.sourceforge.io/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

        ./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-$version
        make
        make DESTDIR=$PKG install
	install -vd $PKG/usr/share/doc/$name-$version
install -m644 doc/{CodingStyle,manual.pdf,SubmittingPatches,user.pod} \
        $PKG/usr/share/doc/$name-$version
}
