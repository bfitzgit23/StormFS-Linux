# Description: A lightweight window manager for the X11 Window System
# URL: https://joewing.net/projects/jwm/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxext libxmu libxinerama libxpm libjpeg-turbo libpng librsvg cairo libxft

name=jwm
version=2.4.6
release=1
source=(https://github.com/joewing/jwm/releases/download/v$version/jwm-$version.tar.xz jwm.desktop)

build() {
	cd $name-$version

	sed -i 's|/usr/local/share/|/usr/share/|' contrib/Makefile po/Makefile* example.jwmrc
	sed "s/autohide/height=\"20\" autohide/" -i example.jwmrc

	export CFLAGS="$CFLAGS -I/usr/include/freetype2"

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib \
		--sysconfdir=/etc \
		--disable-fribidi
	make
	make DESTDIR=$PKG install
	install -Dm644 $SRC/jwm.desktop $PKG/usr/share/xsessions/jwm.desktop
}