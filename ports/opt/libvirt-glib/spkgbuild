# description	: GLib and GObject bindings for libvirt
# homepage	: https://libvirt.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GLib and GObject bindings for libvirt"
name=libvirt-glib
version=5.0.0
release=1
build_opt=(
    -Ddocs=disabled
    -Dtests=disabled
    -Dintrospection=enabled
    -Dvapi=enabled
)
source="https://download.libvirt.org/glib/libvirt-glib-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
