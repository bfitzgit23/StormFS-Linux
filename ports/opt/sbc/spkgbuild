# description	: The SBC is a digital audio encoder and decoder used to transfer data to Bluetooth audio output devices like headphones or loudspeakers.
# homepage	: https://www.kernel.org/pub/linux/bluetooth/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The SBC is a digital audio encoder and decoder used to transfer data to Bluetooth audio output devices like headphones or loudspeakers."
name=sbc
version=2.2
release=2
source="https://www.kernel.org/pub/linux/bluetooth/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
./configure --prefix=/usr --disable-static --disable-tester &&
make

	make DESTDIR=$PKG install
}
