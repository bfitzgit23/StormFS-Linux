# description	: MIT Kerberos V5 network authentication implementation
# homepage	: https://kerberos.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bind-utils gnupg keyutils openldap valgrind yasm libedit cmocka kdcproxy pyrad resolv_wrapper

description="MIT Kerberos V5 network authentication implementation"
name=kerberos
version=1.22.2
release=3
source="https://kerberos.org/dist/krb5/${version%.*}/krb5-$version.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/mitkrb-$version-upstream_fix-1.patch https://www.linuxfromscratch.org/patches/blfs/svn/mitkrb-$version-security_fix-1.patch https://www.linuxfromscratch.org/patches/blfs/svn/mitkrb-$version-openssl_4_fixes-1.patch"

build() {
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    cd src || return 1

    sed -i -e '/eq 0/{N;s/12 //}' \
        plugins/kdb/db2/libdb2/test/run.test \
        || return 1

    config_opts=(
        --prefix=/usr
        --sysconfdir=/etc
        --localstatedir=/var/lib
        --runstatedir=/run
        --with-system-et
        --with-system-ss
        --with-system-verto=no
        --enable-dns-for-realm
        --disable-rpath
    )

    if scratch isinstalled openldap >/dev/null 2>&1; then
        config_opts+=( --with-ldap )
    fi

    ./configure "${config_opts[@]}" || return 1

    make -j"${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1

    install -d "$PKG/usr/share/doc/krb5-$version" || return 1

    cp -a ../doc/. \
        "$PKG/usr/share/doc/krb5-$version/" \
        || return 1

    # Verify that the development/runtime pieces Samba requires were
    # actually installed. Never create a partial Kerberos package.
    for f in \
        "$PKG/usr/bin/krb5-config" \
        "$PKG/usr/include/gssapi/gssapi.h" \
        "$PKG/usr/include/gssapi/gssapi_krb5.h" \
        "$PKG/usr/lib/libkrb5.so" \
        "$PKG/usr/lib/libgssapi_krb5.so"
    do
        if [ ! -e "$f" ]; then
            echo "ERROR: expected Kerberos file missing: $f"
            return 1
        fi
    done

}
