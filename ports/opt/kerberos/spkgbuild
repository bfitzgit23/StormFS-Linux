# description	: MIT Kerberos V5 network authentication implementation
# homepage	: https://kerberos.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bind-utils gnupg keyutils openldap valgrind yasm libedit cmocka kdcproxy pyrad resolv_wrapper

description="MIT Kerberos V5 network authentication implementation"
name=kerberos
version=1.22.2
release=5
source="https://kerberos.org/dist/krb5/${version%.*}/krb5-$version.tar.gz https://www.linuxfromscratch.org/patches/blfs/13.1/mitkrb-$version-upstream_fix-1.patch https://www.linuxfromscratch.org/patches/blfs/13.1/mitkrb-$version-security_fix-1.patch https://www.linuxfromscratch.org/patches/blfs/13.1/mitkrb-$version-openssl_4_fixes-1.patch krb5-$version-remove-openssl-1.0.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patches in dependency order. The upstream OpenSSL-1.0 removal
	# backport must follow the BLFS OpenSSL-4 compatibility fixes.
	#
	# pkgbuild normally starts from an unpacked tree, but a kept work tree
	# must not be patched twice: patch -t assumes -R for an existing hunk and
	# would silently undo these fixes. Skip a fully patched tree and never
	# let patch reverse a hunk.
	if grep -q 'need 1\.1\.0' src/configure.ac 2>/dev/null &&
	   grep -q 'X509_STORE_CTX_set0_trusted_stack' \
		src/plugins/preauth/pkinit/pkinit_crypto_openssl.c 2>/dev/null; then
		echo "Kerberos: source tree is already patched; skipping patch series"
	else
		for _bfs_patch in \
			"$SRC/mitkrb-$version-upstream_fix-1.patch" \
			"$SRC/mitkrb-$version-security_fix-1.patch" \
			"$SRC/mitkrb-$version-openssl_4_fixes-1.patch" \
			"$SRC/krb5-$version-remove-openssl-1.0.patch"
		do
			[ -f "$_bfs_patch" ] || return 1
			patch -N -t "${patch_opt:--p1}" -i "$_bfs_patch" || {
				echo "ERROR: Kerberos patch does not apply: $_bfs_patch" >&2
				return 1
			}
		done
	fi
    cd src || return 1

    sed -i -e '/eq 0/{N;s/12 //}' \
        plugins/kdb/db2/libdb2/test/run.test \
        || return 1

	# Krb5 1.22 requires OpenSSL 1.1 or newer. Report the version the compiler
	# will actually see, so a stale header in a reused build root is visible.
	if [ -r /usr/include/openssl/opensslv.h ]; then
		_bfs_ssl_text=$(sed -n 's/^# *define *OPENSSL_VERSION_TEXT *"\([^"]*\)".*/\1/p' /usr/include/openssl/opensslv.h | head -n 1)
		[ -n "$_bfs_ssl_text" ] && echo "Kerberos: building against $_bfs_ssl_text"
	fi

	config_opts=(
        --prefix=/usr
        --sysconfdir=/etc
        --localstatedir=/var/lib
        --runstatedir=/run
        --with-system-et
        --with-system-ss
        --with-system-verto=no
        --enable-dns-for-realm
        --disable-rpath
    )

    if scratch isinstalled openldap >/dev/null 2>&1; then
        config_opts+=( --with-ldap )
    fi

    ./configure "${config_opts[@]}" || return 1

    make -j"${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1

    install -d "$PKG/usr/share/doc/krb5-$version" || return 1

    cp -a ../doc/. \
        "$PKG/usr/share/doc/krb5-$version/" \
        || return 1

    # Verify that the development/runtime pieces Samba requires were
    # actually installed. Never create a partial Kerberos package.
    for f in \
        "$PKG/usr/bin/krb5-config" \
        "$PKG/usr/include/gssapi/gssapi.h" \
        "$PKG/usr/include/gssapi/gssapi_krb5.h" \
        "$PKG/usr/lib/libkrb5.so" \
        "$PKG/usr/lib/libgssapi_krb5.so"
    do
        if [ ! -e "$f" ]; then
            echo "ERROR: expected Kerberos file missing: $f"
            return 1
        fi
    done

}
