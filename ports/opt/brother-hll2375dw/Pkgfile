# Description: Brother HL-L2375DW CUPS driver
# URL: http://www.brother.com
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cups perl

name=brother-hll2375dw
version=4.0.0
release=1
source=(http://download.brother.com/welcome/dlf103533/hll2375dwpdrv-$version-1.i386.rpm)

build() {
	# using /usr/share instead of /opt
	mkdir -p "$PKG/usr/share"
	cp -R "$SRC/opt/brother" "$PKG/usr/share"
	sed -i 's|\\\/opt\\\/|\\\/usr\\\/|' "$PKG/usr/share/brother/Printers/HLL2375DW/cupswrapper/lpdwrapper"
	sed -i 's|\\\/opt\\\/|\\\/usr\\\/|' "$PKG/usr/share/brother/Printers/HLL2375DW/lpd/lpdfilter"

	# symlink for lpdwrapper so it correctly figures out the printer model from the path
	install -d "$PKG/usr/lib/cups/filter/"
	ln -s "/usr/share/brother/Printers/HLL2375DW/cupswrapper/lpdwrapper" "$PKG/usr/lib/cups/filter/brother_lpdwrapper_HLL2375DW"

	# symlink for the PPD
	install -d "$PKG/usr/share/cups/model/"
	ln -s "/usr/share/brother/Printers/HLL2375DW/cupswrapper/brother-HLL2375DW-cups-en.ppd" "$PKG/usr/share/cups/model/"

	# a couple architecture-specific symlinks
	ln -s "/usr/share/brother/Printers/HLL2375DW/lpd/$CARCH/brprintconflsr3" "$PKG/usr/share/brother/Printers/HLL2375DW/lpd/"
	ln -s "/usr/share/brother/Printers/HLL2375DW/lpd/$CARCH/rawtobr3" "$PKG/usr/share/brother/Printers/HLL2375DW/lpd/"

	# symlink for inf because it tries to execute it there
	ln -s "/usr/share/brother/Printers/HLL2375DW/inf" "$PKG/usr/share/brother/Printers/HLL2375DW/lpd/"
}