# Description: Suckless cron daemon
# URL: http://git.2f30.org/scron
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=scron
version=0.4
release=2
source=(https://dl.2f30.org/releases/$name-$version.tar.gz rc.crond)

build() {
    cd $name-$version
    make
    make DESTDIR=$PKG PREFIX=/usr install

	install -Dm755 $SRC/rc.crond $PKG/etc/rc.d/crond
}