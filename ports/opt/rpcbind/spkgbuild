# description	: RPC program number to universal address mapper
# homepage	: https://sourceforge.net/projects/rpcbind/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="RPC program number to universal address mapper"
name=rpcbind
version=1.2.9
release=1
build_opt="--enable-warmstarts"
source="https://downloads.sourceforge.net/project/rpcbind/rpcbind/$version/rpcbind-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    install -d "$PKG/var/lib/rpcbind" || return 1
}
