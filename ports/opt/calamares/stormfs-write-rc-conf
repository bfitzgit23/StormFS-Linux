#!/bin/sh
#
# Generate /etc/rc.conf for an installed StormFS system.
#
# Calamares runs this from its final shellprocess module while the target is
# chrooted. The live ISO's rc.conf must not be copied to the installed system:
# it contains bfs-live-init and the live autologin policy.

set -eu

timezone=$(cat /etc/timezone 2>/dev/null || true)
if [ -z "$timezone" ] && [ -L /etc/localtime ]; then
    timezone=$(readlink -f /etc/localtime 2>/dev/null |
        sed -n 's#^.*/zoneinfo/##p' || true)
fi
[ -n "$timezone" ] || timezone=UTC

keymap=$(sed -n 's/^KEYMAP=["'"'"']*\([^"'"'"']*\)["'"'"']*$/\1/p' \
    /etc/vconsole.conf 2>/dev/null | tail -n 1 || true)
[ -n "$keymap" ] || keymap=us

font=$(sed -n 's/^FONT=["'"'"']*\([^"'"'"']*\)["'"'"']*$/\1/p' \
    /etc/vconsole.conf 2>/dev/null | tail -n 1 || true)

daemons=""
add_daemon() {
    [ -x "/etc/rc.d/init.d/$1" ] || return 0
    case " $daemons " in
        *" $1 "*) ;;
        *) daemons="${daemons:+$daemons }$1" ;;
    esac
}

# D-Bus and ConsoleKit are the session foundation for the supported desktops.
add_daemon dbus
add_daemon consolekit

for service in networkmanager acpid bluetooth gpm chronyd cups avahi; do
    add_daemon "$service"
done

# Enable exactly one installed display manager. rc starts DAEMONS in order,
# so this runs after the session daemons above.
for dm in lightdm lxdm sddm; do
    if [ -x "/usr/bin/$dm" ] || [ -x "/usr/sbin/$dm" ]; then
        add_daemon "$dm"
        break
    fi
done

cat > /etc/rc.conf <<EOF
#
# /etc/rc.conf: StormFS system configuration
#
# Generated by the StormFS installer. This file is a package backup file:
# package updates preserve local changes.
#

HARDWARECLOCK="UTC"
TIMEZONE="$timezone"
KEYMAP="$keymap"
FONT="$font"
DAEMONS="$daemons"
EOF

exit 0
