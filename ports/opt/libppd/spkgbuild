# description	: libppd package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libppd
version=2.1.1
release=1
build_opt="--prefix=/usr
           --disable-static
           --with-cups-rundir=/run/cups
           --enable-ppdc-utils
           --docdir=/usr/share/doc/$name-$version"
source="https://github.com/OpenPrinting/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
