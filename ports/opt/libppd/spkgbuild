# description	: libppd package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libppd package"
name=libppd
version=2.1.1
release=1
build_opt="--prefix=/usr
           --disable-static
           --with-cups-rundir=/run/cups
           --enable-ppdc-utils
           --docdir=/usr/share/doc/$name-$version"
source="https://github.com/OpenPrinting/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
