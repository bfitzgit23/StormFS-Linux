# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="faad2 package"
name=faad2
version=2.11.3
release=2
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
      -DCMAKE_BUILD_TYPE=Release
      -DBUILD_SHARED_LIBS=ON"
source="https://github.com/knik0/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
