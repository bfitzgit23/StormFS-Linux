name=appstream-glib
version=0.8.4
release=2
build_opt="--prefix=/usr
      --buildtype=release
      -D rpm=false"
source="http://people.freedesktop.org/~hughsient/${name}/releases/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
