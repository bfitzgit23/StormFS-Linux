# description	: The Zip package contains Zip utilities. These are useful for compressing files into ZIP archives.
# homepage	: https://downloads.sourceforge.net/infozip/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The Zip package contains Zip utilities. These are useful for compressing files into ZIP archives."
name=zip
version=3.0
# pkgbuild sources recipes with /bin/sh, so compute the dotted version
# forms that POSIX shell has no substitution for.
_ver_nodot=$(printf '%s' "$version" | tr -d .)
release=1
source="https://downloads.sourceforge.net/infozip/${name}$_ver_nodot.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	sed -i '205 s/CC=gcc/CC="gcc -std=gnu89"/' unix/Makefile
	make -f unix/Makefile generic_gcc
	make -f unix/Makefile INSTALL=install prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install
}
