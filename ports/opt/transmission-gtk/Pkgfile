# Description: Fast, easy, and free BitTorrent client (GTK+ GUI)
# URL: http://www.transmissionbt.com/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libevent gtk3 hicolor-icon-theme desktop-file-utils ninja

name=transmission-gtk
version=4.1.2
release=1
source=(https://github.com/${name%-*}/${name%-*}/releases/download/$version/${name%-*}-$version.tar.xz)

build() {

	cmake -S ${name%-*}-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_BUILD_TYPE=Release \
                -DRUN_CLANG_TIDY=OFF \
		-DINSTALL_DOC=ON \
		-DENABLE_TESTS=OFF \
		-DENABLE_NLS=OFF \
		-DENABLE_GTK=ON \
		-DENABLE_WEB=OFF \
		-DENABLE_QT=OFF \
		-DENABLE_DAEMON=OFF \
		-DENABLE_CLI=OFF \
		-DENABLE_UTILS=OFF
	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/share/transmission
	install -d $PKG/var/lib/transmission -o transmission -g transmission
}