# Description: Cantarell font family
# URL: https://gitlab.gnome.org/GNOME/cantarell-fonts
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: appstream-glib uv

name=ttf-cantarell
version=0.311
release=1
source=($name-$version.tar.gz::https://gitlab.gnome.org/GNOME/cantarell-fonts/-/archive/$version/$_name-$version.tar.gz)

build() {
	cd $_name-$version
	uv sync
	. $SRC/$_name-$version/.venv/bin/activate
	venom-meson build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}