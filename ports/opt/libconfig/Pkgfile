# Description: C/C++ Configuration File Library
# URL: https://github.com/hyperrealm/libconfig
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=libconfig
version=1.8.2
release=1
source=($name-$version.tar.gz::https://github.com/hyperrealm/libconfig/archive/v$version.tar.gz)

build() {
	cd $name-$version

	autoreconf -vi

	./configure --prefix=/usr
	sed -i "s/doc//g" Makefile

	make
	make DESTDIR=$PKG install
}