# Description: GTK user interface for TLP written in Python
# URL: https://github.com/d4nj1/TLPUI
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 python3-build python3-poetry-core pyton3-yaml tlp python3-gobject3 python3-wheel

name=tlpui
version=1.10.1
release=1
source=($name-$version.tar.gz::https://github.com/d4nj1/TLPUI/archive/refs/tags/$name-$version.tar.gz)

build() {
	cd TLPUI-$name-$version
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir=$PKG dist/*.whl

	install -Dm664 "$SRC/TLPUI-$name-$version/$name.desktop" "$PKG/usr/share/applications"  
}