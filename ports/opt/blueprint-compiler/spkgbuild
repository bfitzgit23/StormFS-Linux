# description	: Compiler for the Blueprint GTK interface definition language
# homepage	: https://gitlab.gnome.org/GNOME/blueprint-compiler
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Compiler for the Blueprint GTK interface definition language"
name=blueprint-compiler
version=0.22.2
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
