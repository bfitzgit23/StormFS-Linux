# description	: An image loading library for GTK+
# homepage	: https://wiki.gnome.org/Projects/GdkPixbuf
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: docutils librsvg libtiff gobject-introspection gi-docgen libavif webp-pixbuf-loader

description="An image loading library for GTK+"
name=gdk-pixbuf
version=2.44.8
release=1
source="https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D tests=false \
		-D installed_tests=false \
		-D man=false \
		-D glycin=disabled -D others=enabled &&

	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install  -C build
}
