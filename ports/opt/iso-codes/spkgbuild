# description	: ISO Country/Language/Currency codes
# homepage	: https://salsa.debian.org/iso-codes-team/iso-codes
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="ISO Country/Language/Currency codes"
name=iso-codes
version=4.20.1
release=6
source="https://deb.debian.org/debian/pool/main/i/iso-codes/iso-codes_${version}.orig.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build &&

    rm -rf "$PKG/usr/share/locale"
}
