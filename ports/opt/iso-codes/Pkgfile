# Description: ISO Country/Language/Currency codes
# URL: https://salsa.debian.org/iso-codes-team/iso-codes
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: gettext python3 meson

name=iso-codes
version=4.20.1
release=6
source=(https://deb.debian.org/debian/pool/main/i/iso-codes/iso-codes_${version}.orig.tar.xz)

pkg_build() {
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build &&

    rm -rf "$PKG/usr/share/locale"
}
