# Description: Geocoding library for Python
# URL: https://github.com/geopy/geopy
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-geographiclib python3-gpep517

name=python3-geopy
version=2.4.1
release=3
source=($name-$version.tar.gz::https://github.com/geopy/geopy/archive/$version.tar.gz)

build() {
	cd $nm-$version
	    gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2

	    python3 -m installer -d $PKG \
		    .dist/*.whl
}