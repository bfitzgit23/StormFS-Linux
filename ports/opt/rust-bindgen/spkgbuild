# description	: rust-bindgen package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="rust-bindgen package"
name=rust-bindgen
version=0.73.2
release=1
source="https://github.com/rust-lang/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    scratch isinstalled sccache && export RUSTC_WRAPPER=/usr/bin/sccache

    mkdir -p "$BFS_SOURCE_DIR/rust"

    cargo build \
        --release \
        --manifest-path Cargo.toml || return 1

    install -Dm755 \
        target/release/bindgen \
        "$PKG/usr/bin/bindgen" || return 1
}
