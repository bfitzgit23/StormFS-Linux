# description	: rust-bindgen package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="rust-bindgen package"
name=rust-bindgen
version=0.73.2
release=1
source="https://github.com/rust-lang/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
	cd "$name-$version" || return 1
    scratch isinstalled sccache && export RUSTC_WRAPPER=/usr/bin/sccache

    mkdir -p "$BFS_SOURCE_DIR/rust"

    cargo build \
        --release \
        --manifest-path Cargo.toml || return 1

    install -Dm755 \
        target/release/bindgen \
        "$PKG/usr/bin/bindgen" || return 1
}
