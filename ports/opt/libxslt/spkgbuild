# description	: XSL Transformations library
# homepage	: https://gitlab.gnome.org/GNOME/libxslt/-/wikis/home
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libgcrypt

description="XSL Transformations library"
name=libxslt
version=1.1.45
release=3
source="https://download.gnome.org/sources/libxslt/${version:0:3}/libxslt-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  scratch isinstalled libgcrypt || BFS_LIBXSLT+=' --without-crypto'

  ./configure --prefix=/usr                          \
            --disable-static                       \
            --docdir=/usr/share/doc/libxslt-1.1.38 \
            PYTHON=/usr/bin/python3 &&
make
  make DESTDIR=$PKG install
}
