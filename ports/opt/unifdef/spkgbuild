# description	: Utility for removing preprocessor conditionals from code
# homepage	: https://dotat.at/prog/unifdef/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=unifdef
version=2.12
release=3
source="https://ftp2.osuosl.org/pub/blfs/svn/u/$name-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    sed -i 's/constexpr/unifdef_&/g' unifdef.c
    sed -i 's/ln -s/ln -sf/' Makefile

    make

    make prefix=/usr DESTDIR="$PKG" install
}
