# Description: Ncurses BitTorrent client based on libTorrent
# URL: https://rakshasa.github.io/rtorrent/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libtorrent curl

name=rtorrent
version=0.16.15
release=1
source=(https://github.com/rakshasa/$name/releases/download/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	autoreconf -fvi

	./configure --prefix=/usr --disable-debug
	make
	make DESTDIR=$PKG install
}