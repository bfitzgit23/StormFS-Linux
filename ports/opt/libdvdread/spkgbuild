# description	: DVD reading library.
# homepage	: https://www.videolan.org/developers/libdvdnav.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libdvdread
version=7.1.1
release=4
source="https://download.videolan.org/pub/videolan/libdvdread/$version/libdvdread-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        --default-library=shared &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build
}
