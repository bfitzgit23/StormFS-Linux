# Description: Midori Web Browser - a lightweight, fast and secure web browser
# URL: https://astian.org/midori-browser
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 alsa-lib dbus-glib nss

name=midori-bin
version=11.6
release=1
source=($name-$version.deb::https://github.com/goastian/midori-desktop/releases/download/v$version/midori_${version}-1_amd64.deb)

build() {
  bsdtar xf $name-$version.deb
  bsdtar xf data.tar.xz -C $PKG/
}