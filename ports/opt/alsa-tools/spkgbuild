# description	: The ALSA Tools package contains advanced tools for certain sound cards.
# homepage	: https://www.alsa-project.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gtk envy24control gtk3

description="The ALSA Tools package contains advanced tools for certain sound cards."
name=alsa-tools
version=1.2.15
release=1
source="https://www.alsa-project.org/files/pub/tools/$name-$version.tar.bz2 install"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


exec ../install
}
