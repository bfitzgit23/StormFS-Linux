# Description: Fast and light imlib2-based image viewer
# URL: https://feh.finalrewind.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: imlib2 curl libpng libx11 libxinerama libexif libxt

name=feh
version=3.12.2
release=1
source=(https://feh.finalrewind.org/feh-$version.tar.bz2)

build() {
	cd $name-$version
	make PREFIX=/usr exif=1 stat64=1 inotify=1
	make PREFIX=/usr DESTDIR=$PKG install
}