# description	: Linux io_uring userspace library
# homepage	: https://github.com/axboe/liburing
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Linux io_uring userspace library"
name=liburing
version=2.15
release=5
# liburing's configure is intentionally minimal and rejects generic
# Autoconf options such as --sysconfdir and --libexecdir.
source="https://github.com/axboe/liburing/archive/refs/tags/liburing-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    ./configure \
        --prefix=/usr \
        --includedir=/usr/include \
        --libdir=/usr/lib \
        --libdevdir=/usr/lib \
        --mandir=/usr/share/man \
        --datadir=/usr/share || return 1

    make || return 1
    make DESTDIR="$PKG" install || return 1
}
