# description	: libjxl package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libjxl
version=0.12.0
release=1
build_opt="-D CMAKE_INSTALL_PREFIX=/usr
      -D CMAKE_BUILD_TYPE=Release
      -D BUILD_TESTING=OFF
      -D BUILD_SHARED_LIBS=ON
      -D JPEGXL_ENABLE_SKCMS=OFF
      -D JPEGXL_ENABLE_SJPEG=OFF
      -D JPEGXL_ENABLE_PLUGINS=ON
      -D JPEGXL_INSTALL_JARDIR=/usr/share/java
      -G Ninja .."
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
