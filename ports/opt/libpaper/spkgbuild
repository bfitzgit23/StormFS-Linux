# description	: Library for handling paper characteristics.
# homepage	: http://packages.qa.debian.org/libp/libpaper.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
# Packager: Jose V Beneyto, sepen at crux dot nu

description="Library for handling paper characteristics."
name=libpaper
version=2.2.8
release=2
source="https://github.com/rrthomas/libpaper/releases/download/v$version/$name-$version.tar.gz"

build() {
	cd "$name-$version" || return 1

  ./configure --prefix=/usr        \
            --sysconfdir=/etc    \
            --disable-static     \
            --enable-relocatable \
            --docdir=/usr/share/doc/$name-$version &&
	  make
  make DESTDIR=$PKG install
}
