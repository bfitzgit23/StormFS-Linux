# Description: An advanced BitTorrent client programmed in C++, based on Qt toolkit and libtorrent-rasterbar
# URL: https://www.qbittorrent.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libtorrent-rasterbar qt6-svg qt6-tools

name=qbittorrent
version=5.2.2
release=1
source=(https://downloads.sourceforge.net/qbittorrent/$name-$version.tar.xz)

build() {

	cmake -S $name-$version -B build -G Ninja \
        	-DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DQT6=ON \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}