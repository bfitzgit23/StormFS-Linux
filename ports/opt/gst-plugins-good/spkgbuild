# description	: A set of good-quality plugins for gstreamer under the LGPL.
# homepage	: https://gstreamer.freedesktop.org/modules/gst-plugins-good.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: aalib alsa-oss gtk3 libdv qt5 speex taglib valgrind v4l-utils wayland hotdoc jack libcaca libavc1394 libiec61883 libraw1394 libshout orc twolame wavpack

description="A set of good-quality plugins for gstreamer under the LGPL."
name=gst-plugins-good
version=1.28.7
release=2
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz gst-plugins-good-1.28.7-qt611-qquickwindow.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
  mkdir build &&
cd    build &&

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/stable/ \
      -Dpackage-name="GStreamer 1.28.7 BFSOS" &&
ninja
  DESTDIR=$PKG ninja install
}
