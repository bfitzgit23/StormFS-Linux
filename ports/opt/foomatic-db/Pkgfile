# Description: OpenPrinting printer support database
# URL: http://www.linuxprinting.org/foomatic.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cups perl perl

name=foomatic-db
version=20260209
release=1
source=($name-$version-$commit.tar.gz::https://github.com/OpenPrinting/foomatic-db/archive/$commit.tar.gz)

build(){
	cd $name-$commit
	./make_configure
	./configure --prefix=/usr \
		--disable-gzip-ppds \
		--disable-ppds-to-cups \
		--with-drivers=NOOBSOLETES,NOEMPTYCMDLINE
	make DESTDIR=$PKG install
   
	# add some docs
	install -Dm644 USAGE $PKG/usr/share/doc/${name}/USAGE
	install -Dm644 README $PKG/usr/share/doc/${ame}/README
}