# Description: A lightweight compositor for X11
# URL: https://github.com/yshui/picom
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: pcre2 libconfig dbus libev libxdg-basedir uthash xcb-util-renderutil xcb-util-image pixman libglvnd

name=picom
version=13
release=1
source=($name-$version.tar.gz::https://github.com/yshui/picom/archive/v$version.tar.gz)

build() {
	meson setup $name-$version build --buildtype=release
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	sed 's/vsync = true/vsync = false/' -i $name-$version/picom.sample.conf
	install -Dm644 $name-$version/picom.sample.conf $PKG/etc/xdg/picom.conf
	install -Dm644 $name-$version/picom.sample.conf $PKG/etc/xdg/picom.conf.example
}