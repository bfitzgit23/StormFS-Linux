# description	: A callback framework for C++.
# homepage	: https://libsigcplusplus.github.io/libsigcplusplus/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A callback framework for C++."
name=libsigc++2
version=2.12.1
release=2
source="https://download.gnome.org/sources/libsigc++/${version%.*}/libsigc++-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  mkdir bld && cd bld

  meson setup .. \
    --prefix=/usr \
    --buildtype=release \
    -D build-documentation=false \
    -D b_lto=true \
    -D b_pie=true

  ninja -j ${JOBS:-1}
  DESTDIR=$PKG ninja install

  find $PKG \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
