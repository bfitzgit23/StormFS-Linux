# description	: Automatic proxy configuration management library
# homepage	: https://libproxy.github.io/libproxy/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Automatic proxy configuration management library"
name=libproxy
version=0.5.12
release=3
source="https://github.com/libproxy/libproxy/archive/refs/tags/$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dtests=false \
        -Ddocs=false || return 1
    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
