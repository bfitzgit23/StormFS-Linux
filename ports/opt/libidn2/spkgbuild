# description	: Provides support for IETF Internationalized Domain Names (IDN)
# homepage	: http://www.gnu.org/software/libidn/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: git gtk-doc

description="Provides support for IETF Internationalized Domain Names (IDN)"
name=libidn2
version=2.3.8
release=2
source="https://ftp.gnu.org/gnu/libidn/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


  ./configure --prefix=/usr --disable-static &&
make
  make DESTDIR=$PKG install
rm -r $PKG/usr/share/{gtk-doc,info}
}
