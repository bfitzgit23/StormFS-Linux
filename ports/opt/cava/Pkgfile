# Description: Console-based Audio Visualizer for ALSA
# URL: https://github.com/karlstav/cava
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: alsa-lib libtool m4 fftw iniparser

name=cava
version=1.0.0
release=1
source=(https://github.com/karlstav/cava/releases/download/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
	make DESTDIR=$PKG install
}