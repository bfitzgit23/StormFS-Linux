# description	: colord package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="colord package"
name=colord
version=1.4.8
release=5
source="https://mirror.freedif.org/pub/blfs/conglomeration/colord/colord-$version.tar.xz disable-udev-hwdb-tests.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    mkdir build &&
    cd build &&

    meson setup .. \
        --prefix=/usr \
        --buildtype=release \
        -Ddaemon_user=colord \
        -Dvapi=true \
        -Dsystemd=false \
        -Dlibcolordcompat=true \
        -Dargyllcms_sensor=false \
        -Dbash_completion=false \
        -Ddocs=false \
        -Dman=false &&

    ninja &&

    DESTDIR="$PKG" ninja install
}
