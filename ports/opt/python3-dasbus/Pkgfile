# Description: DBus library in Python 3
# URL: https://github.com/rhinstaller/dasbus
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: dbus python3-setuptools python3-gobject3

name=python3-dasbus
version=1.7
release=3
source=(dasbus-$version.tar.gz::https://github.com/rhinstaller/dasbus/archive/v${version}.tar.gz)

build() {
	cd dasbus-$version
	python3 setup.py build
	python3 setup.py install --root=$PKG --optimize=1 --skip-build
}