# description	: ruby package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="ruby package"
name=ruby
version=3.4.10
release=1
build_opt="-prefix=/usr
            --disable-rpath
            --enable-shared
            --with-valgrind
            --without-baseruby
            ac_cv_func_qsort_r=no
            --docdir=/usr/share/doc/$name-$version"
source="https://cache.${name}-lang.org/pub/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
