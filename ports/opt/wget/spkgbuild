# description	: Modern multi-threaded file and website downloader based on GNU Wget2.
# homepage	: https://gitlab.com/gnuwget/wget2
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Modern multi-threaded file and website downloader based on GNU Wget2."
name=wget
version=2.2.1
release=2
build_opt=(
    --prefix=/usr
    --sysconfdir=/etc
    --disable-doc
)
source="https://ftp.gnu.org/gnu/wget/wget2-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    ./configure "${build_opt[@]}"

    make
    make DESTDIR="$PKG" install

    # BFS packages Wget2 under the traditional wget port name.
    # Preserve wget2 while also providing /usr/bin/wget.
    if [[ -x "$PKG/usr/bin/wget2" ]]; then
        ln -sf wget2 "$PKG/usr/bin/wget"
        install -d "$PKG/etc"
        cat > "$PKG/etc/wgetrc" <<'EOF'
# BFSOS system trust store. Wget2 reads /etc/wgetrc and otherwise may not
# discover the distro CA bundle on every TLS backend/build configuration.
ca_certificate = /etc/pki/tls/certs/ca-bundle.crt
EOF
    else
        echo "ERROR: wget2 binary was not installed." >&2
        return 1
    fi
    rm -rf \
        "$PKG/usr/share/info" \
        "$PKG/usr/share/doc"

    find "$PKG" -type f -name '*.la' -delete
}
