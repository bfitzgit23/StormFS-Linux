# Description: Intel Media Driver for VAAPI â€” Broadwell+ iGPUs
# URL: https://github.com/intel/media-driver/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja intel-gmmlib libva

name=intel-media-driver
version=26.2.3
release=1
source=(https://github.com/intel/media-driver/archive/${name%-*}-$version.tar.gz)

build() {
	cmake -B build -S ${name#*-}-${name%-*}-${version} -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DINSTALL_DRIVER_SYSCONF=OFF \
		-DMEDIA_BUILD_FATAL_WARNINGS=OFF \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}