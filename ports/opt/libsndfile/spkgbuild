# description	: Library for manipulating sound files
# homepage	: https://libsndfile.github.io/libsndfile/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: speex sqlite

description="Library for manipulating sound files"
name=libsndfile
version=1.2.2
release=3
source="https://github.com/libsndfile/libsndfile/releases/download/$version/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

  CFLAGS="${CFLAGS} -std=gnu17" ./configure --prefix=/usr || return 1
  make || return 1
  make DESTDIR="$PKG" install || return 1

  rm -rf "$PKG/usr/share/doc"
}
