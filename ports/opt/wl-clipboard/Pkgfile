# Description: Wayland clipboard utilities
# URL: https://github.com/bugaevc/wl-clipboard/archive/refs/tags/v2.1.0.tar.gz
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: meson wayland-protocols

name=wl-clipboard
version=2.3.0
release=1
source=($name-$version.tar.gz::https://github.com/bugaevc/$name/archive/refs/tags/v$version.tar.gz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}