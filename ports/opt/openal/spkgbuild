# description	: Cross-platform 3D audio
# homepage	: https://github.com/kcat/openal-soft
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: dbus ffmpeg fluidsynth libsdl2 libsndfile pipewire portaudio pulseaudio qt5

description="Cross-platform 3D audio"
name=openal
version=1.25.2
release=2
source="https://github.com/kcat/openal-soft/archive/$version/openal-soft-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  cmake -S . -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -D ALSOFT_UTILS=ON \
    -D ALSOFT_INSTALL_CONFIG=ON \
    -D ALSOFT_INSTALL_HRTF_DATA=ON \
    -D ALSOFT_INSTALL_UTILS=ON \
    -D ALSOFT_EXAMPLES=OFF

  cmake --build build
  DESTDIR=$PKG cmake --install build
}
