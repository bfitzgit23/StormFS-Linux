# description	: GLib-based library for using and managing the Qualcomm IPC Router (QRTR) bus
# homepage	: https://gitlab.freedesktop.org/mobile-broadband/libqrtr-glib
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gobject-introspection gtk-doc

description="GLib-based library for using and managing the Qualcomm IPC Router (QRTR) bus"
name=libqrtr-glib
version=1.4.0
release=1
source="https://gitlab.freedesktop.org/mobile-broadband/libqrtr-glib/-/archive/$version/libqrtr-glib-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
