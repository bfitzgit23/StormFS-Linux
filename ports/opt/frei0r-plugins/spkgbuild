# description	: Frei0r is a minimalistic plugin API for video effects. Note that the 0 in the name is a zero, not a capital letter o.
# homepage	: https://github.com/dyne/frei0r
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen opencv

description="Frei0r is a minimalistic plugin API for video effects. Note that the 0 in the name is a zero, not a capital letter o."
name=frei0r-plugins
version=3.5.0
release=1
source="https://github.com/dyne/frei0r/archive/refs/tags/v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    mkdir -p build || return 1
    cd build || return 1

    cmake \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DWITHOUT_OPENCV=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -Wno-author \
        .. || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
