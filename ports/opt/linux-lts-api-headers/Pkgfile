# Description: Expose the kernel's API for use by Glibc
# URL: https://www.kernel.org/pub/linux/kernel/v6.x/linux-$version.tar.xz
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=linux-lts-api-headers
version=6.18.37
release=1
source=(https://www.kernel.org/pub/linux/kernel/v${version%%.*}.x/linux-$version.tar.xz)

build() {
	cd linux-$version

	make mrproper
	make headers

	find usr/include -name '.*' -delete
	rm usr/include/Makefile

	mkdir -p $PKG/usr/include
	cp -rv usr/include/* $PKG/usr/include
}