# Description: Include btrfs snapshots in GRUB boot options
# URL: https://github.com/Antynea/grub-btrfs
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: btrfs-progs grub wendy

name=grub-btrfs
version=4.14
release=1
source=($name-$version.tar.gz::https://github.com/Antynea/grub-btrfs/archive/refs/tags/v$version.tar.gz run.grub-btrfs rc.grub-btrfs conf)

build() {
	cd $name-$version

	make DESTDIR=$PKG install

	# remove systemd things
	rm -rf $PKG/usr/lib/systemd
	rm -rf $PKG/usr/share/licenses	

	# runit service
	prt-get isinst runit && {
		install -Dm755 $SRC/run.grub-btrfs $PKG/etc/sv/grub-btrfs/run
		install $SRC/conf $PKG/etc/sv/grub-btrfs/conf
		ln -s /run/runit/supervise.grub-btrfs $PKG/etc/sv/grub-btrfs/supervise
	} || continue
	
	# rc service
	prt-get isinst sysvinit && \
		install -Dm755 $SRC/rc.grub-btrfs $PKG/etc/rc.d/grub-btrfs || continue
}