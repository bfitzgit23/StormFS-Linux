# description	: reimplementation of the SIL Graphite text processing engine.
# homepage	: https://github.com/silnrsi/graphite
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: asciidoc dblatex doxygen graphviz

description="reimplementation of the SIL Graphite text processing engine."
name=graphite2
version=1.3.15
release=1
source="https://github.com/silnrsi/graphite/releases/download/$version/$name-$version.tgz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    # CMake 4 / modern GCC compatibility, following current BLFS guidance.
    sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt || return $?
    sed -i 's/PythonInterp/Python3/' CMakeLists.txt || return $?
    find . -name CMakeLists.txt \
        -exec sed -i 's/VERSION 2\.8\.0 FATAL_ERROR/VERSION 4.0.0/' {} + || return $?
    sed -i '/Font.h/i #include <cstdint>' tests/featuremap/featuremaptest.cpp || return $?

    # Avoid tests requiring optional FontTools during package build.
    sed -i '/cmptest/d' tests/CMakeLists.txt || return $?

    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr || return $?
    cmake --build build -j "${JOBS:-1}" || return $?
    DESTDIR="$PKG" cmake --install build || return $?

    # Never allow graphite2 to register as an empty package again.
    find "$PKG/usr/lib" -maxdepth 1 -name 'libgraphite2.so*' -print -quit | grep -q . || {
        echo "graphite2: staged library missing" >&2
        return 1
    }
    test -f "$PKG/usr/lib/pkgconfig/graphite2.pc" || {
        echo "graphite2: staged pkg-config metadata missing" >&2
        return 1
    }
    test -d "$PKG/usr/include/graphite2" || {
        echo "graphite2: staged headers missing" >&2
        return 1
    }
}
