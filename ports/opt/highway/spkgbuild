# description	: Performance-portable SIMD library
# homepage	: https://github.com/google/highway
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Performance-portable SIMD library"
name=highway
version=1.4.0
release=3
renames=(highway-$version.tar.gz)
source="https://github.com/google/highway/archive/refs/tags/$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DHWY_ENABLE_TESTS=OFF \
        -DHWY_ENABLE_EXAMPLES=OFF || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        cmake --install build || return 1
}
