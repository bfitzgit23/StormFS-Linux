description="hexchat package"
name=hexchat
version=2.16.2
release=1
source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
mkdir build &&
cd    build &&

meson setup ..              \
      --prefix=/usr         \
      --buildtype=release   \
      -Dwith-lua=false      \
      -Dwith-python=false   &&
ninja
DESTDIR=$PKG ninja install
}
