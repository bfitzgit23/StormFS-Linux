# Description: Library for making brushstrokes which is used by MyPaint and other projects
# URL: http://mypaint.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: json-c glib gobject-introspection intltool

name=libmypaint
version=1.6.1
release=1
source=(https://github.com/mypaint/libmypaint/releases/download/v$version/libmypaint-$version.tar.xz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

}