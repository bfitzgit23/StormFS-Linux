# Description: Python bindings for the Linux input subsystem
# URL: https://github.com/gvalkov/python-evdev
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools

name=python3-evdev
version=1.9.3
release=1
source=($name-$version.zip::https://github.com/gvalkov/python-evdev/archive/refs/tags/v$version.tar.gz)

build() {
  cd python-evdev-$version
  python3 setup.py build
  python3 setup.py install --root="$PKG" --optimize=1 --skip-build
}