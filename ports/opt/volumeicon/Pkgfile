# Description: Volume control for your system tray
# URL: https://github.com/Maato/volumeicon
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: alsa-lib libnotify

name=volumeicon
version=0.5.1
release=2
source=($name-$version.tar.gz::https://github.com/Maato/$name/archive/refs/tags/$version.tar.gz)

build() {
	cd $name-$version
	
	autoreconf -fvi
  	./configure --prefix=/usr --enable-notify
	make
	make DESTDIR=$PKG install

}