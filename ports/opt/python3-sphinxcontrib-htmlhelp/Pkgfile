# Description: sphinx extension which renders HTML help files
# URL: https://github.com/sphinx-doc/sphinxcontrib-htmlhelp/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-gpep517 python3-setuptools

name=python3-sphinxcontrib-htmlhelp
version=2.1.0
release=2
source=($name-$version.tar.gz::https://pypi.org/packages/source/s/$_name/$_name-$version.tar.gz)

build() {
	cd $_name-$version

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}