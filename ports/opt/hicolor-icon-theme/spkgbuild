# description	: default fallback used by the icon theme specification
# homepage	: https://www.freedesktop.org/wiki/Software/icon-theme/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="default fallback used by the icon theme specification"
name=hicolor-icon-theme
version=0.18
release=1
source="https://icon-theme.freedesktop.org/releases/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja
DESTDIR=$PKG ninja install
}
