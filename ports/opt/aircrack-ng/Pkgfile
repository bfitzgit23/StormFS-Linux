# Description: Key cracker for the 802.11 WEP and WPA-PSK protocols
# URL: https://www.aircrack-ng.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ethtool iw net-tools openssl sqlite wireless_tools

name=aircrack-ng
version=1.7
release=1
source=($name-$version.tar.gz::https://github.com/aircrack-ng/aircrack-ng/archive/$version.tar.gz)

build() {
	cd $name-$version

	cat > which <<EOF
#!/bin/sh
type -p \$1
EOF

chmod +x which
export PATH=$PATH:$PWD

	CFLAGS="$CFLAGS -fcommon"

	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}