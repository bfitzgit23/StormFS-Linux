# description	: OCR engine used by KDE Spectacle text recognition
# homepage	: https://github.com/tesseract-ocr/tesseract
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="OCR engine used by KDE Spectacle text recognition"
name=tesseract
version=5.5.3
release=5
build_opt="-DBUILD_SHARED_LIBS=ON
-DBUILD_TRAINING_TOOLS=OFF
-DBUILD_TESTS=OFF"
source="https://github.com/tesseract-ocr/tesseract/archive/refs/tags/$version.tar.gz https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata https://github.com/tesseract-ocr/tessdata_fast/raw/main/osd.traineddata"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
        install -d "$PKG/usr/share/tessdata"
        install -m644 "$SRC/eng.traineddata" "$PKG/usr/share/tessdata/"
        install -m644 "$SRC/osd.traineddata" "$PKG/usr/share/tessdata/"

        install -d "$PKG/etc/environment.d"
        printf '%s\n' 'TESSDATA_PREFIX=/usr/share' \
                > "$PKG/etc/environment.d/10-tesseract.conf"
}
