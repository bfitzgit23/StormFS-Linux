# description	: DVD Navigation library.
# homepage	: https://www.videolan.org/developers/libdvdnav.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="DVD Navigation library."
name=libdvdnav
version=7.0.0
release=3
source="https://download.videolan.org/pub/videolan/libdvdnav/$version/libdvdnav-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        --default-library=shared &&

    meson compile -C build -j ${JOBS:-1} &&

    DESTDIR="$PKG" meson install -C build
}
