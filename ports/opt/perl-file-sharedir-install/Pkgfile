# Description: File::ShareDir::Install - Install read-only data files from a distribution
# URL: https://search.cpan.org/dist/File-ShareDir-Install
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=perl-file-sharedir-install
version=0.14
release=1
source=($name-$version.tar.gz::https://cpan.org/modules/by-module/File/File-ShareDir-Install-$version.tar.gz)

build() {
	cd File-ShareDir-Install-$version
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}