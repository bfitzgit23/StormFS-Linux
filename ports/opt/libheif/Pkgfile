# Description: Description: library for fast image processing
# URL: https://github.com/strukturag/libheif/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja x265 dav1d aom

name=libheif
version=1.23.1
release=1
source=(https://github.com/strukturag/$name/releases/download/v$version/$name-$version.tar.gz)

build() {
	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_DISABLE_FIND_PACKAGE_SDL2=ON \
		-DWITH_GDK_PIXBUF=OFF \
		-DWITH_EXAMPLE_HEIF_THUMB=OFF \
		-DWITH_X264=OFF \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}