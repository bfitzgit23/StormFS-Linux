# description	: Audio processing library for changing tempo, pitch and playback rates.
# homepage	: https://codeberg.org/soundtouch/soundtouch
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Audio processing library for changing tempo, pitch and playback rates."
name=soundtouch
version=2.4.1
release=2
renames=($name-$version.tar.gz)
source="https://codeberg.org/$name/$name/archive/$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./bootstrap &&
./configure --prefix=/usr \
            --docdir=/usr/share/doc/soundtouch-$version &&
make
	DESTDIR=$PKG make install
}
