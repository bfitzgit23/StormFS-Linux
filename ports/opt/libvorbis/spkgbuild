# description	: Vorbis codec library
# homepage	: https://www.xiph.org/vorbis/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen texlive install-tl-unx

description="Vorbis codec library"
name=libvorbis
version=1.3.7
release=1
source="https://downloads.xiph.org/releases/vorbis/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  ./configure --prefix=/usr --disable-static &&
make
  make DESTDIR=$PKG install

  install -v -m644 doc/Vorbis* $PKG/usr/share/doc/$name-$version
}
