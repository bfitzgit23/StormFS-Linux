# description	: Fast JSON parser and generator for C++
# homepage	: https://github.com/Tencent/rapidjson
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Fast JSON parser and generator for C++"
name=rapidjson
version=20250205.24b5e7a
_commit=24b5e7a8b27f42fa16b96fc70aade9106cf7102f
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DRAPIDJSON_BUILD_DOC=OFF
           -DRAPIDJSON_BUILD_EXAMPLES=OFF
           -DRAPIDJSON_BUILD_TESTS=OFF
           -DCMAKE_POLICY_VERSION_MINIMUM=3.5"
source="https://github.com/Tencent/rapidjson/archive/$_commit/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
