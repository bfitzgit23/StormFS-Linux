name=uhttpmock
version=0.11.0
release=1
build_opt="--prefix=/usr
      --buildtype=release
      -D gtk_doc=false "
source="https://tecnocode.co.uk/downloads/${name}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
