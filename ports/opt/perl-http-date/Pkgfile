# Description: Perl module date conversion routines
# URL: https://metacpan.org/pod/HTTP::Date
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl

name=perl-http-date
version=6.07
release=1
source=($name-$version.tar.gz::https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTTP-Date-$version.tar.gz)

build() {
        cd HTTP-Date-$version
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install

}