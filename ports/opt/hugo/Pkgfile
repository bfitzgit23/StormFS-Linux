# Description: Fast and Flexible Static Site Generator in Go
# URL: https://gohugo.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: go

name=hugo
version=0.163.3
release=1
source=(https://github.com/gohugoio/$name/archive/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	go build -tags extended,withdeploy
	install -Dm755 $name $PKG/usr/bin/$name
}