# Description: An ISO 8601 date/time/duration parser and formatter
# URL: https://github.com/gweis/isodate/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools python3-gpep517 python3-wheel

name=python3-isodate
version=0.7.2
release=1
source=($name-$version.tar.gz::https://files.pythonhosted.org/packages/source/i/isodate/isodate-$version.tar.gz)

build() {
	cd isodate-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl

}