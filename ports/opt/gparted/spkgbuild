# description	: Gparted is the Gnome Partition Editor, a Gtk 3 GUI for other command line tools that can create, reorganise or delete disk partitions.
# homepage	: https://downloads.sourceforge.net/gparted/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Gparted is the Gnome Partition Editor, a Gtk 3 GUI for other command line tools that can create, reorganise or delete disk partitions."
name=gparted
version=1.8.1
release=1
source="https://downloads.sourceforge.net/gparted/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr    \
            --disable-doc    \
            --disable-static &&
	make DESTDIR=$PKG install
}
