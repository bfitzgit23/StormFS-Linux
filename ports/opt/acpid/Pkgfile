# Description: Extensible daemon for delivering ACPI events
# URL: https://sourceforge.net/projects/acpid2/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: bash

name=acpid
version=2.0.34
release=3
source=(https://downloads.sourceforge.net/acpid2/$name-$version.tar.xz rc.$name run.acpid)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install


	install -v -m755 -d $PKG/etc/acpi/events

cat > $PKG/etc/acpi/events/lid << "EOF"
event=button/lid
action=/etc/acpi/lid.sh
EOF

cat > $PKG/etc/acpi/lid.sh << "EOF"
#!/bin/sh
/bin/grep -q open /proc/acpi/button/lid/LID/state && exit 0
/usr/sbin/pm-suspend
EOF
	chmod +x $PKG/etc/acpi/lid.sh

	# runit service
	prt-get isinst runit && {
		install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue

	# rc service
	prt-get isinst sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
}