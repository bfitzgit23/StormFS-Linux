# description	: ACPI event daemon
# homepage	: https://sourceforge.net/projects/acpid2/
# maintainer	: BFSOS maintainers

description="ACPI event daemon"
name=acpid
version=2.0.34
release=1
source="https://downloads.sourceforge.net/acpid2/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure --prefix=/usr --sbindir=/usr/sbin --sysconfdir=/etc || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
    install -d -m 0755 "$PKG/etc/acpi/events"
}
