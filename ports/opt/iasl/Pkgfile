# Description: Intel ACPI Source Language compiler
# URL: https://github.com/acpica
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=iasl
version=20251212
release=2
source=($name-$version.tar.gz::https://github.com/acpica/acpica/releases/download/$version/acpica-unix-$version.tar.gz)

build() {
	cd acpica-unix-$version
	export CFLAGS="$CFLAGS -Wno-dangling-pointer"
	NOWERROR=TRUE make
	make DESTDIR=$PKG install
}