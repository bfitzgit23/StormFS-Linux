# Description: PEP 621 metadata parsing
# URL: https://github.com/FFY00/python-pyproject-metadata
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-flit-core python3-gpep517

name=python3-pyproject-metadata
version=0.11.0
release=1
source=(https://pypi.org/packages/source/p/pyproject_metadata/pyproject_metadata-$version.tar.gz)

build() {
  cd pyproject_metadata-$version

	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
}