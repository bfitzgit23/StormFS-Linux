# description	: Common error codes and messages used by GnuPG and related software.
# homepage	: https://www.gnupg.org/software/libgpg-error/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Common error codes and messages used by GnuPG and related software."
name=libgpg-error
version=1.61
release=3
build_opt="--prefix=/usr"
source="https://distfiles.icmpv6.org/distfiles/$name-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
    install -Dm644 README \
        "$PKG/usr/share/doc/$name-$version/README"

    # BFSOS does not package GNU info pages.
    rm -rf "$PKG/usr/share/info"
}
