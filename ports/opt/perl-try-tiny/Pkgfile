# Description: Minimal try/catch with proper localization of $@
# URL: https://search.cpan.org/dist/Try-Tiny
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl

name=perl-try-tiny
version=0.32
release=1
source=($name-$version.tar.gz::https://cpan.metacpan.org/authors/id/E/ET/ETHER/Try-Tiny-$version.tar.gz)

build() {
        cd Try-Tiny-$version
	perl -I. Makefile.PL INSTALLDIRS=vendor
        make
        make DESTDIR=$PKG install

}