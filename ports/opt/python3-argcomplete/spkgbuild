# description	: Bash and Zsh tab completion for Python argparse
# homepage	: https://github.com/kislyuk/argcomplete
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Bash and Zsh tab completion for Python argparse"
name=python3-argcomplete
version=3.7.1
release=1
source="https://files.pythonhosted.org/packages/source/a/argcomplete/argcomplete-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "argcomplete-3.7.1" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    /usr/bin/pip3 wheel \
        --no-deps \
        --no-build-isolation \
        . -w dist || return 1

    /usr/bin/pip3 install \
        --no-deps \
        --no-index \
        --no-cache-dir \
        --root="$PKG" \
        --prefix=/usr \
        dist/*.whl || return 1
}
