# Description: GNU EFI library
# URL: https://sourceforge.net/projects/gnu-efi/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=gnu-efi
version=4.0.4
release=1
source=(https://github.com/ncroxon/gnu-efi/archive/$version/$name-$version.tar.gz)

build() {
	unset LDFLAGS
	cd $name-$version
	make
	make INSTALLROOT=$PKG PREFIX=/usr install
}