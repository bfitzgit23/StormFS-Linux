# description	: power-profiles-daemon package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gtk-doc dbusmock umockdev

description="power-profiles-daemon package"
name=power-profiles-daemon
version=0.30
release=1
build_opt="--prefix=/usr
      --buildtype=release
      -Dgtk_doc=false
      -Dtests=false"
source="https://gitlab.freedesktop.org/upower/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
