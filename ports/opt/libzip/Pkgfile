# Description: A C library for reading, creating, and modifying zip archives
# URL: https://libzip.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja zlib bzip2 openssl gnutls

name=libzip
version=1.11.4
release=1
source=(https://libzip.org/download/${name}-${version}.tar.xz)

build() {
	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	if [prt-get isinst openjdk-bin] || [prt-get isinst openjdk-17-bin]; then
		rm -rf $PKG/usr/lib/libzip.so
	fi
}