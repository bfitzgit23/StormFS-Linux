# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="subversion package"
name=subversion
version=1.14.5
release=1
source="https://archive.apache.org/dist/${name}/${name}-${version}.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
./configure --prefix=/usr            \
            --disable-static         \
            --with-apache-libexecdir \
            --with-utf8proc=internal &&
make -j1
make -j1 DESTDIR=$PKG install &&

install -v -m755 -d $PKG/usr/share/doc/$name-$version &&
cp      -v -R doc/* $PKG/usr/share/doc/$name-$version
}
