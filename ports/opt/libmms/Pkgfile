# Description: MMS stream protocol library
# URL: https://sourceforge.net/projects/libmms/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=libmms
version=0.6.4
release=1
source=(https://download.sourceforge.net/libmms/${name}-${version}.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}