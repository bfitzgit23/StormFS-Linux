# description	: A library for CD-ROM and CD image access.
# homepage	: http://www.gnu.org/software/libcdio/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libcddb

description="A library for CD-ROM and CD image access."
name=libcdio
version=2.1.0
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr --disable-static &&
make
DESTDIR=$PKG make install
rm -r $PKG/usr/share/info
}
