# description	: Fraunhofer Advanced Audio Coding, extracted from the Android Open Source Project
# homepage	: https://sourceforge.net/projects/opencore-amr/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Fraunhofer Advanced Audio Coding, extracted from the Android Open Source Project"
name=fdk-aac
version=2.0.3
release=2
source="https://downloads.sourceforge.net/project/opencore-amr/$name/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
