# Description: Daemon for virtual console terminals
# URL: https://packages.debian.org/sid/ngetty
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=ngetty
version=1.1.10
release=1
source=(http://salsa.debian.org/debian/ngetty/-/archive/debian/${_version}/$name-debian-${_version}.tar.gz Conf)

build() {
	cd $name-debian-${_version}
	cp $SRC/Conf .	
	make
	make DESTDIR=$PKG install
	rm -f $PKG/etc/ngetty/sample.Conf
}