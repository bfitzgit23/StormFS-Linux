# description	: A collection of freely re-usable Autoconf macros
# homepage	: https://www.gnu.org/software/autoconf-archive/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="A collection of freely re-usable Autoconf macros"
name=autoconf-archive
version=2024.10.16
release=1
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  ./configure --prefix=/usr
  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/share/{doc,info}
  rm $PKG/usr/share/aclocal/ax_check_enable_debug.m4
  rm $PKG/usr/share/aclocal/ax_code_coverage.m4
}
