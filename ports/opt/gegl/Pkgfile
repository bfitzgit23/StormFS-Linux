# Description: GEneric Graphics Library, a graph based image processing format
# URL: https://www.gegl.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: babl json-glib graphviz

name=gegl
version=0.4.70
release=1
source=(https://download.gimp.org/pub/gegl/${version%.*}/$name-$version.tar.xz)

build() {
	meson setup $name-$version build -Ddocs=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}