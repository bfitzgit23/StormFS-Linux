# Description: GTK+3 implementation of wxWidgets API for GUI
# URL: https://www.wxwidgets.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: nanosvg webkitgtk

name=wxgtk3
version=3.2.10
release=1
source=($name-$version.tar.gz::https://github.com/wxWidgets/wxWidgets/archive/refs/tags/v$version.tar.gz)

build() {
	cmake -B build -S wxWidgets-$version \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DwxBUILD_PRECOMP=OFF \
		-DwxBUILD_TOOLKIT=gtk3 \
		-DwxBUILD_TESTS=OFF \
		-DwxUSE_OPENGL=ON \
		-DwxUSE_REGEX=sys\
		-DwxUSE_ZLIB=sys \
		-DwxUSE_EXPAT=sys \
		-DwxUSE_LIBJPEG=sys \
		-DwxUSE_LIBPNG=sys \
		-DwxUSE_LIBTIFF=sys \
		-DwxUSE_LIBLZMA=sys \
		-DwxUSE_NANOSVG=sys \
		-DwxUSE_LIBMSPACK=ON \
		-DwxUSE_PRIVATE_FONTS=ON \
		-DwxUSE_GTKPRINT=ON \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}