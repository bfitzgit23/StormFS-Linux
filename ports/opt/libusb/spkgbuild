# description	: Library giving userland programs access to USB devices
# homepage	: https://libusb.info
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Library giving userland programs access to USB devices"
name=libusb
version=1.0.30
release=2
source="https://github.com/libusb/libusb/releases/download/v$version/$name-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
