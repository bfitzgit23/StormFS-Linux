# description	: Library giving userland programs access to USB devices
# homepage	: https://libusb.info
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libusb
version=1.0.30
release=2
source="https://github.com/libusb/libusb/releases/download/v$version/$name-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
