# description	: A library implementing the SSH2 protocol as defined by Internet Drafts
# homepage	: https://www.libssh2.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: cmake libcrypt openssh docker

description="A library implementing the SSH2 protocol as defined by Internet Drafts"
name=libssh2
version=1.11.1
release=1
source="https://www.libssh2.org/download/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  ./configure --prefix=/usr \
    --disable-static
  make
  make DESTDIR=$PKG install
}
