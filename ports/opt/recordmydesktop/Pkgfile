# Description: Produces a OGG encapsulated Theora/Vorbis recording of your desktop
# URL: https://github.com/Enselic/recordmydesktop/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxdamage libxext libtheora jack

name=recordmydesktop
version=0.4.0
release=1
source=(https://github.com/Enselic/$name/releases/download/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr --enable-jack=yes LIBS="`pkg-config --libs jack`" \
		CFLAGS="`pkg-config --cflags jack` -DHAVE_LIBJACK"
	make
	make DESTDIR=$PKG install
}