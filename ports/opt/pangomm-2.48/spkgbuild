# description	: C++ interface to pango
# homepage	: https://gitlab.gnome.org/GNOME/pangomm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ interface to pango"
name=pangomm-2.48
version=2.56.2
release=3
source="https://ftp.gnome.org/pub/GNOME/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  meson setup build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true
  meson compile -C build
  DESTDIR=$PKG meson install -C build
}
