#!/sbin/openrc-run
name="sshd"
description="OpenSSH daemon"
command="/usr/sbin/sshd"
command_args="-D"
command_background=true
pidfile="/run/sshd.pid"
required_files="/etc/ssh/sshd_config"

depend() {
    need localmount
    after bootmisc modules
    use net logger dns
}

start_pre() {
    # Privilege-separation directory must exist before sshd drops
    # privileges; host keys are generated on first start, mirroring the
    # ssh-keygen -A guard used by the openssh port's sshd.run.
    checkpath -d -m 0700 -o root:root /var/lib/sshd || return 1
    ssh-keygen -A >/dev/null 2>&1 || return 1
}
