#!/sbin/openrc-run
description="Apply pending BFSOS kernel configuration updates"

start() {
    # Same condition as bfs-kernel-finalize.service: only run when a
    # pending kernel-state marker exists.
    set -- /var/lib/bfsos/kernel-state/*/pending
    [ -e "$1" ] || return 0

    ebegin "Finalizing pending BFSOS kernel updates"
    /usr/libexec/bfs-kernel-maintenance finalize-boot
    eend $?
}

depend() {
    need localmount
    after bootmisc modules
}
