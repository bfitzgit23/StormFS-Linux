# Description: BFSOS OpenRC service scripts
# URL: https://github.com/OpenRC/openrc
# Maintainer: BFSOS maintainers
# Depends: openrc dbus networkmanager acpid bluez gpm

name=openrc-init-scripts
version=1
release=1
source=(
    networkmanager
    acpid
    bluetooth
    dbus
    gpm
)

pkg_build() {
    install -d -m 0755 "$PKG/etc/init.d"
    for service in $source; do
        install -m 0755 "$service" "$PKG/etc/init.d/$service" || return 1
    done
}
