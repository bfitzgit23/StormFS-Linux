# Description: BFSOS OpenRC service scripts
# URL: https://github.com/OpenRC/openrc
# Maintainer: BFSOS maintainers
# Depends: openrc dbus networkmanager acpid bluez gpm chrony pipewire wireplumber
# Optional: cups openssh samba avahi

name=openrc-init-scripts
version=3
release=1
source=(
    networkmanager
    acpid
    bluetooth
    dbus
    gpm
    chronyd
    cups
    sshd
    samba
    avahi-daemon
    pipewire.desktop
    pipewire-pulse.desktop
    wireplumber.desktop
)

pkg_build() {
    install -d -m 0755 "$PKG/etc/init.d" \
                      "$PKG/etc/xdg/autostart" || return 1

    # SysV-style daemon services live in /etc/init.d.  Optional services
    # (cups, sshd, samba, avahi-daemon) install their scripts unconditionally;
    # they are only enabled by an admin or by the installer service list, and
    # fail cleanly when the matching package is not installed.
    for service in networkmanager acpid bluetooth dbus gpm chronyd \
                   cups sshd samba avahi-daemon; do
        install -m 0755 "$service" "$PKG/etc/init.d/$service" || return 1
    done

    # PipeWire session stack is per-user; without a per-user service manager
    # it is launched by the desktop session from XDG autostart (as documented
    # by LFS/BLFS and the Gentoo OpenRC wiki).
    for entry in pipewire.desktop pipewire-pulse.desktop wireplumber.desktop; do
        install -m 0644 "$entry" "$PKG/etc/xdg/autostart/$entry" || return 1
    done
}
