# description	: bogofilter package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=bogofilter
version=1.2.5
release=1
build_opt="--prefix=/usr
            --sysconfdir=/etc/bogofilter
            --with-database=sqlite3 "
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
