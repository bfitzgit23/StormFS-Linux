# Description: A fast and easy-to-use status bar
# URL: https://github.com/polybar/polybar
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake cairo xcb-util-image xcb-util-wm python3-sphinx python3-babel

name=polybar
version=3.7.2
release=2
source=(https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz polybar-3.7.2-fontconfig.patch polybar-3.7.2-gcc15-cstdint-includes.patch)

build() {
	
	patch -d $name-$version -Np1 -i $SRC/polybar-3.7.2-fontconfig.patch

	patch -d $name-$version -Np1 -i $SRC/polybar-3.7.2-gcc15-cstdint-includes.patch

	cmake $name-$version -B build -G Ninja \
		 -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DPYTHON_EXECUTABLE=/usr/bin/python3 \
		-Wno-dev
	 cmake --build build
	 DESTDIR=$PKG cmake --install build
}