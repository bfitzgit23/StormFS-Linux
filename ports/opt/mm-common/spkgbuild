# description	: Common build files of the C++ bindings.
# homepage	: https://gtkmm.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Common build files of the C++ bindings."
name=mm-common
version=1.0.8
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true
	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install -C build

	rm -r $PKG/usr/share/doc
}
