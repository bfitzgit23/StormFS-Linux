# Description: A GTK2 based configuration tool for the Openbox windowmanager
# URL: http://www.openbox.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libglade openbox startup-notification desktop-file-utils gtk2 libsm

name=obconf
version=2.0.4
release=2
source=(http://www.openbox.org/dist/$name/$name-$version.tar.gz)

build() {
	cd $name-$version
	export CFLAGS="$CFLAGS -Wno-implicit-function-declaration"
	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}