# description	: CD paranoia libraries from libcdio
# homepage	: https://github.com/rocky/libcdio-paranoia
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="CD paranoia libraries from libcdio"
name=libcdio-paranoia
version=10.2+2.0.2
release=1
source="https://ftp.gnu.org/gnu/libcdio/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install

	rm -rf "$PKG/usr/share/man/ja"
}
