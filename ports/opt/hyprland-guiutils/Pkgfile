# Description: Hyprland GUI utilities
# URL: https://github.com/hyprwm/hyprland-qtutils
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: hyprutils qt6-wayland hyprtoolkit

name=hyprland-guiutils
version=0.2.1
release=1
source=(https://github.com/hyprwm/$name/archive/v$version/$name-$version.tar.gz)

build() {
	cmake -S $name-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}