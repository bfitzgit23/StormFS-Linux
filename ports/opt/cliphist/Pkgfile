# Description: wayland clipboard manager
# URL: https://github.com/sentriz/cliphist
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: go wl-clipboard xdg-utils

name=cliphist
version=0.7.0
release=1
source=(https://github.com/sentriz/cliphist/archive/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	export CGO_CPPFLAGS="$CPPFLAGS"
	export CGO_CFLAGS="$CFLAGS"
	export CGO_CXXFLAGS="$CXXFLAGS"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

	go build -ldflags "-linkmode external -extldflags '$LDFLAGS'" -o $name
	install -Dm0755 -t $PKG/usr/bin/ $name
}