# description	: libclc package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libclc package"
name=libclc
version=23.1.1
release=8
source="https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    rm -rf build build-spirv32-unknown-unknown build-spirv64-unknown-unknown

    cmake -S llvm -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_ENABLE_PROJECTS=clang \
        -DLLVM_RUNTIME_TARGETS="spirv32-unknown-unknown;spirv64-unknown-unknown" \
        -DRUNTIMES_spirv32-unknown-unknown_LLVM_ENABLE_RUNTIMES=libclc \
        -DRUNTIMES_spirv64-unknown-unknown_LLVM_ENABLE_RUNTIMES=libclc \
        || return 1

    ninja -C build -j "${JOBS:-1}" \
        runtimes-spirv32-unknown-unknown \
        runtimes-spirv64-unknown-unknown \
        || return 1

    DESTDIR="$PKG" \
        cmake -P build/runtimes/cmake_install.cmake \
        || return 1

    # Mesa 26 loads the flat spirv*-mesa3d-.spv names, but Clang no
    # longer accepts mesa3d as a SPIR-V OS. Build the generic physical
    # targets and install them under the names Mesa expects.
    for target in spirv32-unknown-unknown spirv64-unknown-unknown; do
        bdir="build-$target"

        # CMake's CLC language otherwise inherits CC, which is the
        # ccache-wrapped GCC here and cannot compile OpenCL C.
        cmake -S libclc -B "$bdir" \
            -G Ninja \
            -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_BUILD_TYPE=Release \
            -DLLVM_DIR=/usr/lib/cmake/llvm \
            -DLLVM_TOOLS_BINARY_DIR=/usr/bin \
            -DCMAKE_CLC_COMPILER=/usr/bin/clang \
            -DLLVM_DEFAULT_TARGET_TRIPLE="$target" \
            || return 1

        cmake --build "$bdir" -j "${JOBS:-1}" \
            || return 1

        DESTDIR="$PKG" cmake --install "$bdir" \
            || return 1

        case "$target" in
            spirv32-unknown-unknown) mesa_name=spirv-mesa3d- ;;
            spirv64-unknown-unknown) mesa_name=spirv64-mesa3d- ;;
        esac

        install -Dm644 "$bdir/$target/libclc.spv" \
            "$PKG/usr/share/clc/$mesa_name.spv" \
            || return 1
    done

    install -d "$PKG/usr/share/pkgconfig"

    cat > "$PKG/usr/share/pkgconfig/libclc.pc" <<'PC_EOF'
prefix=/usr
libdir=${prefix}/lib
libexecdir=${prefix}/share/clc
clang_resource_dir=${libdir}/clang/23

Name: libclc
Description: LLVM OpenCL C device libraries
Version: 23.1.1
PC_EOF
}
