name=tree
version=2.3.2
release=1
source=(https://gitlab.com/OldManProgrammer/unix-tree/-/archive/$version/unix-tree-$version.tar.gz)

build() {
	cd unix-$name-$version

  	make
	make PREFIX=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install
}