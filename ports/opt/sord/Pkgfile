# Description: sord lihgtweight C library for sorting RDF statements in memory
# URL: https://github.com/drobilla/sord
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: serd zix

name=sord
version=0.16.22
release=1
source=(https://download.drobilla.net/$name-$version.tar.xz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}