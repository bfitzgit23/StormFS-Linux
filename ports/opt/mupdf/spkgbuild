# description	: Lightweight PDF and XPS viewer
# homepage	: https://www.mupdf.com/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: freeglut openjpeg2 jbig2dec gumbo-parser

name=mupdf
version=1.28.3
release=1
source="https://mupdf.com/downloads/archive/$name-$version-source.tar.gz"

build() {
	cd "$name-$version" || return 1

	BFS_MUPDF="USE_SYSTEM_LIBS=yes"

	scratch isinstalled freeglut || BFS_MUPDF+=" USE_SYSTEM_GLUT=no"
	scratch isinstalled openjpeg2 || BFS_MUPDF+=" USE_SYSTEM_OPENJPEG=no"
	scratch isinstalled jbig2dec || BFS_MUPDF+=" USE_SYSTEM_JBIG2DEC=no"
	scratch isinstalled gumbo-parser || BFS_MUPDF+=" USE_SYSTEM_GUMBO=no"

	make install $BFS_MUPDF\
		prefix=$PKG/usr \
		mandir=$PKG/usr/share/man \
		XCFLAGS="-fpic -fcommon"

	ln -s mupdf-gl $PKG/usr/bin/mupdf
	rm -r $PKG/usr/share/doc
}
