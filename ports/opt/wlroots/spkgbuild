# description	: Modular Wayland compositor library
# homepage	: https://gitlab.freedesktop.org/wlroots/wlroots
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Modular Wayland compositor library"
name=wlroots
version=0.20.2
release=2
source="https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/${version}/downloads/${name}-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dexamples=false \
        -Dbackends=drm,libinput \
        -Drenderers=gles2 \
        -Dsession=enabled \
        -Dlibliftoff=enabled \
        -Dxwayland=disabled || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
