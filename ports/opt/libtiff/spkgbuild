# description	: Library for manipulation of TIFF (Tag Image File Format) images
# homepage	: http://www.simplesystems.org/libtiff
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: freeglut libjpeg-turbo sphinx libwebp JBIG-KITLERC

name=libtiff
version=4.7.2
release=3
source="https://download.osgeo.org/libtiff/tiff-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
	mkdir -p libtiff-build &&
	cd       libtiff-build &&

cmake \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/libtiff-$version \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -G Ninja .. &&
ninja
	DESTDIR=$PKG ninja install
}
