# description	: An EXIF tag parsing library
# homepage	: https://libexif.github.io/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen graphviz

description="An EXIF tag parsing library"
name=libexif
version=0.6.26
release=1
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr    \
            --disable-static \
            --with-doc-dir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
