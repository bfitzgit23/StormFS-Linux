# description	: A stream oriented C library for parsing XML
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=expect
version=5.45.4
release=1
source="https://prdownloads.sourceforge.net/$name/$name$version.tar.gz expect-5.45.4-gcc15-1.patch"

build() {
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	local tkflags=''

	scratch isinstalled tk && tkflags='
		--with-tk=/usr/lib
		--with-tkinclude=/usr/include
	'



	./configure --prefix=/usr           \
            --with-tcl=/usr/lib     \
            --enable-shared         \
            --disable-rpath         \
            --mandir=/usr/share/man \
            --with-tclinclude=/usr/include \
	            $tkflags
	make
	make DESTDIR=$PKG install
}
