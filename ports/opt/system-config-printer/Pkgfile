# Description: Graphical user interface for CUPS administration
# URL: https://github.com/OpenPrinting/system-config-printer
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: desktop-file-utils libnotify libsecret python3-dbus python3-gobject3 python3-pycups python3-pycurl

name=system-config-printer
version=1.5.18
release=6
source=(https://github.com/OpenPrinting/system-config-printer/releases/download/v$version/${name}-$version.tar.xz)

build() {
	export XML_CATALOG_FILES=/etc/xml/catalog

	cd $name-$version

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--with-cups-serverbin-dir=/usr/lib/cups \
		--with-systemdsystemunitdir=no \
		--with-udevdir=/usr/lib/udev \
		--with-udev-rules  \
		--with-xmlto
	make
	make DESTDIR=$PKG install

}