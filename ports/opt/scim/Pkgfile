# Description: Input method user interface and development platform
# URL: https://github.com/scim-im/scim
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 libtool

name=scim
version=1.4.18
release=1
source=($name-$version.tar.gz::https://github.com/scim-im/scim/archive/$version.tar.gz)

build() {
	cd $name-$version
        ./bootstrap
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}