# description	: Core NetworkManager daemon, nmcli, nm-online and nmtui
# homepage	: https://networkmanager.dev/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bluez dbus-python gnutls gtk-doc jansson libaudit libbpf libnvme libteam modemmanager upower valgrind dnsmasq firewalld

description="Core NetworkManager daemon, nmcli, nm-online and nmtui"
name=networkmanager
version=1.58.1
release=5
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    grep -rl '^#!.*python$' . |
        xargs -r sed -i '1s/python$/python3/' || return 1

    # Keep NM-1.0.gir installed for libnma and other introspection consumers.
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dlibaudit=no \
        -Dnmtui=true \
        -Dovs=false \
        -Dppp=false \
        -Dnbft=false \
        -Dselinux=false \
        -Dqt=false \
        -Dsession_tracking=no \
        -Dsession_tracking_consolekit=true \
        -Dsuspend_resume=consolekit \
        -Dsystemd_journal=false \
        -Dsystemdsystemunitdir=no \
        -Dsystemdsystemgeneratordir=no \
        -Dnm_cloud_setup=false \
        -Dclat=false \
        -Dmodem_manager=false \
        -Dintrospection=true \
        -Dvapi=false \
        -Ddocs=false || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" meson install -C build || return 1

    install -d "$PKG/etc/NetworkManager/conf.d" || return 1

    cat > "$PKG/etc/NetworkManager/NetworkManager.conf" <<'EOC'
[main]
plugins=keyfile
EOC
}
