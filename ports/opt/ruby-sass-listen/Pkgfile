# Description: Listens to file modifications and notifies you about the changes
# URL: https://github.com/sass/listen
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ruby-rb-inotify

name=ruby-sass-listen
version=4.0.0
release=2
source=(https://rubygems.org/downloads/${name#*-}-$version.gem)

build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}