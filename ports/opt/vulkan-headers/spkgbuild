# description	: vulkan-headers package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="vulkan-headers package"
name=vulkan-headers
version=1.4.357.0
# Keep this cache name package-specific: Vulkan-Loader publishes the same
# vulkan-sdk-${version}.tar.gz basename and scratchpkg keys sources by filename.
release=4
source="${name}-${version}.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-${version}.tar.gz"
# Drop a manifest written for the old shared cache filename; pkgbuild will
# regenerate it for the package-specific source name above.
if [ -f .checksums ] && ! grep -q "[[:space:]]${name}-${version}[.]tar[.]gz$" .checksums; then
    rm -f .checksums
fi

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
