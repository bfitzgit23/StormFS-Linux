# description	: C++ interface to pango.
# homepage	: https://gitlab.gnome.org/GNOME/pangomm
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ interface to pango."
name=pangomm
version=2.46.5
release=4
build_opt=(
  -Dbuild-documentation=false
)
source="https://ftp.gnome.org/pub/GNOME/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
