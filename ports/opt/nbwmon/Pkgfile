# Description: Ncurses bandwidth monitor
# URL: https://github.com/causes-/nbwmon
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ncurses

name=nbwmon
version=0.5.2
release=1
source=($name-$version.tar.gz::https://github.com/causes-/$name/archive/$version.tar.gz)

build() {
	cd $name-$version

	make
    	make DESTDIR=$PKG \
        	PREFIX=/usr \
        	install
}