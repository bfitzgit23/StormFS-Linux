# Description: Plugins for additional image formats: TIFF, MNG, TGA, WBMP
# URL: https://www.qt.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: jasper libmng libwebp qt6-base

name=qt6-imageformats
version=6.11.1
release=1
source=($name-$version.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtimageformats-everywhere-src-$version.tar.xz fix.build.patch)

build() {

	patch -Np1 -d qtimageformats-everywhere-src-$version -i $SRC/fix.build.patch

	cmake -S qtimageformats-everywhere-src-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D QT_USE_CCACHE=$(prt-get isinst ccache && printf "ON" || printf "OFF") \
		-D INSTALL_PUBLICBINDIR=usr/bin
	cmake --build build
	DESTDIR=$PKG cmake --install build
}