# description	: Exiv2 is a C++ library and a command line utility for managing image and video metadata.
# homepage	: https://github.com/Exiv2/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libssh doxygen graphviz libxslt

name=exiv2
version=0.28.9
release=1
source="https://github.com/$name/$name/archive/v$version/$name-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
mkdir build &&
cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr  \
      -DCMAKE_BUILD_TYPE=Release   \
      -DEXIV2_ENABLE_VIDEO=yes     \
      -DEXIV2_ENABLE_WEBREADY=yes  \
      -DEXIV2_ENABLE_CURL=yes      \
      -DEXIV2_BUILD_SAMPLES=no     \
      -G "Unix Makefiles" .. &&
make
make DESTDIR=$PKG install
}
