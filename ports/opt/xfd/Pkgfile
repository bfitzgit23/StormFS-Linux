# Description: Displays all the characters in a font using either the X11 core protocol or libXft2
# URL: https://xorg.freedesktop.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxaw libxft util-macros libxkbfile

name=xfd
version=1.1.5
release=1
source=(https://xorg.freedesktop.org/archive/individual/app/$name-$version.tar.xz)

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}