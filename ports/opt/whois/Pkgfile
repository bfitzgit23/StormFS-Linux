# Description: Intelligent WHOIS client
# URL: https://github.com/rfc1036/whois
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libidn2 libxcrypt bash-completion

name=whois
version=5.6.6
release=1
source=($name-$version.tar.xz::https://ftp.debian.org/debian/pool/main/w/whois/whois_$version.tar.xz)

build() {
	cd work
	make CONFIG_FILE='/etc/whois.conf' whois
	make DESTDIR=$PKG install
	install -Dm644 whois.conf -t $PKG/etc
}