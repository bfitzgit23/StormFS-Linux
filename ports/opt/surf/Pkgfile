# Description: A simple web browser based on WebKit/GTK+.
# URL: https://surf.suckless.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: webkitgtk gtk3 pango harfbuzz at-spi2-core cairo gdk-pixbuf libsoup glib libx11 gcr3 p11-kit

name=surf
version=2.1
release=1
source=(https://dl.suckless.org/$name/$name-$version.tar.gz)

build() {
	cd $name-$version
	
	if [ -f $_portdir/config.h ]; then
                cp $_portdir/config.h .
        fi

        for p in $_portdir/*.patch $_portdir/*.diff; do
                [ -f $p ] || continue
                patch -Np1 -i $p
        done

	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}