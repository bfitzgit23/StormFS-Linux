# description	: Mobile broadband settings for various service providers
# homepage	: https://github.com/GNOME/mobile-broadband-provider-info
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Mobile broadband settings for various service providers"
name=mobile-broadband-provider-info
version=20240407
release=1
source="https://download.gnome.org/sources/mobile-broadband-provider-info/20240407/mobile-broadband-provider-info-20240407.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure \
		--prefix=/usr
	make
	make DESTDIR="$PKG" install
}
