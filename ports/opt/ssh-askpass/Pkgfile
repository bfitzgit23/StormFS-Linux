# Description: A GTK3 passphrase requester for ssh-add
# URL: https://www.openssh.com/portable.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3

name=ssh-askpass
version=10.0p2
release=1
source=(http://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$version.tar.gz)

build() {
	cd openssh-10.0p1/contrib
	make gnome-ssh-askpass3
	install -v -d -m755 $PKG/usr/lib/openssh/contrib
	install -v -m755 gnome-ssh-askpass3 $PKG/usr/lib/openssh/contrib
	ln -sv contrib/gnome-ssh-askpass3 $PKG/usr/lib/openssh/ssh-askpass
}