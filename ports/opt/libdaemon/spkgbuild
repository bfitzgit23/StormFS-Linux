description="The libdaemon package is a lightweight C library that eases the writing of UNIX daemons."
name=libdaemon
version=0.14
release=1
source="https://0pointer.de/lennart/projects/$name/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
