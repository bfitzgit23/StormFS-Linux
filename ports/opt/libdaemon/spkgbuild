# description	: The libdaemon package is a lightweight C library that eases the writing of UNIX daemons.
# homepage	: https://0pointer.de/lennart/projects/libdaemon/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen lynx

description="The libdaemon package is a lightweight C library that eases the writing of UNIX daemons."
name=libdaemon
version=0.14
release=1
source="https://0pointer.de/lennart/projects/$name/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
