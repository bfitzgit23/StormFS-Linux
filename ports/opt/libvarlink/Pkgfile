# Description: Varlink C library and command line tool
# URL: https://github.com/varlink/libvarlink
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: meson ninja

name=libvarlink
version=24.0.1
release=1
source=($name-$version.tar.gz::https://github.com/varlink/libvarlink/archive/refs/tags/v$version.tar.gz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}