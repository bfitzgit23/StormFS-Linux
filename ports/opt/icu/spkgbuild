# description	: Widely used set of C/C++ libraries providing Unicode and Globalization support.
# homepage	: https://icu.unicode.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: llvm doxygen

description="Widely used set of C/C++ libraries providing Unicode and Globalization support."
name=icu
version=78.3
release=2
source="https://github.com/unicode-org/icu/releases/download/release-${version}/icu4c-${version}-sources.tgz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cd "$SRC/icu/source" || return 1

    ./configure \
        --prefix=/usr || return 1

    make || return 1

    make -j1 DESTDIR="$PKG" install || return 1
}
