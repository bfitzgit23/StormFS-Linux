# description	: The UDisks package provides a daemon, tools and libraries to access and manipulate disks and storage devices.
# homepage	: https://github.com/storaged-project/$name/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gobject-introspection dbus-python gtk-doc lvm2 python3-gobject exFAT libiscsi btrfs-progs dosfstools gptfdisk mdadm xfsprogs

description="The UDisks package provides a daemon, tools and libraries to access and manipulate disks and storage devices."
name=udisks
version=2.11.2
release=3
source="https://github.com/storaged-project/$name/releases/download/$name-$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
./configure --prefix=/usr        \
            --sysconfdir=/etc    \
            --localstatedir=/var \
            --disable-static     \
            --with-systemdsystemunitdir=no \
            --with-tmpfilesdir=no \
            --enable-available-modules || return 1
make || return 1

	make DESTDIR=$PKG install || return 1

    # udisksd is D-Bus activated on OpenRC; its runtime directories are
    # created by the daemon and udev rules, not systemd-tmpfiles.
    rm -rf "$PKG/usr/lib/systemd" "$PKG/lib/systemd" \
        "$PKG/usr/lib/tmpfiles.d" || return 1
}
