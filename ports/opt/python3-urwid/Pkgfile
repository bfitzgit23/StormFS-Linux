# Description: Curses-based user interface library
# URL: https://urwid.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-typing-extensions python3-setuptools-scm python3-wheel python3-gpep517

name=python3-urwid
version=4.0.3
release=1
source=($name-$version.tar.gz::https://pypi.python.org/packages/source/u/urwid/urwid-$version.tar.gz)

build() {
	cd urwid-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d "$PKG" \
		.dist/*.whl

}