# Description: Portable Hardware Locality is a portable abstraction of hierarchical architectures
# URL: https://www.open-mpi.org/projects/hwloc
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: eudev ncurses cairo libxml2 libsm libice libx11 libpciaccess

name=hwloc
version=2.14.0
release=1
source=(https://www.open-mpi.org/software/hwloc/v${version%.*}/downloads/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--enable-plugins \
		--sysconfdir=/etc
	make
	make DESTDIR=$PKG install
}