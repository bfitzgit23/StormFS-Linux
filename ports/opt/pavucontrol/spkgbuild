# description	: GTK volume control for PulseAudio-compatible sound servers
# homepage	: https://freedesktop.org/software/pulseaudio/pavucontrol/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libcanberra lynx

description="GTK volume control for PulseAudio-compatible sound servers"
name=pavucontrol
version=6.2
release=2
build_opt=(
    -Dlynx=disabled
)
source="https://www.freedesktop.org/software/pulseaudio/pavucontrol/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    if scratch isinstalled libcanberra >/dev/null 2>&1; then
        build_opt+=( -Daudio-feedback=enabled )
    else
        build_opt+=( -Daudio-feedback=disabled )
    fi
	bfs_autobuild
}
