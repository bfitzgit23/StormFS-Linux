# Description: Collection of libraries which implement some of the freedesktop.org specifications
# URL: https://gitlab.freedesktop.org/vyivel/libsfdo
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: meson

name=libsfdo
version=0.1.4
release=1
source=($name-$version.tar.gz::https://gitlab.freedesktop.org/vyivel/libsfdo/-/archive/v$version/$name-v$version.tar.gz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}