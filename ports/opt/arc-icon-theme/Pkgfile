# Description: Arc icon theme, Official releases only
# URL: https://github.com/horst3180/arc-icon-theme
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 hicolor-icon-theme

name=arc-icon-theme
version=20161122
release=1
source=($name-$version.tar.gz::https://github.com/horst3180/$name/archive/$version.tar.gz)

build() {
	cd $name-$version
	./autogen.sh --prefix=/usr
	make
	make DESTDIR=$PKG install
}