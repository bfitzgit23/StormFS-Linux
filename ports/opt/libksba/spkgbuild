# description	: libksba package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: valgrind

description="libksba package"
name=libksba
version=1.8.1
# dotsrc's gcrypt mirror no longer carries 1.8.1; use the upstream GnuPG copy.
release=2
source="https://www.gnupg.org/ftp/gcrypt/${name}/${name}-${version}.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
