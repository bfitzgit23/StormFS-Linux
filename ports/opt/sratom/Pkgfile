# Description: An LV2 Atom RDF serialisation library
# URL: https://drobilla.net/software/sratom.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: sord lv2 python3-sphinx-lv2-theme

name=sratom
version=0.6.22
release=1
source=(https://download.drobilla.net/$name-$version.tar.xz)

build() {
	meson setup $name-$version build \
		-Ddocs=disabled \
		-Dtests=disabled
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}