# description	: Linux kernel trace file system library
# homepage	: https://git.kernel.org/pub/scm/libs/libtrace/libtracefs.git/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: asciidoc xmlto

description="Linux kernel trace file system library"
name=libtracefs
version=1.8.3
release=1
source="https://git.kernel.org/pub/scm/libs/libtrace/libtracefs.git/snapshot/libtracefs-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    local doc_opt="-Ddoc=false"

    if scratch isinstalled asciidoc >/dev/null 2>&1 &&
       scratch isinstalled xmlto >/dev/null 2>&1; then
        doc_opt="-Ddoc=true"
    fi

    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        "$doc_opt" || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1

    rm -rf "$PKG/usr/share/doc"
}
