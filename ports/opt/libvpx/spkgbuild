# description	: The VP8/VP9 Codec SDK
# homepage	: https://www.webmproject.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: curl doxygen

description="The VP8/VP9 Codec SDK"
name=libvpx
version=1.17.0
release=1
source="https://github.com/webmproject/$name/archive/v$version/$name-v$version.tar.gz"

build() {
	cd "$name-$version" || return 1

 sed -i 's/cp -p/cp/' build/make/Makefile &&

mkdir libvpx-build            &&
cd    libvpx-build            &&

../configure --prefix=/usr    \
             --enable-shared  \
             --disable-static &&
make
  make DESTDIR=$PKG install
}
