# description	: double-conversion package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="double-conversion package"
name=double-conversion
version=3.4.0
release=2
export 'CFLAGS=$CFLAGS -fPIC'
keep_static=1
build_opt="-D CMAKE_INSTALL_PREFIX=/usr
      -D CMAKE_POLICY_VERSION_MINIMUM=3.5
      -D BUILD_SHARED_LIBS=ON
      -D BUILD_TESTING=ON
      .. "
source="https://github.com/google/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
