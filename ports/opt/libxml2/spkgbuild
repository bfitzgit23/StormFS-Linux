# description	: Libraries and utilities used for parsing XML files.
# homepage	: https://gitlab.gnome.org/GNOME/libxml2
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Libraries and utilities used for parsing XML files."
name=libxml2
version=2.15.4
release=4
build_opt=(
    --prefix=/usr
    --sysconfdir=/etc
    --with-history
    --with-python=yes
    --disable-static
)
source="https://download.gnome.org/sources/libxml2/${version%.*}/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
    ./configure "${build_opt[@]}" || return 1
    make || return 1
    make DESTDIR="$PKG" install || return 1
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
