# description	: Free Lossless Audio Codec.
# homepage	: https://xiph.org/flac/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libogg docbook-utils doxygen valgrind

description="Free Lossless Audio Codec."
name=flac
version=1.5.0
release=2
source="https://github.com/xiph/flac/releases/download/$version/flac-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

   ./configure --prefix=/usr                                \
            --disable-thorough-tests                     \
            --docdir=/usr/share/doc/$name-$version          &&
make
  DESTDIR=$PKG make install
}
