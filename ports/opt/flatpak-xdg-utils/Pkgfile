# Description: Sandboxed desktop utilities (xdg-open, portals) for Flatpak containers
# URL: https://github.com/flatpak/flatpak-xdg-utils
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: glib json-glib

name=flatpak-xdg-utils
version=1.0.6
release=1
source=(https://github.com/flatpak/flatpak-xdg-utils/releases/download/${version}/flatpak-xdg-utils-${version}.tar.xz)

pkg_build() {
    mkdir -p build && cd build || return 1

    meson setup \
        --prefix=/usr \
        --buildtype=release \
        -D tests=false \
        .. || return 1

    ninja -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" ninja install || return 1
}
