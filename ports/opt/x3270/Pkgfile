# Description: console emulator for IBM Mainframes
# URL: https://github.com/pmattes/x3270
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxaw bdftopcf mkfontscale

name=x3270
version=4.5ga5
release=1
source=($name-$version.tar.gz::https://github.com/pmattes/$name/archive/$version.tar.gz)

build() {
    cd $name-$version
    ./configure --prefix=/usr --sysconfdir=/etc --disable-tcl3270
    make
    make DESTDIR=$PKG install
}