# Description: portable NetBSD-compatibility library
# URL: https://github.com/archiecobbs/libnbcompat
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: autoconf automake libtool

name=libnbcompat
version=1.0.2
release=1
source=($name-$version.tar.gz::https://github.com/archiecobbs/libnbcompat/archive/refs/tags/${version}.tar.gz)

build() {
	cd $name-$version
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}