# description	: Utility that does structural, content-preserving transformations on PDF files
# homepage	: http://qpdf.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gnutls libidn2 ghostscript gnutls libtiff sphinx with sphinx_rtd_theme texlive install-tl-unx

description="Utility that does structural, content-preserving transformations on PDF files"
name=qpdf
version=12.4.1
release=1
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	mkdir build &&
cd    build &&

cmake -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release  \
      -DBUILD_STATIC_LIBS=OFF     \
      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/qpdf-11.6.1 \
      .. &&
make
	make DESTDIR=$PKG install
}
