# description	: Generate C bindings from rust code
# homepage	: https://github.com/eqrion/cbindgen
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: sccache

description="Generate C bindings from rust code"
name=cbindgen
version=0.29.4
release=2
source="https://github.com/mozilla/$name/archive/v$version/$name-v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

cargo build --release
mkdir -p $PKG/usr/bin/
install -Dm755 target/release/cbindgen $PKG/usr/bin/
}
