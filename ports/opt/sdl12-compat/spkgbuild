# description	: SDL 1.2 compatibility layer implemented on top of SDL2
# homepage	: https://github.com/libsdl-org/sdl12-compat
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="SDL 1.2 compatibility layer implemented on top of SDL2"
name=sdl12-compat
version=1.2.76
release=1
source="https://github.com/libsdl-org/sdl12-compat/archive/refs/tags/release-$version/$name-release-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  cmake -S . -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_BUILD_TYPE=Release \
    -DSDL12TESTS=OFF \
    -DSDL12DEVEL=ON \
    -DSTATICDEVEL=OFF || return 1

  cmake --build build -j "${JOBS:-1}" || return 1

  DESTDIR="$PKG" \
    cmake --install build || return 1
}
