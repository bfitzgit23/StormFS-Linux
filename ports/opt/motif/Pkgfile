# Description: The Motif toolkit
# URL: https://sourceforge.net/projects/motif/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxmu libxft libjpeg-turbo

name=motif
version=2.3.8
release=2
source=(https://sourceforge.net/projects/motif/files/$name-$version.tar.gz add-wmluiltok-main-function.patch no-demos.patch)

build() {
	cd $name-$version

	export CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=format-security"

	patch -Np1 -i $SRC/add-wmluiltok-main-function.patch  
	patch -Np1 -i $SRC/no-demos.patch

	touch NEWS AUTHORS
	autoreconf -fi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}