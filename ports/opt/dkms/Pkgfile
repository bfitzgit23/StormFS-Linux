# Description: Dynamic Kernel Modules System
# URL: https://github.com/dell/dkms
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: bash kmod make patch

name=dkms
version=3.4.1
release=1
source=($name-$version.tar.gz::https://github.com/dell/dkms/archive/v$version.tar.gz buildmodules-template.sh)

build() {
	cd $name-$version
	make DESTDIR=$PKG install

	# venom's dkms scripts
	mkdir -pv $PKG/usr/lib/dkms
	install -m644 $SRC/buildmodules-template.sh $PKG/usr/lib/dkms/
}