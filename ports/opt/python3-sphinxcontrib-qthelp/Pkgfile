# Description: sphinx extension which outputs QtHelp document
# URL: https://github.com/sphinx-doc/sphinxcontrib-qthelp/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-gpep517 python3-flit-core python3-setuptools

name=python3-sphinxcontrib-qthelp
version=2.0.0
release=2
source=($name-$version.tar.gz::https://github.com/sphinx-doc/${name#*-}/archive/$version/${name#*-}-$version.tar.gz)

build() {
	cd ${name#*-}-$version

 gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	   python3 -m installer -d $PKG \
			.dist/*.whl
}