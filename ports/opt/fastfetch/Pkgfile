# Description: Like Neofetch, but much faster because written in C
# URL: https://github.com/fastfetch-cli/fastfetch
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: dconf imagemagick pciutils vulkan-icd-loader

name=fastfetch
version=2.65.2
release=1
source=(${name}-${version}.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/${version}.tar.gz)

build() {
	cmake -B build -S $name-$version \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DBUILD_TESTS='OFF' \
		-DENABLE_SQLITE3='OFF' \
		-DENABLE_RPM='OFF' \
		-DENABLE_IMAGEMAGICK6='OFF' \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}