# description	: libpcap provides functions for user-level packet capture, used in low-level network monitoring.
# homepage	: https://www.tcpdump.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bluezlibnl libusb dag septel

description="libpcap provides functions for user-level packet capture, used in low-level network monitoring."
name=libpcap
version=1.10.7
release=1
source="https://www.tcpdump.org/release/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr &&
make
sed -i '/INSTALL_DATA.*libpcap.a\|RANLIB.*libpcap.a/ s/^/#/' Makefile
	make DESTDIR=$PKG install
}
