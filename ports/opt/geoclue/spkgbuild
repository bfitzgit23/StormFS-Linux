# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="geoclue package"
name=geoclue
version=2.8.2
release=3
build_opt="--prefix=/usr
            --buildtype=release
            -Dgtk-doc=false"
source="https://gitlab.freedesktop.org/${name}/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
