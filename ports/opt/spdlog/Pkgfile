# Description: Very fast, header-only/compiled, C++ logging library.
# URL: https://github.com/gabime/spdlog
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: fmt

name=spdlog
version=1.17.0
release=2
source=(https://github.com/gabime/spdlog/archive/v$version/$name-$version.tar.gz)

build() {

	cmake -S $name-$version -B build -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DSPDLOG_BUILD_BENCH=OFF \
		-DSPDLOG_SANITIZE_ADDRESS=OFF \
		-DSPDLOG_FMT_EXTERNAL=ON \
		-DSPDLOG_BUILD_SHARED=ON \
		-DSPDLOG_BUILD_EXAMPLE=OFF \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	sed -e 's|.*#define SPDLOG_FMT_EXTERNAL|#define SPDLOG_FMT_EXTERNAL|' \
		-i $PKG/usr/include/spdlog/tweakme.h

	rm -f $PKG/usr/include/spdlog/sinks/systemd_sink.h
}