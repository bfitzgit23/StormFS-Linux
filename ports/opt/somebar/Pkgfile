# Description: dwm-like bar for dwl
# URL: https://sr.ht/~raphi/somebar/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: wayland-protocols pango

name=somebar
version=1.0.3
release=1
source=($name-$version.tar.gz::https://git.sr.ht/~raphi/somebar/archive/1.0.3.tar.gz config.hpp)

build() { 
	#git clone https://git.sr.ht/~raphi/somebar $name
	cd $name-$version

	# Uncomment if you have any patches to apply
	#for p in $_portdir/*.patch $_portdir/*.diff; do
	#	[ -f $p ] || continue
	#	patch -Np1 -i $p
	#done
	
	# Use a custom config.hpp
 	if [ -f $_portdir/config.hpp ]; then
		cp $_portdir/config.hpp src/config.hpp
	else
		cp -f src/config.def.hpp src/config.hpp
	fi

	venom-meson build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build 
}