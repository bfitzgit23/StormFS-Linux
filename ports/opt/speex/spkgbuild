# description	: Speex speech codec and SpeexDSP library
# homepage	: https://www.speex.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: valgrind

description="Speex speech codec and SpeexDSP library"
name=speex
version=1.2.1
release=3
source="https://downloads.xiph.org/releases/speex/speex-$version.tar.gz https://downloads.xiph.org/releases/speex/speexdsp-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/speex-$version
    make -j "${JOBS:-1}"
    make DESTDIR="$PKG" install

    cd "$SRC/speexdsp-$version"
    ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/speexdsp-$version
    make -j "${JOBS:-1}"
    make DESTDIR="$PKG" install
}
