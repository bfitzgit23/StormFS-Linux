# description	: libisoburn package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: tk

name=libisoburn
version=1.5.8.pl02
release=1
build_opt="-prefix=/usr
            --disable-static
            --enable-pkg-check-modules"
source="https://files.libburnia-project.org/releases/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
