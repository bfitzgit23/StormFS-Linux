# Description: Qt module and API for defining 3D content in Qt Quick
# URL: https://www.qt.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: qt6-quick3d

name=qt6-graphs
version=6.11.1
release=1
source=($name-$version.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtgraphs-everywhere-src-$version.tar.xz)

build() {
	cmake -S qt${name#*-}-everywhere-src-$version -B build  -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS"
	cmake --build build
	DESTDIR=$PKG cmake --install build
}