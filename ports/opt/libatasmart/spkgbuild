# description	: The libatasmart package is a disk reporting library. It only supports a subset of the ATA S.M.A.R.T. functionality.
# homepage	: https://0pointer.de/public/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The libatasmart package is a disk reporting library. It only supports a subset of the ATA S.M.A.R.T. functionality."
name=libatasmart
version=0.19
release=1
source="https://0pointer.de/public/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr --disable-static &&
make

	make docdir=/usr/share/doc/$name-$version DESTDIR=$PKG install
}
