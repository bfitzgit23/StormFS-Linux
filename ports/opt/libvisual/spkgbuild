# description	: Libvisual Audio Visualization
# homepage	: https://github.com/Libvisual/libvisual
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Libvisual Audio Visualization"
name=libvisual
version=0.4.2
release=2
source="https://github.com/Libvisual/libvisual/releases/download/$name-$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  ./configure \
    --prefix=/usr \
    --enable-extra-optimization \
    --disable-examples \
    --disable-nls || return 1

  make -j "${JOBS:-1}" || return 1
  make DESTDIR="$PKG" install || return 1
}
