# description	: Recurrent neural network based audio noise suppression library
# homepage	: https://github.com/xiph/rnnoise
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=rnnoise
version=0.2
release=1
source="https://github.com/xiph/rnnoise/releases/download/v$version/rnnoise-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    ./configure \
        --prefix=/usr \
        --disable-static || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1

    rm -rf "$PKG/usr/share/doc"
}
