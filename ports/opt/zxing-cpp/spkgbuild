# description	: C++ barcode image processing library
# homepage	: https://github.com/zxing-cpp/zxing-cpp
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ barcode image processing library"
name=zxing-cpp
version=3.1.1
release=2
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DZXING_C_API=OFF
           -DZXING_EXAMPLES=OFF
           -DZXING_EXAMPLES_QT=OFF
           -DZXING_BLACKBOX_TESTS=OFF
           -DZXING_UNIT_TESTS=OFF
           -DZXING_PYTHON_MODULE=OFF
           -DZXING_READERS=ON
           -DZXING_WRITERS=BOTH"
source="https://github.com/zxing-cpp/zxing-cpp/releases/download/v$version/zxing-cpp-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
