name=dwl
version=0.8
release=2
source=($name-$version.tar.gz::https://codeberg.org/dwl/dwl/archive/v$version.tar.gz)

build() {
	cd $name

	# Uncomment to compile with XWayland support
	#sed -i -e '/-DXWAYLAND/s/^#//' config.mk

		[ -e "$SRC/config.h" ] 
		cp -f $SRC/config.h config.h
		}

	# Uncomment if you have any patches to apply
	# for i in $SRC/*.patch $SRC/*.diff ; do
	# patch -Np1 -i $i
	# done

	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}