# description	: libsamplerate is a sample rate converter for audio.
# homepage	: https://github.com/libsndfile/$name/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: alsa-lib libsndfile fftw

description="libsamplerate is a sample rate converter for audio."
name=libsamplerate
version=0.2.2
release=1
source="https://github.com/libsndfile/$name/releases/download/$version/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-$version &&
make
	make DESTDIR=$PKG install
}
