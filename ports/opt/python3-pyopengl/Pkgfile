# Description: The cross platform Python binding to OpenGL and related APIs
# URL: http://pyopengl.sourceforge.net/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: freeglut python3-setuptools

name=python3-pyopengl
version=3.1.10
release=1
source=($name-$version.tar.gz::https://pypi.python.org/packages/source/P/PyOpenGL/pyopengl-${version}.tar.gz)

build() {
    cd pyopengl-$version
    /usr/bin/python3 setup.py install --root=$PKG --optimize=1 --skip-build
}