# description	: libgusb package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libgusb package"
name=libgusb
version=0.4.9
release=2
source="https://github.com/hughsie/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
mkdir build &&
cd    build &&

# HTML docs are optional; keeping them off avoids a hard gi-docgen
# build dependency for the library itself.
meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -Ddocs=false        &&
ninja &&
DESTDIR=$PKG ninja install
}
