# description	: Python bindings for GNU Parted
# homepage	: https://github.com/dcantrell/pyparted
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python bindings for GNU Parted"
name=python3-pyparted
version=3.13.0
release=1
source="https://files.pythonhosted.org/packages/source/p/pyparted/pyparted-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "pyparted-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	python3 setup.py build || return 1
	python3 setup.py install --root="$PKG" --prefix=/usr --optimize=1 || return 1
}
