# Description: Provides WebSocket communication compliant with RFC 6455
# URL: https://www.qt.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: qt6-declarative

name=qt6-websockets
version=6.11.1
release=1
source=($name-$version.tar.xz::https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtwebsockets-everywhere-src-$version.tar.xz)

build() {
	cmake -S qtwebsockets-everywhere-src-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DQT_USE_CCACHE=$(prt-get isinst ccache && printf "ON" || printf "OFF") \
		-DINSTALL_PUBLICBINDIR=usr/bin \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}