# description	: a free and open video compression format
# homepage	: https://www.theora.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libvorbis sdl12-compat libpng doxygen texlive tl-unx bibtex transfig valgrind

description="a free and open video compression format"
name=libtheora
version=1.2.0
release=1
source="https://downloads.xiph.org/releases/theora/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  sed -i 's/png_\(sizeof\)/\1/g' examples/png2theora.c &&
./configure --prefix=/usr --disable-static &&
make
make DESTDIR=$PKG install
cd examples/.libs &&
for E in *; do
mkdir -p $PKG/usr/bin/theora_${E}
  install -v -m755 $E $PKG/usr/bin/theora_${E}
done
}
