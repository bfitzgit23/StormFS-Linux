# description	: eudev package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="eudev package"
name=eudev
version=3.2.14
release=1
build_opt="--sbindir=/sbin
	--bindir=/sbin
	--with-rootprefix=
	--with-rootlibdir=/lib
	--libexecdir=/lib"
source="https://github.com/$name-project/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
