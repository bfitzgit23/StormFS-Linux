# description	: Graph visualization software
# homepage	: https://graphviz.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: cairo fontconfig ghostscript gtk3 libgd libpng librsvg pango poppler swig tcl

description="Graph visualization software"
name=graphviz
version=16.1.0
release=1
source="https://gitlab.com/graphviz/graphviz/-/archive/$version/graphviz-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    # Current Graphviz supports CMake directly; avoid carrying the obsolete
    # autotools/libpostfix surgery from the old recipe.
    sed '/ORIGIN/d' -i lib/CMakeLists.txt || return 1

    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release || return 1

    # Match the current BLFS packaging fix for generated gzip commands.
    sed -i '/GZIP/s/:.*$/=/' build/CMakeCache.txt || return 1

    cmake --build build -j"${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
