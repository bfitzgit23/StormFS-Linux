# description	: Startup notification library.
# homepage	: http://freedesktop.org/wiki/Software/startup-notification
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Startup notification library."
name=startup-notification
version=0.12
release=1
source="http://www.freedesktop.org/software/$name/releases/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
install -v -m644 -D doc/$name.txt \
    $PKG/usr/share/doc/$name-$version/$name.txt
}
