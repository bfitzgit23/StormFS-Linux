# description	: Linux kernel trace event library
# homepage	: https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: asciidoc xmlto

description="Linux kernel trace event library"
name=libtraceevent
version=1.9.0
release=1
source="https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/snapshot/libtraceevent-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    local doc_opt="-Ddoc=false"

    if scratch isinstalled asciidoc >/dev/null 2>&1 &&
       scratch isinstalled xmlto >/dev/null 2>&1; then
        doc_opt="-Ddoc=true"
    fi

    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        "$doc_opt" || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1

    rm -rf "$PKG/usr/share/doc"
}
