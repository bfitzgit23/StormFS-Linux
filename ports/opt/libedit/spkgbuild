# description	: Command line editor library providing generic line editing, history, and tokenization functions
# homepage	: https://thrysoee.dk/editline/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Command line editor library providing generic line editing, history, and tokenization functions"
name=libedit
version=20260512_3.1
# pkgbuild sources recipes with /bin/sh; keep this POSIX.
_ver_dash=$(printf '%s' "$version" | sed 's/_/-/')
release=1
source="https://thrysoee.dk/editline/$name-$_ver_dash.tar.gz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/man/man3/history.3 # conflicts with readline
	ln -s editline.3 $PKG/usr/share/man/man3/el.3
}
