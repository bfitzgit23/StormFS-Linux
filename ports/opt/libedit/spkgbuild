# description	: Command line editor library providing generic line editing, history, and tokenization functions
# homepage	: https://thrysoee.dk/editline/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Command line editor library providing generic line editing, history, and tokenization functions"
name=libedit
version=20260512_3.1
# pkgbuild sources recipes with /bin/sh; keep this POSIX.
_ver_dash=$(printf '%s' "$version" | sed 's/_/-/')
release=2
source="https://thrysoee.dk/editline/$name-$_ver_dash.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	# Upstream now installs el_history.3 instead of history.3.  Keep the
	# readline conflict cleanup tolerant of both layouts.
	rm -f "$PKG/usr/share/man/man3/history.3"
	[ -e "$PKG/usr/share/man/man3/editline.3" ] || return 1
	ln -sfn editline.3 "$PKG/usr/share/man/man3/el.3"
}
