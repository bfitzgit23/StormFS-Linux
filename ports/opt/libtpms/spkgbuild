# description	: TPM 1.2/2.0 software emulation library
# homepage	: https://github.com/stefanberger/libtpms
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="TPM 1.2/2.0 software emulation library"
name=libtpms
version=0.10.2
release=2
build_opt=(
    --with-openssl
    --with-tpm2
)
# GitHub tag archives do not carry a generated configure script, so this port
# legitimately owns the autoreconf/autogen step instead of using the generic
# configure backend directly.
source="https://github.com/stefanberger/libtpms/archive/refs/tags/v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    sed -i 's/^    char \*start, \*end;$/    const char *start, *end;/' src/tpm_library.c
    ./autogen.sh --prefix=/usr --libdir=/usr/lib "${build_opt[@]}"
    make
    make DESTDIR="$PKG" install
}
