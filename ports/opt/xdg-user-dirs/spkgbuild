# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xdg-user-dirs package"
name=xdg-user-dirs
version=0.20
release=3
source="https://user-dirs.freedesktop.org/releases/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build . \
        --prefix=/usr \
        --sysconfdir=/etc \
        --buildtype=release || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" meson install -C build || return 1
}
