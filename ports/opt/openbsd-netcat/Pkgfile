# Description: TCP/IP swiss army knife. OpenBSD variant.
# URL: https://salsa.debian.org/debian/netcat-openbsd
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libbsd

name=openbsd-netcat
version=1.234_2
release=1
source=($name-$version.tar.gz::https://salsa.debian.org/debian/netcat-openbsd/-/archive/debian/$source_version/netcat-openbsd-debian-$source_version.tar.gz)

build() {
	cd netcat-openbsd-debian-$source_version
	
	while read patch
	do
		patch -Np1 -i debian/patches/$patch
	done < debian/patches/series
	
	make \
		CFLAGS="$CFLAGS -DDEBIAN_VERSION=\"\\\"$source_version\\\"\" -I/usr/include/libbsd" \
		LDFLAGS="$LDFLAGS -lbsd"
	
	install -Dm0755 nc $PKG/usr/bin/nc
	install -Dm0644 nc.1 $PKG/usr/share/man/man1/nc.1
}