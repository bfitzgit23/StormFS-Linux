# Description: Lightweight, advanced audio player focused on audio quality
# URL: https://audacious-media-player.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: qt6-svg gnome-icon-theme desktop-file-utils

name=audacious
version=4.6.1
release=1
source=(http://distfiles.audacious-media-player.org/$name-$version.tar.bz2)

build() {
	meson setup $name-$version build \
		-Dgtk=false \
		-Dgtk2=false \
		-Dqt=true \
		-Dqt5=true \
		-Dbuildstamp="Venom Linux"
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	rm -r $PKG/usr/share/$name
}