# Description: A diagnostic, debugging and instructional userspace tracer
# URL: https://strace.io/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: elfutils

name=strace
version=7.1
release=1
source=(https://github.com/strace/strace/releases/download/v$version/$name-$version.tar.xz)

build() {
	cd $name-$version

	./configure \
	--prefix=/usr \
	--enable-silent-rules \
	--enable-bundled=yes
	make
	make DESTDIR=$PKG install
}