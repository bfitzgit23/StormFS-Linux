# description	: Diagnostic, debugging and instructional Linux syscall tracer
# homepage	: https://strace.io/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=strace
version=7.2
release=1
source="https://strace.io/files/$version/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
  ./configure \
    --prefix=/usr \
    --disable-mpers \
    --disable-gcc-Werror || return 1

  make -j ${JOBS:-1} || return 1
  make DESTDIR="$PKG" install || return 1
}
