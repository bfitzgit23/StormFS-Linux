# description	: Diagnostic, debugging and instructional Linux syscall tracer
# homepage	: https://strace.io/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Diagnostic, debugging and instructional Linux syscall tracer"
name=strace
version=7.2
release=1
source="https://strace.io/files/$version/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  ./configure \
    --prefix=/usr \
    --disable-mpers \
    --disable-gcc-Werror || return 1

  make -j ${JOBS:-1} || return 1
  make DESTDIR="$PKG" install || return 1
}
