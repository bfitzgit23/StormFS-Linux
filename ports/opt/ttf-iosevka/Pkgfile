name=ttf-iosevka
version=34.6.3
release=1
source=(https://github.com/be5invis/Iosevka/releases/download/v${version}/PkgTTF-Iosevka-${version}.zip)

build() {
	install -d ${PKG}/usr/share/fonts/iosevka
	install -m644 *.ttf ${PKG}/usr/share/fonts/iosevka
}