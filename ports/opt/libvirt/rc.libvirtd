#!/bin/sh
#
# /etc/rc.d/libvirtd: start/stop libvirt daemon
#

. /etc/rc.subr

NAME=libvirtd
PROG=/usr/sbin/libvirtd
PID=/run/libvirtd/pid
OPTS="-d"

case $1 in
	start)
		msg "Starting $NAME..."
		start_daemon -p $PID $PROG $OPTS
		;;
	stop)
		msg "Stopping $NAME..."
		stop_daemon -p $PID $PROG
		;;
	restart)
		$0 stop
		sleep 1
		$0 start
		;;
	status)
		status_daemon -p $PROG
		case $? in
			0) echo "$PROG is running with pid $(cat $PIDFILE)" ;;
			1) echo "$PROG is not running but the pid file $PIDFILE exists" ;;
			3) echo "$PROG is not running" ;;
			4) echo "Unable to determine the program status" ;;
		esac
		;;
	*)
		echo "Usage: $0 [start|stop|restart|status]"
		;;
esac

# End of file
