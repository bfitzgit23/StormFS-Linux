# Description: General parsing module for Python
# URL: https://github.com/pyparsing/pyparsing/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-gpep517 python3-flit-core

name=python3-pyparsing
version=3.3.2
release=1
source=($name-$version.tar.gz::https://files.pythonhosted.org/packages/source/p/${name#*-}/${name#*-}-$version.tar.gz)

build() {
	cd ${name#*-}-$version
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
	python3 -m installer -d $PKG \
		.dist/*.whl
}