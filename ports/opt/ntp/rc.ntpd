#!/bin/sh
#
# /etc/rc.d/ntpd: start/stop NTP Network Time Protocol
#

. /etc/rc.subr

NAME="NTP daemon"
PROG=/usr/sbin/ntpd
PID=/run/ntp/pid
OPTS="-g -u ntp:ntp"

case $1 in
	start)
		msg "Starting $NAME..."
		start_daemon -p $PID $PROG $OPTS
		;;
	stop)
		msg "Stopping $NAME..."
		stop_daemon -p $PID $PROG
		;;
	restart)
		$0 stop
		sleep 1
		$0 start
		;;
	status)
		status_daemon $PROG
		;;
	*)
		echo "usage: $0 [start|stop|restart|status]"
		;;
esac

# End of file
