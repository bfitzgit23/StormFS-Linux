name=hwdata
version=0.411
release=1
build_opt="--prefix=/usr --disable-blacklist"
source="https://github.com/vcrhonek/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
