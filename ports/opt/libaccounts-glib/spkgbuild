# description	: GLib-based client library for accessing the online accounts database
# homepage	: https://gitlab.com/accounts-sso/libaccounts-glib
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GLib-based client library for accessing the online accounts database"
name=libaccounts-glib
version=1.27
release=1
source="https://gitlab.com/accounts-sso/$name/-/archive/VERSION_$version/$name-VERSION_$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dtests=false \
        -Ddocs=false || return 1
    meson compile -C build || return 1
    DESTDIR="$PKG" meson install -C build || return 1
}
