# Description: Generic namespace helpers (ported from SAX2)
# URL: https://search.cpan.org/dist/XML-NamespaceSupport
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl

name=perl-xml-namespacesupport
version=1.12
release=2
source=($name-$version.tar.gz::http://search.cpan.org/CPAN/authors/id/P/PE/PERIGRIN/XML-NamespaceSupport-$version.tar.gz)

build() {
	cd XML-NamespaceSupport-$version

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make
	make install DESTDIR=$PKG

	find $PKG -name '.packlist' -delete
	find $PKG -name '*.pod' -delete
}