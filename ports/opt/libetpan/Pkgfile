# Description: A portable middleware for email access
# URL: https://www.etpan.org/libetpan.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: expat libgcrypt gnutls zlib

name=libetpan
version=1.10.1
release=1
source=($name-$version.tar.gz::https://github.com/dinhviethoa/$name/archive/$version.tar.gz)

build() {
	cd $name-$version
  
	NOCONFIGURE=1 ./autogen.sh
	./configure --prefix=/usr \
	    --disable-static \
	    --disable-db \
	    --with-openssl=no \
	    --with-gnutls=yes
	make
	make DESTDIR=$PKG install
}