# description	: General purpose TCP/IP emulator library used by QEMU
# homepage	: https://gitlab.freedesktop.org/slirp/libslirp
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="General purpose TCP/IP emulator library used by QEMU"
name=libslirp
version=4.9.4
release=1
build_opt=(
    -Ddefault_library=shared
)
source="https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v$version/libslirp-v$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
