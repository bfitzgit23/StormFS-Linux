# description	: Python wrapper for GnuPG
# homepage	: https://github.com/vsajip/python-gnupg
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python wrapper for GnuPG"
name=python3-gnupg
version=0.5.4
release=1
source="https://files.pythonhosted.org/packages/source/p/python-gnupg/python-gnupg-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "python-gnupg-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
	python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
