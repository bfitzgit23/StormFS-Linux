# description	: Adwaita theme for GTK3 and GTK4 with light and dark variants
# homepage	: https://github.com/lassekongo83/adw-gtk3
# maintainer	: StormFS maintainers

description="Adwaita theme for GTK3 and GTK4 with light and dark variants"
name=adw-gtk3
version=6.5
release=1
source="https://github.com/lassekongo83/adw-gtk3/releases/download/v$version/adw-gtk3v$version.tar.xz"

build() {
	install -d "$PKG/usr/share/themes" || return 1
	cp -a adw-gtk3 adw-gtk3-dark "$PKG/usr/share/themes/" || return 1
}
