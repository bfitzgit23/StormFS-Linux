# description	: Commandline MP3 player
# homepage	: https://www.mpg123.de
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: pulseaudio sdl12-compat jack openal portaudio

description="Commandline MP3 player"
name=mpg123
version=1.33.7
release=1
source="https://sourceforge.net/projects/mpg123/files/mpg123/$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr &&
make
	make DESTDIR=$PKG install
}
