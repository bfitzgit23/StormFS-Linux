# description	: Regular expressions library
# homepage	: https://github.com/kkos/oniguruma
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Regular expressions library"
name=oniguruma
version=6.9.10
# pkgbuild sources recipes with /bin/sh; keep this POSIX.
_ver_under=$(printf '%s' "$version" | sed 's/-/_/')
release=1
source="https://github.com/kkos/oniguruma/releases/download/v$_ver_under/onig-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
