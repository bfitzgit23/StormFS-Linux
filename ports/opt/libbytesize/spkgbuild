# description	: Library for common operations with sizes in bytes
# homepage	: https://github.com/storaged-project/libbytesize
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: python3-six gtk-doc polib

description="Library for common operations with sizes in bytes"
name=libbytesize
version=2.12
release=3
# GitHub release assets are returning 504. Debian's archived orig tarball
# lacks the generated configure script, so bootstrap autotools first.
source="https://deb.debian.org/debian/pool/main/libb/libbytesize/${name}_${version}.orig.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    if [ ! -x ./configure ]; then
        NOCONFIGURE=1 ./autogen.sh || return 1
    fi
    PYTHON=python3 \
    ./configure \
        --prefix=/usr || return 1

    make -j "${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1
}
