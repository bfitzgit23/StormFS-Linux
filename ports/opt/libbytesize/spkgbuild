# description	: Library for common operations with sizes in bytes
# homepage	: https://github.com/storaged-project/libbytesize
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: python3-six gtk-doc polib

description="Library for common operations with sizes in bytes"
name=libbytesize
version=2.12
release=1
source="https://github.com/storaged-project/$name/releases/download/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    PYTHON=python3 \
    ./configure \
        --prefix=/usr || return 1

    make -j "${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1
}
