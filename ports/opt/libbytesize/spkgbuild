# description	: Library for common operations with sizes in bytes
# homepage	: https://github.com/storaged-project/libbytesize
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: python3-six gtk-doc polib

description="Library for common operations with sizes in bytes"
name=libbytesize
version=2.12
release=1
source="https://github.com/storaged-project/$name/releases/download/$version/$name-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    PYTHON=python3 \
    ./configure \
        --prefix=/usr || return 1

    make -j "${JOBS:-1}" || return 1

    make DESTDIR="$PKG" install || return 1
}
