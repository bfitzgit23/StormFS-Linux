# description	: Low-level cryptographic library
# homepage	: http://www.lysator.liu.se/~nisse/nettle/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Low-level cryptographic library"
name=nettle
version=4.0
release=1
build_opt="--prefix=/usr \
           --disable-static"
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure $build_opt
    make
    make DESTDIR="$PKG" install

    chmod 755 "$PKG/usr/lib/libhogweed.so"* \
              "$PKG/usr/lib/libnettle.so"*
}
