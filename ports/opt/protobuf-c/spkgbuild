# description	: C implementation of Protocol Buffers
# homepage	: https://github.com/protobuf-c/protobuf-c
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen

description="C implementation of Protocol Buffers"
name=protobuf-c
version=1.5.2
release=4
source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/protobuf-c-${version}-protobuf34_fix-1.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    CXXFLAGS="${CXXFLAGS:--O2 -g} -std=c++20" \
    ./configure \
        --prefix=/usr \
        --disable-static || return 1

    make || return 1
    DESTDIR="$PKG" make install || return 1
}
