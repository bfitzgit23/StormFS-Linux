# Description: A posix script to find and watch youtube videos from the terminal.
# URL: https://github.com/pystardust/ytfzf
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: jq mpv make yt-dlp dmenu fzf ueberzug

name=ytfzf
version=2.6.2
release=1
source=($name-$version.tar.gz::https://github.com/pystardust/ytfzf/archive/v$version.tar.gz)

build() {
	cd $name-$version
	
	make PREFIX=/usr
        make PREFIX=/usr DESTDIR=$PKG install
}