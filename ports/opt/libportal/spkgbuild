# description	: GIO-style APIs for desktop portals
# homepage	: https://github.com/flatpak/libportal
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: qt6 vala xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-gnome

description="GIO-style APIs for desktop portals"
name=libportal
version=0.10.0
release=2
source="https://github.com/flatpak/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -D vapi=false \
        -D docs=false || return 1
    meson compile -C build || return 1
    DESTDIR="$PKG" meson install --no-rebuild -C build || return 1
}
