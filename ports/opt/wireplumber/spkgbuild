# description	: Session and policy manager for PipeWire
# homepage	: https://pipewire.pages.freedesktop.org/wireplumber/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen gobject-introspection python3-lxml sphinx sphinx_rtd_theme breathe

description="Session and policy manager for PipeWire"
name=wireplumber
version=0.5.17
release=1
build_opt="--prefix=/usr --buildtype=release -Dsystem-lua=true"
source="https://gitlab.freedesktop.org/pipewire/$name/-/archive/$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
