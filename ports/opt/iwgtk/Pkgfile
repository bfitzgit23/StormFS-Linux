# Description: Lightweight GTK frontend for iwd (WiFi)
# URL: https://github.com/J-Lentz/iwgtk
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: scdoc adwaita-icon-theme iwd pkgconf gettext gtk4 qrencode

name=iwgtk
version=0.9
release=1
source=($name-$version.tar.gz::https://github.com/J-Lentz/iwgtk/archive/refs/tags/v$version.tar.gz)

build() {

	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# remove systemd
	rm -rf $PKG/usr/lib/systemd
}