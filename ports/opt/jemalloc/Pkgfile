# Description: General-purpose scalable concurrent malloc implementation
# URL: http://www.canonware.com/jemalloc/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: clang

name=jemalloc
version=5.3.1
release=2
source=(https://github.com/jemalloc/jemalloc/releases/download/$version/$name-$version.tar.bz2)

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--disable-cxx \
		--enable-prof \
		--enable-autogen
	make
	make DESTDIR=$PKG install
}