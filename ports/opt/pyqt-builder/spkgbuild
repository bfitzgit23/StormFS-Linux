# description	: PEP 517 build system for PyQt and SIP based projects
# homepage	: https://pypi.org/project/PyQt-builder/
# maintainer	: StormFS maintainers

description="PEP 517 build system for PyQt and SIP based projects"
name=pyqt-builder
version=1.20.3
release=1
source="https://files.pythonhosted.org/packages/source/p/pyqt_builder/pyqt_builder-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    python3 -m build --wheel --no-isolation || return 1
    python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
