# Description: Media player with built-in codecs that can play virtually all video and audio formats
# URL: https://www.smplayer.info/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: mplayer qt5 hicolor-icon-theme

name=smplayer
version=25.6.0
release=2
source=(https://github.com/smplayer-dev/$name/releases/download/v$version/$name-$version.tar.bz2)

build() {
	cd $name-$version

        # Disable -Werror "helps building with the newer gcc"
	sed -i "s|-W\ -Wall\ -Werror|-W -Wall|" webserver/Makefile

	make PREFIX=/usr \
	     DOC_PATH="\\\"/usr/share/doc/smplayer\\\"" \
	     QMAKE_OPTS=DEFINES+=NO_DEBUG_ON_CONSOLE
	make DOC_PATH=/usr/share/doc/smplayer \
	     DESTDIR=$PKG PREFIX=/usr install

}