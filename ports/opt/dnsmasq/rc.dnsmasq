#!/bin/sh
#
# /etc/rc.d/dnsmasq: start/stop dnsmasq daemon
#

. /etc/rc.subr

NAME="Dnsmasq daemon"
PROG=/usr/sbin/dnsmasq
PID=/run/dnsmasq/pid

case $1 in
	start)
		msg "Starting $NAME..."
		start_daemon -p $PID $PROG
		;;
	stop)
		msg "Stopping $NAME..."
		stop_daemon -p $PID $PROG
		;;
	restart)
		$0 stop
		sleep 1
		$0 start
		;;
	status)
		status_daemon $PROG
		;;
	*)
		echo "usage: $0 [start|stop|restart|status]"
		;;
esac

# End of file
