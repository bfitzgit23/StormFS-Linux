# description	: Server and userspace API for handling audio and video multimedia pipelines
# homepage	: https://pipewire.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: avahi fdk-aac ffmpeg libcanberra libdrm libcamera libxcb libsndfile libusb opus sdl2 valgrind xorg-libs doxygen graphviz jack ldacbt libmysofa vulkan xmltoman

name=pipewire
version=1.6.8
release=5
build_opt="-Dtests=disabled \
-Dinstalled_tests=disabled \
-Dexamples=disabled \
-Dsession-managers=[] \
-Dsystemd-user-service=disabled \
-Dalsa=enabled"
source="https://github.com/PipeWire/$name/archive/$version/$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
    install -d "$PKG/etc/alsa/conf.d" || return 1

    ln -s /usr/share/alsa/alsa.conf.d/50-pipewire.conf \
        "$PKG/etc/alsa/conf.d/50-pipewire.conf" || return 1

    ln -s /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf \
        "$PKG/etc/alsa/conf.d/99-pipewire-default.conf" || return 1
}
