# Description: SSH/SFTP library based on libfilezilla
# URL: https://filezilla-project.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: nettle libgmp libfilezilla argon2

name=fzssh
version=1.3.0
release=1
source=(https://sources.archlinux.org/other/packages/${name}/${name}-${version}.tar.xz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}