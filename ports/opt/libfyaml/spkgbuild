# description	: Fully-featured YAML parser and emitter library
# homepage	: https://github.com/pantoniou/libfyaml
# maintainer	: Brian

description="Fully-featured YAML parser and emitter library"
name=libfyaml
version=0.9.6
release=1
source="https://github.com/pantoniou/libfyaml/archive/refs/tags/v$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -Wno-dev || return 1

    cmake --build build -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" cmake --install build || return 1
}
