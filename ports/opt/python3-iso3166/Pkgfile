# Description: Self-contained ISO 3166-1 country definitions
# URL: https://github.com/deactivated/python-iso3166
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools

name=python3-iso3166
version=2.1.1
release=1
source=($name-$version.tar.gz::https://files.pythonhosted.org/packages/source/$_n/${name#*-}/${name#*-}-$version.tar.gz)

build() {
	cd ${name#*-}-$version
	python3 setup.py build
	python3 setup.py install --root=$PKG --optimize=1 --skip-build
}