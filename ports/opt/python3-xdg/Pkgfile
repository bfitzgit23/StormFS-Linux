# Description: Python3 library to access freedesktop.org standards
# URL: http://freedesktop.org/Software/pyxdg
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools

name=python3-xdg
version=0.28
release=2
source=($name-$version.tar.gz::https://pypi.org/packages/source/p/pyxdg/pyxdg-$version.tar.gz)

build() {
	cd pyxdg-$version
	python3 setup.py build
	python3 setup.py install \
	--prefix=/usr\
	--optimize=1 \
	--root=$PKG \
	--skip-build
}