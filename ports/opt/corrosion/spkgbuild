# description	: CMake integration for Rust projects
# homepage	: https://github.com/corrosion-rs/corrosion
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="CMake integration for Rust projects"
name=corrosion
version=0.6.1
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DCORROSION_BUILD_TESTS=OFF"
source="https://github.com/corrosion-rs/corrosion/archive/refs/tags/v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
