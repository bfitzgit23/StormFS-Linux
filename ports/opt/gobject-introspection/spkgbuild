# description	: A middleware layer between C libraries (using GObject) and language bindings
# homepage	: https://live.gnome.org/GObjectIntrospection
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: cairo gjs gtk-doc python3-mako python3-markdown

description="A middleware layer between C libraries (using GObject) and language bindings"
name=gobject-introspection
version=1.86.0
release=1
source="https://download.gnome.org/sources/$name/${version::4}/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
  scratch isinstalled cairo || BFS_GOBJECTINTROSPECTION+=' -D cairo=disabled'
  scratch isinstalled python3-mako python3-markdown || BFS_GOBJECTINTROSPECTION+=' -D doctool=disabled'

  meson setup build . \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true || return $?

  meson compile -C build -j "${JOBS:-1}" || return $?
  DESTDIR="$PKG" meson install -C build || return $?

  /usr/bin/python3 -m compileall -d /usr/lib/$name "$PKG" || return $?
  /usr/bin/python3 -O -m compileall -d /usr/lib/$name "$PKG" || return $?
  /usr/bin/python3 -OO -m compileall -d /usr/lib/$name "$PKG" || return $?
}
