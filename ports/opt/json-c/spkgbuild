# description	: JSON-C implements a reference-counted JSON object model and parser for C.
# homepage	: https://github.com/json-c/json-c
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
#
# Depons on: cmake

description="JSON-C implements a reference-counted JSON object model and parser for C."
name=json-c
version=0.19
release=1
build_opt=(
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -DCMAKE_BUILD_TYPE=Release
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_STATIC_LIBS=OFF
    -DBUILD_TESTING=OFF
    -DDISABLE_WERROR=ON
)
source="https://github.com/json-c/json-c/archive/refs/tags/json-c-$version-20260627.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake \
        -S . \
        -B build \
        "${build_opt[@]}"

    cmake --build build

    DESTDIR="$PKG" cmake --install build

    rm -rf "$PKG/usr/share/doc"
}
