# description	: neon is an HTTP and WebDAV client library, with a C interface.
# homepage	: https//notroj.github.io/neon/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gnutls libxml2 kerberos nss xmlto libproxy pakchois

description="neon is an HTTP and WebDAV client library, with a C interface."
name=neon
version=0.37.1
release=2
source="https://notroj.github.io/$name/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


	./configure --prefix=/usr    \
            --with-ssl       \
            --enable-shared  \
            --disable-static &&
make

	make DESTDIR=$PKG install
}
