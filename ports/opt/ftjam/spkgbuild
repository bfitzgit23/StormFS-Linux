# description	: Small Jam-compatible build tool used by ArgyllCMS
# homepage	: https://freetype.sourceforge.net/jam/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Small Jam-compatible build tool used by ArgyllCMS"
name=ftjam
version=2.5.3rc2
release=1
source="https://distfiles.gentoo.org/distfiles/72/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure --prefix=/usr
    make
    make DESTDIR="$PKG" install

    # Upstream installs the executable as jam; avoid colliding with other Jam variants.
    if [ -x "$PKG/usr/bin/jam" ]; then
        mv "$PKG/usr/bin/jam" "$PKG/usr/bin/ftjam"
        ln -s ftjam "$PKG/usr/bin/jam"
    fi
}
