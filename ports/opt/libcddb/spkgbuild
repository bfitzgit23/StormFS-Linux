# description	: libcddb package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libcddb package"
name=libcddb
version=1.3.2
release=1
keep_static=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.bz2 switch-default-server-to-gnudb.org.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
sed -e '/DEFAULT_SERVER/s/freedb.org/gnudb.gnudb.org/' \
    -e '/DEFAULT_PORT/s/888/&0/'                       \
    -i include/cddb/cddb_ni.h                          &&
sed '/^Genre:/s/Trip-Hop/Electronic/' -i tests/testdata/920ef00b.txt &&
sed '/DISCID/i# Revision: 42'         -i tests/testcache/misc/12340000
CFLAGS+=" -Wno-error=implicit-int -Wno-error=incompatible-pointer-types"
	./configure --prefix=/usr \
		--without-cdio

	make
	make DESTDIR=$PKG install
}
