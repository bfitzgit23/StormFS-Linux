# description	: The smartmontools package contains utility programs (smartctl, smartd) to control/monitor storage systems using the Self-Monitoring, Analysis and Reporting Technology System (S.M.A.R.T.) built into most modern ATA and SCSI disks.
# homepage	: https://downloads.sourceforge.net/smartmontools/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: curl lynx wget gnupg

description="The smartmontools package contains utility programs (smartctl, smartd) to control/monitor storage systems using the Self-Monitoring, Analysis and Reporting Technology System (S.M.A.R.T.) built into most modern ATA and SCSI disks."
name=smartmontools
version=7.5
release=3
source="https://downloads.sourceforge.net/$name/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr           \
            --sysconfdir=/etc       \
            --docdir=/usr/share/doc/$name-$version \
            --with-libsystemd=no \
            --with-systemdsystemunitdir=no \
            --with-systemdenvfile=no || return 1
make || return 1
	make DESTDIR=$PKG install || return 1

    # smartd is supervised by the OpenRC wrapper, not a systemd unit.
    rm -rf "$PKG/usr/lib/systemd" "$PKG/lib/systemd" || return 1
}
