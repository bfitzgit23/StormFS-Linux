# Description: Off-the-Record Messaging Library and Toolkit
# URL: https://otr.cypherpunks.ca/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libgcrypt

name=libotr
version=4.1.1
release=1
source=(http://www.cypherpunks.ca/otr/${name}-${version}.tar.gz libotr-4.1.1-fix-build-with-libgcrypt-1.10.patch)

build() {
	cd $name-$version
	patch -p1 < ../libotr-4.1.1-fix-build-with-libgcrypt-1.10.patch
	./configure --prefix=/usr --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
}