#!/bin/sh
########################################################################
# Begin lightdm
#
# Description : LightDM display manager
#
########################################################################

### BEGIN INIT INFO
# Provides:          lightdm
# Required-Start:    dbus consolekit
# Required-Stop:     dbus consolekit
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LightDM display manager.
# Description:       LightDM display manager.
### END INIT INFO

. /lib/lsb/init-functions

case "${1}" in
   start)
      log_info_msg "Starting the LightDM display manager..."
      start_daemon /usr/bin/lightdm
      evaluate_retval
      ;;

   stop)
      log_info_msg "Stopping the LightDM display manager..."
      killproc /usr/bin/lightdm
      evaluate_retval
      ;;

   restart)
      ${0} stop
      sleep 1
      ${0} start
      ;;

   status)
      statusproc /usr/bin/lightdm
      ;;

   *)
      echo "Usage: ${0} {start|stop|restart|status}"
      exit 1
      ;;
esac

exit 0

# End lightdm
