#!/bin/sh
########################################################################
# Begin consolekit
#
# Description : ConsoleKit session and seat daemon
#
########################################################################

### BEGIN INIT INFO
# Provides:          consolekit
# Required-Start:    dbus
# Required-Stop:     dbus
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ConsoleKit session and seat daemon.
# Description:       Provides local seat and session tracking for
#                    non-systemd desktops and display managers.
### END INIT INFO

. /lib/lsb/init-functions

case "${1}" in
   start)
      log_info_msg "Starting the ConsoleKit daemon..."
      start_daemon /usr/sbin/console-kit-daemon --no-daemon
      evaluate_retval
      ;;

   stop)
      log_info_msg "Stopping the ConsoleKit daemon..."
      killproc /usr/sbin/console-kit-daemon
      evaluate_retval
      ;;

   restart)
      ${0} stop
      sleep 1
      ${0} start
      ;;

   status)
      statusproc /usr/sbin/console-kit-daemon
      ;;

   *)
      echo "Usage: ${0} {start|stop|restart|status}"
      exit 1
      ;;
esac

exit 0

# End consolekit
