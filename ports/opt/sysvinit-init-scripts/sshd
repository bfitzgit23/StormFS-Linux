#!/bin/sh
########################################################################
# Begin sshd
#
# Description : Start the OpenSSH daemon
#
# Derived from BLFS bootscripts (BLFS 20250225) for StormFS Linux, plus
# the host-key and privsep-directory guards from the StormFS OpenRC
# script so first boot works without a manual ssh-keygen -A.
#
########################################################################

### BEGIN INIT INFO
# Provides:            sshd
# Required-Start:      $network
# Should-Start:        networkmanager krb5 samba
# Required-Stop:       $network
# Should-Stop:         networkmanager krb5 samba
# Default-Start:       2 3 4 5
# Default-Stop:        0 1 6
# Short-Description:   Starts sshd daemon.
# Description:         Starts sshd daemon.
### END INIT INFO

. /lib/lsb/init-functions

case "$1" in
    start)
        log_info_msg "Starting SSH Server..."
        # Privilege-separation directory must exist before sshd drops
        # privileges; host keys are generated on first start.
        install -d -m 700 /var/lib/sshd
        ssh-keygen -A >/dev/null 2>&1
        evaluate_retval
        start_daemon -f /usr/sbin/sshd
        evaluate_retval
        # Also prevent sshd from being killed by out of memory conditions
        sleep 1
        pid=`cat /run/sshd.pid 2>/dev/null`
        [ -n "${pid}" ] && echo "-16" > /proc/${pid}/oom_score_adj
        ;;

    stop)
        log_info_msg "Stopping SSH Server..."
        killproc -p "/run/sshd.pid" /usr/sbin/sshd
        evaluate_retval
        ;;

    reload)
        log_info_msg "Reloading SSH Server..."
        pid=`cat /run/sshd.pid 2>/dev/null`

        if [ -n "${pid}" ]; then
           kill -HUP "${pid}"
        else
           (exit 1)
        fi

        evaluate_retval
        ;;

    restart)
        $0 stop
        sleep 1
        $0 start
        ;;

    status)
        statusproc /usr/sbin/sshd
        ;;

    *)
        echo "Usage: $0 {start|stop|reload|restart|status}"
        exit 1
        ;;
esac

exit 0

# End sshd
