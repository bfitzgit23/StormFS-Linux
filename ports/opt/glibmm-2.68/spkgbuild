# description	: C++ interface for the popular glib library
# homepage	: https://www.gtkmm.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ interface for the popular glib library"
name=glibmm-2.68
version=2.90.0
release=1
source="https://ftp.gnome.org/pub/GNOME/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  meson setup build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true

  meson compile -C build
  DESTDIR="$PKG" meson install -C build

  find "$PKG" \( -type f -a -perm -g+w \) -exec chmod g-w '{}' +
}
