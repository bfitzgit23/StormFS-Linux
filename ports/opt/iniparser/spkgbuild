# description	: ini file parser
# homepage	: https://github.com/ndevilla/iniparser
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="ini file parser"
name=iniparser
version=4.2.6
release=1
source="https://github.com/ndevilla/iniparser/archive/v$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_DOCS=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=OFF \
        -Wno-dev || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" cmake --install build || return 1

    # Preserve BFSOS's historical flat-header compatibility.
    if [ -d "$PKG/usr/include/iniparser" ]; then
        for h in "$PKG"/usr/include/iniparser/*.h; do
            [ -e "$h" ] || continue
            ln -sf "iniparser/$(basename "$h")" \
                "$PKG/usr/include/$(basename "$h")" || return 1
        done
    fi
}
