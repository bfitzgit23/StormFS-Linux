# description	: Xapian is an open source search engine library.
# homepage	: https://oligarchy.co.uk/xapian/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: valgrind

description="Xapian is an open source search engine library."
name=xapian
version=1.4.25
release=1
source="https://mirror.freedif.org/pub/blfs/conglomeration/xapian/xapian-core-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/$name-core-$version &&
make
	make DESTDIR=$PKG install
}
