# description	: Seamless operability between C++11 and Python
# homepage	: https://github.com/pybind/pybind11
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Seamless operability between C++11 and Python"
name=pybind11
version=3.1.0
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DPYBIND11_TEST=OFF"
source="https://github.com/pybind/pybind11/archive/refs/tags/v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
