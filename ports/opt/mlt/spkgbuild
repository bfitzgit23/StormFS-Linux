# description	: MLT package is the Media Lovin Toolkit. It is an open source multimedia framework, designed and developed for television broadcasting. It provides a toolkit for broadcasters, video editors, media players, transcoders, web streamers and many more types of applications.
# homepage	: https://github.com/mltframework/mlt/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: doxygen fftw libexif jack moveit sox vid.stab

description="MLT package is the Media Lovin Toolkit. It is an open source multimedia framework, designed and developed for television broadcasting. It provides a toolkit for broadcasters, video editors, media players, transcoders, web streamers and many more types of applications."
name=mlt
version=7.40.0
release=7
source="https://github.com/mltframework/$name/releases/download/v$version/$name-$version.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/mlt-7.40.0-ffmpeg-9.0.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
    mkdir -p build || return 1
    cd build || return 1

    cmake \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DMOD_QT=OFF \
        -DMOD_QT6=ON \
        -DMOD_SOX=OFF \
        -DMOD_MOVIT=OFF \
        -DMOD_VIDSTAB=OFF \
        -DMOD_JACKRACK=OFF \
        -DMOD_RUBBERBAND=OFF \
        -DMOD_RNNOISE=ON \
        -Wno-author \
        .. || return 1

    make -j${JOBS:-1} || return 1
    make DESTDIR="$PKG" install || return 1
}
