# description	: self-hosting compiler that translates Vala source code into C
# homepage	: https://wiki.gnome.org/Projects/Vala
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: dbus libxslt  help2man jing weasyprint

description="self-hosting compiler that translates Vala source code into C"
name=vala
version=0.56.19
release=1
source="https://download.gnome.org/sources/vala/${version%.*}/vala-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

  ./configure --prefix=/usr &&
make
  make install DESTDIR=$PKG
}
