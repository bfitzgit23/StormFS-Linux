# Description: Helper daemon to browse the network for remote CUPS queues and IPP network printers
# URL: https://github.com/OpenPrinting/cups-browsed
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: glib libppd

name=cups-browsed
version=2.1.1
release=1
source=(https://github.com/OpenPrinting/$name/releases/download/$version/$name-$version.tar.xz rc.cups-browsed run.cups-browsed)

build() {
	cd $name-$version
	
	# disable avahi
	prt-get isinst avahi || OPTS=' --disable-avahi'

	./configure $OPTS \
		--prefix=/usr \
		--sysconfdir=/etc \
		--runstatedir=/run \
		--with-cups-rundir=/run/cups \
		--without-rcdir
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share/doc

	# rc service
	prt-get isinst sysvinit && \
		install -Dm755 $SRC/rc.$name $PKG/etc/rc.d/$name || continue
	
	# runit service
	prt-get isinst runit && {
		install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
		ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
	} || continue
}