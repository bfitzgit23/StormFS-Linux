# description	: GN meta-build system used by Chromium
# homepage	: https://gn.googlesource.com/gn/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GN meta-build system used by Chromium"
name=gn
version=0.20260907
release=2
# Custom build required: GN bootstraps its own Ninja graph with build/gen.py;
# this is not a normal BFSOS configure/CMake/Meson/Make project.
# The googlesource archive extracts flat, with no single source directory.
source="https://gn.googlesource.com/gn/+archive/5df47e556efde72cc576d8a3af23b58b614345bd.tar.gz"

build() {
    [ -f build/gen.py ] || return 1
    python3 build/gen.py --allow-warnings || return 1
    ninja -C out gn || return 1
    install -Dm755 out/gn "$PKG/usr/bin/gn" || return 1
}
