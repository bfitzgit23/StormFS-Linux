# Description: Vulkan Utilities and Tools
# URL: https://www.khronos.org/vulkan
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: glslang wayland-protocols volk

name=vulkan-tools
version=1.4.350.1
release=1
source=($name-$version.tar.gz::https://github.com/KhronosGroup/Vulkan-Tools/archive/${name%-*}-sdk-$version/Vulkan-Tools-$version.tar.gz)

build() {
	cmake -S Vulkan-Tools-${name%-*}-sdk-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="${CFLAGS} -ffat-lto-objects" \
		-DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS} -ffat-lto-objects" \
		-DBUILD_ICD=OFF \
		-DBUILD_CUBE=True \
		-DBUILD_VULKANINFO=True \
		-DBUILD_WSI_XCB_SUPPORT=True \
		-DBUILD_WSI_XLIB_SUPPORT=True \
		-DBUILD_WSI_WAYLAND_SUPPORT=True \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}