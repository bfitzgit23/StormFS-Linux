# Description: C library for x86 CPU detection and feature extraction
# URL: https://github.com/anrieff/libcpuid
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja

name=libcpuid
version=0.8.1
release=1
source=(https://github.com/anrieff/libcpuid/releases/download/v$version/$name-$version.tar.gz)

build() {
         cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DLIBCPUID_ENABLE_DOCS=OFF \
		-DLIBCPUID_BUILD_DRIVERS=OFF \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}