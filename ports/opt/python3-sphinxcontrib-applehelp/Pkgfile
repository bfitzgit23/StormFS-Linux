# Description: sphinx extension which outputs Apple help books
# URL: https://github.com/sphinx-doc/sphinxcontrib-applehelp/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-setuptools python3-gpep517 python3-flit-core

name=python3-sphinxcontrib-applehelp
version=2.0.0
release=2
source=($name-$version.tar.gz::https://github.com/sphinx-doc/${name#*-}/archive/$version/${name#*-}-$version.tar.gz)

build() {
	cd ${name#*-}-$version

	    gpep517 build-wheel \
		   --wheel-dir .dist \
		   --output-fd 3 3>&1 >&2
	    python3 -m installer -d $PKG \
			.dist/*.whl
}