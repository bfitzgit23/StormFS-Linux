# description	: Extensible I/O abstraction library for structured file formats
# homepage	: https://gitlab.gnome.org/GNOME/libgsf
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Extensible I/O abstraction library for structured file formats"
name=libgsf
version=1.14.58
release=2
source="https://download.gnome.org/sources/$name/1.14/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
    ./configure --prefix=/usr --disable-static || return 1
    make -j"${JOBS:-1}" || return 1
    make DESTDIR="$PKG" install || return 1
}
