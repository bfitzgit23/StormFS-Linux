# Description: cpptoml is a header-only library for parsing TOML
# URL: https://github.com/skystrife/cpptoml
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake ninja

name=cpptoml
version=0.1.1
release=3
source=(https://github.com/skystrife/cpptoml/archive/v$version/$name-$version.tar.gz 123.patch)

build() {
	patch -Np1 -d $name-$version -i $SRC/123.patch

	cmake -S $name-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}