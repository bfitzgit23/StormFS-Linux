# description	: imagemagick package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="imagemagick package"
name=imagemagick
version=7.1.2_31
srcver=7.1.2-31
release=1
build_opt="--prefix=/usr
            --sysconfdir=/etc
            --enable-hdri
            --with-modules
            --with-perl
            --disable-static"
source="https://download.imagemagick.org/releases/ImageMagick-$srcver.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$srcver" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
