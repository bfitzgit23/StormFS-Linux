# Description: Linux Advanced Power Management
# URL: https://linrunner.de/en/tlp/tlp.html
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: iw hdparm git usbutils pciutils ethtool

name=tlp
version=1.10.1
release=1
source=(https://github.com/linrunner/TLP/archive/$version/$name-$version.tar.gz rc.tlpd run.tlpd finish.tlpd)

build() {
	cd TLP-$version
	make DESTDIR=$PKG install

	rm -rf $PKG/usr/lib/systemd

	# runit service
	prt-get isinst runit && {
		install -Dm755 $SRC/run.tlpd $PKG/etc/sv/tlpd/run
		install -Dm755 $SRC/finish.tlpd $PKG/etc/sv/tlpd/finish
		ln -s /run/runit/supervise.tlpd $PKG/etc/sv/tlpd/supervise
	} || continue

	# rc service
	prt-get isinst sysvinit && \
		install -Dm755 $SRC/rc.tlpd $PKG/etc/rc.d/tlpd || continue
}