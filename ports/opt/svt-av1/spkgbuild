# description	: Scalable Video Technology AV1 encoder
# homepage	: https://gitlab.com/AOMediaCodec/SVT-AV1
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=svt-av1
version=4.2.0
release=1
source="https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v$version/SVT-AV1-v$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DBUILD_SHARED_LIBS=ON \
        -Wno-dev || return 1
    ninja -C build || return 1
    DESTDIR="$PKG" ninja -C build install || return 1
}
