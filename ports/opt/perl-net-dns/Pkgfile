# Description: Perl Interface to the Domain Name System
# URL: http://search.cpan.org/~nlnetlabs/Net-DNS/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: perl-digest-hmac

name=perl-net-dns
version=1.55
release=1
source=(http://search.cpan.org/CPAN/authors/id/N/NL/NLNETLABS/Net-DNS-${version}.tar.gz)

build() {
	cd Net-DNS-$version

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make OPTIMIZE="$CFLAGS" DESTDIR="$PKG" install

	find "$PKG" -depth \
		-type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
		-type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
		-type d -empty -exec rmdir {} +
}