# Description: A Python 3.x interface to libcurl
# URL: http://pycurl.sourceforge.net/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: curl

name=python3-pycurl
version=7.46.0
release=1
source=($name-$version.tar.gz::https://github.com/pycurl/pycurl/archive/REL_${_ver}/python-pycurl-$version.tar.gz)

build() {
	cd pycurl-REL_${_ver}
	CFLAGS="$CFLAGS" CXXFLAGS="$CXXFLAGS" \
	python3 setup.py --with-openssl install --root=$PKG --skip-build
	rm -rf $PKG/usr/share/doc
}