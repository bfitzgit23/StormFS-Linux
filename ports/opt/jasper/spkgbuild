# description	: The JasPer Project is an open-source initiative to provide a free software-based reference implementation of the JPEG-2000 codec.
# homepage	: https://github.com/jasper-software/jasper/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The JasPer Project is an open-source initiative to provide a free software-based reference implementation of the JPEG-2000 codec."
name=jasper
version=4.2.9
release=2
source="https://github.com/jasper-software/$name/archive/version-$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
mkdir BUILD &&
cd    BUILD &&

cmake -DCMAKE_INSTALL_PREFIX=/usr    \
      -DCMAKE_BUILD_TYPE=Release     \
      -DCMAKE_SKIP_INSTALL_RPATH=YES \
      -DJAS_ENABLE_DOC=NO            \
      -DALLOW_IN_SOURCE_BUILD=YES    \
      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/$name-$version \
      ..  &&

make
	make DESTDIR=$PKG install
}
