# description	: ACPI Component Architecture iASL compiler
# homepage	: https://www.intel.com/content/www/us/en/developer/topic-technology/open/acpica/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="ACPI Component Architecture iASL compiler"
name=acpica
version=20260408
release=3
source="https://github.com/open-acpica/acpica/releases/download/$version/acpica-unix-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
    make iasl -j "${JOBS:-1}" || return 1

    mkdir -p "$PKG/usr/bin"
    install -m755 generate/unix/bin/iasl "$PKG/usr/bin/iasl" || return 1
}
