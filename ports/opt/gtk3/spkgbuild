# description	: A multi-platform toolkit for creating graphical user interfaces
# homepage	: https://www.gtk.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: colord cups wayland-protocols

description="A multi-platform toolkit for creating graphical user interfaces"
name=gtk3
version=3.24.52
release=4
build_opt=(
  -Dman=true
  -Dbroadway_backend=true
  -Dtests=false
  -Dinstalled_tests=false
)
source="https://download.gnome.org/sources/gtk/3.24/gtk-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
  if ! scratch isinstalled colord >/dev/null 2>&1; then
    build_opt+=(
      -Dcolord=no
    )
  fi

  if scratch isinstalled libxkbcommon >/dev/null 2>&1 &&
     scratch isinstalled wayland-protocols >/dev/null 2>&1; then
    build_opt+=(
      -Dwayland_backend=true
    )
  else
    build_opt+=(
      -Dwayland_backend=false
    )
  fi
	bfs_autobuild
}
