# description	: Unified high-level API for mobile broadband modems
# homepage	: https://gitlab.freedesktop.org/mobile-broadband/ModemManager
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gtk-doc libxslt

description="Unified high-level API for mobile broadband modems"
name=modemmanager
version=1.24.2
release=3
source="https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$version/ModemManager-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dbash_completion=false \
        -Dqrtr=false || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
