# description	: HTTP library implementation in C
# homepage	: https://wiki.gnome.org/action/show/Projects/libsoup
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: gobject-introspection vala apache brotli curl MIT Kerberos V5  gtk-doc php samba sysprof

description="HTTP library implementation in C"
name=libsoup3
version=3.6.6
release=1
source="https://ftp.gnome.org/pub/gnome/sources/libsoup/${version%.*}/libsoup-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
  sed 's/apiversion/soup_version/' -i docs/reference/meson.build
   mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -Dvapi=enabled      \
            -Dgssapi=disabled   \
            -Dsysprof=disabled  \
            ..                  &&
ninja
  DESTDIR=$PKG ninja install

  rm -r $PKG/usr/share/locale
}
