# Description: FSEvents API with signals handled (without RubyCocoa)
# URL: https://github.com/thibaudgg/rb-fsevent
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ruby

name=ruby-rb-fsevent
version=0.11.2
release=1
source=(https://rubygems.org/downloads/${name#*-}-$version.gem)

build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}