# description	: C++ and Python library of 2D/3D vector, matrix, math, and utility classes
# homepage	: https://github.com/AcademySoftwareFoundation/Imath
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="C++ and Python library of 2D/3D vector, matrix, math, and utility classes"
name=imath
version=3.2.3
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DBUILD_TESTING=OFF
           -DIMATH_INSTALL_PKG_CONFIG=ON"
source="https://github.com/AcademySoftwareFoundation/Imath/archive/refs/tags/v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
