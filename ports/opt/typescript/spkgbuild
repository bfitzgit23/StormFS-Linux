# description	: TypeScript language compiler
# homepage	: https://www.typescriptlang.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="TypeScript language compiler"
name=typescript
version=5.7.3
release=1
source="https://registry.npmjs.org/typescript/-/typescript-$version.tgz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

    install -d "$PKG/usr/lib/node_modules/typescript"
    cp -a bin lib package.json \
        "$PKG/usr/lib/node_modules/typescript/" || return 1

    install -d "$PKG/usr/bin"

    ln -sf ../lib/node_modules/typescript/bin/tsc \
        "$PKG/usr/bin/tsc"

    ln -sf ../lib/node_modules/typescript/bin/tsserver \
        "$PKG/usr/bin/tsserver"
}
