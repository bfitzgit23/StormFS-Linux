# Description: GTK+ frontend to various command line archivers
# URL: https://github.com/ib/xarchiver
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 binutils zip gzip unrar unzip

name=xarchiver
version=0.5.4.26
release=1
source=(https://github.com/ib/$name/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	export CFLAGS="$CFLAGS -fcommon"

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/xfce4 \
		--disable-doc
	make
	make DESTDIR=$PKG install

}