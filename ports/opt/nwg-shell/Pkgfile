# Description: nwg-shell meta-package
# URL: https://github.com/nwg-piotr/nwg-shell
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: azote foot gopsuinfo gnome-themes-extra grim imagemagick jq l3afpad libappindicator network-manager-applet nwg-displays nwg-dock nwg-drawer nwg-look nwg-menu nwg-panel nwg-shell-config nwg-shell-wallpapers papirus-icon-theme polkit-gnome swappy sway swayidle swaylock swaync ttf-dejavu wlsunset xdg-user-dirs xdg-utils xwayland wl-clipboard

name=nwg-shell
version=0.5.50
release=1
source=($name-$version.tar.gz::https://github.com/nwg-piotr/nwg-shell/archive/refs/tags/v$version.tar.gz)

build() {
	cd $name-$version
	python3 setup.py install --root=$PKG --optimize=1
	install -D -t $PKG/usr/bin scripts/*
	install -D -t $PKG/usr/share/backgrounds nwg-shell.jpg
}