# Description: Widevine enables secure premium content protection utilizing free-to-use, standards-based solutions for OTT and CAS services
# URL: http://www.widevine.com/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=chromium-widevine
version=149.0.7827.196
release=1
source=($name-$version.deb::https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_$version-1_amd64.deb)

build() {
	ar x $name-$version.deb
	bsdtar -x --strip-components 4 -f data.tar.xz opt/google/chrome/WidevineCdm

	install -dm755 $PKG/usr/lib/chromium/
	cp -a WidevineCdm $PKG/usr/lib/chromium/
	find $PKG -name '*.so' -exec chmod +x {} \;

	ln -s WidevineCdm/_platform_specific/linux_x64/libwidevinecdm.so \
	$PKG/usr/lib/chromium/libwidevinecdm.so
}