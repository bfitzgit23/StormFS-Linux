# description	: USB traffic redirection library for virtualization
# homepage	: https://gitlab.freedesktop.org/spice/usbredir
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="USB traffic redirection library for virtualization"
name=usbredir
version=0.15.0
release=1
build_opt=(-Dtools=enabled -Dtests=disabled)
source="https://gitlab.freedesktop.org/spice/usbredir/-/archive/usbredir-$version/usbredir-usbredir-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
