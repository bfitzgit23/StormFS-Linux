# Description: A tool for passing the include path and/or library paths to build tools during the configure and make file execution
# URL: https://pkg-config.freedesktop.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=pkg-config
version=0.29.2
release=2
source=(https://gitlab.freedesktop.org/pkg-config/pkg-config/-/archive/pkg-config-0.29.2/pkg-config-pkg-config-0.29.2.tar.gz copy-m4.patch)

build() {
	cd $name-$name-$version

	    patch -Np1 -i $SRC/copy-m4.patch

	./autogen.sh --no-configure
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install

}