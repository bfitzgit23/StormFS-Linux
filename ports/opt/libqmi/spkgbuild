# description	: GLib-based library for talking to WWAN modems and devices using the Qualcomm MSM Interface (QMI) protocol.
# homepage	: https://gitlab.freedesktop.org/mobile-broadband/libqmi
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bash-completion gi-docgen

description="GLib-based library for talking to WWAN modems and devices using the Qualcomm MSM Interface (QMI) protocol."
name=libqmi
version=1.38.0
release=1
source="https://gitlab.freedesktop.org/mobile-broadband/libqmi/-/archive/$version/libqmi-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dgtk_doc=false \
        -Dman=false || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
