# description	: Vulkan ICD loader
# homepage	: https://github.com/KhronosGroup/Vulkan-Loader
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Vulkan ICD loader"
name=vulkan-loader
version=1.4.357.0
# scratchpkg caches sources by filename.  Vulkan-Headers and Vulkan-Loader
# both publish vulkan-sdk-${version}.tar.gz, so use a package-specific cache
# name or one package silently builds from the other package's archive.
release=8
source="${name}-${version}.tar.gz::https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/vulkan-sdk-${version}.tar.gz"
# Drop a manifest written for the old shared cache filename; pkgbuild will
# regenerate it for the package-specific source name above.
if [ -f .checksums ] && ! grep -q "[[:space:]]${name}-${version}[.]tar[.]gz$" .checksums; then
    rm -f .checksums
fi

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_RPATH=TRUE || return 1

    cmake --build build -j "${JOBS:-1}" || return 1

    [ -n "$PKG" ] || return 1
    cmake --install build --prefix "$PKG/usr" || return 1

    _vulkan_lib=
    [ -d "$PKG/usr/lib" ] && _vulkan_lib=$(find "$PKG/usr/lib" -maxdepth 1 -type f \
        \( -name 'libvulkan.so' -o -name 'libvulkan.so.*' \) -print -quit)
    if [ -z "$_vulkan_lib" ]; then
        _vulkan_lib=$(find . -type f \
            \( -name 'libvulkan.so' -o -name 'libvulkan.so.*' \) -print -quit)
        [ -n "$_vulkan_lib" ] || {
            echo "vulkan-loader: build did not produce libvulkan.so" >&2
            return 1
        }
        install -d "$PKG/usr/lib" || return 1
        install -m 0755 "$_vulkan_lib" "$PKG/usr/lib/${_vulkan_lib##*/}" || return 1
    fi

    _vulkan_name=${_vulkan_lib##*/}
    ln -sfn "$_vulkan_name" "$PKG/usr/lib/libvulkan.so.1" || return 1
    [ "$_vulkan_name" = libvulkan.so ] ||
        ln -sfn "$_vulkan_name" "$PKG/usr/lib/libvulkan.so" || return 1

	if [ ! -d "$PKG/usr/lib" ] || ! find "$PKG/usr/lib" -maxdepth 1 \
		\( -name 'libvulkan.so' -o -name 'libvulkan.so.*' \) \
		-print -quit | grep -q .; then
        echo "vulkan-loader: libvulkan.so was not staged" >&2
        return 1
    fi
}
