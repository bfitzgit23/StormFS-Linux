# Description: Instrument file software library
# URL: https://github.com/swami/libinstpatch
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cmake glib libsndfile python3

name=libinstpatch
version=1.1.7
release=1
source=(https://github.com/swami/libinstpatch/archive/v$version/$name-v$version.tar.gz)

build() {
	cmake -S $name-$version -B build \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D LIB_INSTALL_DIR=/usr/lib \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build
}