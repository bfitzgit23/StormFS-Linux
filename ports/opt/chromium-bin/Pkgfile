# Description: Chromium binary package from Arch Linux
# URL: https://www.chromium.org/
# Maintainer: Brian Madonna email bmadonnaster@gmail.com
# Depends on: alsa-lib at-spi2-core atk cups dbus-glib fontconfig freetype2 harfbuzz icu libXcomposite libXcursor libXdamage libXext libXfixes libXrandr libXrender libXScrnSaver libdrm libgbm libxcb gtk3 nspr nss pango pciutils pipewire png systemd libva xdg-utils

name=chromium-bin
version=138.0.7103.49
release=1
source=(https://archive.archlinux.org/packages/c/chromium/chromium-$version-1-x86_64.pkg.tar.zst
    chromium.d/default)

build() {
    cd $SRC

    # Extract the Arch package
    tar xf chromium-$version-1-x86_64.pkg.tar.zst

    # Install files to package directory
    install -d $PKG/usr/lib/chromium
    cp -a usr/lib/chromium/* $PKG/usr/lib/chromium/

    # Install desktop file
    install -Dm644 usr/share/applications/chromium.desktop $PKG/usr/share/applications/chromium.desktop

    # Install icons
    for size in 24 48 64 128 256; do
        if [ -f "usr/share/icons/hicolor/${size}x${size}/apps/chromium.png" ]; then
            install -Dm644 usr/share/icons/hicolor/${size}x${size}/apps/chromium.png \
                $PKG/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png
        fi
    done

    # Install man page
    install -Dm644 usr/share/man/man1/chromium.1.gz $PKG/usr/share/man/man1/chromium.1.gz

    # Install launcher script
    install -Dm755 usr/bin/chromium $PKG/usr/bin/chromium

    # Install chromium default flags
    install -Dm644 $SRC/chromium.d/default $PKG/etc/chromium.d/default

    # Create symlinks
    mkdir -p $PKG/usr/bin
    ln -s /usr/lib/chromium/chromedriver $PKG/usr/bin/chromedriver

    # Remove unnecessary files
    rm -rf $PKG/usr/lib/chromium/locales/*.pak
    install -Dm644 usr/lib/chromium/locales/en-US.pak $PKG/usr/lib/chromium/locales/en-US.pak

    # Create revdep directory
    mkdir -p $PKG/etc/revdep.d
    echo "/usr/lib/chromium" > $PKG/etc/revdep.d/chromium-bin
}
