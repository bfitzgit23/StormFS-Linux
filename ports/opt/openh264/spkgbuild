# description	: Cisco OpenH264 codec
# homepage	: https://github.com/cisco/openh264
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Cisco OpenH264 codec"
name=openh264
version=2.6.0
release=2
build_type=makefile_build
build_opt=(PREFIX=/usr)
source="https://github.com/cisco/openh264/archive/refs/tags/v$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
