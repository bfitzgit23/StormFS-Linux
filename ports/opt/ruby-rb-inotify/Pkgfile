# Description: Thorough inotify wrapper for Ruby using FFI
# URL: https://github.com/guard/rb-inotify
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ruby-ffi

name=ruby-rb-inotify
version=0.11.1
release=2
source=(https://rubygems.org/downloads/${name#*-}-$version.gem)

build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}