#!/bin/sh
#
# /etc/rc.d/mpd: start/stop mpd daemon
#
. /etc/rc.subr


NAME="Mpd daemon"
PROG=/usr/bin/mpd
PID=/run/mpd/pid
OPTS=""

case $1 in
start)
	msg "Starting $NAME..."
	start_daemon -p $PID  $PROG $OPTS
	;;
stop)
	msg "Stopping $NAME"
	stop_daemon -p $PID  $PROG
	;;
restart)
	$0 stop
	sleep 1
	$0 start
	;;
status)
	status_daemon $PROG
	;;
*)
	echo "usage: $0 [start|stop|restart|status]"
	;;
esac

# End of file
