# description	: HTTP/2 C Library and tools
# homepage	: https://github.com/libnghttp2/libnghttp2/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libxml2 boost c-ares cython jansson libevent sphinx jemalloc libev mruby spdylay cUnit

description="HTTP/2 C Library and tools"
name=libnghttp2
version=1.70.0
release=1
source="https://github.com/nghttp2/nghttp2/releases/download/v$version/nghttp2-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/libnghttp2-$version &&
make

	make DESTDIR=$PKG install
}
