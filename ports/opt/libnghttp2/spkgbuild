# description	: HTTP/2 C Library and tools
# homepage	: https://github.com/libnghttp2/libnghttp2/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libxml2 boost c-ares cython jansson libevent sphinx jemalloc libev mruby spdylay cUnit

name=libnghttp2
version=1.70.0
release=1
source="https://github.com/nghttp2/nghttp2/releases/download/v$version/nghttp2-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
	./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/libnghttp2-$version &&
make

	make DESTDIR=$PKG install
}
