# Description: Ruby Documentation tool
# URL: https://yardoc.org/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: ruby

name=ruby-yard
version=0.9.44
release=1
source=(https://rubygems.org/downloads/${name#*-}-$version.gem)

build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}