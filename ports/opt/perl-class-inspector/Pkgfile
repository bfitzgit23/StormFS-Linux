# Description: Get information about a class and its structure
# URL: https://search.cpan.org/dist/Class-Inspector
# Maintainer: Venom Linux Team, venomlinux at disroot dot org

name=perl-class-inspector
version=1.36
release=1
source=($name-$version.tar.gz::https://search.cpan.org/CPAN/authors/id/P/PL/PLICEASE/Class-Inspector-$version.tar.gz)

build() {
	cd Class-Inspector-$version
	perl Makefile.PL INSTALLDIRS=vendor
	make
	make DESTDIR=$PKG install
}