# Description: Simple plain text editor for GTK+ 3
# URL: https://github.com/stevenhoneyman/l3afpad
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gtk3 intltool

name=l3afpad
version=0.8.18.1.11
release=1
source=(https://github.com/stevenhoneyman/l3afpad/archive/v$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}