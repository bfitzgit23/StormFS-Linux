# description	: Low-level data structure handling, portability wrappers, and interfaces for runtime functionality
# homepage	: https://www.gtk.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Low-level data structure handling, portability wrappers, and interfaces for runtime functionality"
name=glib
version=2.90.0
release=1
source="https://download.gnome.org/sources/$name/${version:0:4}/$name-$version.tar.xz https://www.linuxfromscratch.org/patches/blfs/svn/glib-skip_warnings-1.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
  local introspection_opt="-Dintrospection=disabled"

  if scratch isinstalled gobject-introspection >/dev/null 2>&1; then
    introspection_opt="-Dintrospection=enabled"
  fi

  meson setup build . \
    --prefix=/usr \
    --buildtype=release \
    -D glib_debug=disabled \
    -D man-pages=enabled \
    -D sysprof=disabled \
    "$introspection_opt" || return $?

  meson compile -C build -j "${JOBS:-1}" || return $?
  DESTDIR="$PKG" meson install --no-rebuild -C build || return $?
}
