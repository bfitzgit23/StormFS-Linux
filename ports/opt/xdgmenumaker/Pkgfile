# Description: A command line tool that generates XDG menus for several window managers
# URL: https://github.com/gapan/xdgmenumaker
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: python3-xdg gtk3 python3-gobject3

name=xdgmenumaker
version=2.4
release=1
source=(https://github.com/gapan/xdgmenumaker/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	make
	make DESTDIR=$PKG PREFIX=/usr install
}