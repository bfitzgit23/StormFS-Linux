# description	: Python 3 bindings for Qt 5
# homepage	: https://www.riverbankcomputing.com/software/pyqt/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Python 3 bindings for Qt 5"
name=python3-pyqt5
version=5.15.11
release=3
source="https://files.pythonhosted.org/packages/source/P/PyQt5/PyQt5-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "PyQt5-5.15.11" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    local pyver
    pyver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

    yes yes | \
      PATH=/opt/qt5/bin:$PATH \
      DESTDIR="$PKG" \
      sip-install \
        --target-dir "/usr/lib/python${pyver}/site-packages" \
        --scripts-dir "/usr/bin" || return 1
}
