# /etc/conf.d/openrc - Default configuration for OpenRC on StormFS

# Default runlevel to boot into (1-6)
DEFAULT_RUNLEVEL=3

# Extra parameters passed to the kernel at boot
#KCL=""

# Set to "YES" to enable parallel service startup
#RC_PARALLEL="NO"

# Set to "YES" to show dependency information on service output
#RC_VERBOSE="NO"

# Modules to load at boot (space separated)
#MODULES=""

# NTP client to use (ntp-client or chronyd)
#NTP_CLIENT="ntp-client"

# Network manager type (NetworkManager, connman, or none)
#NETWORK_MANAGER="NetworkManager"

# Console font and keymap
#CONSOLEFONT="Lat2-Terminus16"
#CONSOLEMAP=""
#KEYMAP="us"

# Log level for OpenRC services
#RC_LOGLEVEL="notice"
