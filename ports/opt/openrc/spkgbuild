# description	: Dependency-based service manager and init system
# homepage	: https://github.com/OpenRC/openrc
# maintainer	: BFSOS maintainers

description="Dependency-based service manager and init system"
name=openrc
version=0.63
release=3
source="https://github.com/OpenRC/openrc/archive/$version/openrc-$version.tar.gz https://www.linuxfromscratch.org/glfs/view/dev/download/openrc/openrc-$version-lock-1.patch inittab"

build() {
    _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
    [ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
    [ -n "$_bfs_src" ] || return 1
    cd "$_bfs_src" || return 1

    # OpenRC 0.63 does not expose uucp_group until this patch is applied.
    # Apply it before Meson validates the -D uucp_group=root option.
    for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
        [ -f "$_bfs_patch" ] || continue
        patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
    done

    mkdir build && cd build || return 1
    meson setup .. \
        --prefix=/usr \
        --buildtype=release \
        -D uucp_group=root || return 1
    ninja -j"${JOBS:-1}" || return 1
    DESTDIR="$PKG" ninja install || return 1

    install -d -m 0755 "$PKG/etc/runlevels" "$PKG/etc/init.d"
    ln -sfn /sbin/openrc-init "$PKG/sbin/init"

    # openrc-init reads /etc/inittab for the sysinit/wait states and the
    # console gettys; without it the system never reaches a login prompt.
    install -m 0644 inittab "$PKG/etc/inittab" || return 1
}
