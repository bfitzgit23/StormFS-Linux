# description	: Audio/video recording, conversion and streaming framework
# homepage	: https://ffmpeg.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: dav1d libdrm libwebp openjpeg2 pulseaudio samba speex v4l-utils vulkan-loader

name=ffmpeg
version=9.0.1
release=4
source="https://ffmpeg.org/releases/ffmpeg-$version.tar.xz https://www.linuxfromscratch.org/patches/blfs/svn/ffmpeg-$version-chromium_method-1.patch"

build() {
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
  ./configure \
    --prefix=/usr \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --disable-static \
    --enable-shared \
    --disable-debug \
    --enable-libaom \
    --enable-libass \
    --enable-libfdk-aac \
    --enable-libfreetype \
    --enable-libmp3lame \
    --enable-libopus \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libx264 \
    --enable-libx265 \
    --enable-openssl \
    --enable-vdpau \
    --ignore-tests=enhanced-flv-av1,enhanced-flv-multitrack || return 1

  make -j "${JOBS:-1}" || return 1

  gcc tools/qt-faststart.c \
    -o tools/qt-faststart || return 1

  make DESTDIR="$PKG" install || return 1

  install -Dm755 \
    tools/qt-faststart \
    "$PKG/usr/bin/qt-faststart" || return 1
}
