# description	: VirGL virtual OpenGL/Vulkan renderer
# homepage	: https://gitlab.freedesktop.org/virgl/virglrenderer
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=virglrenderer
version=1.3.0
release=1
build_opt=(
    -Ddefault_library=shared
    -Dtests=false
    -Dvenus=true
)
source="https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$version/virglrenderer-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
