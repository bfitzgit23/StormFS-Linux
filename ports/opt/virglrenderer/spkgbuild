# description	: VirGL virtual OpenGL/Vulkan renderer
# homepage	: https://gitlab.freedesktop.org/virgl/virglrenderer
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="VirGL virtual OpenGL/Vulkan renderer"
name=virglrenderer
version=1.3.0
release=1
build_opt=(
    -Ddefault_library=shared
    -Dtests=false
    -Dvenus=true
)
source="https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$version/virglrenderer-$version.tar.bz2"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
