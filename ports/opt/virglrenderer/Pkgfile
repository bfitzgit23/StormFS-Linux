# Description: A virtual 3D GPU library, that allows the guest operating system to use the host GPU to accelerate 3D rendering
# URL: https://gitlab.freedesktop.org/virgl/virglrenderer
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libepoxy mesa libva

name=virglrenderer
version=1.3.0
release=1
source=(https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/$version/$name-$version.tar.gz)

build() {
	meson setup $name-$version build -Dvideo=true
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}