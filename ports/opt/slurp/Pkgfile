# Description: Select a region in a Wayland compositor and print it to the standard output. Works well with grim.
# URL: https://github.com/emersion/slurp
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: meson cairo wayland-protocols libxkbcommon scdoc

name=slurp
version=1.5.0
release=2
source=($name-$version.tar.gz::https://github.com/emersion/slurp/archive/refs/tags/v$version.tar.gz)

build() {
	meson setup $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build 
}