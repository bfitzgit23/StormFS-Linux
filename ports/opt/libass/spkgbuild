# description	: A portable subtitle renderer for the ASS/SSA (Advanced Substation Alpha/Substation Alpha) subtitle format.
# homepage	: https://github.com/libass/libass
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: fontconfig libunibreak

description="A portable subtitle renderer for the ASS/SSA (Advanced Substation Alpha/Substation Alpha) subtitle format."
name=libass
version=0.17.5
release=2
source="https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
  	./configure --prefix=/usr --disable-static &&
	make
  make DESTDIR=$PKG install
}
