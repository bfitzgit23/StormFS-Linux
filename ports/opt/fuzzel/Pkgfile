# Description: Application launcher for wlroots based Wayland compositors
# URL: https://codeberg.org/dnkl/fuzzel
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: cairo fcft fontconfig libpng libxkbcommon pixman meson scdoc tllist wayland-protocols

name=fuzzel
version=1.14.1
release=1
source=($name-$version.tar.gz::https://codeberg.org/dnkl/fuzzel/archive/$version.tar.gz)

build() {
	meson setup $name-$version build \
		-Denable-cairo=enabled \
		-Dpng-backend=libpng \
		-Dsvg-backend=nanosvg
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}