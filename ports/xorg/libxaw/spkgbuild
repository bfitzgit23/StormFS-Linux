# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Athena Widgets toolkit"
name=libxaw
version=1.0.16
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libXaw-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
