# description	: X Resource extension client library
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Resource extension client library"
name=libxres
version=1.2.3
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libxres-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version
	make
	make DESTDIR=$PKG install
}
