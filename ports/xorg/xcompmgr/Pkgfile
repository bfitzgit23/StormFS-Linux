# Description: Compositing manager for X
# URL: http://xorg.freedesktop.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxcomposite libxdamage libxrender

name=xcompmgr
version=1.1.10
release=1
source=(https://www.x.org/releases/individual/app/$name-$version.tar.xz)

build() { 
	cd $name-$version 
	./configure --prefix=/usr 
	make 
	make DESTDIR=$PKG install 
}