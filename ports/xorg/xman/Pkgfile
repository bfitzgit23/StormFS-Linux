# Description: xman manual page browser
# URL: https://www.x.org/releases/individual/app/
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxaw groff man-db

name=xman
version=1.2.0
release=1
source=(https://ftp.x.org/releases/individual/app/xman-$version.tar.xz)

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}