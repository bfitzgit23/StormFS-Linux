# description	: X cursor management library
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X cursor management library"
name=libxcursor
version=1.2.3
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libXcursor-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
