description="xorg driver xf86-video-vmware"
name=xf86-video-vmware
version=13.4.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-vmware-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
