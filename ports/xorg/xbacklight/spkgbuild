# description	: Utility to set a display's backlight level
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xbacklight
version=1.2.4
release=1
source="https://xorg.freedesktop.org/archive/individual/app/xbacklight-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
