description="xorg font font-bitstream-75dpi"
name=xorg-font-bitstream-75dpi
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-bitstream-75dpi-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/75dpi/fonts.dir
}
