name=xlsclients
version=1.1.6
release=2
source="https://xorg.freedesktop.org/archive/individual/app/xlsclients-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
