# description	: xorg font font-mutt-misc
# homepage	: https//xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xorg-font-mutt-misc
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-mutt-misc-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
