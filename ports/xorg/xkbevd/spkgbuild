# description	: xorg XKB keyboard description compiler
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg XKB keyboard description compiler"
name=xkbevd
version=1.1.6
release=2
source="https://xorg.freedesktop.org/archive/individual/app/xkbevd-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	 ./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
