description="ICE authority file utility"
name=iceauth
version=1.0.11
release=2
source="https://xorg.freedesktop.org/archive/individual/app/iceauth-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
