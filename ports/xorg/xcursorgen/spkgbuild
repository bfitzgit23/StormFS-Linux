# description	: Utility to create X cursors
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Utility to create X cursors"
name=xcursorgen
version=1.0.9
release=2
source="https://xorg.freedesktop.org/archive/individual/app/xcursorgen-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	  ./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
