# Description: List available X fonts
# URL: https://xorg.freedesktop.org
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libx11 util-macros

name=xlsfonts
version=1.0.8
release=1
source=(http://xorg.freedesktop.org/releases/individual/app/xlsfonts-$version.tar.xz)

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}