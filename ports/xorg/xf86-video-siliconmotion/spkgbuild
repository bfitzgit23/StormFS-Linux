# description	: xorg driver xf86-video-siliconmotion
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg driver xf86-video-siliconmotion"
name=xf86-video-siliconmotion
version=1.7.9
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-siliconmotion-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
