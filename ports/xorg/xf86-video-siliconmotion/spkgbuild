# description	: xorg driver xf86-video-siliconmotion
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg driver xf86-video-siliconmotion"
name=xf86-video-siliconmotion
version=1.7.9
release=1
source="https://www.x.org/releases/individual/driver/xf86-video-siliconmotion-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
