# description	: xorg font font-bh-lucidatypewriter-100dpi
# homepage	: https//xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xorg-font-bh-lucidatypewriter-100dpi
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-bh-lucidatypewriter-100dpi-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/100dpi/fonts.dir
}
