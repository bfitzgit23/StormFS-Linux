# description	: Tool for modifying keymaps and pointer button mappings in X
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Tool for modifying keymaps and pointer button mappings in X"
name=xmodmap
version=1.0.12
release=2
source="https://www.x.org/releases/individual/app/xmodmap-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
