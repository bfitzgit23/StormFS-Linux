# description	: X.Org protocol headers
# homepage	: https://www.x.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X.Org protocol headers"
name=xorgproto
version=2025.1
release=3
source="https://www.x.org/releases/individual/proto/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        -Dlegacy=true || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1

    rm -f \
        "$PKG"/usr/include/X11/extensions/apple* \
        "$PKG"/usr/include/X11/extensions/windows* \
        "$PKG"/usr/share/pkgconfig/apple* \
        "$PKG"/usr/share/pkgconfig/windows* \
        "$PKG/usr/include/X11/extensions/vldXvMC.h" \
        "$PKG/usr/include/X11/extensions/XKBgeom.h"

    rm -rf "$PKG/usr/share/doc"
}
