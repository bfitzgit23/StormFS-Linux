# description	: X11 client-side library
# homepage	: https://xcb.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X11 client-side library"
name=libxcb
version=1.17.0
release=1
source="https://xorg.freedesktop.org/archive/individual/lib/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG      \
            --without-doxygen \
            --docdir='${datadir}'/doc/libxcb-$version &&
	make
	make DESTDIR=$PKG install
chown -Rv root:root $PKG$XORG_PREFIX/share/doc/libxcb-$version
}
