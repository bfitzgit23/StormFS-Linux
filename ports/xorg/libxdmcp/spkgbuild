# description	: X Display Manager Control Protocol library
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Display Manager Control Protocol library"
name=libxdmcp
version=1.1.5
release=2
source="https://www.x.org/releases/individual/lib/libXdmcp-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure $XORG_CONFIG --docdir=/usr/share/doc/libxdmcp-$version &&
make
	make DESTDIR=$PKG install
}
