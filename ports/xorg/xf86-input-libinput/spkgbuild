# description	: X driver based on libinput
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X driver based on libinput"
name=xf86-input-libinput
version=1.5.0
release=1
source="https://www.x.org/releases/individual/driver/xf86-input-libinput-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	./configure $XORG_CONFIG &&
	make
	make DESTDIR=$PKG install
}
