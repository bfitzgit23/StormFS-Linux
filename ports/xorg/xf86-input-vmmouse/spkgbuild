# description	: xorg driver xf86-input-vmmouse
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg driver xf86-input-vmmouse"
name=xf86-input-vmmouse
version=13.2.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure \
		--prefix=/usr \
		--with-udev-rules-dir=/lib/udev/rules.d

	make
	make DESTDIR=$PKG install
}
