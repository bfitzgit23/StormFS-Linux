# description	: Command line tools for desktop integration tasks.
# homepage	: https://www.freedesktop.org/wiki/Software/xdg-utils/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: lynx w3m dbus

description="Command line tools for desktop integration tasks."
name=xdg-utils
version=v1.2.1
release=1
source="https://gitlab.freedesktop.org/xdg/$name/-/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1


  ./configure --prefix=/usr --mandir=/usr/share/man &&
make
  make DESTDIR=$PKG install
}
