# description	: X Window System server
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Window System server"
name=xorg-server
version=21.1.24
release=3
source="https://xorg.freedesktop.org/archive/individual/xserver/$name-$version.tar.xz https://www.linuxfromscratch.org/patches/blfs/svn/$name-$version-tearfree_backport-2.patch"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	# Apply patch sources; pkgbuild does this automatically.
	for _p in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_p" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_p" || return 1
	done
	mkdir build &&
	cd    build &&

meson setup ..              \
      --prefix=$XORG_PREFIX \
      --localstatedir=/var  \
      -Dglamor=true         \
      -Dxkb_output_dir=/var/lib/xkb &&
ninja

	DESTDIR=$PKG ninja install
	rm -rf $PKG/usr/lib/xorg/protocol.txt
	install -m 755 -d $PKG/etc/X11/xorg.conf.d
	echo "needs_root_rights = yes" >> $PKG/etc/X11/Xwrapper.config
}
