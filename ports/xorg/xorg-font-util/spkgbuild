# description	: Font package creation/installation utilities
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xorg-font-util
version=1.4.2
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-util-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
