# description	: xorg XKB keyboard description compiler
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg XKB keyboard description compiler"
name=xkbcomp
version=1.5.0
release=2
source="https://www.x.org/releases/individual/app/xkbcomp-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG pkgconfigdir=/usr/share/pkgconfig install
}
