# description	: xorg font font-misc-ethiopic
# homepage	: https//xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xorg-font-misc-ethiopic
version=1.0.5
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-misc-ethiopic-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/{O,T}TF/fonts.{dir,scale}
}
