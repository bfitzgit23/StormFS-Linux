# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg font font-misc-ethiopic"
name=xorg-font-misc-ethiopic
version=1.0.5
release=1
source="https://www.x.org/releases/individual/font/font-misc-ethiopic-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/{O,T}TF/fonts.{dir,scale}
}
