# description	: Tool for modifying keymaps and pointer button mappings in X
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xpr
version=1.2.1
release=1
source="https://xorg.freedesktop.org/archive/individual/app/xpr-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
