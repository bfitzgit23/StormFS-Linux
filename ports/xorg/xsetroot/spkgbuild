# description	: Root window parameter setting utility for X
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Root window parameter setting utility for X"
name=xsetroot
version=1.1.4
release=4
source="https://xorg.freedesktop.org/archive/individual/app/xsetroot-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG || return 1

	make || return 1
	make DESTDIR=$PKG install || return 1
}
