# description	: OpenGL Extension Wrangler library
# homepage	: https://glew.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="OpenGL Extension Wrangler library"
name=glew
version=2.3.1
release=1
source="https://downloads.sourceforge.net/project/glew/glew/$version/glew-$version.tgz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    make -j"${JOBS:-1}" \
        GLEW_DEST=/usr \
        LIBDIR=/usr/lib \
        || return 1
    make \
        GLEW_DEST="$PKG/usr" \
        LIBDIR="$PKG/usr/lib" \
        PKGDIR="$PKG/usr/lib/pkgconfig" \
        install \
        || return 1
}
