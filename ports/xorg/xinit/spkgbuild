# description	: X Window System initializer (xinit/startx)
# homepage	: https://www.x.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X Window System initializer (xinit/startx)"
name=xinit
version=1.4.4
release=3
source="https://xorg.freedesktop.org/archive/individual/app/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure $XORG_CONFIG --with-xinitdir=/etc/X11/app-defaults || return $?
    make -j "${JOBS:-1}" || return $?
    make DESTDIR="$PKG" install || return $?
}
