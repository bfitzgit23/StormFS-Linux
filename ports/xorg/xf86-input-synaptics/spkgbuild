# description	: Synaptics touchpad input driver
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Synaptics touchpad input driver"
name=xf86-input-synaptics
version=1.10.0
release=2
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-input-synaptics-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG &&
	make
	make DESTDIR=$PKG install
}
