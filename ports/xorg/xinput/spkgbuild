# description	: Utility to configure and test XInput devices
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xinput
version=1.6.4
release=1
source="https://xorg.freedesktop.org/archive/individual/app/xinput-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	./configure $XORG_CONFIG
	make
	make DESTDIR=$PKG install
}
