# description	: xorg font font-alias
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xorg-font-alias
version=1.0.6
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-alias-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
