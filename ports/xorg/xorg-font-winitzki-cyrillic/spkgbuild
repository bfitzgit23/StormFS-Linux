# description	: xorg font font-winitzki-cyrillic
# homepage	: https//xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg font font-winitzki-cyrillic"
name=xorg-font-winitzki-cyrillic
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-winitzki-cyrillic-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/cyrillic/fonts.dir
}
