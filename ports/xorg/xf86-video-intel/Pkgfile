# Description: Intel graphics video driver
# URL: https://www.x.org/wiki/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: libXScrnSaver xorg-server

name=xf86-video-intel
# pacman keeps the last '-' as the pkgrel separator and rejects a pkgver that
# contains one, so version= must use '_'; srcver keeps the upstream spelling.
version=2.99.917_931
srcver=2.99.917-931
release=1
source=(https://crux.nu/files/distfiles/xf86-video-intel-$srcver.tar.xz)

pkg_build() {

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/xf86-video-intel \
		--enable-tools \
		--with-default-dri=3

	make
	make DESTDIR=$PKG install
}
