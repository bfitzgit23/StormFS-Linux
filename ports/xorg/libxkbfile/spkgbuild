# description	: XKB file handling library
# homepage	: https://www.x.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libxkbfile
version=1.2.0
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libxkbfile-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
    meson setup build \
        --prefix=/usr \
        --libdir=/usr/lib \
        --buildtype=release || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
