# description	: XKB file handling library
# homepage	: https://www.x.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="XKB file handling library"
name=libxkbfile
version=1.2.0
release=3
source="https://www.x.org/releases/individual/lib/libxkbfile-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    meson setup build \
        --prefix=/usr \
        --libdir=/usr/lib \
        --buildtype=release || return 1

    meson compile -C build -j "${JOBS:-1}" || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
