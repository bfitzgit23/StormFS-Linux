# description	: Kernel multi-touch transformation library
# homepage	: https://launchpad.net/mtdev
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Kernel multi-touch transformation library"
name=mtdev
version=1.1.7
release=1
source="https://launchpad.net/$name/trunk/$version/+download/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr --disable-static &&
make
	make DESTDIR=$PKG install
}
