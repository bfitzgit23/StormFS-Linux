# description	: X Authorization routines
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=libxau
version=1.0.12
release=1
source="https://xorg.freedesktop.org/archive/individual/lib/libxau-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG &&
make
	make DESTDIR=$PKG install
}
