# description	: xorg XKB keyboard description compiler
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xkbutils
version=1.0.7
release=3
source="https://xorg.freedesktop.org/archive/individual/app/xkbutils-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	 ./configure $XORG_CONFIG || return $?

	make -j "${JOBS:-1}" || return $?
	make DESTDIR="$PKG" install || return $?
}
