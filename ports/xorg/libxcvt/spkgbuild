# description	: library providing a standalone version of the X server implementation of the VESA CVT standard timing modelines generator
# homepage	: https://gitlab.freedesktop.org/xorg/lib/libxcvt
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="library providing a standalone version of the X server implementation of the VESA CVT standard timing modelines generator"
name=libxcvt
version=0.1.3
release=1
source="https://xorg.freedesktop.org/archive/individual/lib/libxcvt-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
mkdir build &&
cd    build &&

meson setup  --prefix=$XORG_PREFIX --buildtype=release .. &&
ninja
	DESTDIR=$PKG ninja install
}
