# description	: Mesa OpenGL Utility library
# homepage	: https://www.mesa3d.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Mesa OpenGL Utility library"
name=glu
version=9.0.3
release=1
source="https://mesa.freedesktop.org/archive/$name/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	mkdir build &&
	cd    build &&

meson setup ..              \
      --prefix=$XORG_PREFIX \
      -Dgl_provider=gl      \
      --buildtype=release   &&
ninja
	DESTDIR=$PKG ninja install
	rm -vf $PKG/usr/lib/libGLU.a
}
