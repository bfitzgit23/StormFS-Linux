# description	: unaccelerated VESA display driver
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="unaccelerated VESA display driver"
name=xf86-video-vesa
version=2.6.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-vesa-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
