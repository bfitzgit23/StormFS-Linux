description="x window sniper"
name=xmessage
version=1.0.7
release=2
source="https://xorg.freedesktop.org/archive/individual/app/xmessage-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
