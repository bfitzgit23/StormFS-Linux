# description	: xorg driver xf86-video-neomagic
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xf86-video-neomagic
version=1.3.1
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-neomagic-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

    ./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
