# description	: Nouveau graphics video driver
# homepage	: https://nouveau.freedesktop.org/wiki/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Nouveau graphics video driver"
name=xf86-video-nouveau
version=1.0.18
release=2
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-nouveau-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	CFLAGS=$(printf '%s' "$CFLAGS" | sed 's/-fno-plt//')
	CXXFLAGS=$(printf '%s' "$CXXFLAGS" | sed 's/-fno-plt//')
	export CFLAGS="$CFLAGS -DFB_ACCESS_WRAPPER"
	export CXXFLAGS="$CXXFLAGS -DFB_ACCESS_WRAPPER"
	export LDFLAGS="$LDFLAGS -Wl,-z,lazy"
	./configure --prefix=/usr

	make -j1
	make DESTDIR=$PKG install
}
