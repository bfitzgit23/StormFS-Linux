# description	: simple clock for Xorg
# homepage	: https://xorg.freedesktop.org/archive/individual/app
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="simple clock for Xorg"
name=xclock
version=1.2.1
release=1
source="https://mirror.freedif.org/pub/blfs/conglomeration/Xorg/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure $XORG_CONFIG || return $?
    make -j "${JOBS:-1}" || return $?
    make DESTDIR="$PKG" install || return $?
}
