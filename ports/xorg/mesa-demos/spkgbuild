# description	: mesa-demos package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="mesa-demos package"
name=mesa-demos
version=9.0.0
release=2
source="https://archive.mesa3d.org/demos/${name}-${version}.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	prt-get isinst libdecor wayland || SPKG_MESA_DEMOS+=' -D wayland=disabled'

	meson setup build . $SPKG_MESA_DEMOS \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D osmesa=disabled \
		-D gles1=disabled
	meson compile -C build -j ${JOBS:-1}

	install -Dm 0755 -t $PKG/usr/bin \
		build/src/xdemos/glx{gears,info} \
		build/src/egl/opengl/eglinfo
}
