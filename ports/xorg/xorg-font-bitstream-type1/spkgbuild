description="xorg font font-bitstream-type1"
name=xorg-font-bitstream-type1
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-bitstream-type1-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/Type1/fonts.{dir,scale}
}
