# description	: A library to handle keyboard descriptions.
# homepage	: https://xkbcommon.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: libxcb wayland wayland-protocols doxygen

name=libxkbcommon
version=1.13.2
release=8
source="https://github.com/xkbcommon/libxkbcommon/archive/xkbcommon-$version.tar.gz"

build() {
	cd "$name-$version" || return 1
	prt-get isinst wayland-protocols || SPKG_XKBCOMMON+=' -Denable-wayland=false'
	prt-get isinst xkeyboard-config || SPKG_XKBCOMMON+=' -Denable-x11=false'


	mkdir build &&
cd    build &&

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -Denable-docs=false \
     $SPKG_XKBCOMMON &&
ninja
DESTDIR=$PKG ninja install
}
