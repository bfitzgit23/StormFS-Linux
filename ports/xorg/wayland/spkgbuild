# description	: X compat server to be used with wayland
# homepage	: https://wayland.freedesktop.org/xserver.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X compat server to be used with wayland"
name=wayland
version=1.26.0
release=2
source="https://gitlab.freedesktop.org/$name/$name/-/releases/$version/downloads/$name-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	mkdir build &&
	cd    build &&

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -Ddocumentation=false &&
ninja
	DESTDIR=$PKG ninja install
}
