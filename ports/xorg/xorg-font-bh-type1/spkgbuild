description="xorg font font-bh-type1"
name=xorg-font-bh-type1
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-bh-type1-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm -f $PKG/usr/share/fonts/X11/Type1/fonts.{dir,scale}
}
