# description	: library that handles input devices for display servers
# homepage	: https://www.freedesktop.org/wiki/Software/libinput/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: wayland-protocols

name=libinput
version=1.31.3
release=2
source="https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/$name-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1
	mkdir build &&
	cd    build &&

meson setup --prefix=$XORG_PREFIX    \
            --buildtype=release      \
            -Ddebug-gui=false        \
            -Dtests=false            \
            -Dlibwacom=false         \
            -Dudev-dir=/usr/lib/udev \
            ..                      &&
	ninja
	DESTDIR=$PKG ninja install
}
