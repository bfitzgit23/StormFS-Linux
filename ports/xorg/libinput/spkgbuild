# description	: library that handles input devices for display servers
# homepage	: https://www.freedesktop.org/wiki/Software/libinput/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: wayland-protocols

description="library that handles input devices for display servers"
name=libinput
version=1.31.3
release=2
source="https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	mkdir build &&
	cd    build &&

meson setup --prefix=$XORG_PREFIX    \
            --buildtype=release      \
            -Ddebug-gui=false        \
            -Dtests=false            \
            -Dlibwacom=false         \
            -Dudev-dir=/usr/lib/udev \
            ..                      &&
	ninja
	DESTDIR=$PKG ninja install
}
