# description	: X compat server to be used with wayland
# homepage	: https://wayland.freedesktop.org/xserver.html
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X compat server to be used with wayland"
name=xwayland
version=24.1.13
release=2
source="https://xorg.freedesktop.org/archive/individual/xserver/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	sed -i '/install_man/,$d' meson.build &&
	mkdir build &&
	cd    build &&
	meson setup --prefix=$XORG_PREFIX         \
            --buildtype=release           \
            -Dxkb_output_dir=/var/lib/xkb \
            ..                            &&
	ninja
	DESTDIR=$PKG ninja install
	rm -f $PKG/usr/lib/xorg/protocol.txt
	rm -f $PKG/usr/share/man/man1/Xserver.1
}
