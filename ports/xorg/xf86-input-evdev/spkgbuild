# description	: xorg driver xf86-input-evdev
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xf86-input-evdev
version=2.11.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-input-evdev-$version.tar.gz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
