description="xorg font font-micro-misc"
name=xorg-font-micro-misc
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-micro-misc-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
