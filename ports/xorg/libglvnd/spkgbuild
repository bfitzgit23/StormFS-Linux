# description	: GL Vendor-Neutral Dispatch library
# homepage	: https://github.com/NVIDIA/libglvnd
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GL Vendor-Neutral Dispatch library"
name=libglvnd
version=1.7.0
release=2
source="https://github.com/NVIDIA/libglvnd/archive/v${version}/libglvnd-${version}.tar.gz"

build() {
	cd "$name-$version" || return 1
    meson setup build \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Db_lto=true \
        -Db_pie=true \
        -Dx11=enabled \
        -Dglx=enabled \
        -Dgles1=false \
        -Degl=true \
        -Dtls=false || return 1

    meson compile -C build || return 1

    DESTDIR="$PKG" \
        meson install -C build || return 1
}
