# description	: Program for managing utmp/wtmp entries for xdm sessions
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Program for managing utmp/wtmp entries for xdm sessions"
name=sessreg
version=1.1.4
release=2
source="https://xorg.freedesktop.org/archive/individual/app/sessreg-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
