# description	: Create an index of scalable X font files
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=mkfontscale
version=1.2.4
release=2
source="https://xorg.freedesktop.org/archive/individual/app/mkfontscale-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
