# description	: Set the keyboard using the X Keyboard Extension
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=setxkbmap
version=1.3.5
release=2
source="https://xorg.freedesktop.org/archive/individual/app/setxkbmap-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
