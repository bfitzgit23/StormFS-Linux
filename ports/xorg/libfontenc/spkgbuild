# description	: xorg lib libfontenc
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg lib libfontenc"
name=libfontenc
version=1.1.9
release=4
# xorg.freedesktop.org intermittently fails DNS resolution/timeouts on some
# networks. The Alpine distfiles mirror serves a byte-identical tarball.
source="https://distfiles.alpinelinux.org/distfiles/v3.24/libfontenc-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version

	make
	make DESTDIR=$PKG install
}
