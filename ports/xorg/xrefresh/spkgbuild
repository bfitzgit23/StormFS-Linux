# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="x server resource database utility"
name=xrefresh
version=1.1.1
release=2
source="https://www.x.org/releases/individual/app/xrefresh-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure $XORG_CONFIG

	make
	make DESTDIR=$PKG install
}
