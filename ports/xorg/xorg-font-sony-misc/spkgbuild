# description	: xorg font font-sony-misc
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg font font-sony-misc"
name=xorg-font-sony-misc
version=1.0.3
release=1
source="https://xorg.freedesktop.org/archive/individual/font/font-sony-misc-$version.tar.bz2"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
