# description	: Video Acceleration API to enable hardware accelerated video decode/encode.
# homepage	: https://github.com/intel/libva
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: wayland-protocols

description="Video Acceleration API to enable hardware accelerated video decode/encode."
name=libva
version=2.24.1
release=2
source="https://github.com/intel/libva/archive/$version/$name-$version.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	mkdir builds &&
	cd    builds &&

meson setup --prefix=$XORG_PREFIX --buildtype=release &&
ninja

DESTDIR=$PKG ninja  install
chmod -x $PKG/usr/include/va/va_vpp.h
}
