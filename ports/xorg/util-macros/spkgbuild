name=util-macros
version=1.20.2
release=2
source="https://xorg.freedesktop.org/archive/individual/util/util-macros-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
	./configure $XORG_CONFIG
	make DESTDIR=$PKG install
}
