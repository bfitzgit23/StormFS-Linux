# description	: Xlib-based library for the X Present Extension
# homepage	: https://gitlab.freedesktop.org/xorg/lib/libxpresent
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Xlib-based library for the X Present Extension"
name=libxpresent
version=1.0.2
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libxpresent-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	 ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version
	make
	make DESTDIR=$PKG install
}
