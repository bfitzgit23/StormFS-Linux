# Description: Utility for performing actions on windows in X
# URL: https://github.com/baskerville/xdo
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: libxcb xcb-util xcb-util-wm

name=xdo
version=0.5.7
release=1
source=(https://github.com/baskerville/xdo/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}