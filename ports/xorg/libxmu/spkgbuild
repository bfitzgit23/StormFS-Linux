# description	: xorg lib libxmu
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg lib libxmu"
name=libxmu
version=1.3.1
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libxmu-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	  ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version \
                  --with-appdefaultdir=/etc/X11/app-defaults

	make
	make DESTDIR=$PKG install
}
