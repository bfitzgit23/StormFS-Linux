# description	: X font handling library version 2 for server & utilities
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="X font handling library version 2 for server & utilities"
name=libxfont2
version=2.0.9
release=4
source="https://xorg.freedesktop.org/archive/individual/lib/libXfont2-$version.tar.xz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	 ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version --disable-devel-docs

	make
	make DESTDIR=$PKG install
}
