# description	: xorg driver xf86-video-fbdev
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="xorg driver xf86-video-fbdev"
name=xf86-video-fbdev
version=0.5.1
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-fbdev-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
