# description	: xorg driver xf86-video-cirrus
# homepage	: https://xorg.freedesktop.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xf86-video-cirrus
version=1.6.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-cirrus-$version.tar.xz"

build() {
	cd "$name-$version" || return 1

	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
