+        connect(haltButton, SIGNAL(clicked()), this, SLOT(slotHalt()));
+        layout->addWidget(haltButton);
+
+        QPushButton *rebootButton = new QPushButton(i18n("&Restart Computer"), this);
+        connect(rebootButton, SIGNAL(clicked()), this, SLOT(slotReboot()));
+        layout->addWidget(rebootButton);
