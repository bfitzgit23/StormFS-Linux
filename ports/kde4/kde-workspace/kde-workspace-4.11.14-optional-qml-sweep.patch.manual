 bool KSMShutdownDlg::eventFilter ( QObject * watched, QEvent * event )
 {
+#ifdef HAVE_QTDECLARATIVE
     if (watched == m_view && event->type() == QEvent::Resize) {
         adjustSize();
     }
+#endif
     return QDialog::eventFilter(watched, event);
 }
 
