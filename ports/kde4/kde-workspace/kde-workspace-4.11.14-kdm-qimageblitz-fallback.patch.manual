         break;
     }
     case PyramidGradient:
-        m_Background = Blitz::gradient(m_Size, colorA(), colorB(),
-                                       Blitz::PyramidGradient);
+        m_Background = BG_GRADIENT(m_Size, colorA(), colorB(), BG_PYRAMID);
         break;
 
     case PipeCrossGradient:
-        m_Background = Blitz::gradient(m_Size, colorA(), colorB(),
-                                       Blitz::PipeCrossGradient);
+        m_Background = BG_GRADIENT(m_Size, colorA(), colorB(), BG_PIPECROSS);
         break;
 
     case EllipticGradient:
-        m_Background = Blitz::gradient(m_Size, colorA(), colorB(),
-                                       Blitz::EllipticGradient);
+        m_Background = BG_GRADIENT(m_Size, colorA(), colorB(), BG_ELLIPTIC);
         break;
     }
 
@@ -603,6 +687,9 @@
