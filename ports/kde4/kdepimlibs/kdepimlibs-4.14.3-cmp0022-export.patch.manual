 endif()
 
 set_target_properties(
--- a/kcal/CMakeLists.txt
+++ b/kcal/CMakeLists.txt
@@ -107,10 +107,10 @@
 generate_export_header(kcal)
 
 target_link_libraries(kcal ${KDE4_KDEUI_LIBS} ${KDE4_KIO_LIBS} ${QT_QTXML_LIBRARY} kabc kpimutils ${LIBICAL_LIBRARIES})
