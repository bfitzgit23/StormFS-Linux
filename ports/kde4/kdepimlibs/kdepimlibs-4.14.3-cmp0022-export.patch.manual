--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,7 +23,6 @@
 include(FeatureSummary)
 
 set(CMAKE_AUTOMOC ON)
-set(CMAKE_LINK_INTERFACE_LIBRARIES "")
 
 include(GenerateExportHeader)
 
@@ -268,7 +267,8 @@
 install(EXPORT kdepimlibsLibraryTargets
         NAMESPACE ${KDEPIMLIBS_TARGET_PREFIX}
         DESTINATION ${_KdepimLibsConfig_INSTALL_DIR}
-        FILE KDEPimLibsLibraryTargetsWithPrefix.cmake )
+        FILE KDEPimLibsLibraryTargetsWithPrefix.cmake
+        EXPORT_LINK_INTERFACE_LIBRARIES )
 
 # Install a KDEPimLibsDependencies.cmake so people using kdepimlibs 4.2 with kdelibs < 4.2 get a useful error message, Alex
 file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/KDEPimLibsDependencies.cmake "\n message(FATAL_ERROR \"For using this version of kdepimlibs (${KDEPIMLIBS_VERSION}) you need a newer version of kdelibs, please update.\")\n")
--- a/akonadi/CMakeLists.txt
+++ b/akonadi/CMakeLists.txt
@@ -299,7 +299,7 @@
 target_link_libraries( akonadi-kde ${QT_QTDECLARATIVE_LIBRARY} )
 endif()
 
-target_link_libraries( akonadi-kde LINK_INTERFACE_LIBRARIES ${AKONADI_KDE_DEPS})
+target_link_libraries( akonadi-kde INTERFACE ${AKONADI_KDE_DEPS})
 
 set_target_properties( akonadi-kde PROPERTIES VERSION ${GENERIC_LIB_VERSION} SOVERSION ${GENERIC_LIB_SOVERSION} )
 install( TARGETS akonadi-kde EXPORT kdepimlibsLibraryTargets  ${INSTALL_TARGETS_DEFAULT_ARGS} )
