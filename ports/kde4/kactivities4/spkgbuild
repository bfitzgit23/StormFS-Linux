# description	: KDE 4 activity manager
# homepage	: https://kde.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="KDE 4 activity manager"
# Keep the KDE4 package name distinct from the KF5 package in ports/plasma.
name=kactivities4
_pkgname=kactivities
version=4.13.3
release=4
source="https://download.kde.org/Attic/4.13.3/src/$_pkgname-$version.tar.xz kactivities4-4.13.3-cmake4-optional-qml.patch.manual"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$_pkgname-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# 4.13.3 predates CMake's requirement for an explicit minimum version: its
	# top-level CMakeLists.txt starts at project() with no cmake_minimum_required
	# at all, which CMake 4.4 rejects outright.  Add the version upstream used in
	# the surrounding KDE 4.13 modules; the policy floor below keeps CMake 4 from
	# refusing the old compatibility level.
	#
	# The models library builds a QML extension plugin that includes
	# <QtDeclarative/qdeclarative.h>, but Qt 4 is built with -no-declarative.
	# Build and install that plugin only when FindQt4 actually found the module.
	#
	# The workspace settings module needs libkdeclarative from kdelibs, which is
	# not built without QtDeclarative.  Its directory is already added only when
	# KDeclarative is found, so stop reporting it as a required feature.
	patch -p1 -i "$SRC/kactivities4-4.13.3-cmake4-optional-qml.patch.manual" || return 1

	export CMAKE_PREFIX_PATH="/opt/qt4:/usr"
	export PATH="/opt/qt4/bin:$PATH"
	export QT_QMAKE_EXECUTABLE=/opt/qt4/bin/qmake
	export CFLAGS="${CFLAGS:+$CFLAGS }-std=gnu99"
	# 4.13.3 probes for C++11 (auto, lambdas, unique_ptr, variadic templates,
	# initializer lists) before it adds src/service and src/workspace, so a
	# global -std=gnu++98 leaves those probes failing and the activity manager
	# is silently skipped.  Compile the whole package as C++11 instead.
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-std=gnu++11 -fpermissive -Wno-deprecated-declarations"

	# kdelibs before 4.14.3-21 shipped cmake modules that read the location of a
	# kauth-policy-gen target its exported tools file never contained, so every
	# KDE 4 configure aborted in get_target_property().  Report that here instead
	# of letting the raw missing-target error escape.
	_bfs_kdelibs_modules=$(kde4-config --path data 2>/dev/null | cut -d: -f1)/cmake/modules
	if [ -f "$_bfs_kdelibs_modules/FindKDE4Internal.cmake" ] &&
	   ! grep -qF 'TARGET ${KDE4_TARGET_PREFIX}kauth-policy-gen' "$_bfs_kdelibs_modules/FindKDE4Internal.cmake"; then
		echo "$name: installed kdelibs is older than 4.14.3-21;" >&2
		echo "$name: rebuild and reinstall kdelibs before building this package." >&2
		return 1
	fi

	cmake -S . -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DKDE4_BUILD_TESTS=OFF \
		-DBUILD_TESTING=OFF \
		-DSTATIC_LIBRARY=OFF \
		-DCMAKE_DISABLE_FIND_PACKAGE_QJSON=TRUE || return 1

	cmake --build build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" cmake --install build || return 1
}
