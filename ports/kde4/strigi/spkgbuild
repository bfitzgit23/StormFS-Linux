# description	: Strigi desktop search framework for KDE 4
# homepage	: https://strigi.sourceforge.net/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Strigi desktop search framework for KDE 4"
name=strigi
version=0.7.8
release=2
# GitHub's archive omits Strigi's libstreams/libstreamanalyzer submodules.
source="https://www.vandenoever.info/software/strigi/strigi-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	export CMAKE_PREFIX_PATH="/opt/qt4:/usr"
	export PATH="/opt/qt4/bin:$PATH"
	export QT_QMAKE_EXECUTABLE=/opt/qt4/bin/qmake
	export CFLAGS="${CFLAGS:+$CFLAGS }-std=gnu99"
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-std=gnu++98 -fpermissive -Wno-deprecated-declarations"

	# CMake 4 rejects the duplicate outputs from Strigi's Perl DBus generator.
	# The release tarball ships the generated DBus sources, so use those.
	cmake -S . -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_DISABLE_FIND_PACKAGE_Perl=TRUE \
		-DSTRIGI_SYNC_SUBMODULES=OFF \
		-DENABLE_CLUCENE=OFF \
		-DENABLE_EXPAT=OFF \
		-DENABLE_LIBXML2=ON \
		-DENABLE_QT4=ON \
		-DENABLE_DBUS=ON \
		-DBUILD_TESTING=OFF || return 1

	cmake --build build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" cmake --install build || return 1
}
