diff --git a/src/network/ssl/qsslsocket_openssl.cpp b/src/network/ssl/qsslsocket_openssl.cpp
index c1ec979..dee52f6 100644
--- a/src/network/ssl/qsslsocket_openssl.cpp
+++ b/src/network/ssl/qsslsocket_openssl.cpp
@@ -273,7 +273,12 @@ init_context:
 #endif
         break;
     case QSsl::SslV3:
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L
+        // OpenSSL 4 no longer provides the SSLv3 protocol.
+        ctx = 0;
+#else
         ctx = q_SSL_CTX_new(client ? q_SSLv3_client_method() : q_SSLv3_server_method());
+#endif
         break;
     case QSsl::SecureProtocols: // SslV2 will be disabled below
     case QSsl::TlsV1SslV3: // SslV2 will be disabled below
@@ -308,6 +313,17 @@ init_context:
     else
         options = SSL_OP_ALL;
 
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L
+    // TLSv1_client_method() is an alias for the generic TLS method in
+    // OpenSSL 4, so explicitly keep QSsl::TlsV1 restricted to TLS 1.0.
+    if (configuration.protocol == QSsl::TlsV1) {
+        options |= SSL_OP_NO_TLSv1_1 | SSL_OP_NO_TLSv1_2;
+#ifdef SSL_OP_NO_TLSv1_3
+        options |= SSL_OP_NO_TLSv1_3;
+#endif
+    }
+#endif
+
     // This option is disabled by default, so we need to be able to clear it
     if (configuration.sslOptions & QSsl::SslOptionDisableEmptyFragments)
         options |= SSL_OP_DONT_INSERT_EMPTY_FRAGMENTS;
