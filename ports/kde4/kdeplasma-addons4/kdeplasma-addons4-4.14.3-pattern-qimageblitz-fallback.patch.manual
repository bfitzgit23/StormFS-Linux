--- a/wallpapers/pattern/CMakeLists.txt
+++ b/wallpapers/pattern/CMakeLists.txt
@@ -1,8 +1,11 @@
 project(plasma-wallpaper-pattern)
 
-find_package(QImageBlitz REQUIRED)
+find_package(QImageBlitz QUIET)
 
-include_directories(${QIMAGEBLITZ_INCLUDES})
+if(QIMAGEBLITZ_FOUND)
+    include_directories(${QIMAGEBLITZ_INCLUDES})
+    add_definitions(-DHAVE_QIMAGEBLITZ)
+endif(QIMAGEBLITZ_FOUND)
 
 set(pattern_SRCS
     pattern.cpp
--- a/wallpapers/pattern/pattern.cpp
+++ b/wallpapers/pattern/pattern.cpp
@@ -23,7 +23,36 @@
 
 #include "pattern.h"
 
+#ifdef HAVE_QIMAGEBLITZ
 #include "qimageblitz.h"
+#endif
+
+#include <QColor>
+
+namespace {
+
+QImage patternFlatten(QImage &image, const QColor &fg, const QColor &bg)
+{
+#ifdef HAVE_QIMAGEBLITZ
+    return Blitz::flatten(image, fg, bg);
+#else
+    // QImageBlitz maps the darkest gray level to the first color and the
+    // brightest to the second; interpolate between them the same way.
+    QImage img = image.convertToFormat(QImage::Format_RGB32);
+    for (int y = 0; y < img.height(); ++y) {
+        QRgb *line = reinterpret_cast<QRgb *>(img.scanLine(y));
+        for (int x = 0; x < img.width(); ++x) {
+            const int l = qGray(line[x]);
+            line[x] = qRgb(fg.red() + (bg.red() - fg.red()) * l / 255,
+                           fg.green() + (bg.green() - fg.green()) * l / 255,
+                           fg.blue() + (bg.blue() - fg.blue()) * l / 255);
+        }
+    }
+    return img;
+#endif
+}
+
+} // namespace
 
 #include <QFileInfo>
 #include <QPainter>
@@ -104,7 +133,7 @@
 
 QPixmap PatternWallpaper::generatePattern(QImage &image) const
 {
-    return QPixmap::fromImage(Blitz::flatten(image, m_fgColor, m_bgColor));
+    return QPixmap::fromImage(patternFlatten(image, m_fgColor, m_bgColor));
 }
 
 QPixmap PatternWallpaper::generatePattern(const QString &patternFile, const QColor &fg, const QColor &bg) const
@@ -117,7 +146,7 @@
         return QPixmap();
     }
 
-    return QPixmap::fromImage(Blitz::flatten(img, fg, bg));
+    return QPixmap::fromImage(patternFlatten(img, fg, bg));
 }
 
 void PatternWallpaper::save(KConfigGroup & config)
