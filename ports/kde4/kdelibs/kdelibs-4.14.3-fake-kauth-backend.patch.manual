--- a/cmake/modules/FindKDE4Internal.cmake
+++ b/cmake/modules/FindKDE4Internal.cmake
@@ -611,7 +611,9 @@
     set(KDE4_KCFGC_EXECUTABLE             ${HOST_BINDIR}/${CMAKE_CFG_INTDIR}/kconfig_compiler )
     set(KDE4_MEINPROC_EXECUTABLE          ${HOST_BINDIR}/${CMAKE_CFG_INTDIR}/meinproc4 )
    endif(NOT WINCE)
+   if (TARGET ${KDE4_TARGET_PREFIX}kauth-policy-gen)
    get_target_property(KDE4_KAUTH_POLICY_GEN_EXECUTABLE  ${KDE4_TARGET_PREFIX}kauth-policy-gen    LOCATION_${_firstConfig})
+   endif (TARGET ${KDE4_TARGET_PREFIX}kauth-policy-gen)
    get_target_property(KDE4_MAKEKDEWIDGETS_EXECUTABLE    ${KDE4_TARGET_PREFIX}makekdewidgets      LOCATION_${_firstConfig})
 
    # allow searching cmake modules in all given kde install locations (KDEDIRS based)
--- a/kdecore/auth/ConfigureChecks.cmake
+++ b/kdecore/auth/ConfigureChecks.cmake
@@ -175,6 +175,12 @@
 elseif(KDE4_AUTH_BACKEND_NAME STREQUAL "POLKITQT-1")
   set(KAUTH_POLICY_GEN_SRCS ${KAUTH_POLICY_GEN_SRCS}
       auth/backends/polkit-1/kauth-policy-gen-polkit1.cpp )
+elseif(KDE4_AUTH_BACKEND_NAME STREQUAL "FAKE")
+  # Keep building the tool with the fake backend: the installed
+  # KDELibs4ToolsTargets.cmake has to export it, because FindKDE4Internal
+  # reads the location of the imported target unconditionally.
+  set(KAUTH_POLICY_GEN_SRCS ${KAUTH_POLICY_GEN_SRCS}
+      auth/backends/fake/kauth-policy-gen-fake.cpp )
 endif()
 
 ########################
--- a/kdecore/CMakeLists.txt
+++ b/kdecore/CMakeLists.txt
@@ -461,17 +461,16 @@
 
 # KAuth policy generator executable
 
-# Compile only if fake backend has not been selected
+# Always built, also for the fake backend, so the exported
+# KDELibs4ToolsTargets.cmake contains the imported kauth-policy-gen target.
 
-if (NOT "${KDE4_AUTH_BACKEND_NAME}" STREQUAL "FAKE")
-    # KAUTH_POLICY_GEN_SRCS has been generated from auth/ConfigureChecks.cmake
-    kde4_add_executable(kauth-policy-gen NOGUI ${KAUTH_POLICY_GEN_SRCS})
+# KAUTH_POLICY_GEN_SRCS has been generated from auth/ConfigureChecks.cmake
+kde4_add_executable(kauth-policy-gen NOGUI ${KAUTH_POLICY_GEN_SRCS})
 
-    # KAUTH_POLICY_GEN_LIBRARIES has been generated from auth/ConfigureChecks.cmake
-    target_link_libraries( kauth-policy-gen ${KAUTH_POLICY_GEN_LIBRARIES} )
+# KAUTH_POLICY_GEN_LIBRARIES has been generated from auth/ConfigureChecks.cmake
+target_link_libraries( kauth-policy-gen ${KAUTH_POLICY_GEN_LIBRARIES} )
 
-    install( TARGETS kauth-policy-gen EXPORT kdelibsToolsTargets DESTINATION ${LIBEXEC_INSTALL_DIR})
-endif (NOT "${KDE4_AUTH_BACKEND_NAME}" STREQUAL "FAKE")
+install( TARGETS kauth-policy-gen EXPORT kdelibsToolsTargets DESTINATION ${LIBEXEC_INSTALL_DIR})
 
 if ( NOT WINCE )
     ########### next target ###############
--- /dev/null
+++ b/kdecore/auth/backends/fake/kauth-policy-gen-fake.cpp
@@ -0,0 +1,32 @@
