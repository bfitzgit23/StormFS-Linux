+*   Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA .
+*/
+
+#include <auth/policy-gen/policy-gen.h>
+
+#include <cstdio>
+
+// The fake KAuth backend enforces nothing, so there is no policy file to
+// generate.  This stub only exists so the kauth-policy-gen executable (and
+// therefore its imported target in KDELibs4ToolsTargets.cmake) is always
+// present; no install rule invokes it for this backend.
+void output(QList<Action> actions, QHash<QString, QString> domain)
+{
+    (void)actions;
+    (void)domain;
+    std::fputs("kauth-policy-gen: built with the Fake KAuth backend, no policy written\n", stderr);
+}
