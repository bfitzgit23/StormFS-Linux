# description	: KDE 4 core libraries
# homepage	: https://kde.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="KDE 4 core libraries"
name=kdelibs
version=4.14.3
release=15
source="https://download.kde.org/Attic/4.14.3/src/kdelibs-$version.tar.xz kdelibs-4.14.3-cmake4.patch.manual kdelibs-4.14.3-cmake4-interface-libs.patch.manual kdelibs-4.14.3-klocale-bool-comparison.patch.manual kdelibs-4.14.3-optional-dbusmenuqt.patch.manual kdelibs-4.14.3-optional-declarative.patch.manual kdelibs-4.14.3-ordered.patch.manual kdelibs-4.14.3-jasper-exported.patch.manual kdelibs-4.14.3-openssl-1.1.patch.manual"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	# CMake 4 rejects configure-time LOCATION reads and the removed OLD policy
	# behavior, treats a bare TEST argument as the if() operator, and kdeui has
	# a duplicate else() branch.  Use target-file generator expressions, quote
	# comparisons, drop the duplicate branch, and use the 3.5 policy baseline.
	# CMake 4 enables CMP0022, so set KDE4's interface link libraries with
	# the INTERFACE_LINK_LIBRARIES property.  This avoids mixing plain and
	# keyword target_link_libraries signatures and the removed old-style
	# properties.  Normalize the icon install destinations under CMP0177.
	#
	# Qt 4 is built without QtWebKit, so omit the optional kdewebkit module
	# and its Plasma and designer-plugin consumers.
	#
	# klocale_kde.cpp compares the result of QString::contains() against zero.
	# Qt 4 returns QBool there, which only converts to void*, so the ordered
	# pointer/integer comparison is an error rather than something -fpermissive
	# can downgrade.  Test the boolean conversion directly instead.
	#
	# kstatusnotifieritem.cpp includes <dbusmenuexporter.h> unconditionally,
	# but dbusmenu-qt is not part of BFSOS.  Make that dependency optional and
	# fall back to the plain menu event filter when it is unavailable.
	#
	# Qt 4 is also built with -no-declarative/-no-script, so the QML bindings in
	# experimental/libkdeclarative, the copies plasma compiles in, the
	# QDeclarativeItem use in plasma/popupapplet.cpp, and the
	# KDeclarative::runtimePlatform() call in plasma/private/packages.cpp all
	# have to go.  Skip them unless QtDeclarative and QtScript are present, and
	# only define HAVE_QTDECLARATIVE when FindQt4 found the module.
	#
	# The remaining patches are the Arch/AUR kdelibs fixes that still apply to
	# 4.14.3: the QBool comparisons in kio, the libjasper exported entry point,
	# and the OpenSSL 1.1 API (inert while OpenSSL is disabled below).
	#
	# Four further AUR patches are shipped but deliberately not applied:
	#   kdelibs-4.14.3-qt4-qmake.patch.manual drops plain "qmake" from the
	#     FindQt4 search list for Arch's qmake-qt4 layout; BFSOS installs only
	#     /opt/qt4/bin/qmake, so applying it makes Qt undetectable.
	#   kdelibs-4.14.3-archlinux-menu.patch.manual adds an "Arch Linux" menu
	#     to the XDG layout, which is the wrong branding for BFSOS.
	#   kdelibs-4.14.3-kde-applications-menu.patch.manual renames the installed
	#     menu file to coexist with gnome-menus; nothing else here installs
	#     applications.menu.
	#   kdelibs-4.14.3-no-kdewebkit.patch.manual does not apply to 4.14.3, and
	#     the kdewebkit module is already removed by the cmake4 patch above.
	patch -p1 -i "$SRC/kdelibs-4.14.3-cmake4.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-cmake4-interface-libs.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-klocale-bool-comparison.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-optional-dbusmenuqt.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-optional-declarative.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-ordered.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-jasper-exported.patch.manual" || return 1
	patch -p1 -i "$SRC/kdelibs-4.14.3-openssl-1.1.patch.manual" || return 1

	export CMAKE_PREFIX_PATH="/opt/qt4:/usr"
	export PATH="/opt/qt4/bin:$PATH"
	export QT_QMAKE_EXECUTABLE=/opt/qt4/bin/qmake
	export CFLAGS="${CFLAGS:+$CFLAGS }-std=gnu99"
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-std=gnu++98 -fpermissive -Wno-deprecated-declarations"

	cmake -S . -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DQT_QMAKE_EXECUTABLE=/opt/qt4/bin/qmake \
		-DKHTML_BUILD_TESTREGRESSION=OFF \
		-DSTATIC_LIBRARY=OFF \
		-DWITH_SOLID_UDISKS2=OFF \
		-DWITH_SOLID_WMI=OFF \
		-DCMAKE_DISABLE_FIND_PACKAGE_OpenSSL=TRUE \
		-DCMAKE_DISABLE_FIND_PACKAGE_DBusMenuQt=TRUE \
		-DCMAKE_DISABLE_FIND_PACKAGE_QCA2=TRUE \
		-DWITH_ASPELL=OFF \
		-DWITH_ENCHANT=OFF \
		-DWITH_HUNSPELL=OFF \
		-DWITH_KDE3SUPPORT=OFF \
		-DWITH_PolkitQt=OFF \
		-DWITH_PolkitQt1=OFF \
		-DWITH_UDISKS=OFF \
		-DWITH_UDISKS2=OFF \
		-DWITH_UDEV=ON \
		-DWITH_OPENGL=ON \
		-DWITH_ACL=ON \
		-DWITH_Soprano=ON \
		-DWITH_Strigi=ON \
		-DWITH_Attica=ON \
		-DWITH_Phonon=ON \
		-DWITH_Nepomuk=ON \
		-DWITH_SAMBA=OFF \
		-DWITH_BlueZ=OFF \
		-DWITH_NetworkManager=OFF \
		-DWITH_LibSSH=OFF || return 1

	cmake --build build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" cmake --install build || return 1
}
