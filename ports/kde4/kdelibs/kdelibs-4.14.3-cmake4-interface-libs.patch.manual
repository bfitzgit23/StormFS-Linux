+   message(FATAL_ERROR "_KDE4_TARGET_LINK_INTERFACE_LIBRARIES() doesn't exist anymore. Set the INTERFACE_LINK_LIBRARIES target property instead. See kdelibs/kdecore/CMakeLists.txt for an example.")
