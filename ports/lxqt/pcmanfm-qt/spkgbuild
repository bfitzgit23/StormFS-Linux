name=pcmanfm-qt
version=2.4.1
release=2
source="https://github.com/lxqt/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
