# description	: libfm-extra package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="libfm-extra package"
name=libfm-extra
version=1.4.1
release=1
build_opt="--prefix=/usr     
            --sysconfdir=/etc 
            --with-extra-only 
            --with-gtk=no     
            --disable-static" 
source="https://github.com/lxde/releases/raw/refs/heads/master/releases/libfm-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
