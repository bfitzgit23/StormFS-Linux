# description	: brasero package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="brasero package"
name=brasero
version=3.12.3
release=3
build_opt="--prefix=/usr                
            --enable-compile-warnings=no 
            --enable-cxx-warnings=no     
            --enable-nautilus"
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz $name-$version-upstream_fixes-1.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	export BFS_SKIP_PATCHES=1
	bfs_autobuild
}
