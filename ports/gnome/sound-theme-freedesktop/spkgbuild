# description	: The Sound Theme Freedesktop package contains sound themes for the desktop.
# homepage	: https://people.freedesktop.org/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="The Sound Theme Freedesktop package contains sound themes for the desktop."
name=sound-theme-freedesktop
version=0.8
release=1
source="https://people.freedesktop.org/~mccann/dist/$name-$version.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1

	./configure --prefix=/usr &&
make
	make DESTDIR=$PKG install
}
