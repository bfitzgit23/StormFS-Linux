# description	: telepathy-glib package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="telepathy-glib package"
name=telepathy-glib
version=0.24.2
release=1
source="https://telepathy.freedesktop.org/releases/${name}/${name}-${version}.tar.gz"

build() {
	cd "$name-$version" || return 1
sed -i '1794 s/tp_value_array_free/(GDestroyNotify) tp_value_array_free/' telepathy-glib/protocol.c
PYTHON=/usr/bin/python3 ./configure --prefix=/usr          \
                                    --enable-vala-bindings \
                                    --disable-static       &&
make
make install
}
