# description	: Graphical editor for the dconf configuration database
# homepage	: https://apps.gnome.org/DconfEditor/
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Graphical editor for the dconf configuration database"
name=dconf-editor
version=49.0
release=2
source="https://download.gnome.org/sources/${name}/49/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
