# Description: Userspace virtual filesystem designed to work with the I/O abstractions of GLib's GIO library
# URL: https://gitlab.gnome.org/GNOME/gvfs
# Maintainer: Venom Linux Team, venomlinux at disroot dot org
# Depends on: gvfs libnfs

name=gvfs-nfs
version=1.60.1
release=1
source=(https://download.gnome.org/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz)

build() {
	meson setup $name-$version build \
		-Dafc=false \
		-Dbluray=false \
		-Dcdda=false \
		-Ddnssd=false \
		-Dgoa=false \
		-Dgoogle=false \
		-Dgphoto2=false \
		-Dlogind=false \
		-Dmtp=false \
		-Dnfs=true \
		-Donedrive=false \
		-Dsftp=false \
		-Dsmb=false \
		-Dsystemduserunitdir=no \
		-Dtmpfilesdir=no 
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build

	# Remove gvfs conflicts
	for f in $(scratch files gvfs | grep -v /$); do
		rm $PKG/$f || true
	done

	for d in $(scratch files gvfs | grep /$ | tac); do
		rmdir $PKG/$d || true
	done
}