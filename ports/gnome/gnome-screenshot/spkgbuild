description="gnome-screenshot package"
name=gnome-screenshot
version=41.0
release=1
source="https://download.gnome.org/sources/${name}/41/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
sed -i '/merge_file/{n;d}' data/meson.build
	bfs_autobuild
}
