# description	: gnome-nettool package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="gnome-nettool package"
name=gnome-nettool
version=42.0
release=1
source="https://download.gnome.org/sources/${name}/42/${name}-${version}.tar.xz https://www.linuxfromscratch.org/patches/blfs/svn/$name-$version-ping_and_netstat_fixes-1.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	export BFS_SKIP_PATCHES=1
sed -i '/merge_file/s/(.*/(/' data/meson.build
	bfs_autobuild
}
