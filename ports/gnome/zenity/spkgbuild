# description	: Display graphical dialog boxes from shell scripts.
# homepage	: https://gitlab.gnome.org/GNOME/zenity
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: help2man libnotify webkitgtk

description="Display graphical dialog boxes from shell scripts."
name=zenity
version=4.2.2
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	cd "$name-$version" || return 1
  scratch isinstalled help2man || BFS_ZENITY+=' -D manpage=false'
  # disabled for now as it requires webkitgtk4.1
  scratch isinstalled webkitgtk && BFS_ZENITY+=' -D webkitgtk=false'

  meson setup build . $BFS_ZENITY \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true

  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -r $PKG/usr/share/{locale,help}
}
