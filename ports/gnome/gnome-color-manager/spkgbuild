name=gnome-color-manager
version=3.36.2
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd "$name-$version" || return 1
sed /subdir\(\'man/d -i meson.build
mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release .. &&
ninja
ninja install
}
