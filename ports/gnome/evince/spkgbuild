# description	: evince package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=evince
version=48.4
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd "$name-$version" || return 1
mkdir build &&
cd    build &&

CPPFLAGS+=" -I/opt/texlive/2024/include" \
meson setup --prefix=/usr          \
            --buildtype=release    \
            -D gtk_doc=false       \
            --wrap-mode=nodownload \
            ..                     &&
ninja
ninja install
}
