description="gcr package"
name=gcr
version=3.41.2
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd "$name-$version" || return 1
sed -i 's:"/desktop:"/org:' schema/*.xml &&

mkdir build &&
cd    build &&

meson setup --prefix=/usr       \
            --buildtype=release \
            -Dgtk_doc=false     \
            -Dssh_agent=false   \
            ..                  &&
ninja 
DESTDIR=$PKG ninja install
}
