# description	: webkitgtk-41 package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=webkitgtk-41
version=2.52.6
release=4
source="https://webkitgtk.org/releases/webkitgtk-${version}.tar.xz"

build() {
	cd "$name-$version" || return 1
  # fail the build if dependencies are not met
  ls /usr/include/harfbuzz/hb-icu.h || (printf '\e[1;31m%-6s\e[m\n' "You need to install icu, then rebuild harfbuzz for webkitgtk to work, quitting..." ; exit 1)

  # Make sure we do not have ccache masquerade directory in PATH.
  #[ -e '/usr/bin/ccache' ] && PATH="$(echo ${PATH} | awk -v RS=: -v ORS=: '/ccache/ {next} {print}' | sed 's/:*$//')"

  scratch isinstalled openjpeg22 || BFS_WEBKITGTK+=' -DUSE_OPENJPEG=OFF'
  scratch isinstalled enchant || BFS_WEBKITGTK+=' -DENABLE_SPELLCHECK=OFF'
  scratch isinstalled libnotify && BFS_WEBKITGTK+=' -DUSE_LIBNOTIFY=ON' || BFS_WEBKITGTK+=' -DUSE_LIBNOTIFY=OFF'
  scratch isinstalled geoclue && BFS_WEBKITGTK+=' -DENABLE_GEOLOCATION=ON' || BFS_WEBKITGTK+=' -DENABLE_GEOLOCATION=OFF'
  scratch isinstalled bubblewrap xdg-dbus-proxy && BFS_WEBKITGTK+=' -DENABLE_BUBBLEWRAP_SANDBOX=ON' \
  || BFS_WEBKITGTK+=' -DENABLE_BUBBLEWRAP_SANDBOX=OFF'
  scratch isinstalled wpebackend-fdo || BFS_WEBKITGTK+=' -DUSE_WPE_RENDERER=OFF'
  scratch isinstalled libmanette || BFS_WEBKITGTK+=' -DENABLE_GAMEPAD=OFF'
  scratch isinstalled libavif || BFS_WEBKITGTK+=' -DUSE_AVIF=OFF'
  scratch isinstalled gst-plugins-bad || BFS_WEBKITGTK+=' -DUSE_GSTREAMER_TRANSCODER=OFF'

  cmake -S . -B build -G Ninja ${BFS_WEBKITGTK} \
    -D CMAKE_BUILD_TYPE=Release     \
      -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_SKIP_INSTALL_RPATH=ON   \
      -D PORT=GTK                      \
      -D LIB_INSTALL_DIR=/usr/lib      \
      -D USE_GTK4=OFF                  \
      -D USE_LIBBACKTRACE=OFF          \
      -D USE_LIBHYPHEN=OFF             \
      -D ENABLE_GAMEPAD=OFF            \
      -D ENABLE_MINIBROWSER=ON         \
      -D ENABLE_DOCUMENTATION=OFF      \
      -D ENABLE_WEBDRIVER=OFF          \
      -D USE_WOFF2=OFF                 \
      -D USE_GTK3=ON                  \
      -D ENABLE_BUBBLEWRAP_SANDBOX=ON  \
      -D USE_SYSPROF_CAPTURE=NO        \
      -W no-dev  &&
   

  cmake --build build || return 1
  DESTDIR="$PKG" cmake --install build || return 1
  rm -rf "$PKG/usr/share/locale"
  # avoid a footprint collision with webkitgtk
#  mv $PKG/usr/bin/WebKitWebDriver{,-4.1}
}
