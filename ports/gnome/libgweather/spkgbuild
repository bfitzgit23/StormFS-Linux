# description	: GNOME weather information library
# homepage	: https://gitlab.gnome.org/GNOME/libgweather
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GNOME weather information library"
name=libgweather
version=4.6.0
release=1
build_opt="--prefix=/usr
            --buildtype=release
            -Dgtk_doc=false"
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
