# description	: Shared GSettings schemas for the GNOME desktop
# homepage	: https://gitlab.gnome.org/GNOME/gsettings-desktop-schemas
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=gsettings-desktop-schemas
version=51.0
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
    sed -i -r 's:"(/system):"/org/gnome\1:g' schemas/*.in || return 1
	bfs_autobuild
}
