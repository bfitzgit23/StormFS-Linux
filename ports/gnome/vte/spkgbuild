description="vte package"
name=vte
version=0.84.1
release=2
source="https://gitlab.gnome.org/GNOME/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
mkdir build &&
cd    build &&

meson setup --prefix=/usr --buildtype=release \
            -D_systemd=false \
            .. &&
ninja
DESTDIR="$PKG" ninja install
}

post_install () {
rm -v /etc/profile.d/vte.*
}
