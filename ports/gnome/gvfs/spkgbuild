# description	: gvfs package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=gvfs
version=1.62.0
release=1
build_opt="-Donedrive=false
-Dfuse=true
-Dgphoto2=false
-Dafc=false
-Dbluray=false
-Dnfs=false
-Dmtp=false
-Dsmb=true
-Ddnssd=true
-Dgoa=true
-Dgoogle=true"
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1
	bfs_autobuild
}
