description="gnome-online-accounts package"
name=gnome-online-accounts
version=3.58.1
release=1
build_opt="--prefix=/usr                                    
      --buildtype=release                              
      -D documentation=false                           
      -D kerberos=false                                
      -D google_client_secret=5ntt6GbbkjnTVXx-MSxbmx5e 
      -D google_client_id=595013732528-llk8trb03f0ldpqq6nprjp1s79596646.apps.googleusercontent.com"
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
