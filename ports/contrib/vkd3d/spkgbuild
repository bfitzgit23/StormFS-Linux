# description	: Direct3D 12 to Vulkan translation library by WineHQ
# homepage	: https://wiki.winehq.org/Vkd3d
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Direct3D 12 to Vulkan translation library by WineHQ"
name=vkd3d
version=2.1
release=1
build_opt="--with-spirv-tools"
source="https://dl.winehq.org/vkd3d/source/vkd3d-$version.tar.xz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
