# description	: GLib core library for passing menus over D-Bus
# homepage	: https://launchpad.net/libdbusmenu
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="GLib core library for passing menus over D-Bus"
name=libdbusmenu-glib
version=18.10
release=3
build_opt="--prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib/libdbusmenu-glib --localstatedir=/var --disable-dumper --disable-tests --disable-vala --disable-nls --disable-gtk"
# Custom build required: only the GLib sublibrary is installed
source="https://deb.debian.org/debian/pool/main/libd/libdbusmenu/libdbusmenu_18.10.20180917~bzr492+repack1.orig.tar.xz 0001_no-deprecated-gnome-common-macros.patch 0003_port-tools-dbusmenu-bench-to-py3.patch 0004_prevent-test-json-from-failing.patch"

build() {
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
  (
    set -e
  export HAVE_VALGRIND_TRUE='#'
  export HAVE_VALGRIND_FALSE=''

  sed -i 's/-Werror -Wno-error=deprecated-declarations//g' libdbusmenu-{glib,gtk}/Makefile.am || return 1
  sed -i 's/gtkdocize || exit 1//g' autogen.sh || return 1
  sed -i 's/--enable-gtk-doc//g' autogen.sh || return 1

  ./autogen.sh $build_opt || return 1

  make -j"${JOBS:-1}" || return 1
  make DESTDIR="$PKG" -C libdbusmenu-glib install || return 1
  rm -rf "$PKG/usr/share/doc"
  )
}
