# description	: A cross-platform, GPU-accelerated terminal emulator
# homepage	: https://github.com/alacritty/alacritty
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>
# optional	: bash-completion scdoc zsh

name=alacritty
version=0.17.0
release=4
renames=($name-$version.tar.gz)
# Custom build required: Cargo build plus optional completion/manpage staging
source="https://github.com/alacritty/alacritty/archive/refs/tags/v$version.tar.gz"

build() {
	cd "$name-$version" || return 1
  (
    set -e
  scratch isinstalled sccache && export RUSTC_WRAPPER=/usr/bin/sccache
  mkdir $BFS_SOURCE_DIR/rust || true
  export CARGO_HOME=$BFS_SOURCE_DIR/rust

  cargo build --release --manifest-path Cargo.toml || return 1

  install -D -m755 target/release/alacritty \
    "$PKG/usr/bin/alacritty" || return 1

  if scratch isinstalled scdoc; then
    for i in 1 5 7; do
      scdoc < extra/man/alacritty.${i}.scd | tee alacritty.${i}
    install -D -m644 alacritty.${i} \
      $PKG/usr/share/man/man${i}/alacritty.${i}
    done
  fi

  install -D -m644 \
    extra/linux/org.alacritty.Alacritty.appdata.xml \
    "$PKG/usr/share/appdata/io.alacritty.Alacritty.appdata.xml" || return 1

  # install auto-completion files if the ports for it are installed
  scratch isinstalled zsh && install -D -m644 \
    extra/completions/_alacritty \
    $PKG/usr/share/zsh/site-functions/_alacritty
  scratch isinstalled bash-completion && install -D -m644 \
    extra/completions/alacritty.bash \
    $PKG/usr/share/bash-completion/completions/alacritty

  #install -D -m644 $name-$version/alacritty.yml \
  #  $PKG/usr/share/alacritty/alacritty.yml
  install -D -m 644 extra/linux/Alacritty.desktop \
    "$PKG/usr/share/applications/Alacritty.desktop" || return 1
  install -D -m644 extra/logo/alacritty-term.svg \
    "$PKG/usr/share/pixmaps/Alacritty.svg" || return 1
  )
}
