# description	: xfce4-terminal package
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

name=xfce4-terminal
version=1.2.0
release=2
source="https://archive.xfce.org/src/apps/${name}/${version%.*}/${name}-${version}.tar.xz xfce4-terminal-1.2.0-wayland-guard.patch"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	cd "$name-$version" || return 1

	# Apply patch sources; pkgbuild does this automatically.
	for _bfs_patch in "$SRC"/*.patch "$SRC"/*.diff; do
		[ -f "$_bfs_patch" ] || continue
		patch -t "${patch_opt:--p1}" -i "$_bfs_patch" || return 1
	done
	export BFS_SKIP_PATCHES=1
	bfs_autobuild
}
