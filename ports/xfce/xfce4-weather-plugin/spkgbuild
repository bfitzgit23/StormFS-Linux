# description	: Shows information about local weather in the Xfce panel
# homepage	: https://xfce.org
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Shows information about local weather in the Xfce panel"
name=xfce4-weather-plugin
version=0.12.0
release=1
source="https://gitlab.xfce.org/panel-plugins/$name/-/archive/$name-$version/$name-$name-$version.tar.gz"

build() {
	. /usr/share/bfsos/spkgbuild.helper || return 1
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
	bfs_autobuild
}
