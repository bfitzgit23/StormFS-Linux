# description	: Xfce windowing abstraction library for X11 and Wayland
# homepage	: https://docs.xfce.org/xfce/libxfce4windowing/start
# maintainer	: Brian Madonna <bmadonnaster@gmail.com>

description="Xfce windowing abstraction library for X11 and Wayland"
name=libxfce4windowing
version=4.20.7
release=2
source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.bz2"

build() {
	_bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -iname "$name-$version" -print -quit)
	[ -n "$_bfs_src" ] || _bfs_src=$(find . -mindepth 1 -maxdepth 1 -type d -print -quit)
	[ -n "$_bfs_src" ] || return 1
	cd "$_bfs_src" || return 1
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --enable-x11 \
                --disable-debug
    make
    make DESTDIR="$PKG" install
}
