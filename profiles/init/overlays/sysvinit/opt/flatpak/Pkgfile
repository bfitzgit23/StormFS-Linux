# Generated by scripts/generate-init-variants.py for sysvinit.
# The upstream Pkgfile remains the systemd baseline.
# Description: Application deployment and sandboxing framework for Linux desktops
# URL: https://flatpak.org/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: appstream bubblewrap xdg-dbus-proxy dbus dconf glib gpgme json-glib libarchive libseccomp libsoup3 libxmlb ostree p11-kit python3-pyparsing fuse curl xdg-desktop-portal
# Optional: polkit appstream-glib avahi libxslt xmlto docbook-xml docbook-xsl-nons malcontent

name=flatpak
version=1.18.2
release=1
source=(https://github.com/flatpak/flatpak/releases/download/${version}/flatpak-${version}.tar.xz)

pkg_build() {
    mkdir -p build && cd build || return 1

    # -Dsystemd=disabled keeps BFSOS init-neutral: service integration is
    # owned by the selected init profile (systemd/openrc/sysvinit), and
    # system_bubblewrap/system_dbus_proxy point at the distro-provided
    # binaries so Meson does not fetch its own subprojects at build time.
    meson setup \
        --prefix=/usr \
        --buildtype=release \
        -D systemd=disabled \
        -D system_bubblewrap=bwrap \
        -D system_dbus_proxy=xdg-dbus-proxy \
        -D auto_sideloading=false \
        -D gdm_env_file=false \
        -D tests=false \
        .. || return 1

    ninja -j "${JOBS:-1}" || return 1
    DESTDIR="$PKG" ninja install || return 1

    # Strip any systemd-carried artifacts from the disabled-but-installed
    # integration paths so the package stays init-neutral on disk.
    rm -rf "$PKG/usr/share/bfsos/systemd-units" "$PKG/usr/share/bfsos/systemd-units" \
           "$PKG/usr/lib/sysusers.d" "$PKG/usr/lib/tmpfiles.d"

    find "$PKG" -name '*.la' -delete
}
