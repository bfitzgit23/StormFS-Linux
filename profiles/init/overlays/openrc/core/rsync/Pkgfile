# Generated by scripts/generate-init-variants.py for openrc.
# The upstream Pkgfile remains the systemd baseline.
# Description: Utility for incremental file transfers over networks
# URL: https://rsync.samba.org
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
# Depends on: acl openssl zlib zstd

name=rsync
version=3.5.0
release=2
source=(https://www.samba.org/ftp/$name/src/$name-$version.tar.gz \
	rsyncd.conf rsyncd.service rsync.driver)

pkg_build() {


	./configure \
		--prefix=/usr \
		--with-rsh=ssh \
		--with-included-zlib=no \
		--with-included-popt=yes \
		--disable-xxhash \
		--disable-lz4

	make
	make DESTDIR=$PKG install

	install -d $PKG/etc/ports/drivers $PKG/var/log $PKG/usr/share/bfsos/systemd-units/system
	install -m 644 $SRC/rsyncd.service $PKG/usr/share/bfsos/systemd-units/system/rsyncd.service
	install -m 644 $SRC/rsyncd.conf $PKG/etc
	install -m 755 $SRC/rsync.driver $PKG/etc/ports/drivers/rsync
	touch $PKG/var/log/rsyncd.log
}
