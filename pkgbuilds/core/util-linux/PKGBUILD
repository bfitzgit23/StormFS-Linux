# Description: Essential Linux system utilities
# URL: https://www.kernel.org/pub/linux/utils/util-linux/
# Maintainer: Brian Madonna <bmadonnaster@gmail.com>

pkgname=util-linux
pkgver=2.42.4
pkgrel=1

source=(
    https://www.kernel.org/pub/linux/utils/util-linux/v${pkgver%.*}/util-linux-$pkgver.tar.xz
)

options=(!strip !clean)

build() {
    cd "$srcdir/util-linux-$pkgver"

    ./configure \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --runstatedir=/run \
        --sbindir=/usr/sbin \
        --disable-chfn-chsh \
        --disable-login \
        --disable-nologin \
        --disable-su \
        --disable-setpriv \
        --disable-runuser \
        --disable-pylibmount \
        --disable-liblastlog2 \
        --disable-static \
        --without-python \
        --docdir=/usr/share/doc/$pkgname-$pkgver \
        ADJTIME_PATH=/var/lib/hwclock/adjtime

    make
    make DESTDIR="$pkgdir" install
}

post_install() {
    # Post-install steps if needed
    :
}
