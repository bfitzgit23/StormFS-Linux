# Maintainer: Brian Madonna <bmadonnaster@gmail.com>
pkgname=coreutils
pkgver=9.12
pkgrel=1
source=(
    https://ftp.gnu.org/gnu/coreutils/coreutils-$pkgver.tar.xz
    https://www.linuxfromscratch.org/patches/downloads/coreutils/coreutils-9.11-i18n-1.patch
)
export FORCE_UNSAFE_CONFIGURE=1
build() {
    cd "$srcdir/coreutils-$pkgver"
    FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=/usr \
        --enable-install-program=hostname \
        --enable-no-install-program=kill,uptime
    make
    make DESTDIR="$pkgdir" install
}
post_install() {
    mkdir -p "$pkgdir/bin"
    for i in cat chgrp chmod chown cp date dd df echo \
        false ln ls mkdir mknod mv pwd rm rmdir stty sync true uname; do
        mv "$pkgdir/usr/bin/$i" "$pkgdir/bin"
    done
    mkdir -p "$pkgdir/usr/sbin"
    mv "$pkgdir/usr/bin/chroot" "$pkgdir/usr/sbin"
    mkdir -p "$pkgdir/usr/share/man/man8/"
    mv -v "$pkgdir/usr/share/man/man1/chroot.1" "$pkgdir/usr/share/man/man8/chroot.8"
    sed -i 's/"1"/"8"/1' "$pkgdir/usr/share/man/man8/chroot.8"
}
