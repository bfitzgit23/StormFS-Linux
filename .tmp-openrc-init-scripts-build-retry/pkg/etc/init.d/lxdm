#!/sbin/openrc-run

description="LXDE Display Manager"

pidfile=/run/lxdm.pid

depend() {
	provide xdm
	need dbus
}

start() {
	ebegin "Starting LXDM"
	start-stop-daemon --start --exec /usr/sbin/lxdm-binary
	eend $?
}

stop() {
	ebegin "Stopping LXDM"
	start-stop-daemon --stop --exec /usr/sbin/lxdm-binary
	eend $?
}
