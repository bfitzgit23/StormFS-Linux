#!/bin/sh
#
# StormFS Linux QEMU Test Script
# Test the ISO in QEMU with BIOS or UEFI mode.
#
# Usage:
#   ./run_qemu <iso-path> [--uefi] [--ram]
#

usage() {
	echo "Usage: $0 <iso-path> [options]"
	echo
	echo "Options:"
	echo "  --uefi    Boot in UEFI mode (default: BIOS)"
	echo "  --ram     Boot in RAM-only mode (copies rootfs to tmpfs)"
	echo "  --help    Show this help"
	exit 1
}

# Defaults
MODE="bios"
MEMORY="4G"
CPUS="2"
ISO=""

# Parse arguments
while [ $# -gt 0 ]; do
	case "$1" in
		--uefi) MODE="uefi" ;;
		--ram)  MODE="ram" ;;
		--help|-h) usage ;;
		-*) echo "Unknown option: $1"; usage ;;
		*)
			if [ -z "$ISO" ]; then
				ISO="$1"
			else
				echo "Unexpected argument: $1"
				usage
			fi
			;;
	esac
	shift
done

if [ -z "$ISO" ]; then
	echo "ERROR: ISO path is required." >&2
	usage
fi

if [ ! -f "$ISO" ]; then
	echo "ERROR: ISO file not found: $ISO" >&2
	exit 1
fi

# Check for qemu
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
	echo "ERROR: qemu-system-x86_64 not found." >&2
	echo "Install QEMU: sudo pacman -S qemu-full" >&2
	exit 1
fi

# Create a temporary VM disk
VMIMG="$(mktemp -u /tmp/stormfs-vm-XXXXXX.qemu-img)"
qemu-img create -f qcow2 "$VMIMG" 50G >/dev/null 2>&1

cleanup() {
	rm -f "$VMIMG"
}
trap cleanup EXIT

EXTRA_ARGS=""

case "$MODE" in
	bios)
		echo "Booting in BIOS mode..."
		;;
	uefi)
		# Find OVMF UEFI firmware
		OVMF=""
		for path in \
			/usr/share/edk2/x64/OVMF.4m \
			/usr/share/edk2/x64/OVMF_CODE.fd \
			/usr/share/qemu/OVMF_CODE.fd \
			/usr/share/edk2-ovmf/x64/OVMF_CODE.fd \
			/usr/share/edk2/OVMF.fd; do
			if [ -f "$path" ]; then
				OVMF="$path"
				break
			fi
		done

		if [ -z "$OVMF" ]; then
			echo "ERROR: UEFI firmware (OVMF) not found." >&2
			echo "Install edk2-ovmf or set OVMF manually." >&2
			exit 1
		fi

		echo "Booting in UEFI mode (OVMF: $OVMF)..."
		EXTRA_ARGS="-bios $OVMF"
		;;
	ram)
		echo "Booting in RAM-only mode..."
		;;
esac

echo "  ISO: $ISO"
echo "  RAM: $MEMORY  CPUs: $CPUS"
echo
echo "Press Ctrl+A then X to exit QEMU."
echo

qemu-system-x86_64 \
	-enable-kvm \
	-cpu host \
	-m "$MEMORY" \
	-smp "$CPUS" \
	-drive file="$VMIMG",if=virtio,format=qcow2 \
	-device virtio-rng-pci \
	-boot d \
	-cdrom "$ISO" \
	-name "StormFS Linux" \
	$EXTRA_ARGS
